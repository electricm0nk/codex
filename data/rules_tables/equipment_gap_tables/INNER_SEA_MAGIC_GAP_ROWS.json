  "rows": [
    {
      "book": "ISM",
      "key": "Caster's Tattoo (Lesser)",
      "name": "Caster's Tattoo (Lesser)",
      "category": "General",
      "cost_gp": 6000.0,
      "weight_lbs": 0.0,
      "description": "A lesser caster's tattoo is infused with potential magical energy that aids in casting spells of up to third level that normally utilize verbal and somatic components. Once per day, a spellcaster may activate her caster's tattoo as a swift action to automatically enhance the next spell of third level or lower that she casts in that round with both the Still Spell and Silent Spell feats. When she casts the spell, the caster's tattoo flares with light for a moment, then grows faint and faded-it replenishes its energy in 24 hours, after which it becomes bold and colorful and can be used again. Required material components or foci must be in the creature's possession to cast the spell (and are consumed as normal), but need not be held when the spell is cast.",
      "name_pi_citation": null
    },
    {
      "book": "ISM",
      "key": "Caster's Tattoo (Normal)",
      "name": "Caster's Tattoo (Normal)",
      "category": "General",
      "cost_gp": 21000.0,
      "weight_lbs": 0.0,
      "description": "A caster's tattoo is infused with potential magical energy that aids in casting spells of up to sixth level that normally utilize verbal and somatic components. Once per day, a spellcaster may activate her caster's tattoo as a swift action to automatically enhance the next spell of sixth level or lower that she casts in that round with both the Still Spell and Silent Spell feats. When she casts the spell, the caster's tattoo flares with light for a moment, then grows faint and faded-it replenishes its energy in 24 hours, after which it becomes bold and colorful and can be used again. Required material components or foci must be in the creature's possession to cast the spell (and are consumed as normal), but need not be held when the spell is cast.",
      "name_pi_citation": null
    },
    {
      "book": "ISM",
      "key": "Caster's Tattoo (Greater)",
      "name": "Caster's Tattoo (Greater)",
      "category": "General",
      "cost_gp": 48000.0,
      "weight_lbs": 0.0,
      "description": "A greater caster's tattoo is infused with potential magical energy that aids in casting spells of up to ninth level that normally utilize verbal and somatic components. Once per day, a spellcaster may activate her caster's tattoo as a swift action to automatically enhance the next spell of ninth level or lower that she casts in that round with both the Still Spell and Silent Spell feats. When she casts the spell, the caster's tattoo flares with light for a moment, then grows faint and faded-it replenishes its energy in 24 hours, after which it becomes bold and colorful and can be used again. Required material components or foci must be in the creature's possession to cast the spell (and are consumed as normal), but need not be held when the spell is cast.",
      "name_pi_citation": null
    },
    {
      "book": "ISM",
      "key": "Reservoir Tattoo",
      "name": "Reservoir Tattoo",
      "category": "General",
      "cost_gp": 10000.0,
      "weight_lbs": 0.0,
      "description": "Once per day as a standard action, the bearer can transfer into the tattoo an ongoing single-target spell (of up to 3rd level). The spell must be one the bearer cast on itself. While stored in the tattoo, the spell's effects are suppressed, and the spell's duration is similarly suspended. As a standard action, the bearer can bring the spell back into effect on itself. Spells stored in reservoir tattoos are lost when the bearer next prepares spells.",
      "name_pi_citation": null
    },
