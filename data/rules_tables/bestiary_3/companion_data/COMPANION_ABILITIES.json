    {
      "key": "Carbuncle ~ Vulnerability to Suggestion",
      "name": "Vulnerability to Suggestion",
      "facet": "SpecialQuality",
      "delivery": "Extraordinary",
      "type_segments": [
        "CarbuncleRacialAbility",
        "SpecialQuality",
        "Extraordinary"
