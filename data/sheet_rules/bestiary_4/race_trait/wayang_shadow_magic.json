[{"id":"bestiary_4:race_trait:wayang_shadow_magic","label":"Shadow Magic","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Wayangs add 1 to the DC of any saving throws to resist spells of the shadow subschool that they cast. Wayangs with a Charisma score of 11 or higher also gain the following spell-like abilities: 1/day--ghost sound, pass without trace, and ventriloquism. The caster level for these effects is equal to the wayang's character level. The DCs of these spells are equal to 10 + the spell's level + the wayang's Charisma modifier."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:wayang_dissolution_s_child"},"count":1}}},"target":{"SpellDc":{"Subschool":"Shadow"}},"print":true,"pool":"special_ability","tags":["RacialTraits","Wayang Racial Trait","Wayang Racial Default","SpecialQuality","Special Quality","Wayang MA Racial Trait"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_4","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/races/wayang/wayang_abilities_race.lst:21","pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:1290","pathfinder/paizo/roleplaying_game/bestiary_4/b4_abilities_race_pc.lst:163","pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities_race.lst:1684","pathfinder/paizo/roleplaying_game/mythic_adventures/ma_feats.lst:669"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
