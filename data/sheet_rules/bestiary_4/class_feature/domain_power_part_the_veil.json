[{"id":"bestiary_4:class_feature:domain_power_part_the_veil","label":"Part the Veil","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"vc3dfec2ee0f59858"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"You can lace spells you cast with the raw madness that waits in the outer darkness. Activating this ability is a swift action that you must use as you cast a spell that targets a single creature and that allows a Will saving throw to negate or reduce the spell's primary effect. If the target fails to resist the spell, the target is also confused for a number of rounds equal to the spell's level as visions of the void cause temporary insanity. The victim can attempt a new saving throw each round to end the effect - these additional saving throws apply only to the additional confusion effect and not to the original spell effect. This is a mind-affecting effect. You can use this ability "},{"Slot":{"Var":"vc3dfec2ee0f59858"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"vc3dfec2ee0f59858"}},{"Text":"/day)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary_4:class_feature:core_domain_void_domain"},"when":{"Compare":{"lhs":{"Var":"v1cef2c6026713b5c"},"op":"Gte","rhs":{"Const":8}}}},{"by":{"Rule":"bestiary_4:domain:dark_tapestry_subdomain"},"when":{"Compare":{"lhs":{"Var":"v1cef2c6026713b5c"},"op":"Gte","rhs":{"Const":8}}}},{"by":{"Rule":"bestiary_6:class_feature:core_domain_void_domain"},"when":{"Compare":{"lhs":{"Var":"v1cef2c6026713b5c"},"op":"Gte","rhs":{"Const":8}}}},{"by":{"Rule":"bestiary_6:class_feature:inquisitor_domain_dark_tapestry_subdomain"},"when":{"Compare":{"lhs":{"Var":"v1cef2c6026713b5c"},"op":"Gte","rhs":{"Const":8}}}},{"by":{"Ru