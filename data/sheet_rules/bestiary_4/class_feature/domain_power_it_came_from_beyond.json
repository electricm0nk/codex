[{"id":"bestiary_4:class_feature:domain_power_it_came_from_beyond","label":"It Came From Beyond","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Once per day when you cast a summoning spell, any one creature you summon is more powerful than normal. The creature gains the advanced creature simple template. If you summon more than one creature with a spell, only one of the summoned creatures gains the advanced creature simple template. A summoned creature that gains the advanced creature simple template in this manner looks unusually deformed or hideous. This ability only works on spells you cast as a cleric-it does not work on spellcasting ability gained from any other spellcasting classes you might have. This ability replaces the Guarded Mind ability of the Void domain."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary_4:domain:dark_tapestry_subdomain"},"when":{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Void)"}},"count":1}}}},{"by":{"Rule":"bestiary_6:class_feature:inquisitor_domain_dark_tapestry_subdomain"},"when":{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Void)"}},"count":1}}}},{"by":{"Rule":"bestiary_6:domain:dark_tapestry_subdomain"},"when":"Never"},{"by":{"Rule":"horror_adventures:class_feature:inquisitor_domain_dark_tapestry_subdomain"},"when":{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Void)"}},"count":1}}}},{"by":{"Rule":"horror_adventures:domain:dark_tapestry_subdomain"},"when":"Never"},{"by":{"Rule":"inner_sea_gods:domain:dark_tapestry_subdomain"},"when":"Never"},{"by":{"Rule":"inner_sea_world_guide:class_feature:inquisitor_domain_dark_tapestry_subdomain"},"when":{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 