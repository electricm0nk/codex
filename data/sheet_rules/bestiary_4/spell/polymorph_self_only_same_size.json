[{"id":"bestiary_4:spell:polymorph_self_only_same_size","label":"Polymorph Self (same size)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This spell transforms you into an animal, humanoid or elemental of your same size, but of your choosing."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell transforms you into an animal, humanoid or elemental of your same size, but of your choosing. If you use this spell to take on the form of an animal or magical beast, the spell functions as beast shape II. If the form is that of an elemental, the spell functions as elemental body I. If the form is that of a humanoid, the spell functions as alter self. You may choose to resume your normal form as a full-round action; doing so ends the spell."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Polymorph"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes [D]"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_4","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary_4/b4_spells_modified.lst:25","pathfinder/paizo/roleplaying_game/bestiary_4