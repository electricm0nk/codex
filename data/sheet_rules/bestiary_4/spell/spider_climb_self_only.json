[{"id":"bestiary_4:spell:spider_climb_self_only","label":"Spider Climb (self only)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can climb and travel on vertical surfaces or even traverse ceilings as well as a spider does."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You can climb and travel on vertical surfaces or even traverse ceilings as well as a spider does. You must have your hands free to climb in this manner. You gain a climb speed of 20 feet and a +8 racial bonus on Climb skill checks; furthermore, you need not make Climb checks to traverse a vertical or horizontal surface [even upside down]. A spider climbing creature retains its Dexterity bonus to Armor Class [if any] while climbing, and opponents get no special bonus to their attacks against it. It cannot, however, use the run action while climbing."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL*10) minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine"],"subject":"C