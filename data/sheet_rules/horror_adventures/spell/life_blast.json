[{"id":"horror_adventures:spell:life_blast","label":"Life Blast","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Drain life from local vegetation to launch a blast of positive energy."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell must be cast in an area with vegetation or it has no effect. When you cast this spell, you draw the life force from the surrounding land and hurl it at your enemies, dealing (min(12,CASTERLEVEL))d6 points of positive energy damage to any undead creatures in the spell's area. However, doing so blights the land around you in a spread with a radius of (min(60,5*CASTERLEVEL)) feet. All vegetation in that area immediately withers and dies. Plant creatures aren't affected. The blast starts from your palm and is able to travel through solid objects and obstacles. [Material Components] a dead leaf."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"150 ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"150-ft. line"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will half"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Divine"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"ranger","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"druid","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":4}},"when":"Always"}],"provenance":{"book":"horror_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:44","pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:119"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
