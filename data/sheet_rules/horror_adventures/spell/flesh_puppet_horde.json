[{"id":"horror_adventures:spell:flesh_puppet_horde","label":"Flesh Puppet Horde","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Control multiple zombies in human guise."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions as flesh puppet, but can animate multiple zombies. As noted in animate dead, you can't control more than (4*CASTERLEVEL) HD worth of undead in total, nor can a single casting create more than (2*CASTERLEVEL) HD. A separate string attaches to each zombie in your horde. Severing a zombie's string reverts that zombie to a corpse, but doesn't end the spell for other zombies. Because commanding a flesh puppet requires a swift action, you can issue commands to only one zombie per round, though zombies you previously commanded continue to follow their orders. Likewise, you can command only one zombie to speak per round. Unlike with flesh puppet, you can command a zombie to attack. If you do, all your zombies immediately gain the staggered quality and no longer appear to be alive. This spell ends automatically if you cast flesh puppet or flesh puppet horde on a new corpse. [Material Components] an onyx worth 50 gp for each zombie and a silken string."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Evil"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"10 minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One or more corpses touched"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Permanent [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"antipaladin","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":5}},"when":"Always"}],"provenance":{"book":"horror_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:33","pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:108"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
