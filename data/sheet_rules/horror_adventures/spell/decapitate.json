[{"id":"horror_adventures:spell:decapitate","label":"Decapitate","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Turn a critical hit into a decapitation."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You can cast this spell only as a response to a confirmed critical hit against the target that would deal slashing damage. If the target fails the saving throw and has a discernible head, the attack deals an extra 4d6 points of damage and the critical multiplier of the critical hit increases by 1. If the critical hit then brings the target to 0 hit points or fewer, the target is instantly decapitated and dies unless it can survive decapitation. Even on a successful saving throw, the critical hit deals an extra 4d6 points of damage. [Spell Focus] a sliver from a guillotine blade."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 immediate action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude partial (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero