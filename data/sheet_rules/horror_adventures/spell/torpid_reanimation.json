[{"id":"horror_adventures:spell:torpid_reanimation","label":"Torpid Reanimation","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Animate dead when a specific trigger condition occurs."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell works like animate dead except you set a specific condition for when the animation occurs and you do not immediately have control of the creatures. The condition can be simple, such as being touched, a certain word spoken, or on hearing a specific sound. You can also set a condition based on time, but it must occur within (caster level) days. At any time, you can cause the animation to occur as a standard action. You can gain control of any uncontrolled undead you created with this spell as a free action if you are within at least 60 feet of the undead creature and have line of sight to it; if you have control of an undead you created with this spell and later lose control of that undead, you can't use this ability to regain control of the same undead. The limit on the number of Hit Dice you can control with animate dead still applies. [Material Components] an onyx gem worth at least 25 gp per HD of the undead."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Evil"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One or more corpses touched"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) days and instantaneous (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"antipaladin","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":5}},"when":"Always"}],"provenance":{"book":"horror_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:70","pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:145"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
