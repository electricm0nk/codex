[{"id":"horror_adventures:spell:sacred_nimbus","label":"Sacred Nimbus","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Holy energy damages evil creatures that attack you and protects you from evil attacks."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You are surrounded by a nimbus of golden light shaped like your god's holy symbol or a symbol of your faith. Any evil creature striking you with unarmed strikes, natural weapons, or a handheld weapon deals normal damage, but at the same time, the attacker takes 1d6+(min(15,CASTERLEVEL)) points of damage. Creatures wielding melee weapons with reach are not subject to this damage if they attack you. Spell resistance applies against this damage. You also take half damage from magical attacks with the evil descriptor. If such an attack allows a Reflex save for half damage, you take no damage on a successful saving throw."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Good"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds [D]"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Divine"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"paladin","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"inquisitor","spell_level":5}},"when":"Always"}],"provenance":{"book":"horror_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:60","pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:135"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
