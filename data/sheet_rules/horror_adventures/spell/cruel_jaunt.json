[{"id":"horror_adventures:spell:cruel_jaunt","label":"Cruel Jaunt","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Sense creatures suffering from fear, then teleport close to them."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You gain the ability to detect fear, as per sense fear (see page 127), but you sense creatures within Medium range. Once per round as a standard action, you can teleport to a creature suffering from a fear effect within the spell's range if you are aware of the creature and its rough location. You can carry objects with you so long as you don't transport more than your maximum load. You arrive in a random open space within 20 feet of the creature and immediately begin sensing the location of creatures with a fear condition from your new location. Once you teleport to a new location with this spell, you can take no additional actions for the round, as if casting dimension door. You can't teleport if there are no creatures suffering from a fear effect in range. [Material Components] a dilated human eyeball."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Teleportation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Evil, Fear, Mind-Affecting"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M/DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":100},{"Mul":[{"Const":10},{"CasterLevel":"Holder"}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"antipaladin","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"inquisitor","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":6}},"when":"Always"}],"provenance":{"book":"horror_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:20","pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:95"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
