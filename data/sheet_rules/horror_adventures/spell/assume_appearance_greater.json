[{"id":"horror_adventures:spell:assume_appearance_greater","label":"Assume Appearance (Greater)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Use a likeness to adopt a dead creature's form."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions similar to assume appearance, except that you can imitate a creature even if you have only a likeness (such as a sketch or painting) that is fairly accurate. If there is an age difference between the likeness and the actual creature, you take on the appearance of the creature near the end of its life. If you have heard the creature whose form you plan to assume speak aloud, you can also copy its voice as vocal alterationUM (speak with dead can also be used to fulfill this requirement). The spell doesn't grant insight into the dead creature's mannerisms. Additionally, if a likeness used as a focus for the spell is kept on your person or within 30 feet at all times, the aura of greater assume appearance is redirected to the likeness instead of to you, similar to a reverse application of the misdirection spell. [Spell Focus] corpse or likeness of the deceased creature whose form you plan to assume."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Polymorph"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 minute"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) days [D]"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"alchemist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"bard","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"medium","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"mesmerist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"summoner","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":4}},"when":"Always"}],"provenance":{"book":"horror_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:7","pathfinder/paizo/roleplaying_game/horror_adventures/ha_spells.lst:82"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
