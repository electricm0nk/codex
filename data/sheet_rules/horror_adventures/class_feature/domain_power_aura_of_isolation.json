[{"id":"horror_adventures:class_feature:domain_power_aura_of_isolation","label":"Aura of Isolation","value":"Text","also":[[{"Uses":{"period":"rounds per day"}},{"Number":{"Var":"vc3dfec2ee0f59858"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you can create a 20-foot aura that causes enemies within to be overcome with feelings of isolation and loss. Your enemies treat the aura as difficult terrain, as they become sluggish within its area of effect. Furthermore, while within the aura, your enemies cannot provide flanking, nor cat they use or benefit from the aid another action. The aura lasts for "},{"Slot":{"Var":"vc3dfec2ee0f59858"}},{"Text":" rounds, but the rounds need not be consecutive. This is a mind-affecting emotion effect."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"horror_adventures:class_feature:inquisitor_domain_isolation_subdomain"},"when":{"Compare":{"lhs":{"Var":"v1cef2c6026713b5c"},"op":"Gte","rhs":{"Const":8}}}},{"by":{"Rule":"horror_adventures:domain:isolation_subdomain"},"when":"Never"},{"by":{"Rule":"inner_sea_gods:domain:isolation_subdomain"},"when":{"Compare":{"lhs":{"Var":"va654709c2b0036f9"},"op":"Gte","rhs":{"Const":8}}}}],"provenance":{"book":"horror_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/ha_abilities_class.lst:89"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
