[{"id":"horror_adventures:class_feature:necrologist_undead_phantom","label":"Undead Phantom","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A necrologist's phantom is undead, rather than an outsider. It has normal undead immunities and no Constitution score; uses d8 Hit Dice, each of which is modified by the phantom's Charisma modifier as normal; and gains the abilities below at the levels indicated. An undead phantom otherwise follows the standard phantom rules (for instance, its base attack bonus and skills don't change to match undead)."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Spiritualist Class Feature","NecrologistClassFeatures"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"horror_adventures:class_feature:spiritualist_archetype_necrologist"},"when":{"Compare":{"lhs":{"ClassLevel":"spiritualist"},"op":"Gte","rhs":{"Const":1}}}}],"offers":{"id":"horror_adventures:class_feature:necrologist_undead_phantom","count":{"Const":1},"from":{"Races":["horror_adventures:race:undead_phantom"]}},"grants":[{"FactGrant":{"CompanionSlots":{"role":"Undead Phantom","count":{"Const":1}}}}],"provenance":{"book":"horror_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/horror_adventures/support/ha_abilities_class_oa.lst:317"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
