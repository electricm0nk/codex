[{"id":"horror_adventures:feat:unyielding_ferocity","label":"Unyielding Ferocity","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When near the brink of death, you fight ferociously until the bitter end."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When you are reduced to 0 or fewer hit points, if you remain conscious from your ferocity monster ability, you can make a full attack on your next turn (or your current turn if you are reduced to 0 hit points on your own turn). If you do, you push your body to the point that your mind becomes more primitive, and you can no longer use any Charisma-, Dexterity-, or Intelligence-based skills except Acrobatics, Fly, Intimidate, or Ride, or any ability that requires patience or concentration (such as spellcasting) until your hit points are raised above 0. [Normal] When using the ferocity ability, you are staggered while you have fewer than 0 hit points and thus can't make a full attack."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:race_trait:half_orc_orc_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:adaptation_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"bestiary:race_trait:orc_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:ability:builder_racial_trait_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:ability:builder_racial_trait_orc_ferocity"},"count":1}}]}},{"Compare":{"lhs":{"Max":[{"AbilityScore":"Con"},{"Var":"v356e9d6dc3609183"}]},"op":"Gte","rhs":{"Const":19}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:race_trait:half_orc_orc_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:adaptation_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"bestiary:race_trait:orc_ferocity"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:ability