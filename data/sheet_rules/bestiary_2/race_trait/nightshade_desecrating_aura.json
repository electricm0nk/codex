[{"id":"bestiary_2:race_trait:nightshade_desecrating_aura","label":"Desecrating Aura","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"All nightshades have a 30-foot-radius emanation equivalent to a desecrate spell centered on a shrine of evil power.  Undead within this radius (including the nightshade) gain a +2 profane bonus on attack and damage rolls and saving throws, as well as +2 hit points per die, and the save DC of channeled negative energy is increased by +6 (these adjustments are included for the nightshades in their entries).  This aura can be negated by dispel evil, but a nightshade can reactivate it on its turnas a free action.  A desecrating aura suppresses and is suppressed by consecrate or hallow; both effects are negated wtihin any overlapping area of effect."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(30 ft.)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","target":"Attack","bonus_type":{"name":"Profane","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Aura","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_2","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/ce_abilities_race.lst:1971"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary_2:race_trait:nightshade_desecrating_aura#bonus1","label":"Desecrating Aura (damage)","value":{"Number":{"Const":2}},"applies":"Always","target":{"Damage":"Melee"},"bonus_type":{"name":"Profane","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Aura","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_2","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/ce_abilities_race.lst:1971"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":