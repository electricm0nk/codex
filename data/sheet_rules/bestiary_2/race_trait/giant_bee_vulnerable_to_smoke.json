[{"id":"bestiary_2:race_trait:giant_bee_vulnerable_to_smoke","label":"Vulnerable to Smoke","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Smoke from particularly smoky fires or effects (such as that created by a pyrotechnics spell) causes a giant bee to become nauseated if it fails a DC 14 Fortitude save.  This condition persists as long as the giant bee remains in the smoke, plus 1d4 rounds."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Weakness","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary_2:monster:bee_giant_queen"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:bee_giant"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:bumblebee_giant"},"when":"Always"}],"provenance":{"book":"bestiary_2","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary_2/b2_abilities_race.lst:178"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
