[{"id":"bestiary_2:monster_ability:neh_thalggu_brain_collection","label":"Brain Collection","value":{"Number":{"Const":7}},"prose":[{"family":"Desc","pieces":[{"Text":"A neh-thalggu can store up to seven  humanoid brains and use them to enhance its knowledge and power.  Each stored brain grants a neh-thalggu a cumulative +1 insight bonus to AC, concentration checks, and Knowledge checks.  A neh-thalggu can extract a brain from a helpless opponent with a coup de grace attack, or as a standard action from a body that has been dead for no more than 1 minute.  A neh-thalggu that has fewer than seven grains gains one negative level for each missing brain.  These negative levels can never become permanent, but they can only be removed by replacing one of its collected brains.  The stats presented here assume a monster with a full collection."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":"Ac","bonus_type":{"name":"Insight","mode":"Plain"},"print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_2","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary_2/b2_abilities_race.lst:866"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary_2:monster_ability:neh_thalggu_brain_collection#bonus1","label":"Brain Collection (concentration)","value":{"Number":{"Const":7}},"applies":"Always","target":{"Other":"concentration"},"bonus_type":{"name":"Insight","mode":"Plain"},"print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_2","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary_2/b2_abilities_race.lst:866"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary_2:mo