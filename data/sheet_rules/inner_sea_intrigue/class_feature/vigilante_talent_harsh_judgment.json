[{"id":"inner_sea_intrigue:class_feature:vigilante_talent_harsh_judgment","label":"Harsh Judgment","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"A vigilante with this talent can pronounce judgment upon his foes as a swift action as per the inquisitor class feature (Advanced Player's Guide 38). He can choose from among the following inquisitor judgments: destruction, piercing, purity, and smiting. Once activated, this ability lasts until the combat ends, at which point all of the bonuses immediately end. When the vigilante uses this ability, he must select one type of judgment to make. As a swift action, he can change this judgment to another type. For the purpose of determining the bonuses provided by this ability, the vigilante's level stacks with levels in any other classes that grant judgment or harsh judgment. The vigilante can use this ability "},{"Slot":{"Min":[{"Const":7},{"Div":[{"Sum":[{"Var":"vc98e174c19273973"},{"Const":2}]},{"Const":3}]}]}},{"Text":"/day. Only a vigilante with the zealot archetype (Ultimate Intrigue 62) can select this talent."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Not":{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:vigilante_talent_harsh_judgment"},"count":1}}},{"Compare":{"lhs":{"Var":"v2618cd51432b9d63"},"op":"Eq","rhs":{"Const":1}}}]},"target":{"Pool":"harsh_judgment_effect"},"print":true,"pool":"special_ability","tags":["Vigilante Talent","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_intrigue","kind":"class_feature","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_intrigue/isi_abilities_class.lst:321","pathfinder/paizo/campaign_setting/inner_sea_intrigue/isi_abilities_class.lst:327"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"inner_sea_intrigue:class_feature:vigilante_talent_harsh_judgment#bonus1","label":"Harsh Judgm