[{"id":"inner_sea_intrigue:spell:dream_reality","label":"Dream Reality","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You cause the target to perceive the world as if in a dream. When the spell ends, the target forgets all identifying details of events that transpired while the spell lasted. The memories were not taken from it; rather, its mind never recorded the memories as real in the first place. If modify memory is cast upon it before the spell ends, the target remembers these events. A target under the effect of lullaby before this spell is cast applies its penalty to the saving throw against this spell."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Illusion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Compulsion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Mind-Affecting"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will disbelief"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":fa