[{"id":"inner_sea_intrigue:spell:diminished_detection","label":"Diminished Detection","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can avoid being detected when you are on the edges of some divination spells' ranges. Whenever you would normally be within the area of effect of a detection spell (such as detect magic, detect evil, or detect undead), the area of effect is reduced by half for the purposes of the spell's caster detecting you or your possessions. The caster of the detect spell is unaware of this reduction in her spell's range; she simply does not detect you."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Abjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"S,V,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) hours"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"alchemist","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"bard","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":2}},"when":"Always"}],"provenance":{"book":"inner_sea_intrigue","kind":"spell","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_intrigue/isi_spells.lst:14"]