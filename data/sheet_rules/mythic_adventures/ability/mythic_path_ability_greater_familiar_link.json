[{"id":"mythic_adventures:ability:mythic_path_ability_greater_familiar_link","label":"Greater Familiar Link","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have bound yourself so deeply to your familiar that your life forces are intertwined. Anytime you or your familiar takes damage, you may split the damage evenly between you and your familiar as if using shield other. Using this ability doesn't require an action, but it works only if you're conscious and both you and your familiar are alive. You must have a familiar to select this ability."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"mythic_adventures:ability:mythic_path_archmage"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Familiar"}},"count":1}},{"Compare":{"lhs":{"Var":"vf8cfa6f9260be027"},"op":"Gte","rhs":{"Const":1}}}]}},{"Compare":{"lhs":{"Var":"v81c12baf453fb22d"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["Mythic Path Ability","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"mythic_adventures","kind":"ability","closure_rows":["pathfinder/paizo/roleplaying_game/mythic_adventures/ma_abilities.lst:178"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
