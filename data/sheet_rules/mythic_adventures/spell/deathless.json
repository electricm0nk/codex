[{"id":"mythic_adventures:spell:deathless","label":"Deathless","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The target's soul is strongly anchored to its body, preventing death from hit point damage. No matter how low the target's hit points get, it remains alive (though not necessarily conscious). This spell doesn't prevent death from sources other than hit point damage-such as Constitution damage or drain, death effects, or energy drain. Spells that cure hit points affect the creature normally."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: If you expend one use of mythic power when you cast the spell, you become an anchor for the souls of you and your cohorts. The range increases to 30 feet, and instead of affecting one creature, it affects all allies within a 30-foot radius emanation centered on you. Augmented (8th): If you expend three uses of mythic power, the range increases to 1 mile, and the area to a 1-mile radius emanation centered on you."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Deathless"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"living creature touched"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL*1) round"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude negates (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes (harmless)"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"alchemist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"inquisitor","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"medium","spell_level":4}},"when":"Always"}],"provenance":{"book":"mythic_adventures","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/mythic_adventures/ma_spells.lst:282","pathfinder/paizo/roleplaying_game/mythic_adventures/ma_spells.lst:7","pathfinder/paizo/roleplaying_game/occult_adventures/support/oa_spells_ma.lst:8"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
