[{"id":"mythic_adventures:feat:spirited_charge","label":"Spirited Charge (Mythic)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your mounted charge knocks the wind and wits from those foolish enough to stand against you."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When you hit an opponent with a mounted charge, that opponent must succeed at a Fortitude saving throw (DC "},{"Slot":{"Sum":[{"Const":10},{"Floor":{"Div":["Level",{"Const":2}]}},{"AbilityMod":"Str"}]}},{"Text":") or be staggered for "},{"Slot":{"Var":"v1c4484d110f05f91"}},{"Text":" rounds. If you use a lance with this attack, increase the saving throw DC by 2. As a free action before you make the attack, you can expend one use of mythic power to daze your opponent on a failed saving throw instead of staggering it."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:spirited_charge"},"count":1}},{"Compare":{"lhs":{"Var":"v81c12baf453fb22d"},"op":"Gte","rhs":{"Const":1}}},{"Holds":{"what":{"Rule":"core_rulebook:feat:spirited_charge"},"count":1}},{"Compare":{"lhs":{"Var":"v81c12baf453fb22d"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"mythic_feat","tags":["Mythic","MountedMastery"],"subject":"Character","repeatable":false,"provenance":{"book":"mythic_adventures","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/mythic_adventures/ma_feats.lst:164","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_feats.lst:257"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
