[{"id":"ultimate_combat:spell:reinforce_armaments","label":"Reinforce Armaments","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Temporarily mitigates the fragile quality in targeted weapon or armor."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You reinforce a weapon or armor suit to give it a temporarily upgrade or mitigate the fragile quality (see page 146). A suit of armor or weapon touched that has the fragile quality is not considered to have the fragile quality for the spell's duration. Normal armor suits or weapons subjected to this spell instead gain the masterwork quality for the spell's duration and their hardness is doubled. If this spell is cast on masterwork or magical armor or weapons, their hardness is doubled for the duration of the spell."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Temporarily mitigates the fragile quality in targeted weapon or armor."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M/DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL*10) minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (harmless, object)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes (harmless, object)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"one armor suit or weapon touched"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"cleric","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":1}},"when":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_feature:haunted_occultist_implement_school_transmutation"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:occultist_implement_school_transmutation"},"count":1}}]}}}],"grants":[{"FactDeclare":{"name":"CompMaterial","value":"(a metal pin)"}}],"provenance":{"book":"ultimate_combat","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_spells.lst:111","pathfinder/paizo/roleplaying_game/occult_adventures/support/oa_spells_uc.lst:40","pathfinder/paizo/roleplaying_game/ultimate_combat/uc_spells.lst:264"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
