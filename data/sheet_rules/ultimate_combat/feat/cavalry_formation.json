[{"id":"ultimate_combat:feat:cavalry_formation","label":"Cavalry Formation","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are skilled at riding in close formation with your mounted allies without impeding your effectiveness on the battlefield."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"You and your mount can overlap the space of mounts whose riders have this feat, although no more than two creatures can share any one square. Further, you can charge through a space containing an allied mount if that mount's rider has this feat, although the space from which you make your charge attack must comply with this feat's other benefit or be unoccupied."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Holds":{"what":{"Rule":"core_rulebook:feat:mounted_combat"},"count":1}},"print":true,"pool":"feat","tags":["Combat","Teamwork"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_cavalry_formation"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_cavalry_formation"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:sohei_cavalry_formation"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:40"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420