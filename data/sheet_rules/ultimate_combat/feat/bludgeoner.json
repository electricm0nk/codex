[{"id":"ultimate_combat:feat:bludgeoner","label":"Bludgeoner","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can knock foes out cold with just about any blunt instrument."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"You take no penalty on attack rolls for using a lethal bludgeoning weapon to deal nonlethal damage. \n [Normal] You take a -4 penalty on attack rolls when using a lethal weapon to deal nonlethal damage. You cannot use a lethal weapon to deal nonlethal damage in a sneak attack. \n [Special] A rogue with this feat can use a lethal bludgeoning weapon to deal nonlethal damage with a sneak attack."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_bludgeoner"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Rule":"inner_sea_combat:class_feature:ranger_combat_style_feat_bludgeoner"},"when":{"Situational":{"text":"while wearing no heavy armor"}}},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:26"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
