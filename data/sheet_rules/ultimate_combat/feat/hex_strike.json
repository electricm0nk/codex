[{"id":"ultimate_combat:feat:hex_strike","label":"Hex Strike","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Chanting and cursing, you put a hex on your enemy as part of your unarmed strike."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When you gain this feat, choose one hex that you can use to affect no more than one opponent. If you make a successful unarmed strike against an opponent, in addition to dealing your unarmed strike damage, you can use a swift action to deliver the effects of the chosen hex to that opponent. Doing so does not provoke attacks of opportunity. \n [Special]You can take this feat multiple times. Each time you take it, you apply it to a different qualifying hex."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"WitchHex"}},"count":1}},{"Compare":{"lhs":{"Var":"v62c9bc9506696185"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v7de5713e90100cf5"},"op":"Gte","rhs":{"Const":1}}}]}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":true,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"}],"offers":{"id":"ultimate_combat:feat:hex_strike","count":{"Const":1},"from":{"Rules":{"pool":"special_ability","tags":[],"requires":"Always"}}},"provenance":{"book":"ulti