[{"id":"ultimate_combat:feat:efreeti_touch","label":"Efreeti Touch","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your knowledge of the secrets of the burning wind and blazing sun allows you to collect flames into your hands and unleash them in a gout of elemental fire."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"While using Efreeti Style, as a standard action, you can spend two Elemental Fist (Advanced Player's Guide 158) attempts to unleash a 15-foot cone-shaped burst of flame. Creatures caught in the cone take your unarmed strike damage plus the fire damage from your Elemental Fist and catch on fire. A successful Reflex save (DC 10 + 1/2 your character level + your Wis modifier) reduces the damage by half and prevents a target from catching on fire."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:feat:efreeti_style"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:efreeti_stance"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:feat:elemental_fist"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"v0bc76bc9333aeda5"},"op":"Gte","rhs":{"Const":11}}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"AbilityScore":"Con"},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":17}}}]}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_efreeti_touch"},"when":"Always"},{"by":{"Rule":"adventurers_guide:class_feature:brazen_disciple_feat_efreeti_touch"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:master_of_many_styles_efreeti_touch"},"when":"Always"},{"by":{"Rul