[{"id":"ultimate_combat:feat:monkey_style","label":"Monkey Style","value":{"Number":{"Max":[{"Const":0},{"AbilityMod":"Wis"}]}},"prose":[{"family":"Desc","pieces":[{"Text":"Your unarmed fighting style is nimble and unpredictable, full of ground rolls and short leaps."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"You add your Wisdom bonus on Acrobatics checks. While using this style, you take no penalty on melee attack rolls or to AC while prone. Further, you can crawl and stand up from lying prone without provoking attacks of opportunity, and you can stand up as a swift action if you succeed at a DC 20 Acrobatics check. \n [Normal] You take a -4 penalty on attack rolls and AC against melee attacks while prone. Standing up is a standard action that provokes attacks of opportunity."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"SkillRanks":"acrobatics"},"op":"Gte","rhs":{"Const":5}}},{"Compare":{"lhs":{"SkillRanks":"climb"},"op":"Gte","rhs":{"Const":5}}}]}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":13}}}]},"target":{"Skill":"acrobatics"},"print":true,"pool":"feat","tags":["Combat","Style"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_monkey_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:master_of_many_styles_monkey_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_monkey_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:unarmed_fighter_style_monkey_style"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:218"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_