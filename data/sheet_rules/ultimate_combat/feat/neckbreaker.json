[{"id":"ultimate_combat:feat:neckbreaker","label":"Neckbreaker","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"With a quick jerk, you snap an enemy's neck."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"If you have an opponent your size or smaller helpless or pinned, after you initiate or maintain a grapple, you can make a Stunning Fist attempt at a -5 penalty on the attack roll. If you succeed, you wrench that opponent's neck, dealing 2d6 Strength or Dexterity damage. If the targeted ability score is reduced to 0, any remaining damage is dealt to that opponent's Constitution score. A creature that is immune to critical hits or that has no discernible head and neck is immune to the effects of this feat."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":6,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:feat:bonebreaker"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:greater_grapple"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_grapple"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:jawbreaker"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:stunning_fist"},"count":1}}]}},{"Compare":{"lhs":{"SkillRanks":"heal"},"op":"Gte","rhs":{"Const":12}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_neckbreaker"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_neckbreaker"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:tetori_bonus_feat_neckbreaker"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:220"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":