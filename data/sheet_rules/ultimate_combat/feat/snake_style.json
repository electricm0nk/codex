[{"id":"ultimate_combat:feat:snake_style","label":"Snake Style","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"You watch your foe's every movement and then punch through its defense."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"You gain a +2 bonus on Sense Motive checks, and you can deal piercing damage with your unarmed strikes. While using the Snake Style feat, when an opponent targets you with a melee or ranged attack, you can spend an immediate action to make a Sense Motive check. You can use the result as your AC or touch AC against that attack. You must be aware of the attack and not flat-footed. \n [Normal] An unarmed strike deals bludgeoning damage."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"SkillRanks":"acrobatics"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"SkillRanks":"sense_motive"},"op":"Gte","rhs":{"Const":3}}}]}}]},"target":{"Skill":"sense_motive"},"print":true,"pool":"feat","tags":["Combat","Style"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_snake_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:master_of_many_styles_snake_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_snake_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:unarmed_fighter_style_snake_style"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:310"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
