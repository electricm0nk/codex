[{"id":"ultimate_combat:feat:jawbreaker","label":"Jawbreaker","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You deliver a powerful strike to the mouth, breaking teeth and bone."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When you make a successful Stunning Fist attempt against an opponent that is grappled, helpless, or stunned, instead of imparting any other Stunning Fist effect, you can cripple that opponent's mouth, dealing normal unarmed strike damage and 1d4 points of bleed damage. Until the bleed damage ends, the target is unable to use its mouth to attack, speak clearly, and employ verbal spell components. A creature that is immune to critical hits or that has no discernible mouth is immune to the effects of this feat."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:stunning_fist"},"count":1}}]}},{"Compare":{"lhs":{"SkillRanks":"heal"},"op":"Gte","rhs":{"Const":6}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_jawbreaker"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc