[{"id":"ultimate_combat:feat:twin_thunders","label":"Twin Thunders","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When you fight giants, your powerful blows combine with skills learned from generations of your people to quickly even the odds."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"Once per round, when wielding a bludgeoning weapon for which you have Weapon Focus in each hand against a creature with the giant subtype, if you hit the creature with your off-hand weapon after you hit with your primary weapon, roll the damage dice for your off-hand weapon twice and add the results together before adding any bonuses. Such extra weapon damage dice are not multiplied on a critical hit."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:race_trait:dwarf_defensive_training"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:race_trait:gnome_defensive_training"},"count":1}}]}},{"Holds":{"what":{"Rule":"core_rulebook:feat:weapon_focus"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:two_weapon_fighting"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sacred_fist_flurry_of_blows"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:template:isdwarf"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:template:isgnome"},"count":1}}]}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_twin_thunders"},"when":"Always"}],"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:337"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
