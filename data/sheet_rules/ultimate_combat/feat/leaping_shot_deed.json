[{"id":"ultimate_combat:feat:leaping_shot_deed","label":"Leaping Shot Deed","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"You leap through the air, guns blazing."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"You gain a +2 bonus on Acrobatics checks made to jump. As a full-round action, you can move up to your speed and make firearm attacks at your highest base attack bonus with each loaded firearm you are wielding. You can make these attacks at any point during your movement, and if you are wielding two firearms, you can make the attacks at different points during the movement. At the end of this movement, you fall prone. This deed costs 1 grit point to perform."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:dodge"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:mobility"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:gunslinger_grit"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:amateur_gunslinger"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":4}}}]},"target":{"SkillSituation":{"skill":"acrobatics","situation":"when jumping"}},"print":true,"pool":"feat","tags":["Grit"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:198"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
