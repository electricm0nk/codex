[{"id":"ultimate_combat:feat:false_opening","label":"False Opening","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When you make a ranged attack while threatened, you can fool your opponent into thinking he has an opening."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"Choose a ranged weapon or a thrown weapon. When you make a ranged attack using that weapon, you can choose to provoke an attack of opportunity from one or more opponents who threaten you. You gain a +4 dodge bonus against such attacks. An opponent that makes such an attack and misses you loses his Dexterity bonus to AC against you until the end of your turn."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:dodge"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:weapon_focus"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:feat:close_quarters_thrower"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:feat:point_blank_master"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":13}}}]}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":true,"offers":{"id":"ultimate_combat:feat:false_opening","count":{"Const":1},"from":{"Weapons":["ABILITY FEAT[Weapon Focus],EQUIPMENT[TYPE Ranged]"]}},"provenance":{"book":"ultimate_combat","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_feats.lst:112"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
