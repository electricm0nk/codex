[{"id":"ultimate_combat:class_feature:sohei_weapon_training","label":"Weapon Training","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"At 6th level, a sohei gains weapon training in one of the following weapon groups, as the fighter class feature (Core Rulebook 56) - bows, crossbows, monk weapons, polearms, spears, or thrown weapons. He may select an additional group of weapons for every six levels after 6th, to a maximum of three at 18th level. A sohei may use flurry of blows and ki strike with any weapon in which he has weapon training. This ability replaces purity of body, diamond body, quivering palm, timeless body, and tongue of sun and moon."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":6}}},"target":{"Pool":"sohei_weapon_training_i"},"print":true,"pool":"special_ability","tags":["MonkClassFeatures","Extraordinary","ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:1357"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_combat:class_feature:sohei_weapon_training#bonus1","label":"Weapon Training (sohei weapon training ii picks)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":12}}},"target":{"Pool":"sohei_weapon_training_ii"},"print":true,"pool":"special_ability","tags":["MonkClassFeatures","Extraordinary","ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:1357"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"i