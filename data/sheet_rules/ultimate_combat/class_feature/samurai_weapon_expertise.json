[{"id":"ultimate_combat:class_feature:samurai_weapon_expertise","label":"Weapon Expertise","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"At 3rd level, a samurai gains an unparalleled expertise with his chosen weapons. At 3rd level, the samurai selects either the katana, longbow, naginata, or wakizashi. The samurai can draw the selected weapon as a free action as if he had the Quick Draw feat. In addition, whenever he threatens a critical hit with the selected weapon, he gains a +2 bonus on the confirmation roll. Finally, his samurai levels stack with any fighter levels he possesses for the purposes of meeting the prerequisites for feats that specifically select his chosen weapon, such as Weapon Specialization."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"[Selected Weapon - Katana]"}],"applies":{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:samurai_expertise_selection"},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"[Selected Weapon - Longbow]"}],"applies":{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:samurai_expertise_selection"},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"[Selected Weapon - Naginata]"}],"applies":{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:samurai_expertise_selection"},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"[Selected Weapon - Wakizashi]"}],"applies":{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:samurai_expertise_selection"},"count":1}},"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"samurai_expertise"},"print":true,"pool":"special_ability","tags":["SamuraiClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/pai