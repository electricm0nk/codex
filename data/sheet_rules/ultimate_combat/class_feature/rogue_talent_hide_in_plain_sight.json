[{"id":"ultimate_combat:class_feature:rogue_talent_hide_in_plain_sight","label":"Hide in Plain Sight","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A rogue with this talent can select a single terrain from the ranger's favored terrain list. She is a master at hiding in that terrain, and while within that terrain, she can use the Stealth skill to hide, even while being observed. A rogue may take this advanced talent more than once, each time selecting a different terrain from the favored terrain list."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"Var":"ve4704d6c844d69d3"},"op":"Gte","rhs":{"Const":10}}},"print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary","RogueTalent","RogueAdvancedTalent","Unchained Rogue Advanced Talent","AdvancedMaskedPerformerTalent"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:1619","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:715","pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_abilities_class.lst:274"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
