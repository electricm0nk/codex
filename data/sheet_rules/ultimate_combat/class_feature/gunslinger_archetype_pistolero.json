[{"id":"ultimate_combat:class_feature:gunslinger_archetype_pistolero","label":"Pistolero","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While most gunslingers have favorite firearms, there are those rare ones who choose to specialize in onehanded firearms exclusively. These gunslingers are called pistoleros. While they lack the flexibility of being able to pick up any kind of firearm and use it with reasonable proficiency, they are crackerjack shots with pistols and similar firearms. Their skill and aim with these firearms at close range is second to none, and they rarely misfire with these weapons."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"gunslinger"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:gunslinger_archetype_pistolero"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerGunTraining"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerDeadeyeDeed"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerStartlingShotDeed"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerBleedingWoundDeed"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:gunslinger_archetype_pistolero"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:gunslinger_archetype_bolt_ace"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:gunslinger_archetype_pistolero"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:gunslinger_archetype_bolt_ace"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:gunslinger_archetype_musket_master"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:gunsling