[{"id":"ultimate_combat:class_feature:rogue_archetype_driver","label":"Driver","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A driver makes her living driving vehicles in the service of those who can pay for her considerable talents. She may be a wagon-driver practiced at smuggling contraband, an accomplished musher blazing arctic trails, or a seemingly refined coach driver placing her roguish talents in the service of a wealthy patron. This archetype works best with the vehicle combat rules in Chapter 4."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Never","print":true,"pool":"archetype","tags":["PFSNotLegal"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Rogue_CF_Trapfinding","value":"true"}},{"FactDeclare":{"name":"Rogue_CF_TrapSense","value":"true"}},{"FactDeclare":{"name":"Rogue_Archetype_Trapfinding","value":"true"}},{"FactDeclare":{"name":"Rogue_Archetype_TrapSense","value":"true"}},{"FactDeclare":{"name":"Rogue_CF_Trapfinding","value":"true"}},{"FactDeclare":{"name":"Rogue_CF_TrapSense","value":"true"}},{"FactDeclare":{"name":"Rogue_Archetype_Trapfinding","value":"true"}},{"FactDeclare":{"name":"Rogue_Archetype_TrapSense","value":"true"}}],"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:1670","pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:1938"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
