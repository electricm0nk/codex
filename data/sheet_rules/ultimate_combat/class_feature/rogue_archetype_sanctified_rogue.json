[{"id":"ultimate_combat:class_feature:rogue_archetype_sanctified_rogue","label":"Sanctified Rogue","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The sanctified rogue serves a higher purpose, acting as a representative of a church or cult, or following the tenets of a specific faith or deity. While most sanctified rogues share the beliefs or ideals of the religions they represent, not all of them are necessarily pious. A handful of disreputable holy thieves serve purely as mercenaries. At the other end of spectrum, however, more sanctified rogues adhere to the tenets of their faith with fanatical devotion. Regardless, all seem blessed with the ability to call upon divine favor to aid them in times of need."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"rogue"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:rogue_archetype_sanctified_rogue"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RogueUncannyDodge"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RogueImprovedUncannyDodge"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:rogue_archetype_sanctified_rogue"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_burglar"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_scout"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_trapsmith"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_cat_burglar"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_deadly_courtesan"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_filcher"