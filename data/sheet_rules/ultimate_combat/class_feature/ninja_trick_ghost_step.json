[{"id":"ultimate_combat:class_feature:ninja_trick_ghost_step","label":"Ghost Step","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a swift action, a ninja with this trick can pass through walls as if she were a ghost. Until the end of her turn, she can pass through a wall or other surface that is up to 5 feet thick per level as if she were incorporeal. She must exit the solid material by the end of her turn. Each use of this ability uses up 1 ki point."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Var":"v71c8fae6d71d9e29"},"op":"Gte","rhs":{"Const":10}}},{"Compare":{"lhs":{"Var":"ve4704d6c844d69d3"},"op":"Gte","rhs":{"Const":10}}}]}},"print":true,"pool":"special_ability","tags":["NinjaClassFeatures","SpecialQuality","Extraordinary","AdvancedNinjaTrick"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:166"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
