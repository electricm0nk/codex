[{"id":"ultimate_combat:class_feature:archaeologist_clever_explorer","label":"Clever Explorer","value":{"Number":{"Div":[{"ClassLevel":"bard"},{"Const":2}]}},"prose":[{"family":"Desc","pieces":[{"Text":"At 2nd level, an Archaeologist gains a bonus equal to half his class level on Disable Device and Perception checks. He can disable intricate and complex devices in half the normal amount of time (minimum 1 round) and open a lock as a standard action. At 6th level, an Archaeologist can take 10 on Disable Device checks, even if distracted or endangered, and can disarm magical traps. This ability replaces the versatile performance ability."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"ClassLevel":"bard"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"disable_device"},"print":true,"pool":"special_ability","tags":["BardClassFeatures","Extraordinary","ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:392"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_combat:class_feature:archaeologist_clever_explorer#bonus1","label":"Clever Explorer (Perception)","value":{"Number":{"Div":[{"ClassLevel":"bard"},{"Const":2}]}},"applies":{"Compare":{"lhs":{"ClassLevel":"bard"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"perception"},"print":true,"pool":"special_ability","tags":["BardClassFeatures","Extraordinary","ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:392"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
