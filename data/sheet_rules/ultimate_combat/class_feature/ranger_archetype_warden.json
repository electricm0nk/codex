[{"id":"ultimate_combat:class_feature:ranger_archetype_warden","label":"Warden","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"All rangers have a bond with the wilderness, but the warden may have the strongest. This protector sits guard in the middle of the wilderness, keeping a lookout for any dangers that might spill from the deeper wilderness beyond, and protecting civilization from the savagery of nature-and vice versa. His long weeks, months, and sometimes years of isolation cause him to \"hear\" what the land is saying. Not all are crazy."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"ranger"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_warden"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerFavoredEnemy"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerCombatStyle"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerHuntersBond"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_warden"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:ranger_archetype_hooded_champion"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:ranger_archetype_wild_hunter"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:ranger_archetype_guide"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_warden"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_wild_stalker"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:ranger_archetype_dandy"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:ranger_archetype_guildbreaker"},"count