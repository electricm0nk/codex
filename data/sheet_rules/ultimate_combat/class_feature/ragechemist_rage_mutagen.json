[{"id":"ultimate_combat:class_feature:ragechemist_rage_mutagen","label":"Rage Mutagen","value":{"Number":{"Var":"v44fc9f0398bea037"}},"prose":[{"family":"Desc","pieces":[{"Text":"At 2nd level, whenever a ragechemist creates a mutagen that improves his Strength, that mutagen's bonus to Strength increases by 2 and penalized the alchemist's Intelligence score. Furthermore, while under the effects of this mutagen, whenever the alchemist takes damage, his rage grows, with detrimental effects. At the end of each turn that he takes hit point damage, the ragechemist must succeed at a Will saving throw (DC 15, or DC 20 if any of the damage came from a critical hit that turn) or take a -2 penalty on Will saving throws and to Intelligence. These penalties end 1 hour after the mutagen ends and stack with themselves. If the penalty lowers the ragechemist's Intelligence score to 0, the ragechemist is comatose until 1 hour after the mutagen expires. This ability replaces poison use."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Situational":{"text":"when active"}},"target":{"Ability":"Str"},"print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_combat:class_feature:alchemist_archetype_ragechemist"},"when":{"Compare":{"lhs":{"ClassLevel":"alchemist"},"op":"Gte","rhs":{"Const":2}}}}],"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:260"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_combat:class_feature:ragechemist_rage_mutagen#bonus1","label":"Rage Mutagen (Int)","value":{"Number":{"Var":"v2d497fa34bb64145"}},"applies":{"Situational":{"text":"when active"}},"target":{"Ability":"Int"},"print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality"],"subject":"Chara