[{"id":"ultimate_combat:class_feature:fighter_archetype_unbreakable","label":"Unbreakable","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The unbreakable is a warrior of indomitable will, unstoppable and implacable once he has set his mind upon a course of action. The unbreakable endures any trial to do what must be done, and when his mind is set toward a goal, nothing can stop him from achieving it, though many may try. He is a juggernaut and a zealot, supremely confident in his own abilities."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"fighter"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype_unbreakable"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterTowerShieldProficiency"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterBonusFeat1"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterBravery"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterWeaponTraining1"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterWeaponTraining2"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterWeaponTraining3"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterWeaponTraining4"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterArmorTraining3"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"FighterArmorTraining4"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype_unbreakable"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"occult_adventures:class_feature:fighter_archetype_sensate"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype