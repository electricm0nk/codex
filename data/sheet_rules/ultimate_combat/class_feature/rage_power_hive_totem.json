[{"id":"ultimate_combat:class_feature:rage_power_hive_totem","label":"Hive Totem","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While raging, the barbarian takes half damage from attacks by swarms of vermin, including spells and effects that act like a swarm of vermin (like summon swarm used to summon spiders or insect plague). She also gains a +1 bonus on Strength ability checks and to CMD against bull rush, drag, and trip attacks for every four barbarian levels she has (maximum +5). A barbarian must have the animal fury power and be at least 4th level before selecting this rage power."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"BarbarianTotemRagePower"}},"count":1}}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:rage_power_hive_totem"},"count":1}}]}},{"Holds":{"what":{"Rule":"core_rulebook:class_feature:rage_power_animal_fury"},"count":1}},{"Compare":{"lhs":{"Var":"vf83ac5bd59fb0b07"},"op":"Gte","rhs":{"Const":4}}}]},"print":true,"pool":"special_ability","tags":["RagePower","SpecialAttack","Supernatural","BarbarianTotemRagePower","Unchained Rage Power"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:283","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:422"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
