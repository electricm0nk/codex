[{"id":"ultimate_combat:class_feature:gunslinger_stunning_shot","label":"Stunning Shot","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"At 19th level, when a gunslinger hits a creature, she can spend 2 grit points to stun the creature for 1 round. The creature must make a Fortitude saving throw (the DC = 10 + 1/2 the gunslinger's level + the gunslinger's Wisdom modifier). If the creature fails, it is stunned for 1 round. Creatures that are immune to critical hits are also immune to this effect."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","DeedsLVL19","DeedHasCost","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_combat:class_feature:gunslinger_deeds"},"when":{"All":[{"Compare":{"lhs":{"Var":"ve3ca02a6a308ef6e"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v5eabe89496ce5620"},"op":"Gte","rhs":{"Const":19}}}]}},{"by":{"Rule":"ultimate_combat:class_feature:gunslinger_deeds"},"when":{"All":[{"Compare":{"lhs":{"Var":"ve3ca02a6a308ef6e"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v5eabe89496ce5620"},"op":"Gte","rhs":{"Const":19}}}]}}],"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:79"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
