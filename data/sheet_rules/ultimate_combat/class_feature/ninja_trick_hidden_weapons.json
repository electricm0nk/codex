[{"id":"ultimate_combat:class_feature:ninja_trick_hidden_weapons","label":"Hidden Weapons","value":{"Number":{"Var":"v71c8fae6d71d9e29"}},"prose":[{"family":"Desc","pieces":[{"Text":"A ninja with this ability can easily conceal weapons on her body. The ninja adds her level on opposed Sleight of Hand checks made to conceal a weapon. In addition, she can draw hidden weapons as a move action, instead of as a standard action."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"SkillSituation":{"skill":"sleight_of_hands","situation":"conceal weapon"}},"print":true,"pool":"special_ability","tags":["NinjaClassFeatures","SpecialQuality","Extraordinary","NinjaTrick","NinjaTrickOnly"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_combat","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_combat/uc_abilities_class.lst:135"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
