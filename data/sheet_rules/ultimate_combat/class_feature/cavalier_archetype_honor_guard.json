[{"id":"ultimate_combat:class_feature:cavalier_archetype_honor_guard","label":"Honor Guard","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Certain cavaliers are trained not as advance combatants, but as loyal guards, standing as firm defenders in the face of threats to their chosen charge. These honor guards are sometimes merely ornamental, performing their functions on a ceremonial basis, but a surprising number are capable, deadly opponents, able to take down a threat long before their liege knows of the danger. To be an honor guard is to constantly place one's self in harm's way, and to always be willing to lay down one's life at a moment's notice."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"cavalier"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:cavalier_archetype_honor_guard"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CavalierCavaliersCharge"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CavalierDemandingChallenge"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CavalierMightyCharge"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:cavalier_archetype_honor_guard"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:fell_rider_cavalier_archetype"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:cavalier_archetype_qadiran_horselord"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:cavalier_archetype_sister_in_arms"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_combat:class_feature:cavalier_archetype_spellscar_drifter"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:cavalier_archetype_ghost_rider"},"count":1}},{"Holds":{"what":{"Rule":