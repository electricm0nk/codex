[{"id":"ultimate_combat:class_feature:ranger_archetype_wild_stalker","label":"Wild Stalker","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Civilization grows stronger and more decadent with each passing year. It tears into unclaimed wilderness and destroys the fragile ecology in its constant push for expansion and exploitation. The wild stalker forsakes the bonds of community and lives in the trackless wilds far from others of his kind, or perhaps grew up there, never knowing of civilization as anything more than his enemy. He drives pioneers back to civilization and strives to keep the land unspoiled."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"ranger"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_wild_stalker"},"count":1}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerFavoredEnemy.RangerCombatStyle.RangerHuntersBond"}},"count":1}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_wild_stalker"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:ranger_archetype_hooded_champion"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:ranger_archetype_wild_hunter"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:ranger_archetype_guide"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_warden"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:ranger_archetype_wild_stalker"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:ranger_archetype_dandy"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:ranger_archetype_guildbreaker"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:ranger_archetype_wild_soul"},"