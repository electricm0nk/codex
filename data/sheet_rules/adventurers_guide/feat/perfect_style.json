[{"id":"adventurers_guide:feat:perfect_style","label":"Perfect Style","value":{"Number":{"Const":1}},"prose":[{"family":"Benefit","pieces":[{"Text":"When you take this feat, choose one of the Houses of Perfection; once this decision has been made, it cannot be changed. While using this style, you gain a type of energy resistance based on the House of Perfection you have chosen. Additionally, you gain a ki pool that you can use to activate abilities of your chosen House of Perfection style. Your pool contains "},{"Slot":{"Var":"ve4ffd1f73b83d471"}},{"Text":" ki points. If you have a ki pool from another source, you do not gain additional ki points from this feat. [Special] You can select Perfect Style multiple times. Each time you do so, you must select a different House of Perfection to belong to."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ki points"},"pieces":[{"Slot":{"Var":"ve4ffd1f73b83d471"}}],"applies":{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Ki Pool"}},"count":1}}},"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Wis"},{"Var":"ve59ae2a694dab2b8"}]},"op":"Gte","rhs":{"Const":13}}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":5}}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":5}}}]}}]},"target":{"Pool":"house_of_perfection"},"print":true,"pool":"feat","tags":["Combat","Style"],"subject":"Character","repeatable":true,"granted_by":[{"by":{"Rule":"ultimate_combat:class_feature:master_of_many_styles_perfect_style__9eb6c2a704f5caad"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_perfect_style"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_perfect_style_2"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_perfect_style_3"},"when":"Always"}],"provenance":{"book":"adventurers_guide","kind":"feat","closur