[{"id":"adventurers_guide:ability:devil_binder_infernal_binding","label":"Infernal Binding","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A devil binder must select an eidolon of the devil subtype. The devil binder's eidolon never increases its maximum number of attacks, and its base attack bonus is equal to half its Hit Dice. At 4th level and every 4 levels thereafter, the eidolon's Charisma score increases by 2. This alters the summoner's eidolon."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Summoner Class Feature","DevilBinderClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"adventurers_guide:ability:summoner_archetype_devil_binder"},"when":{"Compare":{"lhs":{"ClassLevel":"summoner"},"op":"Gte","rhs":{"Const":1}}}}],"provenance":{"book":"adventurers_guide","kind":"ability","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/support/ag_abilities_pu.lst:61"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
