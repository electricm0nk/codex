[{"id":"adventurers_guide:class_feature:dashing_thief_bold_thief","label":"Bold Thief","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A dashing thief fulfills the Council's larcenous goals with style. Her derring-do and swashbuckler's edge deeds apply to Disable Device and Sleight of Hand, but not to Fly and Ride. She adds Disable Device to her list of class skills, but does not have Fly or Ride as class skills. This ability alters the swashbuckler's class skills and the derring-do and swashbuckler's edge deeds."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Swashbuckler Class Feature","RostlandBravoClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"adventurers_guide:class_feature:swashbuckler_archetype_dashing_thief"},"when":{"Compare":{"lhs":{"ClassLevel":"swashbuckler"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"ClassSkill":"acrobatics"}},{"FactGrant":{"ClassSkill":"bluff"}},{"FactGrant":{"ClassSkill":"climb"}},{"FactGrant":{"ClassSkillGroup":"Craft"}},{"FactGrant":{"ClassSkill":"diplomacy"}},{"FactGrant":{"ClassSkill":"disable_device"}},{"FactGrant":{"ClassSkill":"escape_artist"}},{"FactGrant":{"ClassSkill":"intimidate"}},{"FactGrant":{"ClassSkill":"knowledge_local"}},{"FactGrant":{"ClassSkill":"knowledge_nobility"}},{"FactGrant":{"ClassSkill":"perception"}},{"FactGrant":{"ClassSkillGroup":"Perform"}},{"FactGrant":{"ClassSkillGroup":"Profession"}},{"FactGrant":{"ClassSkill":"sense_motive"}},{"FactGrant":{"ClassSkill":"sleight_of_hand"}},{"FactGrant":{"ClassSkill":"swim"}}],"provenance":{"book":"adventurers_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:1079"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
