[{"id":"adventurers_guide:class_feature:mammoth_rider_steed","label":"Steed","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A mammoth rider can choose from among specific animal companions to serve as her loyal steed. A GM might expand this list to include other possible steeds. This steed functions as a druid's animal companion, replacing any animal companion or mount gained from another class. The mammoth rider's class levels stack with other classes that grant an animal companion to determine her effective druid level."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Mammoth Rider Class Features","ClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"offers":{"id":"adventurers_guide:class_feature:mammoth_rider_steed","count":{"Const":1},"from":{"Races":["companion_megafauna_arsinoitherium","companion_herd_animal_aurochs","companion_baluchitherium","companion_camel","companion_cat_big_lion","companion_cat_big_tiger","companion_elk","companion_horse","companion_elephant_mastodon","companion_megafauna_megaloceros","companion_rhinoceros","companion_dinosaur_triceratops","companion_wolf","companion_amargasaurus","companion_brontotherium","companion_deinotherium","companion_elasmotherium","companion_kentrosaurus","companion_polar_bear_dire","companion_moa","companion_uintatherium","companion_dinosaur_styracosaurus","companion_baluchitherium","companion_saber_toothed_cat"]}},"provenance":{"book":"adventurers_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:354"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
