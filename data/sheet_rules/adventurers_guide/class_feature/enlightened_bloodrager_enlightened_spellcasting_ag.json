[{"id":"adventurers_guide:class_feature:enlightened_bloodrager_enlightened_spellcasting_ag","label":"Enlightened Spellcasting","value":{"Number":{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":[{"Var":"vca4e20e30e4444b8"},{"Const":-4},{"Const":1}]}]}]}},"prose":[{"family":"Desc","pieces":[{"Text":"An enlightened bloodrager's unusually sophisticated outlook on the relationship between magic and emotional outbursts allows her to cast an expanded array of spells. She gains the ability to know and cast 0-level spells, which are cast like any other spells, but don't consume spell slots and can be used again. She gains a number of 0-level spells known equal to those of a bard whose level is 3 lower than her bloodrager level. She selects these 0-level spells from the druid's list of 0-level spells. The enlightened bloodrager gains one 1st-level druid spell as a bonus spell known."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"She gains one 2nd-level druid spell as a bonus spell known."}],"applies":{"Compare":{"lhs":{"ClassLevel":"bloodrager"},"op":"Gte","rhs":{"Const":7}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"She gains one 3rd-level druid spell as a bonus spell known."}],"applies":{"Compare":{"lhs":{"ClassLevel":"bloodrager"},"op":"Gte","rhs":{"Const":10}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"She gains one 4th-level druid spell as a bonus spell known."}],"applies":{"Compare":{"lhs":{"ClassLevel":"bloodrager"},"op":"Gte","rhs":{"Const":13}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The bloodrager treats any druid spells she takes with this ability as bloodrager spells for the purposes of other abilities, and adds them to her bloodrager class spell list. At 8th level and every 3 spell levels thereafter, she can swap out these spells using the normal rules for swapping out at a spell. If she chooses to swap out one of her bonus druid spells, she must replace it with a druid spell of the same level. Any swapped-out spells are removed from her bloodrager class spell list. This ability alters the bloodrager's spellcasting, and replaces all bonus spells gained as part of a bloodline."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"enlightened_spellcasting_level_0"},"print":true,"pool":"special_ability","tags":["Bloodrager Class Feature","EnlightenedBloodragerClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"adventurers_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:700"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"adventurers_guide:class_feature:enlightened_bloodrager_enlightened_spellcasting_ag#bonus1","label":"Enlightened Spellcasting (enlightened spellcasting level 1 picks)","value":{"Number":{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":[{"Var":"vca4e20e30e4444b8"},{"Const":-4},{"Const":1}]}]}]}},"applies":"Always","target":{"Pool":"enlightened_spellcasting_level_1"},"print":true,"pool":"special_ability","tags":["Bloodrager Class Feature","EnlightenedBloodragerClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"adventurers_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:700"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"adventurers_guide:class_feature:enlightened_bloodrager_enlightened_spellcasting_ag#bonus2","label":"Enlightened Spellcasting (enlightened spellcasting level 2 picks)","value":{"Number":{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":[{"Var":"vca4e20e30e4444b8"},{"Const":-7},{"Const":1}]}]}]}},"applies":"Always","target":{"Pool":