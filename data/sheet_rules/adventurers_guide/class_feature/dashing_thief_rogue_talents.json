[{"id":"adventurers_guide:class_feature:dashing_thief_rogue_talents","label":"Rogue Talents","value":{"Number":{"Div":[{"Var":"vcfa810e54cf6258a"},{"Const":4}]}},"prose":[{"family":"Desc","pieces":[{"Text":"Council training grants a dashing thief numerous opportunities to learn trade secrets from fellow scoundrels. At 4th level and every 4 levels thereafter, a dashing thief gains a rogue talent, treating her class level as her rogue level when determining the talents' benefits. Starting at 12th level, the dashing thief can choose advanced rogue talents."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"rogue_talent"},"print":true,"pool":"special_ability","tags":["Swashbuckler Class Feature","RostlandBravoClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"adventurers_guide:class_feature:swashbuckler_archetype_dashing_thief"},"when":{"Compare":{"lhs":{"ClassLevel":"swashbuckler"},"op":"Gte","rhs":{"Const":4}}}}],"provenance":{"book":"adventurers_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:1081"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
