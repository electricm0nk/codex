[{"id":"adventurers_guide:class_feature:mammoth_spirit_megafauna_companion","label":"Megafauna Companion","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The shaman's spirit animal transforms into a megafauna animal companion, using the shaman's shaman level as her effective druid level. The shaman must choose a mammalian megafauna. It retains its Intelligence score and the special abilities it gains from the spirit animal class feature, but it also has the statistics and abilities of an animal companion. If the animal companion is dismissed, lost, or dies, it can be replaced in the same way as a normal spirit animal."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Shaman Class Feature","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"adventurers_guide:class_feature:shaman_wandering_spirit_mammoth"},"when":{"Compare":{"lhs":{"Var":"va94955b003fcf376"},"op":"Gte","rhs":{"Const":1}}}}],"offers":{"id":"adventurers_guide:class_feature:mammoth_spirit_megafauna_companion","count":{"Const":1},"from":{"Races":["companion_bat_dire","companion_dire_rat","companion_polar_bear_dire","companion_elephant_mastodon","companion_megafauna_arsinoitherium","companion_baluchitherium","companion_megafauna_gylptodon","companion_megafauna_megaloceros","companion_megafauna_megatherium","companion_chalicotherium","companion_brontotherium","companion_deinotherium","companion_uintatherium","companion_elasmotherium","adventurers_guide:race:companion_embolotherium"]}},"provenance":{"book":"adventurers_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:1220"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
