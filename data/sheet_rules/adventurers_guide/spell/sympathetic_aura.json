[{"id":"adventurers_guide:spell:sympathetic_aura","label":"Sympathetic Aura","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This spell functions like magic aura, except it extends its altered aura to similar items in a 5-foot radius. For this purpose, similar items must be alike in approximate shape, composition, and function, so a potion of cure light wounds targeted by this spell to appear nonmagical would also obscure the auras of nearby potions, elixirs, and oils, as well as flasks. Items other than the targeted item retain their altered aura for (caster level) rounds after being removed from the spell's area."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Illusion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Glamer"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One touched object weighing up to (CASTERLEVEL*5) lbs."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) days [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bard","spell_level":2}},"when