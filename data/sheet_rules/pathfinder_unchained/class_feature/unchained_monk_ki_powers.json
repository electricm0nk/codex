[{"id":"pathfinder_unchained:class_feature:unchained_monk_ki_powers","label":"Ki Powers","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"At 4th level and every 2 levels thereafter, a monk can select one ki power. These powers allow the monk to perform amazing feats of mystical power and acrobatic prowess by expending points from his ki pool. Once a ki power is selected, it cannot be changed. Some ki powers require the monk to be of a specific level or higher before they can be chosen. Unless otherwise noted, a monk cannot select an individual ki power more than once."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Unchained Monk Class Feature","SpecialQuality","Supernatural","Ki Powers"],"subject":"Character","repeatable":false,"provenance":{"book":"pathfinder_unchained","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:468","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:479","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:480","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:481","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:482","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:483","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:484","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:485","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:486","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:487"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
