[{"id":"pathfinder_unchained:class_feature:unchained_monk_weapon_and_armor_proficiency","label":"Weapon and Armor Proficiency","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Monks are proficient with the club, crossbow (light or heavy), dagger, handaxe, javelin, kama, nunchaku, quarterstaff, sai, short sword, shortspear, shuriken, siangham, sling, spear, and any weapon with the monk special weapon quality. Monks are not proficient with any armor or shields. When wearing armor, using a shield, or carrying a medium or heavy load, a monk loses his AC bonus, as well as his fast movement and flurry of blows abilities."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Unchained Monk Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"pathfinder_unchained:class_feature:monk_unchained_class"},"when":{"All":[{"Compare":{"lhs":{"Var":"v2bf141248893e951"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v2fcdae4d361b066c"},"op":"Gte","rhs":{"Const":1}}}]}},{"by":{"Rule":"pathfinder_unchained:class_feature:monk_unchained_class"},"when":{"All":[{"Compare":{"lhs":{"Var":"v2bf141248893e951"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v2fcdae4d361b066c"},"op":"Gte","rhs":{"Const":1}}}]}}],"grants":[{"FactGrant":{"Proficiency":{"Weapon":"Club"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Light)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Heavy)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Dagger"}}},{"FactGrant":{"Proficiency":{"Weapon":"Handaxe"}}},{"FactGrant":{"Proficiency":{"Weapon":"Javelin"}}},{"FactGrant":{"Proficiency":{"Weapon":"Kama"}}},{"FactGrant":{"Proficiency":{"Weapon":"Nunchaku"}}},{"FactGrant":{"Proficiency":{"Weapon":"Quarterstaff"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sai"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sword (Short)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shortspear"}}},{"FactGran