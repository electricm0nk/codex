[{"id":"pathfinder_unchained:class_feature:unchained_monk_weapon_and_armor_proficiency","label":"Weapon and Armor Proficiency","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Monks are proficient with the club, crossbow (light or heavy), dagger, handaxe, javelin, kama, nunchaku, quarterstaff, sai, short sword, shortspear, shuriken, siangham, sling, spear, and any weapon with the monk special weapon quality. Monks are not proficient with any armor or shields. When wearing armor, using a shield, or carrying a medium or heavy load, a monk loses his AC bonus, as well as his fast movement and flurry of blows abilities."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Unchained Monk Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"Proficiency":{"Weapon":"Club"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Light)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Heavy)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Dagger"}}},{"FactGrant":{"Proficiency":{"Weapon":"Handaxe"}}},{"FactGrant":{"Proficiency":{"Weapon":"Javelin"}}},{"FactGrant":{"Proficiency":{"Weapon":"Kama"}}},{"FactGrant":{"Proficiency":{"Weapon":"Nunchaku"}}},{"FactGrant":{"Proficiency":{"Weapon":"Quarterstaff"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sai"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sword (Short)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shortspear"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shuriken"}}},{"FactGrant":{"Proficiency":{"Weapon":"Siangham"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sling"}}},{"FactGrant":{"Proficiency":{"Weapon":"Spear"}}},{"FactGrant":{"Proficiency":{"WeaponGroup":"Monk"}}}],"provenance":{"book":"pathfinder_unchained","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:459"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_c