[{"id":"advanced_players_guide:feat:improved_blind_fight","label":"Improved Blind-Fight","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your keen senses guide your hand against hidden foes."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"Your melee attacks ignore the miss chance for less than total concealment. You may still reroll your miss chance percentile roll for total concealment. If you successfully pinpoint an invisible or hidden attacker within 30 feet, that attacker gets no advantages related to hitting you with ranged attacks. That is, you don't lose your Dexterity bonus to Armor Class, and the attacker doesn't get the usual +2 bonus for being invisible."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:blind_fight"},"count":1}},{"Compare":{"lhs":{"SkillRanks":"perception"},"op":"Gte","rhs":{"Const":10}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_improved_blind_fight"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"},{"by":{"Rule":"ultimate_equipment:equipment:blind_man_s_fold"},"when":"Always"},{"by":{"Rule":"ultimate_intrigue:class_feature:vigilante_talent_strike_the_unseen"},"when":{"Compare":{"lhs":{"Var":"vc98e174c19273973"},"op":"Gte","rhs":{"Const":10}}}}],"provenance":{"book":"advanced_pl