[{"id":"advanced_players_guide:feat:crossbow_mastery","label":"Crossbow Mastery","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can load crossbows with blinding speed and even fire them in melee with little fear of reprisal."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"The time required for you to reload any type of crossbow is reduced to a free action, regardless of the type of crossbow used. You can fire a crossbow as many times in a full attack action as you could attack if you were using a bow. Reloading a crossbow for the type of crossbow you chose when you took Rapid Reload no longer provokes attacks of opportunity."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":3,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:point_blank_shot"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:rapid_reload"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:rapid_shot"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":15}}}]}}]},"print":true,"pool":"feat","tags":["Combat","VolleyMarksmanBonus"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_crossbow_mastery"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:ranger_combat_style_feat_crossbow_mastery"},"when":{"Situational":{"text":"while wearing no heavy armor"}}}],"provenance":{"book":"advanced_players_guide","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_feats.lst:36","pathfinder/dreamscarred_press/ultimate_psionics/up_feats_apg.lst:10"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
