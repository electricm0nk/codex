[{"id":"advanced_players_guide:feat:trick_riding","label":"Trick Riding","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are not only skilled at controlling a horse in combat; you can make it look like art."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"While wearing light or no armor, you do not need to make Ride skill checks for any task listed in the Ride skill with a DC of 15 or lower. You do not take a -5 penalty for riding a mount bareback. You can make a check using Mounted Combat to negate a hit on your mount twice per round instead of just once."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:mounted_combat"},"count":1}},{"Compare":{"lhs":{"SkillRanks":"ride"},"op":"Gte","rhs":{"Const":9}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_trick_riding"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:ranger_combat_style_feat_trick_riding"},"when":{"Situational":{"text":"while wearing no heavy armor"}}},{"by":{"Rule":"ultimate_combat:class_feature:emissary_mounted_acrobatics"},"when":"Always"}],"provenance":{"book":"advanced_players_guide","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_feats.lst:203"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
