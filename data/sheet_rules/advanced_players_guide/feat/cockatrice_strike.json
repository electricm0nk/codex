[{"id":"advanced_players_guide:feat:cockatrice_strike","label":"Cockatrice Strike","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"With a single strike, you transmute flesh to stone."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"As a full-round action, you can make a single unarmed strike against a dazed, flat-footed, paralyzed, staggered, stunned, or unconscious foe. If that attack is a critical hit, the target is petrified unless it succeeds on a Fortitude saving throw with a DC of 10 + 1/2 your character level + your Wisdom modifier. This is a supernatural polymorph effect."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":3,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:gorgon_s_fist"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:medusa_s_wrath"},"count":1}}]}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":14}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_cockatrice_strike"},"when":"Always"}],"provenance":{"book":"advanced_players_guide","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_feats.lst:26"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
