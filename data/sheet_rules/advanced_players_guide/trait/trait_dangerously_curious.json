[{"id":"advanced_players_guide:trait:trait_dangerously_curious","label":"Dangerously Curious","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"You have always been intrigued by magic, possibly because you were the child of a magician or priest. You often snuck into your parent's laboratory or shrine to tinker with spell components and magic devices, and often caused quite a bit of damage and headaches for your parent as a result. You gain a +1 trait bonus on Use Magic Device checks, and Use Magic Device is always a class skill for you."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:trait:trait_dangerously_curious"},"count":1}},{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"MagicTrait"}},"count":1}}}]}},"target":{"Skill":"use_magic_device"},"bonus_type":{"name":"Trait","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Trait","BasicTrait","MagicTrait"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"ClassSkill":"use_magic_device"}}],"provenance":{"book":"advanced_players_guide","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities.lst:42"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
