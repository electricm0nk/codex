[{"id":"advanced_players_guide:trait:trait_black_sheep_titus","label":"Black Sheep / Titus Scarnetti (bitter nobleman)","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Scarnetti Manor was hit hard recently, and the revelation of Scarnetti's ties to Sczarni criminals damaged his reputation as well. He's eager to rebuild his presence in town, and you're one of the ones he's selected as an agent. Choose one of the following skills - Bluff, Sleight of Hand, or Stealth. Your work for Scarnetti gives you a +1 trait bonus on that skill, and it is always a class skill for you."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Holds":{"what":{"Rule":"advanced_players_guide:trait:trait_black_sheep"},"count":1}},"target":{"Chosen":"advanced_players_guide:trait:trait_black_sheep_titus"},"bonus_type":{"name":"Trait","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Trait","TraitCampaignChoice"],"subject":"Character","repeatable":true,"offers":{"id":"advanced_players_guide:trait:trait_black_sheep_titus","count":{"Const":1},"from":{"Skills":["bluff","sleight_of_hand","stealth"]}},"grants":[{"FactGrant":{"ClassSkillChosen":"advanced_players_guide:trait:trait_black_sheep_titus"}}],"provenance":{"book":"advanced_players_guide","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities.lst:161"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
