[{"id":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_lotus","label":"Monk of the Lotus","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Monks are warriors who hone their bodies into deadly weapons, but some monks eschew violence in favor of a more peaceful philosophy. While a monk of the lotus realizes that combat cannot always be avoided-and is more than capable in a fight-he understands that all creatures are connected, and to harm another is to harm the self. Instead, he strives to find peaceful resolutions to conflicts, and in doing so, hopes to achieve inner peace. A monk of the lotus has the following class features."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_lotus"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkStunningFist"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkAbundantStep"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkQuiveringPalm"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkTongueOfTheSunAndMoon"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_lotus"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:monk_archetype_kata_master"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_hungry_ghost_monk"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_four_winds"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_lotus"},"count":1}},{"Holds":{"what":{"Rule":"advanced_play