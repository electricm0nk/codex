[{"id":"advanced_players_guide:class_feature:protean_bloodline_reality_wrinkle","label":"Reality Wrinkle","value":"Text","also":[[{"Uses":{"period":"rounds per day"}},{"Number":{"Var":"v1e6e46419dd325ef"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"You can surround yourself with a mobile, 10-foot-radius emanation of mutable reality. This rippling distortion is similar to solid fog but does not provide concealment or block line of sight. Your movement is not slowed by this aura. Attacks from outside the aura suffer a 20% miss chance against targets inside the aura. You may use this ability "},{"Slot":{"Var":"v1e6e46419dd325ef"}},{"Text":" rounds per day, though this duration need not be continuous."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"v1e6e46419dd325ef"}},{"Text":" rounds)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:sorcerer_bloodline_protean"},"count":1}},{"Compare":{"lhs":{"Var":"v324845f228af54c6"},"op":"Gte","rhs":{"Const":9}}}]},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Protean Bloodline ~ Power LVL 09","Sorcerer Bloodline Power","SpecialQuality","SpellLike"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3174"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
