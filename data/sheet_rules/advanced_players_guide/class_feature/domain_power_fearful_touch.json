[{"id":"advanced_players_guide:class_feature:domain_power_fearful_touch","label":"Fearful Touch","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"vc8fc21689e3de31b"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you can make a melee touch attack against a creature, causing it to experience terrible hallucinations for 1 round. During this time, the creature loses any immunity to fear effects it might possess and takes a -2 penalty on attack rolls made against you. In addition, the creature takes a -"},{"Slot":{"Max":[{"Div":[{"Var":"v925c9ebdb6fe293e"},{"Const":2}]},{"Const":1}]}},{"Text":" penalty on Will saves made against fear effects. This power is a mind-affecting effect. You can use this ability "},{"Slot":{"Var":"vc8fc21689e3de31b"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:class_feature:core_domain_nightmare_subdomain"},"when":{"All":[{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Weather)"}},"count":1}}},{"Compare":{"lhs":{"Var":"vd7bcea085a3cc5ec"},"op":"Gte","rhs":{"Const":1}}}]}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:1859"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
