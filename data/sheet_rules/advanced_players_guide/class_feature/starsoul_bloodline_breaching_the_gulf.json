[{"id":"advanced_players_guide:class_feature:starsoul_bloodline_breaching_the_gulf","label":"Breaching the Gulf","value":{"Number":{"Const":3}},"also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Const":1}}]],"prose":[{"family":"Desc","pieces":[{"Text":"Your caster level is increased by 3 when casting spells of the teleportation subschool. In addition, once per day you can teleport a single creature within 30 feet into the void of space if it fails a Will save. The save DC is equal to 10 + 1/2 your sorcerer level + your Charisma modifier. The target can attempt a new saving throw as a full-round action each round to return. While trapped in the airless void, the target takes 6d6 points of cold damage per round and must hold its breath or begin to suffocate."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(DC "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"Var":"vd7d8e3ec0f5a79a8"},{"Const":2}]},{"Var":"v611a15d183db42fc"}]}},{"Text":")"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:sorcerer_bloodline_starsoul"},"count":1}},{"Compare":{"lhs":{"Var":"v2d53da957c451507"},"op":"Gte","rhs":{"Const":15}}}]},"target":{"CasterLevel":{"Subschool":"Teleportation"}},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Starsoul Bloodline ~ Power LVL 15","Sorcerer Bloodline Power","SpecialAttack","SpellLike"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3229"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
