[{"id":"advanced_players_guide:class_feature:counterspell_school_disruption","label":"Disruption","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"v1fab79c872dd538d"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"At 1st level, you gain the ability to disrupt spellcasting with a touch. As a melee touch attack, you can place a disruptive field around the target. While the field is in place, the target must make a concentration check to cast any spell or to use a spell-like ability in addition to any other required concentration checks. The DC of this check is equal to 15 + twice the spell's level. If the check is failed, the target's spell is wasted. This field lasts for "},{"Slot":{"Max":[{"Div":[{"Var":"v7213ac96f37a433c"},{"Const":2}]},{"Const":1}]}},{"Text":" rounds. You can use this ability "},{"Slot":{"Var":"v1fab79c872dd538d"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"Var":"vdad126dc004294d9"},"op":"Lt","rhs":{"Const":1}}},"print":true,"pool":"special_ability","tags":["WizardClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:arcanist_school_counterspell_disruption"},"when":{"Not":{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}}}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3345","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3403"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
