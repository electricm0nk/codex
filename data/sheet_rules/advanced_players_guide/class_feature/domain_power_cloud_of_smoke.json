[{"id":"advanced_players_guide:class_feature:domain_power_cloud_of_smoke","label":"Cloud of Smoke","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"vd9fa130ccf321b95"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you can create a 5-foot-radius cloud of smoke. This power has a range of 30 feet. Creatures inside the cloud take a -2 penalty on attack rolls and Perception skill checks for as long as they remain inside and for 1 round after exiting the cloud. Creatures inside the cloud gain concealment from attacks made by opponents that are not adjacent to them. You can use this ability "},{"Slot":{"Var":"vd9fa130ccf321b95"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:class_feature:core_domain_smoke_subdomain"},"when":{"All":[{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Weather)"}},"count":1}}},{"Compare":{"lhs":{"Var":"v84e634ecec23c5cb"},"op":"Gte","rhs":{"Const":1}}}]}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:1869"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
