[{"id":"advanced_players_guide:class_feature:cavalier_tactician","label":"Tactician","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"A cavalier receives a teamwork feat as a bonus feat. He must meet the prerequisites for this feat. As a standard action, the cavalier can grant this feat to all allies within 30 feet who can see and hear him. Allies retain the use of this bonus feat for "},{"Slot":{"Sum":[{"Const":3},{"Div":[{"Var":"v92fd06113d454d82"},{"Const":2}]}]}},{"Text":" rounds. Allies do not need to meet the prerequisites of these bonus feats. The cavalier can use this ability "},{"Slot":{"Sum":[{"Const":1},{"Div":[{"Var":"v92fd06113d454d82"},{"Const":5}]}]}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"tactician_teamwork_feat"},"print":true,"pool":"special_ability","tags":["CavalierClassFeatures","Internal"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_combat:class_feature:tactician_tactician"},"when":"Always"}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:196"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
