[{"id":"advanced_players_guide:class_feature:rogue_talent_redirect_attack","label":"Redirect Attack","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Const":1}}]],"prose":[{"family":"Desc","pieces":[{"Text":"Once per day, when a rogue with this talent is hit with a melee attack, she can redirect the attack to strike at an adjacent creature with a free action. The creature targeted must be within melee reach of the attack that hit the rogue, and the creature that made the attack against the rogue must make a new attack roll against the new target."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"Var":"ve4704d6c844d69d3"},"op":"Gte","rhs":{"Const":10}}},"print":true,"pool":"special_ability","tags":["RogueAdvancedTalent","Extraordinary","SpecialQuality","Unchained Rogue Advanced Talent"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2935","pathfinder/paizo/roleplaying_game/pathfinder_unchained/pu_abilities_class.lst:718"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
