[{"id":"advanced_players_guide:class_feature:master_spy_elude_detection","label":"Elude Detection","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"At 5th level, a master spy can befuddle divinations used against her as if she were under the effect of a nondetection spell with a caster level equal to her character level. She can suppress or resume this protection as a standard action. If dispelled, the spy cannot resume the nondetection for 1d4 rounds."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ClassFeatures","Master SpyClassFeatures","SpecialQuality","SpellLike"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:ability:master_spy"},"when":{"Compare":{"lhs":{"Var":"vebf4bb666346cb2b"},"op":"Gte","rhs":{"Const":5}}}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:1411"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
