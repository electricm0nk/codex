[{"id":"advanced_players_guide:class_feature:rage_power_energy_absorption","label":"Energy Absorption","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While raging, the barbarian can absorb energy from a single attack of her chosen energy type once per rage. She does not make a saving throw against the effect but takes no damage from it, instead gaining 1 temporary hit point per 3 points of damage the attack would have inflicted. These temporary hit points last until the end of the barbarian's rage."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rage_power_energy_resistance_greater"},"count":1}},{"Compare":{"lhs":{"Var":"v81feb433e02a1864"},"op":"Gte","rhs":{"Const":12}}}]},"print":true,"pool":"special_ability","tags":["ClassFeatures","BarbarianClassFeatures","RagePower","SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:1500"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
