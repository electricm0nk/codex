[{"id":"advanced_players_guide:class_feature:domain_power_death_s_kiss","label":"Death's Kiss","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"v6ef432803178252f"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"You can cause a creature to take on some of the traits of the undead with a melee touch attack. Touched creatures are treated as undead for the purposes of effects that heal or cause damage based on positive and negative energy. This effect lasts for "},{"Slot":{"Max":[{"Const":1},{"Div":[{"Var":"v925c9ebdb6fe293e"},{"Const":2}]}]}},{"Text":" rounds. It does not apply to the Turn Undead or Command Undead feats. You can use this ability "},{"Slot":{"Var":"v6ef432803178252f"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:class_feature:core_domain_undead_subdomain"},"when":{"All":[{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Weather)"}},"count":1}}},{"Compare":{"lhs":{"Var":"vd395660bc06a465e"},"op":"Gte","rhs":{"Const":1}}}]}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:1877"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
