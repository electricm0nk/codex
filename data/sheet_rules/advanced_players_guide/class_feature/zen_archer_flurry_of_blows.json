[{"id":"advanced_players_guide:class_feature:zen_archer_flurry_of_blows","label":"Flurry of Blows","value":{"Number":{"Sum":[{"Var":"v08103d7d8f77a4cc"},{"Const":1}]}},"prose":[{"family":"Desc","pieces":[{"Text":"Starting at 1st level, a zen archer can make a flurry of blows as a full-attack action, but only when using a bow (even though it is a ranged weapon). He may not make a flurry of blows with his unarmed attacks or any other weapons. A zen archer does not apply his Strength bonus on damage rolls made with flurry of blows unless he is using a composite bow with a Strength rating. A zen archer's flurry of blows otherwise functions as normal for a monk of his level. A zen archer cannot use Rapid Shot or Manyshot when making a flurry of blows with his bow."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Situational":{"text":"when active"}},"target":{"Other":"weapon attacks"},"print":true,"pool":"special_ability","tags":["ClassFeatures","MonkClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2381"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"advanced_players_guide:class_feature:zen_archer_flurry_of_blows#bonus1","label":"Flurry of Blows (weapon)","value":{"Number":{"Const":-2}},"applies":{"Situational":{"text":"when active"}},"target":{"Other":"weapon tohit"},"print":true,"pool":"special_ability","tags":["ClassFeatures","MonkClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2381"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_conver