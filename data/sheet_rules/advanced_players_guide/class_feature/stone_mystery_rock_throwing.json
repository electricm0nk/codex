[{"id":"advanced_players_guide:class_feature:stone_mystery_rock_throwing","label":"Rock Throwing","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are an accomplished rock thrower and have a +1 racial bonus on attack rolls with thrown rocks. You can hurl rocks up to two categories smaller than your own size. The range increment for a rock is 20 feet, and you can hurl it up to 5 range increments. Damage for a hurled rock is 2d4 for a Medium creature or 2d3 for a Small creature, plus 1-1/2 your Strength bonus."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["OracleClassFeatures","SpecialAttack","OracleRevelation","StoneRevelation","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary:monster:giant_cloud"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_fire"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_frost"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_hill"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_stone"},"when":"Always"},{"by":{"Rule":"bestiary:monster:treant"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:athach"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_brineborn_marsh"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_marsh"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_taiga"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:korred"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:titan_thanatotic"},"when":"Always"},{"by":{"Rule":"bestiary_6:companion:companion_advancement_devil_monkey"},"when":"Always"},{"by":{"Rule":"inner_sea_bestiary:monster:giant_shadow"},"when":"Always"}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:675"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.