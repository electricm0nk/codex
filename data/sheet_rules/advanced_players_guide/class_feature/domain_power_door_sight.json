[{"id":"advanced_players_guide:class_feature:domain_power_door_sight","label":"Door Sight","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"v468e76ed057d25f3"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"You can lay your hand upon any surface and see what is on the other side, as if using clairvoyance. Using this power takes 1 minute, during which time you must be touching the surface you want to see through. You can keep looking for as long as 10 minutes with each use of this power, but must touch the surface and take no other action the entire time. The surface cannot be thicker than "},{"Slot":{"Sum":[{"Const":6},{"Var":"v925c9ebdb6fe293e"}]}},{"Text":" inches. You can use this power "},{"Slot":{"Var":"v468e76ed057d25f3"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural","DomainPower"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:class_feature:core_domain_exploration_subdomain"},"when":{"All":[{"Not":{"Holds":{"what":{"MissingRule":{"pool":"internal","name":"DisableDomainLVL1 (Weather)"}},"count":1}}},{"Compare":{"lhs":{"Var":"v410f8532af4b3759"},"op":"Gte","rhs":{"Const":1}}}]}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:1834"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
