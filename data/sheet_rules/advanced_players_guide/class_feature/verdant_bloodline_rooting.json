[{"id":"advanced_players_guide:class_feature:verdant_bloodline_rooting","label":"Rooting","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a move action, you can extend roots into the ground. Your speed is reduced to 5 feet, but you gain a +4 bonus to natural armor and a +10 bonus to CMD against bull rush, overrun, reposition, and trip maneuvers. You also gain tremorsense 30 feet and fast healing 1. You can use this power for "},{"Slot":{"Var":"vb4cd0d8f51c3446a"}},{"Text":" minutes per day. This duration need not be consecutive, but it must be used in 1-minute increments."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"vb4cd0d8f51c3446a"}},{"Text":" minutes)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:sorcerer_bloodline_verdant"},"count":1}},{"Compare":{"lhs":{"Var":"v1efda555c86c8f51"},"op":"Gte","rhs":{"Const":15}}}]},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Verdant Bloodline ~ Power LVL 15","Sorcerer Bloodline Power","SpecialQuality","Special Quality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3265"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
