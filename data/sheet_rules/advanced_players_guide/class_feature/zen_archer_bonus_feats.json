[{"id":"advanced_players_guide:class_feature:zen_archer_bonus_feats","label":"Bonus Feats","value":{"Number":{"Const":0}},"prose":[{"family":"Desc","pieces":[{"Text":"A zen archer's bonus feats must be taken from the following list: Combat Reflexes, Deflect Arrows, Dodge, Far Shot, Point-Blank Shot, Precise Shot, and Rapid Shot. At 6th level, the following feats are added to the list: Focused Shot*, Improved Precise Shot, Manyshot, Mobility, and Parting Shot*. At 10th level, the following feats are added to the list: Improved Critical, Pinpoint Targeting, Shot on the Run, and Snatch Arrows. A monk need not have any of the prerequisites normally required for these feats to select them. These feats replace the monk's normal bonus feats."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"zen_archer_feat"},"print":true,"pool":"special_ability","tags":["ClassFeatures","MonkClassFeatures","SpecialQuality","MonkBonusFeats"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2382","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2404","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2405","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2406","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2407","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2408","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2409","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2410","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2412","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:2413","pathfinder/paizo/rolep