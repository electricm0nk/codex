[{"id":"advanced_players_guide:class_feature:shadow_school_binding_darkness","label":"Binding Darkness","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"v1fab79c872dd538d"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you cast a weave of shadows at any foe within 30 feet as a ranged touch attack. The shadows entangle your foe for "},{"Slot":{"Sum":[{"Div":[{"Var":"ved5f632c53f89238"},{"Const":5}]},{"Const":1}]}},{"Text":" rounds. In conditions of bright light, this duration is halved (minimum 1 round). A creature entangled by your shadows has concealment from those without darkvision or the ability to see in darkness, and other creatures likewise have concealment relative to it. You can use this ability "},{"Slot":{"Var":"v1fab79c872dd538d"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"Var":"vdad126dc004294d9"},"op":"Lt","rhs":{"Const":1}}},"print":true,"pool":"special_ability","tags":["WizardClassFeatures","SpecialQuality","SpellLike"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:arcanist_school_shadow_binding_darkness"},"when":{"Not":{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}}}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3380","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3414"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
