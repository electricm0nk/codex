[{"id":"advanced_players_guide:class_feature:phantasm_school_bedeviling_aura","label":"Bedeviling Aura","value":"Text","also":[[{"Uses":{"period":"rounds per day"}},{"Number":{"Var":"ved5f632c53f89238"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"At 8th level, you can emit a 30- foot aura that bedevils your enemies with phantasmal assailants. Enemies within this aura move at half speed, are unable to take attacks of opportunity, and are considered to be flanked. This is a mind-affecting effect. You can use this ability for "},{"Slot":{"Var":"ved5f632c53f89238"}},{"Text":" rounds per day. These rounds do not need to be consecutive."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"v53d8624665563b96"},"op":"Lt","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v53d8624665563b96"},"op":"Lt","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["WizardClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3374","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3431"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
