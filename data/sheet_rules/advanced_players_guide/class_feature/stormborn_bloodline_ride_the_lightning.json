[{"id":"advanced_players_guide:class_feature:stormborn_bloodline_ride_the_lightning","label":"Ride the Lightning","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Const":1}}]],"prose":[{"family":"Desc","pieces":[{"Text":"As a full-round action you can become a living lightning bolt and move in a straight line up to 10 times your speed. You do not provoke attacks of opportunity while moving in this way. Creatures or objects in your path are affected as by your thunderbolt power. Creatures do not block your movement but solid barriers do unless they are reduced to 0 hit points. You can use this power once per day for "},{"Slot":{"Var":"va8bab4165e32e8ab"}},{"Text":" rounds."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"va8bab4165e32e8ab"}},{"Text":" rounds)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:sorcerer_bloodline_stormborn"},"count":1}},{"Compare":{"lhs":{"Var":"v376005e71f569206"},"op":"Gte","rhs":{"Const":15}}}]},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Stormborn Bloodline ~ Power LVL 15","Sorcerer Bloodline Power","SpecialAttack","SpellLike"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3247"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
