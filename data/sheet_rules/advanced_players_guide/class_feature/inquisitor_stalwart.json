[{"id":"advanced_players_guide:class_feature:inquisitor_stalwart","label":"Stalwart","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"An inquisitor can use mental and physical resiliency to avoid certain attacks. If she makes a Fortitude or Will saving throw against an attack that has a reduced effect on a successful save, she instead avoids the effect entirely. This ability can only be used if the inquisitor is wearing light armor, medium armor, or no armor. A helpless inquisitor does not gain the benefit of the stalwart ability."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["InquisitorClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Class":{"id":"ex_inquisitor","at_level":11}},"when":{"All":[{"Compare":{"lhs":{"Var":"v50e2bbe9f679a51c"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"ClassLevel":"ex_inquisitor"},"op":"Gte","rhs":{"Const":11}}}]}},{"by":{"Rule":"advanced_players_guide:ability:inquisitor"},"when":{"All":[{"Compare":{"lhs":{"Var":"v50e2bbe9f679a51c"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"vc3124f12718cbc3c"},"op":"Gte","rhs":{"Const":11}}}]}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:308"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
