[{"id":"advanced_players_guide:class_feature:shapechange_school_battleshaping","label":"Battleshaping","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"v1fab79c872dd538d"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"As a swift action, you grow a single natural weapon. The natural weapon lasts for 1 round and has a +"},{"Slot":{"Div":[{"Var":"vfacd4b8aca847c70"},{"Const":4}]}},{"Text":" enhancement bonus on attack and damage rolls. You can grow a claw, a bite, or a gore attack. These attacks deal the normal damage for a creature of your size (see page 302 of the Pathfinder RPG Bestiary). At 11th level, you can shape two natural weapons. You may not grow additional limbs or a tail with this ability. You can use this ability "},{"Slot":{"Var":"v1fab79c872dd538d"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"vdad126dc004294d9"},"op":"Lt","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"vdad126dc004294d9"},"op":"Lt","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["WizardClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:arcanist_school_shapechange_battleshaping"},"when":{"Not":{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}}}}],"provenance":{"book":"advanced_players_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3384","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_abilities_class.lst:3415"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
