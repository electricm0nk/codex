[{"id":"advanced_players_guide:race_trait:gnome_magical_linguist","label":"Magical Linguist","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Gnomes study languages in both their mundane and supernatural manifestations. Gnomes with this racial trait add +1 to the DC of spells they cast with the language-dependent descriptor or those that create glyphs, symbols, or other magical writings. They gain a +2 racial bonus on saving throws against such spells. Gnomes with a Charisma of 11 or higher also gain the following spell-like abilities: 1/day--arcane mark, comprehend languages, message, read magic. The caster level for these effects is equal to the gnome's level."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces the gnome magic and illusion resistance racial traits."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_magical_linguist"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"Add +1 to the DC of spells that create glyphs, symbols, or other magical writings that don't have the language-dependent descriptor."}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"SaveBonus"},"pieces":[{"Text":"+2 racial bonus on saving throws against spells with the language-dependent descriptor or those that create glyphs, symbols, or other magical writings."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_magical_linguist"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_magical_linguist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_pyromaniac"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_fell_magic"},"count":1}},{"Hol