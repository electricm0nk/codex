[{"id":"advanced_players_guide:race_trait:dwarf_stubborn","label":"Stubborn","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Dwarves are renowned for being stubborn. Dwarves with this racial trait receive a +2 racial bonus on Will saves to resist spells and spell-like abilities of the enchantment (charm) and enchantment (compulsion) schools. In addition, if they fail such a save, they receive another save 1 round later to prematurely end the effect (assuming it has a duration greater than 1 round). This second save is made at the same DC as the first. If the dwarf has a similar ability from another source (such as a rogue's slippery mind), he can only use one of these abilities per round, but can try one on the second round if the first reroll ability fails."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces the hardy racial trait."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:dwarf_stubborn"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"WillSaveBonus"},"pieces":[{"Text":"+2 vs. enchantment (charm) and enchantment (compulsion) spells and spell-like abilities"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:dwarf_stubborn"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:dwarf_magic_resistant"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:dwarf_stubborn"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_magic_resistant"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_stubborn"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:race_trait:dwarf_healthy"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:race_trait:dwarf_viscous_blood"},"count":1}},{"Holds":{"what":{"Rule":"inner_