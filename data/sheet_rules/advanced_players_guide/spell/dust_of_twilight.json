[{"id":"advanced_players_guide:spell:dust_of_twilight","label":"Dust of Twilight","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A shower of iridescent black particles clings to and extinguishes torches, lanterns, sunrods, and similar mundane light sources and dispels any spell of 2nd level or lower with the light descriptor (as dispel magic). Creatures in the area must make a Fortitude save or become fatigued."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Black particles extinguish light sources within area."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"A shower of iridescent black particles clings to and extinguishes torches, lanterns, sunrods, and similar mundane light sources and dispels any spell of 2nd level or lower with the light descriptor (as dispel magic). Creatures in the area must make a Fortitude save or become fatigued."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: A creature that fails its Fortitude save against the spell must also succeed at a Will save at the same DC or fall asleep (as the Sleep spell). Creatures that succeed at their saves are merely drowsy (as the lullaby spell). Augmented: If you expend two uses of mythic power, add half your tier to the level of light spells mythic dust of twilight dispels."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Dust of Twilight"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Darkness"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instant