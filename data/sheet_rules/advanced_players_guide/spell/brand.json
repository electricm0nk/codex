[{"id":"advanced_players_guide:spell:brand","label":"Brand","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Brand etches an indelible rune or mark of no more than 6 characters onto a creature, inflicting 1 point of damage. The mark may be placed on any exposed portion of the creature, typically the head or forearm. A brand can be hidden by clothing or removed by scraping it away (causing 1d6 points of damage), though the brand returns if the damage is healed."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Creates permanent brand on target creature."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Brand etches an indelible rune or mark of no more than 6 characters onto a creature, inflicting 1 point of damage. The mark may be placed on any exposed portion of the creature, typically the head or forearm. A brand can be hidden by clothing or removed by scraping it away (causing 1d6 points of damage), though the brand returns if the damage is healed."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) days"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"T