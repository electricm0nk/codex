[{"id":"bestiary_3:monster_ability:crucidaemon_chained_daggers","label":"Chained Daggers","value":{"Number":{"Const":4}},"prose":[{"family":"Desc","pieces":[{"Text":"A crucidaemon fights with the two daggers chained to its wrists as if dual wielding daggers with a reach of 10 feet (although it can also attack adjacent foes with no penalty). It takes no penalty on attack or damage rolls while wielding both of these daggers at once. These daggers are considered to be +2 daggers that deal 2d6 points of bleed damage. The daggers become nonmagical upon the daemon's death, and cannot be disarmed. A crucidaemon may remanifest a destroyed dagger as a standard action."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":"Attack","print":true,"pool":"special_ability","tags":["CrucidaemonRacialAbility","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_3","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary_3/b3_abilities_race.lst:606"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary_3:monster_ability:crucidaemon_chained_daggers#bonus1","label":"Chained Daggers (attack)","value":{"Number":{"Const":8}},"applies":"Always","target":"Attack","print":true,"pool":"special_ability","tags":["CrucidaemonRacialAbility","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary_3","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary_3/b3_abilities_race.lst:606"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
