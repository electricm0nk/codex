[{"id":"bestiary:monster_ability:barghest_feed","label":"Feed","value":{"Number":{"Var":"vd95be35ef634fce1"}},"prose":[{"family":"Desc","pieces":[{"Text":"Once per month, a barghest can devour a nonevil humanoid's corpse as a full-round action to gain a growth point. It gains a bonus equal to its growth point total on attack rolls, CMB rolls, saving throws, and skill checks. Its maximum hit points increase by 5 for each growth point it gains. For every 2 growth points, a barghest's caster level for its spell-like abilities and its CR increase by +1. When a barghest reaches 4 growth points, it sheds its skin and becomes a greater barghest, losing all of its growth points (and bonuses) but gaining the stats presented on this page for a greater barghest."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":"Attack","print":true,"pool":"special_ability","tags":["SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"offers":{"id":"bestiary:monster_ability:barghest_feed","count":{"Const":1},"from":{"Number":{"min":{"Const":1},"max":{"Const":4}}}},"provenance":{"book":"bestiary","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary/b1_abilities_race.lst:140"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary:monster_ability:barghest_feed#bonus1","label":"Feed (hit points)","value":{"Number":{"Mul":[{"Var":"vd95be35ef634fce1"},{"Const":5}]}},"applies":"Always","target":"Hp","print":true,"pool":"special_ability","tags":["SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary/b1_abilities_race.lst:140"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary:monster_ability:barghest_feed#bonus2","label":"Feed (cr)","value":{"Number