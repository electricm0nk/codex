[{"id":"bestiary:monster_ability:nabasu_consume_life","label":"Consume Life","value":{"Number":{"Div":[{"Var":"vd95be35ef634fce1"},{"Const":2}]}},"prose":[{"family":"Desc","pieces":[{"Text":"When a nabasu creates a ghoul with its gaze attack, it gains a growth point. It gains a bonus equal to its growth point total on attack rolls, CMB rolls, saving throws, caster level checks, and skill checks. Its maximum hit points increase by 10 for each growth point, and its caster level for spell-like abilities increases by 1. For every 2 growth points, its natural armor bonus, SR, and CR increase by 1. Every time it gains a growth point it makes a DC 30 caster level check--success indicates it matures (gaining both the advanced and the giant simple templates) and plane shifts to the Abyss in a burst of smoke. A nabasu can have a maximum of 20 growth points--it automatically matures if it has not done so already when it reaches 20 growth points."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"vd95be35ef634fce1"}},{"Text":" Growth Points)"}],"pick_last":true,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"When a nabasu creates a ghoul with its gaze attack, it gains a growth point."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":"Ac","bonus_type":{"name":"NaturalArmor","mode":"Replace"},"print":true,"pool":"special_ability","tags":["SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"offers":{"id":"bestiary:monster_ability:nabasu_consume_life","count":{"Const":1},"from":{"Number":{"min":{"Const":1},"max":{"Const":20}}}},"provenance":{"book":"bestiary","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/bestiary/b1_abilities_race.lst:292"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"bestiary:monster_ability:nabasu_consume_life#