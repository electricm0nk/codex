[{"id":"bestiary:monster_ability:universal_monster_rule_fast_healing","label":"Fast Healing","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A creature with the fast healing special quality regains hit points at an exceptional rate, usually 1 or more hit points per round, as given in the creature's entry. Except where noted here, fast healing is just like natural healing. Fast healing does not restore hit points lost from starvation, thirst, or suffocation, nor does it allow a creature to regrow lost body parts. Unless otherwise stated, it does not allow lost body parts to be reattached. Fast healing continues to function (even at negative hit points) until a creature dies, at which point the effects of fast healing end immediately."}],"applies":{"Compare":{"lhs":{"Var":"v7bcb72a8803e9b3c"},"op":"Eq","rhs":{"Const":0}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Works only in areas below freezing."}],"applies":{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"Var":"v7bcb72a8803e9b3c"},"op":"Eq","rhs":{"Const":1}}},{"Holds":{"what":{"Race":"mephit_ice"},"count":1}}]}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Works only in arid environments."}],"applies":{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"Var":"v7bcb72a8803e9b3c"},"op":"Eq","rhs":{"Const":1}}},{"Holds":{"what":{"Race":"mephit_salt"},"count":1}}]}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Works only in boiling water or steam."}],"applies":{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"Var":"v7bcb72a8803e9b3c"},"op":"Eq","rhs":{"Const":1}}},{"Holds":{"what":{"Race":"mephit_steam"},"count":1}}]}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Works only in contact with magma or lava."}],"applies":{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"Var":"v7bcb72a8803e9b3c"},"op":"Eq","rhs":{"Const":1}}},{"Holds":{"what":{"Race":"mephit_magma"},"coun