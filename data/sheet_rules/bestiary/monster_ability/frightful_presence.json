[{"id":"bestiary:monster_ability:frightful_presence","label":"Frightful Presence","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your very presence unsettling to foes. Activating this ability is a free action that is usually part of an attack or charge. Opponents within range who witness the action may become frightened or shaken. The range is "},{"Slot":{"Var":"v96e08079b51b6190"}},{"Text":" feet, and the duration is usually 5d6 rounds. This ability affects only opponents with fewer Hit Dice or levels than the creature has. An affected opponent can resist the effects with a successful Will save (DC "},{"Slot":{"Var":"v38545f075afc24b8"}},{"Text":"). On a failed save, the opponent is shaken, or panicked if 4 HD or fewer. An opponent that succeeds on the saving throw is immune to your frightful presence for 24 hours. Frightful presence is a mind-affecting fear effect."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"v96e08079b51b6190"}},{"Text":" ft., DC "},{"Slot":{"Var":"v38545f075afc24b8"}},{"Text":")"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary","Aura"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:companion:evolution_frightful_presence"},"when":"Always"},{"by":{"Rule":"bestiary:monster:tarrasque"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:dullahan"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:dullahan_coach_of_the_silent"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:jabberwock"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:jabberwock_lesser"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:scylla"},"when":"Always"},{"by":{"Rule":"book_of_the_damned_volume_2:monster:demon_vavakia"},"when":"Always"},{"by":{"Rule":"inner_sea_bestiary:monster:korir_kokembe"},"when":"Always"}],"provenance":{"b