[{"id":"bestiary:monster_ability:universal_monster_rule_poison_supernatural","label":"Poison","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A creature with this ability can poison those it attacks. The effects of the poison, including its save, frequency, and cure, are included in the creature's description. The saving throw to resist a poison is usually a Fort save (DC 10 + 1/2 poisoning creature's racial HD + creature's Con modifier; the exact DC is given in the creature's descriptive text). Poisons can be removed through neutralize poison and similar effects."}],"applies":{"Compare":{"lhs":{"Var":"v5c476c4c5db10ea8"},"op":"Eq","rhs":{"Const":0}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(DC "},{"Slot":{"Var":"v59a04a2582e80b77"}},{"Text":")"}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"NaturalAttackBonus"},"pieces":[{"Text":"Bite"}],"applies":{"Compare":{"lhs":{"Var":"v6fc2668d3f271e77"},"op":"Eq","rhs":{"Const":1}}},"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"NaturalAttackBonus"},"pieces":[{"Text":"Claw"}],"applies":{"Compare":{"lhs":{"Var":"v702fec1d8e7a8d90"},"op":"Eq","rhs":{"Const":1}}},"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"NaturalAttackBonus"},"pieces":[{"Text":"Sting"}],"applies":{"Compare":{"lhs":{"Var":"v234dc115ba5d4aac"},"op":"Eq","rhs":{"Const":1}}},"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Universal Monster Rule","Special Ability","SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"bestiary","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/ce_abilities_race.lst:2379"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
