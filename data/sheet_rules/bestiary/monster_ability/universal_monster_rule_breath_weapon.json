[{"id":"bestiary:monster_ability:universal_monster_rule_breath_weapon","label":"Breath Weapon","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some creatures can exhale a cone, line, or cloud of energy or other magical effects. A breath weapon attack usually deals damage and is often based on some type of energy. Breath weapons allow a Reflex save for half damage (DC 10 + 1/2 breathing creature's racial HD + breathing creature's Con modifier; the exact DC is given in the creature's descriptive text). A creature is immune to its own breath weapon unless otherwise noted. Some breath weapons allow a Fortitude save or a Will save instead of a Reflex save. Each breath weapon also includes notes on how often it can be used, even if this number is limited in times per day."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"v91b1f8c0074526fd"}},{"Text":"-ft. cone, "},{"Slot":{"Var":"v7342bdf5b3ea04d2"}},{"Text":"d"},{"Slot":{"Var":"v212f4c9ba94619c7"}},{"Text":" acid damage, Reflex DC "},{"Slot":{"Var":"v1ae5e60a8da39ce0"}},{"Text":" for half, usable every "},{"Slot":{"Var":"vab0b815468083b2b"}},{"Text":" rounds)"}],"applies":{"All":[{"Compare":{"lhs":{"Var":"vde011da58f530174"},"op":"Eq","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"vab0b815468083b2b"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v91b1f8c0074526fd"},"op":"Gte","rhs":{"Const":1}}}]},"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"v91b1f8c0074526fd"}},{"Text":"-ft. cone, "},{"Slot":{"Var":"v7342bdf5b3ea04d2"}},{"Text":"d"},{"Slot":{"Var":"v212f4c9ba94619c7"}},{"Text":" acid damage, Reflex DC "},{"Slot":{"Var":"v1ae5e60a8da39ce0"}},{"Text":" for half, usable every "},{"Slot":{"Const":0}},{"Text":"d"},{"Slot":{"Const":0}},{"Text":" rounds)"}],"applies":{"All":[{"Compare":{"lhs":{"Var":"vde011da58f530174"},"op":"Eq","rhs":{"Const":