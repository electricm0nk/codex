[{"id":"bestiary:monster_ability:burn","label":"Burn","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You deal fire damage in addition to damage dealt on a successful hit in melee. Those affected by the burn ability must also succeed on a Reflex (DC "},{"Slot":{"Var":"v64ed1eccdabf22fe"}},{"Text":") save or catch fire, taking "},{"Slot":{"Var":"va6560f6f09e35790"}},{"Text":"d"},{"Slot":{"Var":"v617c0a30d11c927c"}},{"Text":" damage for an additional 1d4 rounds at the start of its turn. A burning creature can attempt a new save as a full-round action. Dropping and rolling on the ground grants a +4 bonus on this save. Creatures that hit a burning creature with natural weapons or unarmed attacks take fire damage as though hit by the burning creature and must make a Reflex save to avoid catching on fire."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"va6560f6f09e35790"}},{"Text":"d"},{"Slot":{"Var":"v617c0a30d11c927c"}},{"Text":", DC "},{"Slot":{"Var":"v64ed1eccdabf22fe"}},{"Text":")"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialAttack","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary:monster:elemental_fire_elder"},"when":"Always"},{"by":{"Rule":"bestiary:monster:elemental_fire_greater"},"when":"Always"},{"by":{"Rule":"bestiary:monster:elemental_fire_huge"},"when":"Always"},{"by":{"Rule":"bestiary:monster:elemental_fire_large"},"when":"Always"},{"by":{"Rule":"bestiary:monster:elemental_fire_medium"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:azata_brijidine"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:devil_immolation"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:elemental_magma_elder"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:elemental_magma_greater"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:elemental_magma_h