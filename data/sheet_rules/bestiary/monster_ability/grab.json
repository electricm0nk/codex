[{"id":"bestiary:monster_ability:grab","label":"Grab","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"If You hit with the indicated attack, you deal normal damage and can attempt to start a grapple as a free action without provoking an attack of opportunity."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"If you hit with the indicated attack (usually a claw or bite attack), you deal normal damage and can attempt to start a grapple as a free action without provoking an attack of opportunity. You have the option to conduct the grapple normally, or simply use the part of your body you used in the grab to hold the opponent. If you choose to do the latter, you takes a -20 penalty on your CMB check to make and maintain the grapple, but do not gain the grappled condition itself. A successful hold does not deal any extra damage unless you also have the constrict special attack. If you do not constrict, each successful grapple check you make during successive rounds automatically deals the damage indicated for the attack that established the hold. Otherwise, you deal constriction damage as well. You receive a +4 bonus on combat maneuver checks made to start and maintain a grapple. Unless otherwise noted, grab can only be used on creatures of a size equal to or smaller than you."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialAttack","Extraordinary","AttackOption"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:mutation_warrior_discovery_tentacle"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_final_embrace"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:companion:evolution_grab"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:companion:familiar_crab_giant_king"},"when":"Always"},{"by":{"Rule":"advanced_players_gu