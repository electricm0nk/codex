[{"id":"bestiary:monster_ability:pull","label":"Pull","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can choose to make a free combat maneuver check with a successful attack. If successful, this check pulls a creature closer. This ability only works on creatures of a size equal to or smaller than you. Creatures pulled in this way do not provoke attacks of opportunity and stop if the pull would move them into a solid object or creature."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialAttack","Extraordinary","AttackOption"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_players_guide:companion:evolution_pull"},"when":"Always"},{"by":{"Rule":"bestiary:monster:frog_giant"},"when":"Always"},{"by":{"Rule":"bestiary:companion:companion_frog_giant"},"when":"Always"},{"by":{"Rule":"bestiary_3:companion:companion_advancement_giant_chameleon"},"when":"Always"},{"by":{"Rule":"bestiary_5:companion:companion_frog_goliath"},"when":"Always"},{"by":{"Rule":"bestiary_5:companion:companion_frog_father"},"when":"Always"},{"by":{"Rule":"core_rulebook:template:wild_shape_medium_animal_giant_frog"},"when":{"Compare":{"lhs":{"Var":"vc48eb5d6765f795e"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"inner_sea_bestiary:monster:charnel_colossus"},"when":"Always"}],"provenance":{"book":"bestiary","kind":"monster_ability","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/ce_abilities_race.lst:1465"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
