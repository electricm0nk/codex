[{"id":"inner_sea_gods:spell:beacon_of_luck","label":"Beacon of Luck","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You send out a burst of luck with a 30-foot radius centered  around you. While the beacon of luck is in effect, you gain  a +2 sacred bonus on all saving throws. As an immediate  action before a saving throw is made, allies within the area  can choose to benefit from this luck, rolling twice for a saving  throw and taking the better result. Once a creature benefits  from the beacon of luck in this way, it cannot gain the benefit  of this spell for 24 hours."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M/DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal; see text"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Divination"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bard","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"inquisitor","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"paladin","spell_level":4}},"when":"Always"}],"grants":[{"FactDeclare":{"name":"CompMaterial","value":"(a tuft of rabbit fur)"}}],"provenance":{"book":"inner_sea_gods","kind":"spell","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_gods/isg_spells.lst:1