[{"id":"inner_sea_gods:spell:smite_abomination","label":"Smite Abomination","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Drawing upon positive energy, you emulate some of a paladin's power to smite undead. Choose one undead creature as your target. Your melee attacks against that target gain a bonus equal to your Charisma or Wisdom modifier, whichever is higher, on your attack rolls, and a bonus equal to your caster level on damage rolls. Your melee attacks also bypass the target's damage reduction. These bonuses do not stack with the bonuses from a paladin's smite."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, OF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"inquisitor","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"cleric","spell_level":5}},"when":"Always"}],"provenance":{"book":"inner_sea_gods","kind":"spell","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_gods/isg_spells.lst:58"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0","pi":{"declared":["FACTSET"]}}}]
