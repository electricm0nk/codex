[{"id":"inner_sea_gods:monster_ability:mother_s_maw_desecrate_aura","label":"Desecrate Aura","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"The herald has a 20-foot-radius emanation equivalent to a Desecrate spell centered on a shrine of evil power.  Undead within this radius (including the Maw) gain a +2 profane bonus on attack and damage rolls and saving throws, as well as +2 hit points per die, and the save DC of channeled negative energy is increased by +6 (these adjustments are included for the Maw in its entry).  This aura can be negated by Dispel Evil, but the herald can reactivate it on its turn as a free action.  A desecrating aura suppresses and is suppressed by Consecrate or Hallow; both effects are negated within any overlapping area of effect."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(20 ft.)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","target":"Attack","bonus_type":{"name":"Profane","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Aura","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_gods","kind":"monster_ability","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_gods/isg_abilities_races.lst:280"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"inner_sea_gods:monster_ability:mother_s_maw_desecrate_aura#bonus1","label":"Desecrate Aura (damage)","value":{"Number":{"Const":2}},"applies":"Always","target":{"Damage":"Melee"},"bonus_type":{"name":"Profane","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Aura","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_gods","kind":"monster_ability","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_gods/isg_abilities_races.lst:280"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_ver