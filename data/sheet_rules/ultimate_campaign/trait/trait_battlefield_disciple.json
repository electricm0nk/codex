[{"id":"ultimate_campaign:trait:trait_battlefield_disciple","label":"Battlefield Disciple","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are skilled at supporting your allies in the heat of battle. You gain a +2 trait bonus on Heal checks made to stabilize a dying creature. In addition, when you successfully use the aid another action in combat to grant an ally a bonus on her next attack roll, the bonus you grant increases by 1."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"Increase Grant of Aid bonus to an ally by 1."}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"SkillBonus"},"pieces":[{"Text":"+2 trait bonus on Heal checks made to stabilize a dying creature"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_campaign:trait:trait_battlefield_disciple"},"count":1}},{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"CombatTrait"}},"count":1}}}]}},"print":true,"pool":"special_ability","tags":["Trait","BasicTrait","CombatTrait"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_campaign","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_campaign/uca_abilities_traits.lst:22"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
