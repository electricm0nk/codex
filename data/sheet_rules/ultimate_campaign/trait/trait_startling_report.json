[{"id":"ultimate_campaign:trait:trait_startling_report","label":"Startling Report","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Through either perfect timing or the determination of your action, the sound of your firearm going off sets your enemies on edge. When you shoot a firearm, you gain a +2 trait bonus on Intimidate checks for 1 round against those who heard the shot."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_campaign:trait:trait_startling_report"},"count":1}},{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"CombatTrait"}},"count":1}}}]}},"print":true,"pool":"special_ability","tags":["Trait","BasicTrait","CombatTrait"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_campaign","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_campaign/uca_abilities_traits.lst:47"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
