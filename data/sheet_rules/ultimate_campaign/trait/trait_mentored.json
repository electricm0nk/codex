[{"id":"ultimate_campaign:trait:trait_mentored","label":"Mentored","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"A tutor or private instructor guided you in learning your art, profession, or trade, and through your education, you became capable of teaching and guiding others. Choose a single Craft, Perform, or Profession skill. You gain a +1 trait bonus on checks with that skill. You also gain a +1 trait bonus when you aid another's skill check with any skill."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_campaign:trait:trait_mentored"},"count":1}},{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"SocialTrait"}},"count":1}}}]}},"target":{"Chosen":"ultimate_campaign:trait:trait_mentored"},"bonus_type":{"name":"Trait","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Trait","BasicTrait","SocialTrait"],"subject":"Character","repeatable":true,"offers":{"id":"ultimate_campaign:trait:trait_mentored","count":{"Const":1},"from":{"Skills":[]}},"provenance":{"book":"ultimate_campaign","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_campaign/uca_abilities_traits.lst:203"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
