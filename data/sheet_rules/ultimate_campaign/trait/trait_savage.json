[{"id":"ultimate_campaign:trait:trait_savage","label":"Savage","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"You were born and raised in untamed lands far from civilization. You learned to survive in the elements among brutal humanoids and beasts. You gain a +1 trait bonus on Knowledge (nature) checks and a +1 trait bonus on Survival checks to get along in the wild. Knowledge (nature) is always a class skill for you."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_campaign:trait:trait_savage"},"count":1}},{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"SocialTrait"}},"count":1}}}]}},"target":{"Skill":"knowledge_nature"},"bonus_type":{"name":"Trait","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Trait","BasicTrait","SocialTrait"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"ClassSkill":"knowledge_nature"}}],"provenance":{"book":"ultimate_campaign","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_campaign/uca_abilities_traits.lst:208"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
