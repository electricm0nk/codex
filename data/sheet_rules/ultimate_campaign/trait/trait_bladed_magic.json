[{"id":"ultimate_campaign:trait:trait_bladed_magic","label":"Bladed Magic","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have an innate talent for using magical weaponry and those weapons capable of becoming magical. You gain a +1 trait bonus on Craft checks made to craft magic or masterwork weapons. In addition, when you use your arcane pool class ability to grant a weapon an enhancement bonus, that bonus lasts for 2 minutes instead of 1."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_campaign:trait:trait_bladed_magic"},"count":1}},{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"MagicTrait"}},"count":1}}}]}},"print":true,"pool":"special_ability","tags":["Trait","BasicTrait","MagicTrait"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_campaign","kind":"trait","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_campaign/uca_abilities_traits.lst:128"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
