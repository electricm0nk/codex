[{"id":"advanced_class_guide:spell:mirror_transport","label":"Mirror Transport","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Mirror becomes a multiple-use dimension door."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions as mirror hideaway, except any creature that enters the target mirror can spend a swift action to exit through another mirror within 500 feet as if using dimension door; this is a one-way transport. The creature can exit through a mirror only if it could fit through an opening the same size as the mirror. Each transport through the target mirror reduces the spell's duration by 1 hour."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mirror becomes a multiple-use dimension door."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) hours [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"yes (object)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes (object)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"one mirror"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Psychic"],"subject":"Character","repeatable":false,"grante