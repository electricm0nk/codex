[{"id":"advanced_class_guide:spell:sundering_shards","label":"Sundering Shards","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Sundered item explodes, dealing 1d6 damage to adjacent creatures."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You channel power into a melee weapon. If the weapon's wielder destroys an item with a successful sunder combat maneuver, she can release the extra power in the weapon, shattering the sundered item into jagged shards that deal 1d6 points of piercing and slashing damage to the creature that was wearing, carrying, or wielding the now-shattered item. Any creature (other than the wielder of the weapon targeted by this spell) adjacent to that creature must succeed at a Reflex saving throw or take 1d6 points of piercing and slashing damage from flying shards. The shards also count as whatever special materials the sundered item was made of (for example, the shards from a shattered cold iron weapon are cold iron). Once the weapon's extra power is unleashed, the spell is discharged."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Sundered item explodes, dealing 1d6 damage to adjacent creatures."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) hours or until discharged"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Reflex negates (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"melee weapon touched"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bloodrager","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":1}},"when":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_feature:haunted_occultist_implement_school_transmutation"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:occultist_implement_school_transmutation"},"count":1}}]}}}],"provenance":{"book":"advanced_class_guide","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:122","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:260","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:1459","pathfinder/paizo/roleplaying_game/occult_adventures/support/oa_spells_acg.lst:47"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
