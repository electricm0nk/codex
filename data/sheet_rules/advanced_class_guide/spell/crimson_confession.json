[{"id":"advanced_class_guide:spell:crimson_confession","label":"Crimson Confession","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Touching the marked object or area turns one's skin red."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You ward an object or an area with your personal rune or mark. You can choose for the writing to be visible or invisible, and it doesn't harm the material upon which it is placed. A detect magic spell causes an invisible mark to glow and be visible. If any creature other than you touches the warded object or area and fails a Fortitude save, its skin turns bright red for 1 hour per level. This coloring cannot be washed away, but it can be dispelled. See invisibility, true seeing, a gem of seeing, or a robe of eyes likewise allows the user to see an invisible mark. A read magic spell reveals the words, if any. The ward cannot be dispelled, but it can be removed by the caster or by an erase spell."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Touching the marked object or area turns one's skin red."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"10 minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"permanent and (CASTERLEVEL) hours [see text]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Abjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"object touched or up to 1 sq. ft."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":2}},"when":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_feature:haunted_occultist_implement_school_abjuration"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:occultist_implement_school_abjuration"},"count":1}}]}}}],"provenance":{"book":"advanced_class_guide","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:43","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:181","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:1503","pathfinder/paizo/roleplaying_game/occult_adventures/support/oa_spells_acg.lst:48"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
