[{"id":"advanced_class_guide:spell:unbearable_brightness","label":"Unbearable Brightness","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your body glows with a terrible light. Creatures within 30 feet of you that can see you are dazzled (no saving throw). Creatures with light sensitivity must succeed at a Reflex saving throw or be blinded. This light counts as daylight for the purpose of affecting darkness effects (and vice versa). If the emanation enters an area under the effect of magical darkness (or vice versa), both effects are temporarily negated so that the otherwise prevailing light conditions exist in the overlapping areas of effect. Dazzled and blinded conditions from your light end when the spell ends or when the creature is out of line of sight."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Your glowing body dazzles or blinds others."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Your glowing body dazzles or blinds others."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Light"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal and 30 ft. [see text]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"none and Reflex partial (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"no and yes (see text)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"30-ft.-radius emanation centered on you"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"alchemist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":4}},"when":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_feature:haunted_occultist_implement_school_evocation"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:occultist_implement_school_evocation"},"count":1}}]}}}],"provenance":{"book":"advanced_class_guide","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:131","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:269","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:1812","pathfinder/paizo/roleplaying_game/occult_adventures/support/oa_spells_acg.lst:59"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
