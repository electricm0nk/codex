[{"id":"advanced_class_guide:spell:mantle_of_calm","label":"Mantle of Calm","value":{"Number":{"Const":-2}},"prose":[{"family":"Desc","pieces":[{"Text":"Neutralize the rage effects of those who have attacked you."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You surround yourself with a mantle of calm serenity. You take a -2 penalty on attack rolls, and opponents gain a +2 bonus on saving throws against spells you cast. Any creature affected by a rage effect (barbarian's rage, bloodrager's bloodrage, blood rage monster ability, rage spell, skald's inspired rage raging song, and so on) that strikes you with a melee attack must attempt at a Will saving throw, without the rage effect's bonus to Will; failure means the rage effect ends (as if it were dispelled or the creature voluntarily ended it, as appropriate). If you become affected by a rage effect while this spell is active, this spell immediately ends. If your rage effect comes from a skald's raging song, then it ends only for you, and you cannot re-accept the effects of the song."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Neutralize the rage effects of those who have attacked you."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Emotion, Mind-Affecting"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"piec