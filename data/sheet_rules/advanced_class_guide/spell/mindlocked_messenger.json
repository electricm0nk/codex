[{"id":"advanced_class_guide:spell:mindlocked_messenger","label":"Mindlocked Messenger","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Target gains a message that can be given only to its intended recipient."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You speak a short message (up to 10 words per caster level), implanting both it and the identity of the message's intended recipient in the mind of a willing creature. The creature is aware of the message and who the recipient is. Any attempt to speak, write, or otherwise communicate the message to anyone other than its intended recipient causes the target to forget the message for 1d6 minutes. Attempts to read the target's mind (such as with detect thoughts) or to force the target to reveal the message (such as with torture or magical compulsion) likewise cause temporary amnesia regarding the message. The target can communicate the message only to someone it believes is the intended recipient, which means that disguises, illusions, and polymorph effects might fool the target into delivering the message. Once the target communicates the message, the message is permanently erased from the target's memory."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Target gains a message that can be given only to its intended recipient."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"10 minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Language-Dependent, Mind-Affecting"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"permanent until discharged [see text]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Enchantment"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Compulsion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"one willing living creature"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bard","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"mesmerist","spell_level":2}},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:82","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:220","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:395","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:1673","pathfinder/paizo/roleplaying_game/occult_ad