[{"id":"advanced_class_guide:spell:heart_of_the_metal","label":"Heart of the Metal","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Enable weapons to overcome DR like adamantine, cold iron, or silver."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You lend the nature of adamantine, cold iron, or silver, depending on component used, to the targeted weapons, with the following effects: Adamantine: The weapons overcome DR/adamantine and ignore hardness less than 20. Cold Iron: The weapons overcome DR/cold iron. Silver: The weapons overcome DR/silver. No other advantages or disadvantages of these metal types apply. For example, a weapon given the nature of adamantine is not automatically masterwork. This is able to affect nonmetal weapons. If you grant the target weapons the property of cold iron, the spell lasts half as long as normal."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Enable weapons to overcome DR like adamantine, cold iron, or silver."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Earth"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes [see text]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"none"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatB