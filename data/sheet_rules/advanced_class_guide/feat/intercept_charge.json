[{"id":"advanced_class_guide:feat:intercept_charge","label":"Intercept Charge","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When an opponent charges your ally with this feat, as an immediate action you can move up to your speed toward any square in the path of the charge. If you end your movement in the path of the charge, the opponent must stop when it becomes adjacent to you and then attack you instead of your ally. Your movement from using this feat counts toward your movement on your next turn."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"feat","tags":["Combat","Teamwork"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_intercept_charge"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_feats.lst:100"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
