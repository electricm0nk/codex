[{"id":"advanced_class_guide:feat:grabbing_drag","label":"Grabbing Drag","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can move easily with a grappled enemy in tow."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When you are using Grabbing Style, if you use the move grapple action, you can move both yourself and a single target that you're grappling your full speed instead of half your speed. After you have done so, you can use a move action to move yourself and the target of your grapple half your speed without needing to attempt an additional combat maneuver check. You cannot use this feat if you are grappling two targets."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:feat:grabbing_style"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_grapple"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":8}}},{"Compare":{"lhs":{"Var":"v0bc76bc9333aeda5"},"op":"Gte","rhs":{"Const":4}}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":4}}},{"Compare":{"lhs":{"ClassLevel":"brawler"},"op":"Gte","rhs":{"Const":4}}}]}}]}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_grabbing_drag"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:master_of_many_styles_grabbing_drag"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_grabbing_drag"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_feats.lst:78"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
