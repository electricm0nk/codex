[{"id":"advanced_class_guide:feat:grasping_strike","label":"Grasping Strike","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"when you use Vital Strike (or Improved Vital Strike or Greater Vital Strike), you cause the foliage in the area to reach out and entangle your foe (as the condition) if it fails a DC "},{"Text":"caster level divided by 2 plus 10 plus Wisdom modifier"},{"Text":" Reflex save. The effect lasts for 1 minute or until the enemy breaks free with a successful Strength check or an Escape Artist check (DC = "},{"Text":"caster level divided by 2 plus 10 plus Wisdom modifier"},{"Text":"), whichever comes first.\n You can use this benefit a "},{"Slot":{"Max":[{"AbilityMod":"Wis"},{"Const":1}]}},{"Text":" times per day. You can choose to use this ability as a free action after you hit the enemy with the attack. This is a supernatural ability."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:vital_strike"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:feat:nature_magic"},"count":1}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"HighestSpellLevel":"Any"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"ClassLevel":"ranger"},"op":"Gte","rhs":{"Const":4}}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"HighestSpellLevel":"Any"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"ClassLevel":"druid"},"op":"Gte","rhs":{"Const":1}}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"HighestSpellLevel":"Any"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"ClassLevel":"hunter"},"op":"Gte","rhs":{"Const":1}}}]}}]}},{"Compare":{"lhs":{"SkillRanks":"knowledge_nature"},"op":"Gte","rhs":{"Const":5}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_grasping_strike"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"