[{"id":"advanced_class_guide:class_feature:warpriest_archetype_divine_commander","label":"Divine Commander","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some warpriests are called to lead great armies and face legions of foes. These divine commanders live for war and fight for glory. Their hearts quicken at battle cries, and they charge forth with their deity's symbol held high. These leaders of armies do so to promote the agenda of their faith, and lead armies of devoted followers willing to give their lives for the cause. (Several of the divine commander's abilities reference and interact with the mass combat rules in Pathfinder RPG Ultimate Campaign.)"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"warpriest"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:warpriest_archetype_divine_commander"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CF_WarpriestBlessings"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"WarpriestBlessings"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"WarpriestBonusFeat3"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"WarpriestBonusFeat6"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"WarpriestBonusFeat12"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"WarpriestBonusFeat15"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:warpriest_archetype_divine_commander"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:warpriest_archetype_divine_commander"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:warpriest_archetype_forgepriest"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:c