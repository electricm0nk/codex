[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_marid_coldsnap","label":"Marid Coldsnap","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can summon a torrent of water to blast your enemies, chilling them to the bone."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"While using Marid Style, as a standard action, you can spend two Elemental Fist (Advanced Player's Guide 158) attempts to unleash a 30-foot line of frigid water. Creatures caught in the line take your unarmed strike damage plus the cold damage from your Elemental Fist attack and are entangled in ice as per the Marid Spirit feat. A successful Reflex save (DC 10 + 1/2 your character level + your Wis modifier) reduces the damage by half and prevents a target from becoming entangled."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:feat:elemental_fist"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:marid_spirit"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:marid_style"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"Var":"v0bc76bc9333aeda5"},"op":"Gte","rhs":{"Const":11}}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"AbilityScore":"Con"},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":17}}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4483"],"oracle_pin":"7f818006e371188e5717fd