[{"id":"advanced_class_guide:class_feature:speaker_for_the_past_time_mystery_aging_touch","label":"Aging Touch","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your touch ages living creatures and objects. As a melee touch attack, you can deal "},{"Slot":{"Var":"vf4b69ef4cbe8b9d1"}},{"Text":" points of Strength damage to living creatures. Against objects or constructs, you can deal "},{"Slot":{"Var":"v647df4c535909bed"}},{"Text":"d6 points of damage. If used against an object in another creature's possession, treat this attack as a sunder combat maneuver. You can use this ability "},{"Slot":{"Var":"va8b7ceeba6d52d8c"}},{"Text":"/day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["speaker for the past revelation","SpecialAttack","Supernatural","TimeRevelation","RevelationTargetOneOnly"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:3629"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
