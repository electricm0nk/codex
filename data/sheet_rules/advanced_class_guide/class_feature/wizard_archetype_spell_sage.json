[{"id":"advanced_class_guide:class_feature:wizard_archetype_spell_sage","label":"Spell Sage","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A spell sage has mastered spells of all types, and is able to increase the effectiveness of his own spells and eventually even cast spells from other classes' spell lists. While most wizards focus on a school, the spell sage looks at the particular aspects of individual spells and is not afraid to modify them with interesting bits of insight to gain deeper understandings of the formulae."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spell_sage"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_exploiter_wizard"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_exploiter_wizard"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spell_sage"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spell_sage"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:wizard_archetype_cruoromancer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:wizard_archetype_spellbinder"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:wizard_archetype_wind_listener"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:wizard_archetype_runesage"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:class_feature:wizard_archetype_el