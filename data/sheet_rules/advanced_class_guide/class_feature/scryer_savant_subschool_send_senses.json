[{"id":"advanced_class_guide:class_feature:scryer_savant_subschool_send_senses","label":"Send Senses","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you place a scrying sensor at a point within "},{"Slot":{"Sum":[{"Const":100},{"Mul":[{"Var":"v6c9d4ef138dbc3e5"},{"Const":10}]}]}},{"Text":" feet that you can see and have line of effect to. You can see or hear (not both) through this sensor "},{"Slot":{"Max":[{"Div":[{"Var":"v6c9d4ef138dbc3e5"},{"Const":2}]},{"Const":1}]}},{"Text":" rounds. The sensor otherwise functions as a clairaudience/clairvoyance spell with a caster level equal to your arcanist level. You can use this ability "},{"Slot":{"Sum":[{"AbilityMod":"Int"},{"Const":3}]}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ArcanistClassFeatures","SpecialQuality","SpellLike","ArcanistSavantSchoolPower","ArcanistExploit3"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:scryer_savant_subschool"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2604"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
