[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_kick_up","label":"Kick Up","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As long as you have at least one hand free, you can use a swift action to retrieve a single unattended item or weapon that weighs 10 pounds or less from the ground, either in your square or in any adjacent square not occupied or threatened by an enemy. Additionally, when you kick up a weapon and attempt a feint before the end of your turn, you receive a +2 circumstance bonus on the feint attempt."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:acrobatic"},"count":1}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"ClassLevel":"slayer"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"ClassLevel":"swashbuckler"},"op":"Gte","rhs":{"Const":1}}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"SkillRanks":"acrobatics"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4169"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
