[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_hero_s_display","label":"Hero's Display","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"With a dramatic flourish you display your weapons to the crowd. Onlookers are elated, and your enemies are demoralized."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"When you spend a swift action to make a performance combat check, you present the weapon in which you have Weapon Focus in a triumphant display. You gain a +2 bonus on the performance combat check and make an Intimidate check to demoralize all foes within 30 feet who can see your display."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:dazzling_display"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:weapon_focus"},"count":1}}]}},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat","Performance"],"subject":"Character","repeatable":true,"offers":{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_hero_s_display","count":{"Const":1},"from":{"Weapons":["ABILITY FEAT[Weapon Focus]"]}},"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4460"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
