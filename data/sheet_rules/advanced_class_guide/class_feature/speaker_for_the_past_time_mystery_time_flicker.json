[{"id":"advanced_class_guide:class_feature:speaker_for_the_past_time_mystery_time_flicker","label":"Time Flicker","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you can flicker in and out of time, gaining concealment (as the blur spell). You can use this ability for "},{"Slot":{"Var":"v7cfe4caf3d43f3a6"}},{"Text":" minutes per day. This duration does not need to be consecutive, but it must be spent in 1-minute increments."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Each time you activate this ability, you can treat it as the blink spell, though each round spent this way counts as 1 minute of your normal time flicker duration."}],"applies":{"Compare":{"lhs":{"ClassLevel":"shaman"},"op":"Gte","rhs":{"Const":7}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"ClassLevel":"shaman"},"op":"Gte","rhs":{"Const":3}}},"print":true,"pool":"special_ability","tags":["speaker for the past revelation","SpecialQuality","Supernatural","TimeRevelation"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:3636"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
