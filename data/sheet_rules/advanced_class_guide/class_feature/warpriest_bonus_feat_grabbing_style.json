[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_grabbing_style","label":"Grabbing Style","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are adept at the one-handed grab."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"When you use this style, you do not take a -4 penalty on combat maneuver checks to grapple a foe with only one hand. Additionally, you do not lose your Dexterity bonus to AC while pinning an opponent.\n Normal: Without two hands free, you take a -4 penalty on the combat maneuver roll to grapple a foe. While pinning a foe, you lose your Dexterity bonus to AC."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_grapple"},"count":1}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":6}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":6}}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:brawler_brawler_s_flurry"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:class_feature:monk_flurry_of_blows"},"count":1}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat","Style"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4158"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
