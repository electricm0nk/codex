[{"id":"advanced_class_guide:class_feature:cult_leader_class_skills","label":"Class Skills","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"The cult leader's class skills are Acrobatics (Dex), Bluff (Cha), Climb (Str), Craft (Int), Diplomacy (Cha), Disguise (Cha), Escape Artist (Dex), Heal (Wis), Intimidate (Cha), Knowledge (local) (Int), Knowledge (religion) (Int), Perception (Wis), Profession (Wis), Sense Motive (Wis), Sleight of Hand (Dex), Spellcraft (Int), and Stealth (Dex). These skills replace the warpriest's class skills. Skill Ranks per Level: 4 + Int modifier."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Other":"skill points"},"print":true,"pool":"special_ability","tags":["Cult Leader Class Feature","Warpriest Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"ClassSkill":"acrobatics"}},{"FactGrant":{"ClassSkill":"bluff"}},{"FactGrant":{"ClassSkill":"climb"}},{"FactGrant":{"ClassSkillGroup":"Craft"}},{"FactGrant":{"ClassSkill":"diplomacy"}},{"FactGrant":{"ClassSkill":"disguise"}},{"FactGrant":{"ClassSkill":"escape_artist"}},{"FactGrant":{"ClassSkill":"heal"}},{"FactGrant":{"ClassSkill":"intimidate"}},{"FactGrant":{"ClassSkill":"knowledge_local"}},{"FactGrant":{"ClassSkill":"knowledge_religion"}},{"FactGrant":{"ClassSkill":"perception"}},{"FactGrant":{"ClassSkillGroup":"Profession"}},{"FactGrant":{"ClassSkill":"sense_motive"}},{"FactGrant":{"ClassSkill":"sleight_of_hand"}},{"FactGrant":{"ClassSkill":"spellcraft"}},{"FactGrant":{"ClassSkill":"stealth"}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:3950"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
