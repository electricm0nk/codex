[{"id":"advanced_class_guide:class_feature:cult_leader_weapon_and_armor_proficiency","label":"Weapon and Armor Proficiency","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Cult leaders are proficient with all simple weapons, plus the hand crossbow, rapier, sap, shortbow, and short sword, as well as the favored weapon of their deity. They are proficient with light armor and light shields. The cult leader does not gain Weapon Focus as a bonus feat as a warpriest normally would. This replaces the warpriest's weapon and armor proficiencies."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Cult Leader Class Feature","Warpriest Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"Proficiency":{"ShieldGroup":"Light"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Hand)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Rapier"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sap"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shortbow"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sword (Short)"}}},{"FactGrant":{"Proficiency":"DeityFavoredWeapon"}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:3951"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
