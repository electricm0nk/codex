[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_djinni_spin","label":"Djinni Spin","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can surround yourself with the power of the storm, spinning like a hurricane to unleash a violent blast of electrical energy."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"While using Djinni Style, as a standard action you can spend two Elemental Fist (Advanced Player's Guide 158) attempts to surround yourself with a whirlwind of electrified air. Creatures adjacent to you take your unarmed strike damage plus the electricity damage from your Elemental Fist and are deafened for 1d4 rounds. A successful Fortitude save (DC 10 + 1/2 your character level + your Wis modifier) reduces the damage by half and prevents a target from being deafened."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:feat:djinni_style"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:djinni_spirit"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:feat:elemental_fist"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"Var":"v0bc76bc9333aeda5"},"op":"Gte","rhs":{"Const":11}}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"AbilityScore":"Con"},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":17}}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4428"],"orac