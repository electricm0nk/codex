[{"id":"advanced_class_guide:class_feature:warpriest_weapon_and_armor_proficiency","label":"Weapon and Armor Proficiency","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"A warpriest is proficient with all simple and martial weapons, as well as the favored weapon of his deity, and with all armor (heavy, light, and medium) and shields (except tower shields). If the warpriest worships a deity with unarmed strike as its favored weapon, the warpriest gains Improved Unarmed Strike as a bonus feat."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"warpriest_unarmed_strike"},"print":true,"pool":"special_ability","tags":["Warpriest Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Class":{"id":"ex_warpriest","at_level":1}},"when":{"Compare":{"lhs":{"ClassLevel":"ex_warpriest"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"Proficiency":"DeityFavoredWeapon"}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2138"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
