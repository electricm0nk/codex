[{"id":"advanced_class_guide:class_feature:undead_savant_subschool_bolster","label":"Bolster","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, you can touch an undead creature and infuse it with negative energy. It gains a +"},{"Slot":{"Sum":[{"Div":[{"Var":"v6c9d4ef138dbc3e5"},{"Const":5}]},{"Const":1}]}},{"Text":" profane bonus on all attack rolls and saving throws, as well as 1 temporary hit point per Hit Die and a +2 bonus to its turn resistance. These bonuses last for "},{"Slot":{"Max":[{"Div":[{"Var":"v6c9d4ef138dbc3e5"},{"Const":2}]},{"Const":1}]}},{"Text":" rounds. The bonuses and temporary hit points are immediately dispelled if the creature is within the area of a consecrate spell. You can use this ability "},{"Slot":{"Sum":[{"AbilityMod":"Int"},{"Const":3}]}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ArcanistClassFeatures","SpecialQuality","SpellLike","ArcanistSavantSchoolPower","ArcanistExploit3"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:undead_savant_subschool"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2609"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
