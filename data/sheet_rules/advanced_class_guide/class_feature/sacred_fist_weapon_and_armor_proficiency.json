[{"id":"advanced_class_guide:class_feature:sacred_fist_weapon_and_armor_proficiency","label":"Weapon and Armor Proficiency","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Sacred fists are proficient with the club, crossbow (light or heavy), dagger, handaxe, javelin, kama, nunchaku, quarterstaff, sai, shortspear, short sword, shuriken, siangham, sling, and spear. Sacred fists are not proficient with any armor or shields. When wearing armor, using shield, or carrying a medium or heavy load, a sacred fist loses his AC bonus and flurry of blows."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Sacred Fist Class Feature","Warpriest Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"Proficiency":{"Weapon":"Club"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Light)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Heavy)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Dagger"}}},{"FactGrant":{"Proficiency":{"Weapon":"Handaxe"}}},{"FactGrant":{"Proficiency":{"Weapon":"Javelin"}}},{"FactGrant":{"Proficiency":{"Weapon":"Kama"}}},{"FactGrant":{"Proficiency":{"Weapon":"Nunchaku"}}},{"FactGrant":{"Proficiency":{"Weapon":"Quarterstaff"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sai"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shortspear"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sword (Short)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shuriken"}}},{"FactGrant":{"Proficiency":{"Weapon":"Siangham"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sling"}}},{"FactGrant":{"Proficiency":{"Weapon":"Spear"}}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4004"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
