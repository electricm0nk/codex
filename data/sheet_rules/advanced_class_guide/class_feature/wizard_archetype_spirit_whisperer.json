[{"id":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer","label":"Spirit Whisperer","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Spirit whisperers are a breed apart among wizards, and are often mistaken for witches. While spirit whisperers do gain and store their spells by communing with familiars, the spirits they gain guidance from are somewhat closer to the world and more direct than the powers with which witches typically traffic. These wizards treat such spirits as mentors and friends, conversing with them rather than appeasing them in the effort to gain and use arcane knowledge."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:class_feature:wizard_archetype_elder_mythos_scholar"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_exploiter_wizard"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_exploiter_wizard"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spell_sage"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spell_sage"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:wizard_archetype_spirit_whisperer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_gu