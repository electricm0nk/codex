[{"id":"advanced_class_guide:class_feature:spirit_warden_unnatural_mien","label":"Unnatural Mien","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The spirit warden's dealings with the spirit world give her an unsettling demeanor. Diplomacy and Handle Animal are not class skills for a spirit warden. Intimidate is added as a class skill, and she gains a +2 bonus on Intimidate checks to demoralize a foe."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Spirit Warden Class Feature","Shaman Class Feature","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"ClassSkill":"clear_handle_animal"}},{"FactGrant":{"ClassSkill":"clear_diplomacy"}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:3643"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
