[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_shaitan_earthblast","label":"Shaitan Earthblast","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"With a forceful stomp you release a blast of acid from the earth to burn your enemies."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"While using the Shaitan Style feat, as a standard action, you can spend two Elemental Fist (Advanced Player's Guide 158) attempts to unleash a 20-foot column of acid that has a 5-foot radius and erupts from a point of origin within 30 feet of you. Creatures caught in the column take your unarmed strike damage plus the acid damage from your Elemental Fist and are staggered for 1 round. A successful Reflex save (DC 10 + 1/2 your character level + your Wis modifier) reduces the damage by half and prevents a target from being staggered."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":3,"of":[{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"AbilityScore":"Con"},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":17}}}]}},{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:feat:elemental_fist"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:shaitan_skin"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:shaitan_style"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"Var":"v0bc76bc9333aeda5"},"op":"Gte","rhs":{"Const":11}}}]}}]}},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/adva