[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_improvised_weapon_mastery","label":"Improvised Weapon Mastery","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can turn nearly any object into a deadly weapon, from a razor sharp chair leg to a sack of flour."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You do not suffer any penalties for using an improvised weapon. Increase the amount of damage dealt by the improvised weapon by one step (for example, 1d4 becomes 1d6) to a maximum of 1d8 (2d6 if the improvised weapon is two-handed). The improvised weapon has a critical threat range of 19-20, with a critical multiplier of W2."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:catch_off_guard"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:throw_anything"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":8}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":8}}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4257"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
