[{"id":"advanced_class_guide:class_feature:swashbuckler_perfect_thrust","label":"Perfect Thrust","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"At 15th level, while the swashbuckler has at least 1 panache point, she can as a full-round action make a perfect thrust, pooling all of her attack potential into a single melee attack made with a light or one-handed piercing melee weapon. When she does, she makes the attack against the target's touch AC, and ignores all damage reduction."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"Var":"va46d63ef4db7dce1"},"op":"Gte","rhs":{"Const":15}}},"print":true,"pool":"special_ability","tags":["SpecialQuality","Swashbuckler Deed","SwashbucklerDeedsLVL15","Extraordinary","AttackOption"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:swashbuckler_deeds"},"when":{"All":[{"Compare":{"lhs":{"Var":"ve673a172b99d2a8f"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"ved91883b4d74e9ed"},"op":"Gte","rhs":{"Const":15}}}]}},{"by":{"Rule":"advanced_class_guide:class_feature:swashbuckler_deeds"},"when":{"All":[{"Compare":{"lhs":{"Var":"ve673a172b99d2a8f"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"ved91883b4d74e9ed"},"op":"Gte","rhs":{"Const":15}}}]}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2092"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
