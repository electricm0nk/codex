[{"id":"advanced_class_guide:class_feature:swashbuckler_swashbuckler_initiative","label":"Swashbuckler Initiative","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"At 3rd level, as long as the swashbuckler has at least 1 panache point, she gains the following benefits. First, she gains a +2 bonus on initiative checks. Furthermore, if she has the Quick Draw feat, her hands are free and unrestrained, and she has any light or one-handed piercing weapon that is not hidden, she can draw that weapon as part of the initiative check."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"+2 bonus on initiative checks if you have 1+ panache points."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"va46d63ef4db7dce1"},"op":"Gte","rhs":{"Const":3}}},{"Situational":{"text":"when active"}}]},"target":"Initiative","print":true,"pool":"special_ability","tags":["SpecialQuality","Swashbuckler Deed","SwashbucklerDeedsLVL3","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:daring_champion_panache_and_deeds"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:swashbuckler_deeds"},"when":{"All":[{"Compare":{"lhs":{"Var":"v8daf81ade232f3bb"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"ved91883b4d74e9ed"},"op":"Gte","rhs":{"Const":3}}}]}},{"by":{"Rule":"advanced_class_guide:class_feature:swashbuckler_deeds"},"when":{"All":[{"Compare":{"lhs":{"Var":"v8daf81ade232f3bb"},"op":"Eq","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"ved91883b4d74e9ed"},"op":"Gte","rhs":{"Const":3}}}]}}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2075"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
