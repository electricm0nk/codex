[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feats","label":"Bonus Feats","value":{"Number":{"Div":[{"Var":"vbb6dd41666d88c6d"},{"Const":3}]}},"prose":[{"family":"Desc","pieces":[{"Text":"At 3rd level and every 3 levels thereafter, a warpriest gains a bonus feat in addition to those gained from normal advancement. These bonus feats must be selected from those listed as combat feats. The warpriest must meet the prerequisites for these feats, but he treats his warpriest level as his base attack bonus (in addition to base attack bonuses gained from other classes and Hit Dice) for the purpose of qualifying for these feats. Finally, for the purposes of these feats, the warpriest can select feats that have a minimum number of fighter levels as a prerequisite, treating his warpriest level as his fighter level."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"warpriest_bonus_feat"},"print":true,"pool":"special_ability","tags":["Warpriest Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2155","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2171","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2172","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2173","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2174","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2175","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2176","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_race.lst:288"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"advanced_class_guide:class_feature:warpries