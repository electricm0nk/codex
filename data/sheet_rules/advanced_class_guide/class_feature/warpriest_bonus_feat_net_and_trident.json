[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_net_and_trident","label":"Net and Trident","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your skill with lighter weapons allows you to wield one alongside your net."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You can treat a net as a one-handed ranged weapon, allowing you to wield a light or one-handed melee weapon and still make ranged attacks with your net. When you use your light or one-handed melee weapon to attack an entangled opponent, you gain a +2 bonus on damage rolls and on attack rolls to confirm a critical hit. \n [Normal] A net is a two-handed ranged weapon."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:feat:net_adept"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:two_weapon_fighting"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":13}}}]}},{"Holds":{"what":{"Proficiency":{"Weapon":"Net"}},"count":1}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4499"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
