[{"id":"advanced_class_guide:class_feature:summoner_archetype_spirit_summoner","label":"Spirit Summoner","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A spirit summoner is an arcane spellcaster whose eidolon is a manifestation of a shamanic spirit. The bond connecting the summoner and this spirit might be friendly, as a member of a tribe giving flesh to his protector spirit, or hostile, as an outlander or rival compelling service from an unwilling spirit. The summoner can draw upon the divine power of this spirit, but is not constrained by the spirit's morals or ethics."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"summoner"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_spirit_summoner"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerAspect"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerMakersCall"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerMergeForms"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerTransposition"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerEidolon"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerSummonMonster"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_spirit_summoner"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_naturalist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_spirit_summoner"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:summoner_archetype_shaitan_binder"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue: