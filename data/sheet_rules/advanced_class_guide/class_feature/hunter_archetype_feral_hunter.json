[{"id":"advanced_class_guide:class_feature:hunter_archetype_feral_hunter","label":"Feral Hunter","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A feral hunter has forged a bond with nature that's so strong that she doesn't merely channel the aspects of animals-she actually becomes an animal herself. Though she lacks an animal companion, a feral hunter is in tune with the beast lurking within her flesh and spirit, and lives in a near-wild state of being. A feral hunter often resembles a lycanthrope, but her power comes from her own nature and is not influenced by moonlight or silver."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"hunter"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:hunter_archetype_feral_hunter"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterAnimalCompanion"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterAnimalFocus"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterHunterTactics"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterSpeakWithMaster"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterPreciseCompanion"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterBonusTricks"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterImprovedEmpatheticLink"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterGreaterEmpatheticLink"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterMasterOfTheWild"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterRaiseAnimalCompanion"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterTeamworkFeat6"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterTeamworkFeat