[{"id":"advanced_class_guide:class_feature:shaman_spirit_hex_stormwalker","label":"Stormwalker","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The shaman can move through nonmagical fog, rain, mist, snow, and other environmental effects without penalty. She is never slowed by such effects, and she doesn't need to attempt Acrobatics skill checks to move across such surfaces. She can also move through magical environmental effects that she created."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The shaman can see twice as far as normal through environmental effects, whether or not they are magical in nature."}],"applies":{"Compare":{"lhs":{"Var":"vacb5a847c03975e0"},"op":"Gte","rhs":{"Const":10}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Not":{"Holds":{"what":{"MissingRule":{"pool":"special_ability","name":"Witch Hex ~ Stormwalker"}},"count":1}}},{"Compare":{"lhs":{"Var":"v9b748cdb96a7da42"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["ShamanSpiritHex","ShamanNatureHex","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:shaman_wandering_hex_stormwalker"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:1635"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
