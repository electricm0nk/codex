[{"id":"advanced_class_guide:class_feature:monk_archetype_kata_master","label":"Kata Master","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The kata master takes the visual aspect of his martial art to its logical extreme, harnessing her flowing movements and skilled maneuvers as a psychological weapon against her enemies. A kata master forsakes the mental discipline of her more contemplative brethren in favor of these flamboyant exhibitions. She often performs in staged fights and tournaments, utilizing stylized forms to amaze the audience and shock and dismay her opponents."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:monk_archetype_kata_master"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkStunningFist"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkStillMind"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkWholenessOfBody"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkQuiveringPalm"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MonkKiPool"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:monk_archetype_kata_master"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:monk_archetype_kata_master"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_hungry_ghost_monk"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_four_winds"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:monk_archetype_monk_of_the_lotus"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide: