[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_greater_dirty_trick","label":"Greater Dirty Trick","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When you pull a dirty trick, your foe is truly hindered."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You receive a +2 bonus on checks made to attempt a dirty trick. This bonus stacks with the bonus granted by Improved Dirty Trick. Whenever you successfully perform a dirty trick, the penalty lasts for 1d4 rounds, plus 1 round for every 5 by which your attack exceeds the target's CMD. In addition, removing the condition requires the target to spend a standard action."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:combat_expertise"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:feat:improved_dirty_trick"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Int"},{"Var":"vfa21bca192d79cd9"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"v6d18c49ca392b75f"},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"v65e464f2144fbfe1"},"op":"Gte","rhs":{"Const":1}}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":6}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":6}}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4337"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
