[{"id":"advanced_class_guide:class_feature:swashbuckler_deeds","label":"Deeds","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Swashbucklers spend panache points to accomplish deeds. Most deeds grant the swashbuckler a momentary bonus or effect, but some provide longer-lasting effects. Some deeds remain in effect while the swashbuckler has at least 1 panache point, but do not require expending panache to be maintained. A swashbuckler can only perform deeds of her level or lower. Unless otherwise noted, a deed can be performed multiple successive times, as long as the swashbuckler has or spends the required number of panache points to perform the deed."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Swashbuckler Class Feature","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:1956","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2106","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2107","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2108","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2109","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2110","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2111","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2112","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2113","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2114","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2115","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2116","pathf