[{"id":"advanced_class_guide:class_feature:manipulator_savant_subschool_beguiling_touch","label":"Beguiling Touch","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can charm a living creature by touching it. Creatures with more than "},{"Slot":{"Var":"v6c9d4ef138dbc3e5"}},{"Text":" Hit Dice are unaffected, as are creatures in combat and those with an attitude of hostile toward you. Creatures receive a Will save DC "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"Var":"v6c9d4ef138dbc3e5"},{"Const":2}]},{"AbilityMod":"Int"}]}},{"Text":" to negate the effect. Creatures that fail their save are affected by charm monster for "},{"Slot":{"Max":[{"Div":[{"Var":"v6c9d4ef138dbc3e5"},{"Const":2}]},{"Const":1}]}},{"Text":" rounds. This is a mind-affecting effect. You can use this ability a "},{"Slot":{"Sum":[{"AbilityMod":"Int"},{"Const":3}]}},{"Text":" per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ArcanistClassFeatures","SpecialQuality","SpellLike","ArcanistSavantSchoolPower","ArcanistExploit3"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:manipulator_savant_subschool"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2600"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
