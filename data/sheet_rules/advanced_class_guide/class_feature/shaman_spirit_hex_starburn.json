[{"id":"advanced_class_guide:class_feature:shaman_spirit_hex_starburn","label":"Starburn","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a standard action, the shaman causes one creature within 30 feet to burn like a star. The creature takes "},{"Slot":{"Div":[{"Var":"vacb5a847c03975e0"},{"Const":2}]}},{"Text":"d6 points of fire damage and emits bright light for 1 round. A successful Fortitude saving throw (DC "},{"Slot":{"Var":"vdff512149a56858d"}},{"Text":") halves the damage and negates the emission of bright light. The shaman can use this hex "},{"Slot":{"Max":[{"Const":1},{"AbilityMod":"Cha"}]}},{"Text":"/day, but must wait 1d4 rounds between uses."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Not":{"Holds":{"what":{"MissingRule":{"pool":"special_ability","name":"Witch Hex ~ Starburn"}},"count":1}}},{"Compare":{"lhs":{"Var":"v0345fd0af7b34cf1"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["ShamanSpiritHex","ShamanHeavensHex","SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:shaman_wandering_hex_starburn"},"when":"Always"}],"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:1571"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
