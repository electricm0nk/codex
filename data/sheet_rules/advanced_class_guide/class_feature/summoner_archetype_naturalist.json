[{"id":"advanced_class_guide:class_feature:summoner_archetype_naturalist","label":"Naturalist","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A naturalist is a summoner who is in tune with the natural world, using his magic like a lens to focus various animal aspects onto his eidolon. More akin to a hunter than to other arcane spellcasters, a naturalist instinctively masters the power of such creatures as the bear, wolf, mouse, or tiger to make his exotic eidolon the perfect living tool for battle or stealth, and he eventually discovers how to apply these transformations to himself as well."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"summoner"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_naturalist"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerSummonMonsterI"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerShieldAlly"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerGreaterShieldAlly"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerAspect"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerLifeBond"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SummonerGreaterAspect"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_naturalist"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_naturalist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:summoner_archetype_spirit_summoner"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:summoner_archetype_blood_god_disciple"},"count":1}},{"Holds":{"what":{"Rul