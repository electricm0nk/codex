[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_deadly_stroke","label":"Deadly Stroke","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"With a well-placed strike, you can bring a swift and painful end to most foes."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"As a standard action, make a single attack with the weapon for which you have Greater Weapon Focus against a stunned or flat-footed opponent. If you hit, you deal double the normal damage and the target takes 1 point of Constitution bleed (see Appendix 2). The additional damage and bleed is not multiplied on a critical hit."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:dazzling_display"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:greater_weapon_focus"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:shatter_defenses"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:weapon_focus"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":11}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":11}}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4218"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
