[{"id":"advanced_class_guide:class_feature:warpriest_bonus_feat_tiger_pounce","label":"Tiger Pounce","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your unarmed strikes are as precise as they are powerful, but they leave you open and you can pursue foes with blinding speed."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"While using the Tiger Style feat, you can apply the penalty from Power Attack to your AC instead of attack rolls. Additionally, once per round as a swift action, you can move up to half your speed closer to a target you hit with an unarmed strike or made a successful combat maneuver against on this turn or your last turn."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:power_attack"},"count":1}},{"Holds":{"what":{"MissingRule":{"pool":"feat","name":"Tiger Style"}},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:feat:tiger_claws"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":9}}},{"Compare":{"lhs":{"Var":"va441b2fe80a15876"},"op":"Gte","rhs":{"Const":9}}}]}},{"Compare":{"lhs":{"Var":"v0bc76bc9333aeda5"},"op":"Gte","rhs":{"Const":8}}}]}}]},"print":true,"pool":"special_ability","tags":["Warpriest Bonus Feat"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:4566"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
