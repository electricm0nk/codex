[{"id":"advanced_class_guide:class_feature:underground_chemist_discovery_dilution","label":"Dilution","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Once per day, the underground chemist can dilute any one potion or elixir, creating two doses of the same potion from one. Diluting a potion costs a number of gp equal to one-quarter of the potion's market value. A potion that has been diluted cannot be diluted again.This discovery cannot be used to dilute extracts or mutagens."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:rogue_archetype_underground_chemist"},"count":1}},{"Compare":{"lhs":{"Var":"v71b5ff57577f62e8"},"op":"Gte","rhs":{"Const":12}}}]},"print":true,"pool":"special_ability","tags":["SpecialQuality","RogueTalent"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:3572"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
