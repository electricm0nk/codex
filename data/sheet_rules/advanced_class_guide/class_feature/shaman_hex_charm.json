[{"id":"advanced_class_guide:class_feature:shaman_hex_charm","label":"Charm","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A shaman charms an animal or humanoid creature within 30 feet by beckoning and speaking soothing words. This improves the attitude of an animal or humanoid creature by"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"1 step,"}],"applies":{"Compare":{"lhs":{"Var":"vccdb325948cc87c1"},"op":"Lt","rhs":{"Const":8}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"2 steps,"}],"applies":{"Compare":{"lhs":{"Var":"vccdb325948cc87c1"},"op":"Gte","rhs":{"Const":8}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"as if the shaman had successfully used the Diplomacy skill. The effect lasts for "},{"Slot":{"Var":"vbdf6c566de4a5fc0"}},{"Text":" rounds. A successful Will saving throw (DC "},{"Slot":{"Var":"vdff512149a56858d"}},{"Text":") negates this effect. Whether or not the save is successful, the creature cannot be the target of this hex again for 24 hours. This is a mind-affecting charm effect."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:witch_hex_charm"},"count":1}}},"print":true,"pool":"special_ability","tags":["ShamanHex","SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:1429"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
