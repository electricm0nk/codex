[{"id":"advanced_class_guide:class_feature:greenrager_summoning_rager","label":"Summoning Rager","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"A greenrager's magic unlocks the secrets of summoning allies from nature. He adds summon nature's ally I to his list of 1st-level bloodrager spells known as a bonus spell, as if it were a bonus bloodrager spell. At 7th level, he adds summon nature's ally II as a bonus 2nd-level bloodrager spell, at 10th level he adds summon nature's ally III as a bonus 3rd level bloodrager spell, and at 13th level he adds summon nature's ally IV as a bonus 4th-level bloodrager spell."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":{"Var":"vca4e20e30e4444b8"},"op":"Gte","rhs":{"Const":6}}},"target":{"SpellsKnown":{"class":"bloodrager","level":1}},"print":true,"pool":"special_ability","tags":["Greenrager Class Feature","Bloodrager Class Feature","SpecialQuality","SpellLike","BloodragerBloodlineFeat6"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2767"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"advanced_class_guide:class_feature:greenrager_summoning_rager#bonus1","label":"Summoning Rager (level 2 spells known)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"vca4e20e30e4444b8"},"op":"Gte","rhs":{"Const":7}}},"target":{"SpellsKnown":{"class":"bloodrager","level":2}},"print":true,"pool":"special_ability","tags":["Greenrager Class Feature","Bloodrager Class Feature","SpecialQuality","SpellLike","BloodragerBloodlineFeat6"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:2767"],"oracle_pin"