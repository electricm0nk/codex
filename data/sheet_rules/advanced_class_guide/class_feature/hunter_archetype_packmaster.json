[{"id":"advanced_class_guide:class_feature:hunter_archetype_packmaster","label":"Packmaster","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some hunters form bonds with packs of well-trained creatures. Whether such a hunter is a northern berserker running with a pack of timber wolves or a savage warrior dashing through the jungle alongside her herd of dimetrodons, the packmaster revels in the thrill of the hunt and the glory of the kill. A packmaster is more comfortable in groups than alone, and although her animal companions may be weaker than a typical hunter's, what they lack in strength they make up for in numbers."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"hunter"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:hunter_archetype_packmaster"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterAnimalCompanion"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterAnimalFocus"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterTeamworkFeats"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterSecondAnimalFocus"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"HunterMasterHunter"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:hunter_archetype_packmaster"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:hunter_archetype_feral_hunter"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:hunter_archetype_packmaster"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:hunter_archetype_verminous_hunter"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:hunter_archetype_totem_bonded"},"count":