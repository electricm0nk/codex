[{"id":"advanced_class_guide:class_feature:sorcerer_archetype_mongrel_mage","label":"Mongrel Mage","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A mongrel mage is a sorcerer whose bloodline is so weak, or mixed with so many others, that her power isn't clearly associated with any bloodline source. A mongrel mage's bloodline powers can change on a daily basis, but always fall short of those of a full-blooded sorcerer's powers. A mongrel mage is a dabbler in all bloodlines but a master of none, and she is looked down upon by true sorcerers."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_mongrel_mage"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"SorcererBloodlineFeats"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CF_SorcererBloodline"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CF_SorcererBloodlinePowers"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"CF_SorcererBloodlineSpells"}},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_mongrel_mage"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_eldritch_scrapper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_eldritch_scrapper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_eldritch_scrapper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_eldritch_scrapper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:sorcerer_archetype_mongrel_mage"},"count":1}},{"Hold