[{"id":"advanced_class_guide:class_feature:fey_bloodrager_bloodline_fury_of_the_fey","label":"Fury of the Fey","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When you enter a bloodrage, you can choose one type of creature (and subtype for humanoid and outsider) that can be affected by the bane magic weapon special ability. You may not choose animals, fey, magical beasts, or plants. All of your melee attacks are considered to have that bane ability of that type. This ability doesn't stack with other forms of the bane ability."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:bloodrager_bloodline_fey"},"count":1}},{"Compare":{"lhs":{"Var":"v2bf0053f5bf2e9ab"},"op":"Gte","rhs":{"Const":20}}}]},"print":true,"pool":"special_ability","tags":["Class Feature","Bloodrager Class Feature","Fey Bloodrager Bloodline ~ Power LVL 20","Bloodrager Bloodline Power","SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_class_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_abilities_class.lst:830"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
