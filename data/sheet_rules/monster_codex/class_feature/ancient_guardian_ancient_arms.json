[{"id":"monster_codex:class_feature:ancient_guardian_ancient_arms","label":"Ancient Arms","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"An ancient guardian can't wield weapons made primarily of metal. She is proficient with only the club, dart, quarterstaff, shortspear, sling, and spear. She is also proficient with all natural attacks (claw, bite, and so forth) of any form she assumes with wild shape. Using a prohibited weapon renders her unable to cast druid spells or use any of her druid supernatural or spell-like class abilities while wielding the weapon and for 24 hours after ceasing to wield it."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Druid Class Features","AncientGuardianClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"monster_codex:class_feature:druid_archetype_ancient_guardian"},"when":{"Compare":{"lhs":{"ClassLevel":"druid"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"Proficiency":{"Weapon":"Club"}}},{"FactGrant":{"Proficiency":{"Weapon":"Dart"}}},{"FactGrant":{"Proficiency":{"Weapon":"Quarterstaff"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shortspear"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sling"}}},{"FactGrant":{"Proficiency":{"Weapon":"Spear"}}},{"FactGrant":{"Proficiency":{"WeaponGroup":"Auto"}}}],"provenance":{"book":"monster_codex","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/monster_codex/mc_abilities_class.lst:71"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
