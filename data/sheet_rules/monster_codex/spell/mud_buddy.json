[{"id":"monster_codex:spell:mud_buddy","label":"Mud Buddy","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You create a Small minion out of mud, and it obeys your commands. The mud buddy has AC 12, 10 hit points, Strength 5, and a speed of 30 feet. It can perform any tasks an unseen servant can, plus any similar tasks its Strength allows (it's able to lift up to 50 pounds), but instead of walking on water, it gains a swim speed of 30 feet. You can command a mud buddy to move up to 5 feet and trip an opponent (CMB = your caster level + your spellcasting ability score modifier). After the trip attempt is resolved, the spell ends. When the spell ends, the mud buddy reverts to a patch of wet earth."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Creation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"5 cubic feet of earth or mud"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) hours [D] (see text)"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"druid","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_lev