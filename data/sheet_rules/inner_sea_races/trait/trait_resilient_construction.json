[{"id":"inner_sea_races:trait:trait_resilient_construction","label":"Resilient Construction","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Once per day, if you would be reduced to 0 or fewer hit points while under the effects of an ongoing spell you cast with a range of personal, you are not destroyed by the attack, but instead become inactive and helpless for 1 round, at negative hit points. If you take damage again during that time, or if you are still below 0 hit points at the end of that round, you are destroyed."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Var":"v04c8475b3f352cce"},"op":"Eq","rhs":{"Const":1}}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"RaceTrait"}},"count":1}}},{"Holds":{"what":{"Rule":"inner_sea_races:trait:trait_resilient_construction"},"count":1}}]}},{"Holds":{"what":{"Rule":"bestiary_4:template:iswyrwood"},"count":1}}]},"print":true,"pool":"special_ability","tags":["Trait","RaceTrait","Wyrwood Race Trait"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_races","kind":"trait","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities.lst:107"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
