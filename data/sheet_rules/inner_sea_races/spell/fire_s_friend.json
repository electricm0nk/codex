[{"id":"inner_sea_races:spell:fire_s_friend","label":"Fire's Friend","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You cloak yourself in flames that do not harm you or your carried equipment but damage other creatures and objects. The flames cast light as a torch. Any creature that attacks you with a non-reach melee weapon or that begins its turn engaged in a grapple with you takes 1d6 points of fire damage and must succeed at a Reflex save or catch fire. The creature can negate the damage (and avoid catching fire) with spell resistance. Any time you end your movement in the same square as a flammable object or creature, that creature or object must succeed at a Reflex save or catch fire."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Fire"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Holds":{"what":{"Rule":"bestiary:template:isgoblin"},"count":1}},"print":true,"pool":"","tags":["Arcane"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"alchemist","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"bloodrager","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":2}},"when":"Always"}],"