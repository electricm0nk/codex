[{"id":"inner_sea_races:race_trait:lashunta_insidious_telepathy","label":"Insidious Telepathy","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some lashunta have a knack for manipulating the minds of those they communicate with telepathically. They gain a +1 racial bonus on Charisma-based skill checks to influence any creature with whom they are telepathically communicating. If a lashunta telepathically issues a command to a charmed or dominated creature, she gains a +1 racial bonus on Charisma checks to compel the creature to follow that order."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces lashunta magic."}],"applies":{"Not":{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:lashunta_insidious_telepathy"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:lashunta_insidious_telepathy"},"count":1}},{"Not":{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:lashunta_insidious_telepathy"},"count":1}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Lashunta Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Lashunta_ReplaceLashuntaMagic","value":"True"}}],"provenance":{"book":"inner_sea_races","kind":"race_trait","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities_race.lst:914"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
