[{"id":"inner_sea_races:race_trait:half_orc_war_leader","label":"War-Leader","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"Some orcs seek out human mates in hopes of birthing intelligent leaders for their interminable war efforts. When nature and luck smile upon this endeavor and a half-orc child shows cunning, that child is raised with many harrowing opportunities to learn how to best lead on the battlefield. Such half-orcs gain a +2 bonus on Diplomacy and Profession (soldier) checks as well as to their Leadership score (for the purpose of the Leadership feat). Armies they control in mass combat gain a +1 bonus to Morale. (See Pathfinder RPG Ultimate Campaign.)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces darkvision and orc ferocity."}],"applies":{"Not":{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:half_orc_war_leader"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"Armies you control in mass combat gain a +1 bonus to Morale."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:half_orc_war_leader"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:half_orc_forest_walker"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:half_orc_skilled"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:race_trait:half_orc_smog_sight"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:half_orc_sea_raider"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:half_orc_war_leader"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:half_orc_beastmaster"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:half_orc_bestial"},"count