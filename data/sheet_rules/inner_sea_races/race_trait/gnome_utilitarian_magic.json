[{"id":"inner_sea_races:race_trait:gnome_utilitarian_magic","label":"Utilitarian Magic","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some gnomes develop practical magic to assist them with their obsessive projects. These gnomes add 1 to the DC of any saving throws against transmutation spells they cast. If their Intelligence score is 11 or higher, they also gain the following spell-like abilities: 1/day--mage hand, open/close, prestidigitation, and unseen servant. The DC for these spells is equal to 10 + the spell's level + the gnome's Intelligence modifier."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces gnome magic."}],"applies":{"Not":{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:gnome_utilitarian_magic"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:gnome_vivacious"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_magical_linguist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_pyromaniac"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_fell_magic"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_magical_linguist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_pyromaniac"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:gnome_utilitarian_magic"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:gnome_vivacious"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Gnome Racial Trait","SpecialQuality","Special Quality","Applied Bonus"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Gnome_ReplaceGnomeMagic","value":"true"}}],"provenance":{"book":"inner_sea_races","kind":"race_trait","closure_rows":["pathfinder/pa