[{"id":"inner_sea_races:race_trait:beast_talker_skinwalker_change_shape","label":"Change Shape","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Const":1}}]],"prose":[{"family":"Desc","pieces":[{"Text":"Once per day, a beast talker skinwalker can change shape to a bestial form as a standard action. In bestial form, a skinwalker gains a +2 racial bonus to his choice of Strength, Dexterity, or Constitution. While in this form, a skinwalker also takes on an animalistic feature that provides a special effect. Each time a skinwalker assumes bestial form, he can choose to gain two claw attacks that each deal 1d4 points of damage, 60 foot darkvision, or a +1 natural armor bonus. These benefits last for "},{"Text":" minutes (1 minute per level). The skinwalker may return to his humanoid form as a swift action. A skinwalker must first return to his humanoid form before changing to bestial form again to change benefits."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:skinwalker_beast_talker"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"bestiary_5:race_trait:werebat_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:werebear_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:wereboar_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:werecrocodile_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:wereraptor_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:wererat_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:wereshark_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:weretiger_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_5:race_trait:werewolf_kin_change_shape"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:skinwalker_beast_talker"},"count":1}}]}}]},"print":true,"pool":"special_ability","tags":["RacialTraits","Skinwalker Racial Trait","SpecialQuality","Special Quality","Special Ability","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_races","kind":"race_trait","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities_race.lst:1217"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
