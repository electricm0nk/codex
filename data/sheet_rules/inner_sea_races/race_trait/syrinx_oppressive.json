[{"id":"inner_sea_races:race_trait:syrinx_oppressive","label":"Oppressive","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Syrinxes often have a natural talent for sensing how to unsettle and oppress other creatures. As a swift action, a syrinx can attempt a Sense Motive check against a DC of 10 + a creature's Hit Dice + its Charisma modifier or a DC of 10 + the creature's Bluff modifier, whichever is higher. On a success, syrinx gains a +4 racial bonus on Intimidate checks against that target and a +1 racial bonus to the DC of any fear effects she uses against that target."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces nocturnal and pride."}],"applies":{"Not":{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:syrinx_oppressive"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:syrinx_oppressive"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:syrinx_oppressive"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:syrinx_oppressive"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Syrinx Racial Trait","SpecialQuality","Special Quality","Special Ability"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Syrinx_ReplaceNocturnal","value":"True"}},{"FactDeclare":{"name":"Syrinx_ReplacePride","value":"True"}}],"provenance":{"book":"inner_sea_races","kind":"race_trait","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities_race.lst:1343"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
