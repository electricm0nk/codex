[{"id":"ultimate_wilderness:feat:boon_companion","label":"Boon Companion","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Your bond with your animal companion or familiar is unusually close."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"The abilities of your animal companion or familiar are calculated as though your class were 4 levels higher, to a maximum effective druid level equal to your character level. If you have more than one animal companion or familiar, choose one to receive this benefit. If you lose or dismiss an animal companion or familiar that has received this benefit, you may apply this feat to the replacement creature. Special: You may select this feat more than once. The effects do not stack. Each time you take the feat, it applies to a different animal companion or familiar."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Var":"vff8480c4641cf704"},"op":"Gt","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v8091902b3d915004"},"op":"Gt","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v4255f045c08d920f"},"op":"Gt","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"va0211e001d91bfd1"},"op":"Gt","rhs":{"Const":0}}},{"Compare":{"lhs":{"Var":"v48f5ef074c575902"},"op":"Gt","rhs":{"Const":0}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Animal Companion"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Familiar"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Mount"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Special Mount"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Huntmaster Companion"}},"count":1}}]}}]}},"target":{"Pool":"boon_companion_selection"},"print":true,"pool":"feat","tags":["General"],"subject":"Character","repeatable":true,"provenance":{"book":"ultimate_wilderness","k