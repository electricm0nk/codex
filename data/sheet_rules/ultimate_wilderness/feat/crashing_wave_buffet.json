[{"id":"ultimate_wilderness:feat:crashing_wave_buffet","label":"Crashing Wave Buffet","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You disorient your opponents by pushing and pounding them mercilessly, just like how the sea beats relentlessly against the rocks."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When dragging or repositioning an opponent, you use your full body to knock your opponent around like a constant wave. At the end of the drag or reposition maneuver, your opponent must succeed at a Fortitude save (DC "},{"Slot":{"Sum":[{"Const":10},{"Div":["Level",{"Const":2}]},{"AbilityMod":"Wis"}]}},{"Text":" + 2 for every 5 feet you drag or reposition your opponent). On a failed save, your opponent becomes disorientated from the movement and takes a -2 penalty on attack rolls, combat maneuver checks, and Dexterity-based skill checks until the end of its next turn."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"MissingRule":{"pool":"feat","name":"Crashing Wave Style"}},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:feat:improved_drag"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:feat:improved_reposition"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}}]}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":6}}},{"Compare":{"lhs":{"Var":"ve59ae2a694dab2b8"},"op":"Gte","rhs":{"Const":15}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_combat:class_feature:master_of_many_styles_crashing_wave_buffet"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:monk_bonus_feat_crashing_wave_buffet"},"when":"Always"}],"provenance":{"book":"ultimate_wilderness","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_feats.lst:30"],"oracle_pin":"7f81