[{"id":"ultimate_wilderness:class_feature:oracle_archetype_river_soul","label":"River Soul","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"River soul oracles derive their powers from their bonds with rivers, whether these waterways are rapid cascades or lazy channels plied by boats. The powerful bond formed with a river is also the river soul oracle's curse, as he must always carry water from the river with him, and his fate is bound to it. River soul oracles can be gentle and still when calm, but they're raging torrents when angered."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"oracle"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:oracle_archetype_river_soul"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:oracle_archetype_ancient_lorekeeper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:oracle_archetype_community_guardian"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:oracle_archetype_keleshite_prophet"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:oracle_archetype_dual_cursed_oracle"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:oracle_archetype_enlightened_philosopher"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:oracle_archetype_stargazer"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:oracle_archetype_river_soul"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:oracle_archetype_tree_soul"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:oracle_archetype_ancient_lorekeeper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:oracle_archetype_community_guardian"},"count":1}},{"Holds":{"what":{"Rule":"advan