[{"id":"ultimate_wilderness:class_feature:elementalist_shifter_elemental_form","label":"Elemental Form","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When an elementalist shifter uses wild shape, she is instead affected as if by elemental body I, but she gains only the benefits listed in her elemental aspect. While in an elemental form, the elementalist shifter can speak only the elemental language associated with that form, and she can do so only if she knows it. This alters wild shape."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Shifter Class Features","ElementalistShifterClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_elementalist_shifter"},"when":{"Compare":{"lhs":{"ClassLevel":"shifter"},"op":"Gte","rhs":{"Const":4}}}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_class.lst:1046"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
