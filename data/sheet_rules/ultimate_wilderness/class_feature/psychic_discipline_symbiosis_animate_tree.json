[{"id":"ultimate_wilderness:class_feature:psychic_discipline_symbiosis_animate_tree","label":"Animate Tree","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can animate a tree within 180 feet as a standard action. This functions as a treant's animate trees ability, with the following exceptions. Each day, you can animate "},{"Slot":{"Sum":[{"Const":3},{"AbilityMod":"Cha"}]}},{"Text":" trees, and you can control up to "},{"Slot":{"Div":[{"Sum":[{"Var":"va5640d0c657c24c7"},{"Const":-11}]},{"Const":2}]}},{"Text":" trees at a time. A tree remains animated for "},{"Slot":{"Mul":[{"Const":10},{"Var":"va5640d0c657c24c7"}]}},{"Text":" minutes, or until dismissed by you or destroyed."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:psychic_discipline_symbiosis"},"when":{"Compare":{"lhs":{"ClassLevel":"psychic"},"op":"Gte","rhs":{"Const":13}}}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/support/uw_abilities_class_oa.lst:169"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
