[{"id":"ultimate_wilderness:class_feature:filidh_natural_magic","label":"Natural Magic","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A filidh casts spells as a bard, but the spells are divine, not arcane, and therefore not subject to arcane spell failure. A filidh must use a holy symbol or a musical instrument as a divine focus when a spell includes such a component. He still uses the bard spell list. This alters the bard's spellcasting."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Bard Class Features","FilidhClassFeatures"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:bard_archetype_filidh"},"when":{"Compare":{"lhs":{"ClassLevel":"bard"},"op":"Gte","rhs":{"Const":1}}}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_class.lst:266"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
