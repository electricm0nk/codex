[{"id":"ultimate_wilderness:class_feature:cartographer_swift_travels","label":"Swift Travels","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While in studied terrain, a cartographer intuitively knows the easiest, shortest, and fastest way through the wilderness. For the purpose of determining overland speed, the cartographer treats any trackless terrain as though he were on a trail, and he treats any terrain with a road or trail as though it were a highway. He can extend the benefit to up to "},{"Slot":{"Var":"v66ee218841c1ebd5"}},{"Text":" creatures traveling with him."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Investigator Class Features","CartographerClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:investigator_archetype_cartographer"},"when":{"Compare":{"lhs":{"ClassLevel":"investigator"},"op":"Gte","rhs":{"Const":4}}}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_class.lst:738"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
