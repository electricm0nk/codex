[{"id":"ultimate_wilderness:class_feature:skirmisher_wilderness_training","label":"Wilderness Training","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A skirmisher relies on his skills and the element of surprise rather than the heaviest shields and armor. He gains Acrobatics and Stealth as class skills. In addition, the skirmisher gains a number of skill ranks at each level equal to 4 + his Intelligence modifier, instead of 2 + his Intelligence modifier. This alters the fighter's class skills and skill ranks per level."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Fighter Class Features","SkirmisherClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:fighter_archetype_skirmisher"},"when":{"Compare":{"lhs":{"ClassLevel":"fighter"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"ClassSkill":"acrobatics"}},{"FactGrant":{"ClassSkill":"stealth"}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_class.lst:576"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
