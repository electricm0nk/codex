[{"id":"ultimate_wilderness:class_feature:leshykineticist_leshy_element","label":"Leshy Element","value":{"Number":{"Const":-1}},"prose":[{"family":"Desc","pieces":[{"Text":"A leshykineticist must select the wood element (see page 58) as her primary element and for both her expanded elements. She must choose wood blast as her first simple blast and positive blast as her second simple blast. At 6th level, she gains green tongue as a bonus utility wild talent, ignoring its prerequisites. At 7th level, when she first gains positive blast, she gains kinetic healer and the photokinetic infusion instead of the extra wild talent of 3rd level or lower for expanding in the same element. Her kinetic healer wild talent restores 1 extra hit point per die when healing plant creatures. At 9th level, she gains an extra wild talent of 3rd level or lower of her choice. At 10th level, she gains greater green tongue as a bonus utility wild talent, ignoring its prerequisites. This alters element and expanded element."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"kineticist_blast"},"print":true,"pool":"special_ability","tags":["Kineticist Class Features","LeshykineticistClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:kineticist_archetype_leshykineticist"},"when":{"Compare":{"lhs":{"ClassLevel":"kineticist"},"op":"Gte","rhs":{"Const":1}}}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/support/uw_abilities_class_oa.lst:22"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_wilderness:class_feature:leshykineticist_leshy_element#bonus1","label":"Leshy Element (kineticist blast picks)","value":{"Number":{"Const":-1}},"applies":{"Compare":{"lhs":{"ClassLevel":"kineticist"},"op":"Gte","rhs":{"Const":7