[{"id":"ultimate_wilderness:class_feature:investigator_archetype_cartographer","label":"Cartographer","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Cartographers are eager trailblazers who explore uncharted terrain, study landmarks, and find new paths through the wilderness. They record this information meticulously so that those who follow in their footsteps can travel swiftly and safely within the studied area. Rather than studying poisons like many investigators do, cartographers use their alchemical expertise to create better inks that allow them to draw maps with incredible level of detail."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"investigator"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:investigator_archetype_cartographer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:investigator_archetype_empiricist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:investigator_archetype_infiltrator"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:investigator_archetype_spiritualist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:investigator_archetype_steel_hound"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:class_feature:investigator_archetype_cult_hunter"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:class_feature:investigator_archetype_gravedigger"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:class_feature:investigator_archetype_profiler"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:investigator_archetype_bonded_investigator"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:investigator_archetype_guardian_of_immortality"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class