[{"id":"ultimate_wilderness:class_feature:fighter_archetype_tribal_fighter","label":"Tribal Fighter","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A tribal fighter knows that it is not the weapon that matters but the hand that wields it. Instead of encasing himself in metal armor like the soldiers fighting and dying for the so-called civilized lands do, he prefers to wear something he or his ancestors have killed. These relics and trophies help the tribal fighter attain a battle focus that allows him to perform incredible feats of violence with the simplest of weapons."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"fighter"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:fighter_archetype_tribal_fighter"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype_dragoon"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype_tactician"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype_unarmed_fighter"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:fighter_archetype_unbreakable"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:fighter_archetype_tribal_fighter"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:fighter_archetype_martial_master"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:fighter_archetype_archer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:fighter_archetype_crossbowman"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:fighter_archetype_phalanx_soldier"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:fighter_archetype_polearm_master"},"count":1}},{"Holds"