[{"id":"ultimate_wilderness:class_feature:shifter_defensive_instinct","label":"Defensive Instinct","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When unarmored, not using a shield, unencumbered, and conscious, the shifter adds "},{"Slot":{"Mul":[{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":[{"Var":"v10eb36da6a6aee49"},{"Const":-1},{"Const":1}]}]}]},{"Max":[{"AbilityMod":"Wis"},{"Const":0}]}]}},{"Text":" to her AC and CMD. If she is wearing nonmetal armor or using a nonmetal shield, she instead adds "},{"Slot":{"Div":[{"Mul":[{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":[{"Var":"v10eb36da6a6aee49"},{"Const":-1},{"Const":1}]}]}]},{"Max":[{"AbilityMod":"Wis"},{"Const":0}]}]},{"Const":2}]}},{"Text":" to her AC."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"In addition, the shifter gains a +"},{"Slot":{"Div":[{"Var":"v10eb36da6a6aee49"},{"Const":4}]}},{"Text":" bonus to her AC and CMD."}],"applies":{"Compare":{"lhs":{"Var":"v10eb36da6a6aee49"},"op":"Gte","rhs":{"Const":4}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"These bonuses to AC apply even against touch attacks and when the shifter is flat-footed. She loses these bonuses when she is immobilized or helpless. These bonuses do not stack with the monk AC bonus class feature."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Shifter Class Feature","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_class.lst:16"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
