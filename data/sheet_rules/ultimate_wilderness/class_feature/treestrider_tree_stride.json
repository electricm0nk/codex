[{"id":"ultimate_wilderness:class_feature:treestrider_tree_stride","label":"Tree Stride","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A treestrider can use a full-round action to move between two trees, as per the spell tree stride. Unlike the spell, this ability has a duration of instantaneous and the treestrider can make only a single transfer. She can bring her animal companion with her, but if she does, her companion can't take any actions that round. Tree stride can be used "},{"Slot":{"Sum":[{"Const":3},{"AbilityMod":"Wis"}]}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Hunter Class Features","TreestriderClassFeatures","SpecialQuality","SpellLike"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_wilderness:class_feature:hunter_archetype_treestrider"},"when":{"Compare":{"lhs":{"ClassLevel":"hunter"},"op":"Gte","rhs":{"Const":10}}}}],"provenance":{"book":"ultimate_wilderness","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_class.lst:725"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
