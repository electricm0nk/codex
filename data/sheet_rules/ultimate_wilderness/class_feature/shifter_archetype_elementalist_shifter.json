[{"id":"ultimate_wilderness:class_feature:shifter_archetype_elementalist_shifter","label":"Elementalist Shifter","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Rather than drawing power from bestial aspects, elementalist shifters channel power from the Inner Sphere and can take on powerful elemental forms at the cost of the greater diversity available to traditional shifters. Although the elementalist shifter's powers seem more outlandish and supernatural than those of others of their kind, they remain equally immersed in the druidic traditions; their focus is simply rooted in expressions of nature found in extraplanar regions: the planes of Air, Earth, Fire, and Water."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"shifter"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_elementalist_shifter"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_elementalist_shifter"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_elementalist_shifter"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_fiendflesh_shifter"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_leafshifter"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_oozemorph"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_rageshaper"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_verdant_shifter"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_weretouched"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:shifter_archetype_element