[{"id":"ultimate_wilderness:race_trait:ghoran_seed","label":"Seed","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a full-round action, a ghoran can expel the seed from an orifice in its abdomen. If planted in fertile ground and left undisturbed for 2d6 days, the seed grows into a healthy duplicate of the original ghoran, save that the duplicate can reallocate all skill ranks upon sprouting. Once a ghoran expels this seed, it gains 1 negative level, and it dies as soon as the duplicate sprouts. This duplicate replaces the previous ghoran character."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Racial Points"},"pieces":[{"Text":"6"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"Not":{"Holds":{"what":{"Fact":{"name":"Ghoran_ReplaceSeed","value":"True"}},"count":1}}},"print":true,"pool":"special_ability","tags":["BuilderOtherTrait"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_wilderness","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/races/ghoran/ghoran_abilities_race.lst:21","pathfinder/paizo/roleplaying_game/bestiary_5/b5_abilities_race_pc.lst:119","pathfinder/paizo/campaign_setting/inner_sea_bestiary/isb_abilities_race.lst:94","pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities_race.lst:680","pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_race.lst:78"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
