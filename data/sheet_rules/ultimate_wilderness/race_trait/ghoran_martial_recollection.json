[{"id":"ultimate_wilderness:race_trait:ghoran_martial_recollection","label":"Martial Recollection","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The personal history of many ghorans is scarred with desperate struggles for survival, and memories of that conflict are deeply ingrained within their seeds. Whenever ghorans with this racial trait grow new bodies from their seeds, they reselect all combat feats known instead of reallocating skill ranks.\nThis alters seed and replaces nature magic."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_wilderness:race_trait:ghoran_martial_recollection"},"count":1}},{"Holds":{"what":{"Fact":{"name":"Ghoran_ReplaceNaturalMagic","value":"True"}},"count":1}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Ghoran Racial Trait","SpecialQuality","Special Quality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_wilderness","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_wilderness/uw_abilities_race.lst:86"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
