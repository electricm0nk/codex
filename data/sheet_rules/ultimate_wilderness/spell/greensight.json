[{"id":"ultimate_wilderness:spell:greensight","label":"Greensight","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Grant a target the ability to see through plant matter as if it were transparent."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The target of this spell gains the ability to see up to 60 feet through thick plant matter as though it were transparent. Greenery, leaves, and vines-even lichen, moss, and slime-offer no concealment to the recipient's sight, though her vision still can be blocked by solid wood, such as trees or wooden structures. Undergrowth does not grant concealment to a creature against a target of the effects of greensight."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Grant a target the ability to see through plant matter as if it were transparent."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL*10) minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Creature touched"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool