[{"id":"ultimate_wilderness:spell:waft","label":"Waft","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You make the targets light enough to be carried by wind. Creatures affected by this spell suffer cumulative penalties for attacking as if under the effects of levitate unless they have a fly speed. Treat each target as two size categories lighter for the purposes of being checked or blown away by wind. If a target has a fly speed, it can fly overland at the wind's speed in the same direction as the wind by succeeding at a DC 20 Fly check. If a creature flying overland this way attempts to change direction, it risks being blown away as usual. By linking hands or creating a connection with rope, creatures affected by this spell can be towed through the air by a flying creature as if each weighed only one-eighth its actual weight."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) hours"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Up to (CASTERLEVEL/2) creatures, no two of which can be more than 30 ft. apart"}]