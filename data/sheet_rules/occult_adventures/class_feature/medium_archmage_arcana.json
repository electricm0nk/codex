[{"id":"occult_adventures:class_feature:medium_archmage_arcana","label":"Archmage Arcana","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"(Lesser) Instead of your normal spells per day for your medium level, you use the spells per day from Table: Mesmerist. For each level of spell you can now cast (including level 0), each time you channel an archmage spirit, select a single spell of that level from the sorcerer/wizard spell list to add to your medium spell list and spells known until you lose contact with the archmage. When you cast these spells, they count as arcane (though not for the purpose of fulfilling prerequisites), and thus you must provide verbal and somatic components instead of thought and emotion components."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"medium_wizard_spell_0"},"print":true,"pool":"special_ability","tags":["MediumClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"occult_adventures:class_feature:medium_archmage_spirit"},"when":"Always"}],"provenance":{"book":"occult_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:839","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1427"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"occult_adventures:class_feature:medium_archmage_arcana#bonus1","label":"Archmage Arcana (medium wizard spell 1 picks)","value":{"Number":{"Const":1}},"applies":"Always","target":{"Pool":"medium_wizard_spell_1"},"print":true,"pool":"special_ability","tags":["MediumClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"occult_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:839","pathfin