[{"id":"occult_adventures:class_feature:psychic_discipline_self_perfection_ac_bonus","label":"AC Bonus","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When unarmored and unencumbered, you add your Wisdom bonus (if any) to your AC and CMD. The bonus to AC applies even against touch attacks or when you're flat-footed. You lose these bonuses when you're immobilized or helpless, when you wear any armor, when you carry a shield, or when you carry a medium or heavy load."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"occult_adventures:class_feature:psychic_discipline_self_perfection"},"when":{"Compare":{"lhs":{"ClassLevel":"psychic"},"op":"Gte","rhs":{"Const":1}}}}],"provenance":{"book":"occult_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1250"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
