[{"id":"occult_adventures:class_feature:medium_divine_surge","label":"Divine Surge","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"(Lesser) Instead of your normal spells per day for your medium level, you use the spells per day from Table: Mesmerist. For each level of spell you can now cast (including level 0), each time you channel an hierophant spirit, select a single spell of that level from the cleric/oracle spell list to add to your medium spell list and spells known until you lose contact with the hierophant. When you cast these spells, they count as divine (though not for the purpose of fulfilling prerequisites), and thus you must provide verbal and somatic components instead of thought and emotion components. You need a divine focus if the spell requires one."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"medium_cleric_spell_0"},"print":true,"pool":"special_ability","tags":["MediumClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"occult_adventures:class_feature:medium_hierophant_spirit"},"when":"Always"}],"provenance":{"book":"occult_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:860","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1428"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"occult_adventures:class_feature:medium_divine_surge#bonus1","label":"Divine Surge (medium cleric spell 1 picks)","value":{"Number":{"Const":1}},"applies":"Always","target":{"Pool":"medium_cleric_spell_1"},"print":true,"pool":"special_ability","tags":["MediumClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"occult_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adve