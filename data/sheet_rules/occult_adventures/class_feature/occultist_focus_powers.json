[{"id":"occult_adventures:class_feature:occultist_focus_powers","label":"Focus Powers","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"An occultist learns the base focus power from each of his implement schools and can select "},{"Slot":{"Var":"v9ba420a01d286643"}},{"Text":" more focus power(s) from the list of those available to him through those schools. Whenever the occultist learns a new implement school, he gains the base power of that school. The occultist can use focus powers only by expending mental focus (see Mental Focus). Unless otherwise noted, the DC for any saving throw against a focus power equals "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"Var":"vfc40634209ba5cad"},{"Const":2}]},{"AbilityMod":"Int"}]}},{"Text":". The occultist can't select a focus power more than once. Some focus powers require him to reach a specific occultist level before he can choose them."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Occultist Class Feature","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"occult_adventures","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:981","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1139","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1140","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1141","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1142","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1143","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1144","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1145","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities_class.lst:1146","pathfinder/paizo/roleplaying_game/occult_adventures/oa_abilities