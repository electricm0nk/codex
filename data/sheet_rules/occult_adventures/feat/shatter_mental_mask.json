[{"id":"occult_adventures:feat:shatter_mental_mask","label":"Shatter Mental Mask","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are adept at ripping away an opponent's mental mask, exposing its true visage during a psychic duel."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"While in a psychic duel, when you create an offensive manifestation that can be negated or halved only with a successful Will saving throw, if your opponent fails that Will saving throw, its mental mask is shattered, revealing the opponent's true form. Special: If you possess the Third Eye feat, your opponent's mental mask is shattered even on a successful Will saving throw."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"occult_adventures:feat:psychic_sensitivity"},"count":1}},{"Holds":{"what":{"ClassTag":"Psychic"},"count":1}}]}},{"Compare":{"lhs":"Level","op":"Gte","rhs":{"Const":2}}}]},"print":true,"pool":"feat","tags":["General","Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Choice":"advanced_class_guide:class_feature:add_swashbuckler_feat"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":{"Compare":{"lhs":{"Var":"v23f38a262aff8676"},"op":"Eq","rhs":{"Const":20}}}},{"by":{"Choice":"advanced_class_guide:class_feature:martial_flexibility_feat"},"when":"Always"},{"by":{"Choice":"adventurers_guide:ability:student_of_perfection_swashbuckler_bonus_feat"},"when":"Always"},{"by":{"Choice":"occult_adventures:class_feature:battle_host_bonus_feats"},"when":"Always"}],"provenance":{"book":"occult_adventures","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/occult_adventures/oa_feats.lst:65"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
