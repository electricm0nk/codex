[{"id":"advanced_race_guide:race_trait:oread_ferrous_growth","label":"Ferrous Growth","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Const":1}}]],"prose":[{"family":"Desc","pieces":[{"Text":"Oreads with this racial trait learn how to mimic the magic of their shaitan ancestors. Once per day, such an oread can cause a touched piece of nonmagical iron or steel to grow into an object up to 10 pounds in weight, such as a sword, crowbar, or light steel shield. This object remains in this form for 10 minutes or until broken or destroyed, at which point it shrinks back to its original size and shape."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces the spell-like ability racial trait."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:oread_ferrous_growth"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:oread_ferrous_growth"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:oread_ferrous_growth"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:oread_mountain_born"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:oread_treacherous_earth"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Oread Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Oread_ReplaceSpellLikeAbility","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:631"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
