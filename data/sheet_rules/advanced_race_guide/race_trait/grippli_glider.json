[{"id":"advanced_race_guide:race_trait:grippli_glider","label":"Glider","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Gripplis' aerodynamic bodies and thick webbing between the toes enable a falling grippli to treat the distance fallen as half the actual distance. The grippli can steer himself while falling, moving horizontally up to a number of feet equal to half the vertical distance fallen. The grippli cannot use this trait if it is wearing heavy armor, is carrying a heavy load, or is unable to react to the fall (such as being helpless)."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces swamp stride."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:grippli_glider"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:grippli_glider"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:grippli_glider"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:grippli_princely"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:grippli_toxic_skin"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:grippli_defensive_training"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Grippli Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Grippli_ReplaceSwampStride","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:905"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
