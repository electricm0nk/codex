[{"id":"advanced_race_guide:race_trait:dwarf_saltbeard","label":"Saltbeard","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"Dwarves occasionally found iron cities along rugged seacoasts, and natives of such cities gain a +2 bonus on Profession (sailor) and Survival checks while at sea. They gain a +1 racial bonus on attack rolls and a +2 dodge bonus to AC against creatures with the aquatic or water subtype. Their greed racial trait applies only to treasure found in or under the water, but applies to all such treasure regardless of whether or not it contains metal or gemstones."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces defensive training, hatred, and stonecunning."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_saltbeard"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(+"},{"Slot":{"Var":"v008745dc7caed583"}},{"Text":" dodge bonus to AC vs. aquatic and water creatures)"}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"+1 racial bonus on attack rolls and a +2 dodge bonus to AC against creatures with the aquatic or water subtype."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_saltbeard"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:dwarf_deep_warrior"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_deep_warrior"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_saltbeard"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_sky_sentinel"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_wyrmscourged"},"count":1}},{"Holds":{