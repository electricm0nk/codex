[{"id":"advanced_race_guide:race_trait:kobold_gliding_wings","label":"Gliding Wings","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some kobolds are born with wings that, while too weak for actual flying, do allow them to fall at a very slow and safe pace. A kobold with wings can use them to glide. It can make a DC 15 Fly check to fall safely from any height without taking falling damage, as if using feather fall. When falling safely, it may make an additional DC 15 Fly check to glide, moving 5 feet laterally for every 20 feet it falls."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces crafty."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:kobold_gliding_wings"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:kobold_gliding_wings"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:kobold_beast_bond"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:kobold_gliding_wings"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:kobold_jester"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Kobold Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Kobold_ReplaceCrafty","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:575"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
