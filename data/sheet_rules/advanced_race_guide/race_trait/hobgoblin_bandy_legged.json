[{"id":"advanced_race_guide:race_trait:hobgoblin_bandy_legged","label":"Bandy-Legged","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Bandy-legged hobgoblins have an even more exaggerated stature than other hobgoblins, with bowed legs and massive shoulders. Hobgoblins with this racial trait gain a +2 racial bonus on Climb and Ride checks, and a +2 racial bonus to their CMD against bull rush or trip attempts while on solid ground. The base speed of bandy-legged hobgoblins is reduced to 20 feet."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:hobgoblin_bandy_legged"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"RacialSkillModifier"},"pieces":[{"Text":"+2 Climb, +2 Ride"}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"StatBlock":"Speed"},"pieces":[{"Text":"Walk "},{"Text":"20"},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"MissingRule":{"pool":"special_ability","name":"Hobgoblin ~ Hobgoblin ~ Bandy-Legged"}},"count":1}},{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:hobgoblin_bandy_legged"},"count":1}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Hobgoblin Racial Trait","SpecialQuality","Special Quality","Applied Bonus"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Hobgoblin_ReplaceSpeed","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:512"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
