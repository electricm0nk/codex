[{"id":"advanced_race_guide:race_trait:gnome_fell_magic","label":"Fell Magic","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Gnomes add +1 to the DC of any saving throws against necromancy spells that they cast. Gnomes with Wisdom scores of 11 or higher also gain the following spell-like abilities: 1/day--bleed, chill touch, detect poison, and touch of fatigue. The caster level for these effects is equal to the gnome's level. The DC for these spells is equal to 10 + the spell's level + the gnome's Wisdom modifier."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces gnome magic."}],"applies":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_fell_magic"},"count":1}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_fell_magic"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_magical_linguist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:gnome_pyromaniac"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_fell_magic"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_magical_linguist"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:gnome_pyromaniac"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:gnome_utilitarian_magic"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:gnome_vivacious"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Gnome Racial Trait","SpecialQuality","Special Quality","Applied Bonus"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Gnome_ReplaceGnomeMagic","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abil