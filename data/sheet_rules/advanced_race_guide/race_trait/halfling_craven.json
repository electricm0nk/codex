[{"id":"advanced_race_guide:race_trait:halfling_craven","label":"Craven","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While most halflings are fearless, some are skittish, making them particularly alert. Halflings with this racial trait gain a +1 bonus on initiative checks and a +1 bonus on attack rolls when flanking. They take a -2 penalty on saves against fear effects and gain no benefit from morale bonuses on such saves. When affected by a fear effect, their base speed increases by 10 feet and they gain a +1 dodge bonus to Armor Class."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces fearless and halfling luck."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:halfling_craven"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"+1 bonus on attack rolls when flanking. When affected by a fear effect, your base speed increases by 10 feet and you gain a +1 dodge bonus to Armor Class."}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"SaveBonus"},"pieces":[{"Text":"-2 penalty on saves against fear effects and gain no benefit from morale bonuses on such saves."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:halfling_craven"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:halfling_craven"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:halfling_practicality"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:race_trait:halfling_wanderlust"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:halfling_craven"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:halfling_practicality"},"count":1}},{"Holds":{"what":{"Rule":"advanced