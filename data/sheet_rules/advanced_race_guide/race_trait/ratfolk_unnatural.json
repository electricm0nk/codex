[{"id":"advanced_race_guide:race_trait:ratfolk_unnatural","label":"Unnatural","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some ratfolk unnerve normal animals, and train to defend themselves against the inevitable attacks from such creatures. These ratfolk take a -4 penalty on all Charisma-based skill checks to affect creatures of the animal type, and receive a +2 dodge bonus to AC against animals. An animal's starting attitude toward ratfolk is one step worse than normal."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces rodent empathy."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:ratfolk_unnatural"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(+2 dodge bonus to AC vs. animals)"}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"SkillBonus"},"pieces":[{"Text":"You take a -4 penalty on all Charisma-based skill checks to affect creatures of the animal type."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:ratfolk_unnatural"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:ratfolk_unnatural"},"count":1}},{"Holds":{"what":{"Rule":"monster_codex:race_trait:ratfolk_cleanliness"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Ratfolk Racial Trait","SpecialQuality","Defensive"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Ratfolk_ReplaceRodentEmpathy","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:662"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
