[{"id":"advanced_race_guide:race_trait:tengu_glide","label":"Glide","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some tengus can use their feathered arms and legs to glide. Tengus with this racial trait can make a DC 15 Fly check to fall safely from any height without taking falling damage, as if using feather fall. When falling safely, a tengu may make an additional DC 15 Fly check to glide, moving 5 feet laterally for every 20 feet he falls."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces gifted linguist."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:tengu_glide"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:tengu_glide"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:tengu_carrion_sense"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:tengu_glide"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Tengu Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Tengu_ReplaceGiftedLinguist","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:719"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
