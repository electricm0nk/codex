[{"id":"advanced_race_guide:race_trait:dhampir_vampiric_empathy","label":"Vampiric Empathy","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Though dhampirs often relate poorly to humanoids, some share an affinity with baser creatures. These dhampirs gain the ability to communicate with bats, rats, and wolves as if under the effects of a speak with animals spell (caster level equal to 1/2 the dhampir's Hit Dice). In addition, they gain a +2 racial bonus on Diplomacy checks when dealing with these animals. Whenever these dhampirs initiate an exchange, animals begin with a starting attitude of indifferent. This is a supernatural ability."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces manipulative."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dhampir_vampiric_empathy"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"CombatBonus"},"pieces":[{"Text":"You have the ability to communicate with bats, rats, and wolves as if under the effects of a speak with animals spell (caster level "},{"Slot":{"Div":["Level",{"Const":2}]}},{"Text":")."}],"pick_last":true,"suppress_when_all_zero":false},{"family":{"Aspect":"SkillBonus"},"pieces":[{"Text":"+2 racial bonus on Diplomacy checks when dealing with bats, rats, and wolves."}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dhampir_vampiric_empathy"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dhampir_vampiric_empathy"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_2:ability:dhampir_jiang_shi_born"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_2:ability:dhampir_moroi_born"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_2:ability:dhampir_nosferatu_born"},"count":1}},{"Holds":{"what":{"Rule":"bestiary_2:ability:dhampir_vetala_born"},"count