[{"id":"advanced_race_guide:race_trait:catfolk_curiosity","label":"Curiosity","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Catfolk are naturally inquisitive about the world around them, though some are more curious than others. Such catfolk gain a +4 bonus on Diplomacy checks to gather information, and Knowledge (history) and Knowledge (local) are always class skills for them. If they choose a class that has either of these Knowledge skills as class skills, they gain a +2 racial bonus on those skills instead."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces natural hunter."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:catfolk_curiosity"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"RacialSkillModifier"},"pieces":[{"Text":"+4 Diplomacy to gather information"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:catfolk_curiosity"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:catfolk_cat_s_claws"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:catfolk_clever_cat"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:catfolk_curiosity"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Catfolk Racial Trait","SpecialQuality","Special Quality","Applied Bonus"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Catfolk_ReplaceNaturalHunter","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:362"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
