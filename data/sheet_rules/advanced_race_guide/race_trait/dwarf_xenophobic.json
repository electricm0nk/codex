[{"id":"advanced_race_guide:race_trait:dwarf_xenophobic","label":"Xenophobic","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Isolationist dwarves despise non-dwarven humanoids. They speak only Dwarven and do not gain any bonus languages from possessing a high Intelligence score. In addition, they learn only one language per 2 ranks of Linguistics they possess. However, their untrusting nature gives them a +1 bonus against mind-affecting effects, except for fear affects."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces a dwarf's normal languages."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_xenophobic"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"SaveBonus"},"pieces":[{"Text":"+1 vs. mind-affecting effects, except fear"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_xenophobic"},"count":1}},{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:dwarf_xenophobic"},"count":1}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Dwarf Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactGrant":{"Language":"Dwarven"}},{"FactDeclare":{"name":"Dwarf_ReplaceLanguages","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:49"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
