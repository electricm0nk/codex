[{"id":"advanced_race_guide:race_trait:samsaran_mystic_past_life","label":"Mystic Past Life","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"You can add spells from another spellcasting class to the spell list of your current spellcasting class. You add a number of spells equal to 1 + your spellcasting class's key ability score bonus (Wisdom for clerics, and so on). The spells must be the same type (arcane or divine) as the spellcasting class you're adding them to. For example, you could add divine power to your druid class spell list, but not to your wizard class spell list because divine power is a divine spell. These spells do not have to be spells you can cast as a 1st-level character. The number of spells granted by this ability is set at 1st level. Changes to your ability score do not change the number of spells gained."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces shards of the past."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:samsaran_mystic_past_life"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:samsaran_mystic_past_life"},"count":1}},{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:samsaran_mystic_past_life"},"count":1}}}]}},{"AtLeast":{"n":6,"of":[{"Compare":{"lhs":{"AbilityScore":"Str"},"op":"Gte","rhs":{"Const":3}}},{"Compare":{"lhs":{"AbilityScore":"Dex"},"op":"Gte","rhs":{"Const":3}}},{"Compare":{"lhs":{"AbilityScore":"Con"},"op":"Gte","rhs":{"Const":3}}},{"Compare":{"lhs":{"AbilityScore":"Int"},"op":"Gte","rhs":{"Const":3}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":3}}},{"Compare":{"lhs":{"AbilityScore":"Cha"},"op":"Gte","rhs":{"Const":3}}}]}}]},"target":{"Pool":"mystic_past_life_class"},"print":true,"pool":"special_ability","tags":["RacialTraits","Samsaran Racial 