[{"id":"advanced_race_guide:race_trait:vanara_whitecape","label":"Whitecape","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The rare whitecape vanara clans have more in common with savanna-dwelling baboons than the jungledwelling monkeys that most vanaras resemble. Their stooping build grants them a +4 racial bonus to CMD when resisting a bull rush or trip. These vanaras usually have a thick mane of hair on the head and shoulders (called a \"cape\") and shorter tails."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This racial trait replaces prehensile tail."}],"applies":{"Not":{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:vanara_whitecape"},"count":1}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:vanara_whitecape"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:race_trait:vanara_whitecape"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_races:race_trait:vanara_risky_troublemaker"},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","Vanara Racial Trait","SpecialQuality","Special Quality"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Vanara_ReplacePrehensileTail","value":"True"}}],"provenance":{"book":"advanced_race_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:1237"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
