[{"id":"advanced_race_guide:spell:black_mark","label":"Black Mark","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You mark the target with a black marking on its skin; the mark's exact appearance determined by you, but can be no larger than your hand. The black mark functions as a mark of justice, and when the mark is activated, the target becomes shaken anytime it is on or in the water more than a 5 feet from shore. In addition, as long as the black mark is active, the target is affected as if subject to nature's exile, but all creatures with the aquatic or water subtype or with a swim speed are made hostile, even those not of the animal type, though nonaquatic animals are not."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: Any time the cursed creature travels on or in the water more than 1 mile from shore, each day it (or the vessel it's on) is attacked by one or more aquatic or water monsters, as if summoned by summon nature's ally VII (caster level 13th)."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Black Mark"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Curse, Fear"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Permanent"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will Negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Var":"v94f78e5e0d4be5c0"},"op":"Eq","rhs":{"Const":1}}},{"Holds":{"what":{"Rule":"core_rulebook:template:ishuman"},"count":1}}]}},"print":true,"pool":"","tags":["Arcane","Divine"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"druid","spell_level":7}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":7}},"when":"Always"}],"provenance":{"book":"advanced_race_guide","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_spells.lst:61","pathfinder/paizo/roleplaying_game/mythic_adventures/ma_spells.lst:27"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
