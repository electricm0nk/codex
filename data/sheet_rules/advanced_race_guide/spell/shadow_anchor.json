[{"id":"advanced_race_guide:spell:shadow_anchor","label":"Shadow Anchor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The target's shadow becomes a flexible tether to its current square. The creature can move up to 5 feet from that square without penalty. Moving farther than 5 feet from the tether point requires the target to make a bull rush combat maneuver check against a CMB of "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"CasterLevel":"Holder"},{"Const":2}]},{"AbilityMod":"Int"}]}},{"Text":" (if a witch or wizard) or "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"CasterLevel":"Holder"},{"Const":2}]},{"AbilityMod":"Cha"}]}},{"Text":" (if a bard or sorcerer). The target takes a -1 penalty for every 5 feet of distance between it and its tethered square. Failing this check means the target's move is wasted and it cannot move farther away. If it fails this check by 10 or more, it is pulled 5 feet toward the tether square and is knocked prone. If it beats the check by 10 or more, the spell ends. This spell does not work on creatures that do not cast shadows or reflections. If the target uses a teleportation effect or leaves the current plane, the spell ends."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: Add your tier to the CMD of the shadow tether. A creature attempting to escape the shadow tether using planar travel or teleportation must succeed at a Will saving throw or be shunted to the Plane of Shadow instead of its intended destination, as if it had cast shadow walk (if the target could not reach the Shadow Plane from its current location using shadow walk, this aspect of the spell has no effect)."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Shadow Anchor"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Shadow"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will Negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Illusion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Shadow"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Var":"v94f78e5e0d4be5c0"},"op":"Eq","rhs":{"Const":1}}},{"Holds":{"what":{"Rule":"bestiary_4:template:iswayang"},"count":1}}]}},"print":true,"pool":"","tags":["Arcane","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bard","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"mesmerist","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":2}},"when":"Always"}],"provenance":{"book":"advanced_race_guide","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_spells.lst:223","pathfinder/paizo/roleplaying_game/mythic_adventures/ma_spells.lst:229","pathfind