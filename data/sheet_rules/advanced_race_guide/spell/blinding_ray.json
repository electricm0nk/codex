[{"id":"advanced_race_guide:spell:blinding_ray","label":"Blinding Ray","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You blast your enemies with blinding rays of sunlight. You may fire "},{"Slot":{"Min":[{"Const":3},{"Sum":[{"Const":1},{"Div":[{"Sum":[{"CasterLevel":"Holder"},{"Const":-3}]},{"Const":4}]}]}]}},{"Text":" rays. Each ray requires a ranged touch attack to hit. If a ray hits, it explodes into powerful motes of light, and the target must save or be blinded for 1 round. If the target has light blindness, light sensitivity, or is otherwise vulnerable to bright light, it instead must save or be blinded for 1d4 rounds and take "},{"Slot":{"Min":[{"Const":5},{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}]}},{"Text":"d4 points of damage. Any creature blinded by a ray sheds light as a sunrod for the duration of its blindness. The rays may be fired at the same or different targets, but all rays must be aimed at targets within 30 feet of each other and fired simultaneously."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: On a successful saving throw, the target is dazzled for 1 round. On a failed saving throw, the target is instead blinded for 1d4 rounds. A target with light blindness, light sensitivity, or any other vulnerability to light is instead blinded for 1d4 rounds on asuccessful saving throw and permanently blinded on a failed saving throw."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Blinding Ray"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Good, Light"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces