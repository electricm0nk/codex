[{"id":"advanced_race_guide:spell:battle_trance","label":"Battle Trance","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are transformed into a single-minded force of destruction. You gain the ferocity monster special ability, a number of temporary hit points equal to 1d6 + your caster level (maximum +10), and a +4 morale bonus on saving throws against mind-affecting effects. You cannot use the withdraw action or willingly move away from a creature that has attacked you. When you use this spell, you immediately take 4 points of Intelligence damage. You must make a DC 20 concentration check to cast spells, and all other concentration checks to cast spells have a -5 penalty."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: The number of temporary hit points you gain increases to 2d6 + your caster level (maximum +10) + your tier. The morale bonus on saving throws against mind-affecting effects increases to +6. Augmented (5th): If you expend two uses of mythic power, you gain a +4 morale bonus to Strength, immunity to non mythic mind-affecting effects, and DR 5/epic."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Battle Trance"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Mind-Affecting"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will Negates"}],"pick_last":false,