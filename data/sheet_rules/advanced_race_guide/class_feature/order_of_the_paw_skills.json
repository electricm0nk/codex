[{"id":"advanced_race_guide:class_feature:order_of_the_paw_skills","label":"Skills","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"An order of the paw cavalier adds Knowledge (nature) and Survival to his list of class skills. He can make Knowledge (nature) checks untrained. Also, an order of the paw cavalier is adept at following tracks while mounted, using his mount's speed rather than his own to determine the penalty for tracking while moving, whether he is mounted or not."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:class_feature:order_of_the_paw"},"when":{"Compare":{"lhs":{"Var":"va14bdaed00123777"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"ClassSkill":"knowledge_nature"}},{"FactGrant":{"ClassSkill":"survival"}}],"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:320"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
