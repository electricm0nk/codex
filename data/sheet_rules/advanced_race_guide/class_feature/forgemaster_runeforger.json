[{"id":"advanced_race_guide:class_feature:forgemaster_runeforger","label":"Runeforger","value":{"Number":{"Sum":[{"Const":1},{"Div":[{"Var":"v4de69de69e1b0ba0"},{"Const":2}]}]}},"prose":[{"family":"Desc","pieces":[{"Text":"A forgemaster may inscribe mystical runes upon a suit of armor, shield, or weapon as full-round action, using this ability "},{"Slot":{"Sum":[{"Const":3},{"AbilityMod":"Int"}]}},{"Text":" times per day. These runes last "},{"Slot":{"Var":"v4de69de69e1b0ba0"}},{"Text":" rounds, but inscribing the same rune twice on an item increases this duration to "},{"Slot":{"Var":"v4de69de69e1b0ba0"}},{"Text":" minutes, three times to "},{"Text":" minutes, and four times to "},{"Slot":{"Var":"v4de69de69e1b0ba0"}},{"Text":" hours. Erase affects runes as magical writing. Only one type of rune marked with an asterisk (*) may be placed on an item at any given time. This ability replaces channel energy."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"runeforger_option"},"print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:class_feature:cleric_archetype_forgemaster"},"when":{"Compare":{"lhs":{"ClassLevel":"cleric"},"op":"Gte","rhs":{"Const":1}}}}],"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:64"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
