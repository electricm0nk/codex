[{"id":"advanced_race_guide:class_feature:reincarnated_oracle_spirit_memories","label":"Spirit Memories","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Once per day, you call upon the unfulfilled desires and goals of your past lives and project their frustration and despair through your eyes at a target. This is a gaze attack affecting one creature. The target must make a Will save (DC "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"Var":"v6d748c75963035d8"},{"Const":2}]},{"AbilityMod":"Cha"}]}},{"Text":") or be sickened and staggered for 1 round. This is a mind-affecting compulsion effect. You can use this ability "},{"Slot":{"Sum":[{"Const":3},{"AbilityMod":"Cha"}]}},{"Text":" times per day. You must take this revelation at 1st, 3rd, or 7th level."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Not":{"Compare":{"lhs":{"ClassLevel":"oracle"},"op":"Gte","rhs":{"Const":3}}}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:reincarnated_oracle_location_memories"},"count":1}}]}},"print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality","Supernatural","ReincarnatedOracleRevelation"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:944"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
