[{"id":"advanced_race_guide:class_feature:rogue_talent_graceful_faller","label":"Graceful Faller","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A catfolk rogue with this talent lands on her feet even when she takes lethal damage from a fall. If the catfolk rogue also has the nimble faller racial trait, she takes damage from any fall as if it were 20 feet shorter than it actually is."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Holds":{"what":{"Rule":"bestiary_3:template:iscatfolk"},"count":1}},"print":true,"pool":"special_ability","tags":["ClassFeatures","SpecialQuality","Extraordinary","RogueTalent"],"subject":"Character","repeatable":false,"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:436"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
