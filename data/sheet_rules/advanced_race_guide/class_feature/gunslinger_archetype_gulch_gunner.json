[{"id":"advanced_race_guide:class_feature:gunslinger_archetype_gulch_gunner","label":"Gulch Gunner","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Ratfolk warfare often occurs in cramped, claustrophobic spaces such as the ratfolk's own underground warrens and heavily trapped gulch fortresses, or the subterranean tunnels of goblins and similar foes. Since these battlegrounds often have tight corners and few areas with long lines of sight, those ratfolk who seek to master the use of firearms almost inevitably become experts in close-quarters combat. These gulch gunners often specialize in proficiency with a single pistol (easily handled in tight spaces) and wander from warren to warren selling their tunnel-shooting skills to the highest bidder."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"gunslinger"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:gunslinger_archetype_gulch_gunner"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerGrit"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerDeadeyeDeed"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerPistolWhipDeed"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerMenacingShotDeed"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerGunTraining9"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerGunTraining13"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"GunslingerGunTraining17"}},"count":1}}]}}}]}},{"Holds":{"what":{"Rule":"bestiary_3:template:isratfolk"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:gunslinger_archetype_gulch_gunner"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds"