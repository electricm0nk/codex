[{"id":"advanced_race_guide:class_feature:paladin_archetype_redeemer","label":"Redeemer","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As most half-orcs are outcasts, a half-orc paladin recognizes that often those who are monstrous are not necessarily evil and that sometimes even those who are evil became that way because of circumstances and misfortune. Some half-orc paladins take up these misunderstood creatures as their cause, standing up for the monstrous creatures and, when possible, leading them to the light. These paladins are called redeemers. A redeemer has the following class features."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"paladin"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:paladin_archetype_redeemer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"PaladinSmiteEvil"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"PaladinDetectEvil"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"PaladinAuraOfResolve"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"PaladinAuraOfJustice"}},"count":1}}]}}}]}},{"Holds":{"what":{"Rule":"core_rulebook:template:ishalforc"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:paladin_archetype_redeemer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:paladin_archetype_hospitaler"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:paladin_archetype_sacred_servant"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:paladin_archetype_undead_scourge"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:paladin_archetype_redeemer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_ra