[{"id":"advanced_race_guide:class_feature:rogue_archetype_cat_burglar","label":"Cat Burglar","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Gifted with finesse and stealth, catfolk make excellent burglars. Cat burglars are masters of breaking and entering, using their feline grace to make it seem as though no crime was ever committed in the first place. Few locks can withstand skilled cat burglars, and such nimble rogues are capable of bypassing traps without activating them and enabling associates to do the same."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"rogue"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_cat_burglar"},"count":1}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RogueUncannyDodge"}},"count":1}}}]}},{"Holds":{"what":{"Rule":"bestiary_3:template:iscatfolk"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_cat_burglar"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_burglar"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_scout"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_trapsmith"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_cat_burglar"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_deadly_courtesan"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_archetype_filcher"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:rogue_archetype_bellflower_irrigator"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:rogue_archetype_toxic_talon"},"count":1}},{"Holds":{"what":{"Rule":"in