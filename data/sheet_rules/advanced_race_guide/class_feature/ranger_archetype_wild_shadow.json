[{"id":"advanced_race_guide:class_feature:ranger_archetype_wild_shadow","label":"Wild Shadow","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The isolation that some half-elves feel leads them to live a life of isolation amid the wild places of the world. Such rangers stalk the wild like shadows, creating close bonds with the wild itself instead of seeking the solace and aid of companions. While ill at ease within cities and other urban areas, they are adept at using the terrain to tactical advantage; they dart through brambles and rough terrain with uncommon grace and use the land itself to lock down enemies."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"ranger"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:ranger_archetype_wild_shadow"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerTrack"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerWildEmpathy"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerFavoredTerrain"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerHuntersBond"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerWoodlandStride"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerQuarry"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerCamouflage"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"RangerImprovedQuarry"}},"count":1}}]}}}]}},{"Holds":{"what":{"Fact":{"name":"IsHalfElf","value":"true"}},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:ranger_archetype_wild_shadow"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:ranger_archetype_wave_warden"},"count":1}},