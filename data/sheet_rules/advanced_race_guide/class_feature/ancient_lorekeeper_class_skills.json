[{"id":"advanced_race_guide:class_feature:ancient_lorekeeper_class_skills","label":"Class Skills","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"An ancient lorekeeper adds Knowledge (arcane) and Knowledge (local) to her list of class skills. Whenever she makes a Knowledge check of any kind about a question regarding elves (creatures of the elf subtype), the ancient lorekeeper adds half her class level on her check. This replaces the bonus skills the ancient lorekeeper gains from her mystery."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:class_feature:oracle_archetype_ancient_lorekeeper"},"when":{"Compare":{"lhs":{"ClassLevel":"oracle"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"ClassSkillGroup":"Craft"}},{"FactGrant":{"ClassSkill":"diplomacy"}},{"FactGrant":{"ClassSkill":"heal"}},{"FactGrant":{"ClassSkill":"knowledge_history"}},{"FactGrant":{"ClassSkill":"knowledge_planes"}},{"FactGrant":{"ClassSkill":"knowledge_religion"}},{"FactGrant":{"ClassSkill":"knowledge_arcana"}},{"FactGrant":{"ClassSkill":"knowledge_local"}}],"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:112"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
