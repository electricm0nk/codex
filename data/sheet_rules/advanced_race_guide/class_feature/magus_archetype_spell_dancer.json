[{"id":"advanced_race_guide:class_feature:magus_archetype_spell_dancer","label":"Spell Dancer","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The strong emphasis on wizards within elven culture influences how even non-wizard elves see themselves. Many elven magi do not consider themselves masters of a blend of martial and magical talents, but rather a sub-category of wizards who study the effect of physical movement and techniques upon spellcasting ability. They believe their ability to cast spells while fighting is an outgrowth of the concept of the \"spell dance,\" which itself is just another kind of wizardry."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"magus"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:magus_archetype_spell_dancer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusBonusFeat5"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusMediumArmor"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusHeavyArmor"}},"count":1}}]}}}]}},{"Holds":{"what":{"Rule":"core_rulebook:template:iself"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:magus_archetype_spell_dancer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:magus_archetype_eldritch_scion"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:magus_archetype_spell_dancer"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:magus_archetype_esoteric"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:magus_archetype_mindblade"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:magus_archetype_bladebound"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:c