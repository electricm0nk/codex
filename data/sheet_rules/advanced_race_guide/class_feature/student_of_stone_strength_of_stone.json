[{"id":"advanced_race_guide:class_feature:student_of_stone_strength_of_stone","label":"Strength of Stone","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A student of stone learns to draw strength from the earth. So long as both he and his opponent are touching the ground, the student of stone gains a +1 bonus on attack rolls, damage rolls, bull rush and trip combat maneuver rolls, and to his CMD when resisting a bull rush or trip attempt. This ability replaces fast movement."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:class_feature:monk_archetype_student_of_stone"},"when":{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":3}}}}],"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:681"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
