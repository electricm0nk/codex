[{"id":"advanced_race_guide:class_feature:wishcrafter_expanded_wishcraft","label":"Expanded Wishcraft","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"The wishcrafter grows more adept at altering reality to fit the whims of others. She may add an additional spell selected from the sorcerer/wizard spell list to her list of spells known. This spell must be one level lower than the highest-level spell she can cast. A wishcrafter can only use these spells in conjunction with her wishbound arcana ability. For example, if she used this ability to learn cat's grace, she can only cast it when another creature wishes for it, and can't cast it on herself because it is a targeted spell. She cannot use these spells to craft or recharge magic items."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"SpellCell":{"class":"sorcerer","level":0}},"print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:class_feature:wishcrafter_sorcerer_archetype"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":3}}}},{"by":{"Rule":"advanced_race_guide:class_feature:wishcrafter_sorcerer_archetype"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":5}}}},{"by":{"Rule":"advanced_race_guide:class_feature:wishcrafter_sorcerer_archetype"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":7}}}},{"by":{"Rule":"advanced_race_guide:class_feature:wishcrafter_sorcerer_archetype"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"advanced_race_guide:class_feature:wishcrafter_sorcerer_archetype"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":11}}}},{"by":{"Rule":"advanced_race_guide:class_feature:wishcrafter_sorcerer_archetype"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"