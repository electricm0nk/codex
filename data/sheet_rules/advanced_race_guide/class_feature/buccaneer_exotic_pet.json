[{"id":"advanced_race_guide:class_feature:buccaneer_exotic_pet","label":"Exotic Pet","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A buccaneer gains a familiar as a wizard of half the buccaneer's class level (though the exotic pet never gains the ability to deliver touch spells or share spells). This pet is typically a monkey or parrot (use the stats for a raven familiar). Such animals are useful scouts, even in the thick of combat. As long as the pet is within 30 feet of the buccaneer, the buccaneer also gains the benefit of evasion."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ArchetypeAbility","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:class_feature:gunslinger_archetype_buccaneer"},"when":{"Compare":{"lhs":{"ClassLevel":"gunslinger"},"op":"Gte","rhs":{"Const":5}}}}],"offers":{"id":"advanced_race_guide:class_feature:buccaneer_exotic_pet","count":{"Const":1},"from":{"Races":["monkey","familiar_parrot"]}},"grants":[{"FactGrant":{"CompanionSlots":{"role":"Exotic Pet","count":{"Const":1}}}}],"provenance":{"book":"advanced_race_guide","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_class.lst:359"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
