[{"id":"advanced_race_guide:class_feature:cleric_archetype_fiendish_vessel","label":"Fiendish Vessel","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Many clerics pray to or make evil bargains with fiendish powers, devoting body and soul to the insane plans and wicked aims of their despicable patrons. But these mortal clerics are often just shallow beings searching for quick power or the caress of true and final oblivion-few truly grasp the full scope of the entities they worship. Fiendish vessels, through their fiendish heritage, share an innate connection with their patron, and that connection grants them understanding and power."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Never","print":true,"pool":"archetype","tags":["PFSNotLegal"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy1","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy2","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy3","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy4","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy5","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy6","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy7","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy8","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy9","value":"true"}},{"FactDeclare":{"name":"Cleric_CF_ChannelEnergy10","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy1","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy2","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy3","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy4","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy5","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy6","value":"true"}},{"FactDeclare":{"name":"Cleric_Archetype_ChannelEnergy7