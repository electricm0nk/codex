[{"id":"advanced_race_guide:ability:builder_racial_trait_rock_catching","label":"Rock Catching","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Can catch small, medium, or large rocks. 1/round, you can catch a rock (or similarly shaped projectile) that would hit you by making a reflex save to catch it as a free action. The DC is 15 for small, 20 for medium, and 25 for large. If the attack had a magic bonus, add it to the DC. You need to be aware of the attack to use this ability."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"[Cost: "},{"Slot":{"Const":2}},{"Text":"]"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary","RacialTrait","BuilderAdvancedDefenseTrait","Monstrous"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary:monster:giant_cloud"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_fire"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_frost"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_hill"},"when":"Always"},{"by":{"Rule":"bestiary:monster:giant_storm"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_brineborn_marsh"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_marsh"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_taiga"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:giant_wood"},"when":"Always"},{"by":{"Rule":"inner_sea_bestiary:monster:giant_shadow"},"when":"Always"}],"provenance":{"book":"advanced_race_guide","kind":"ability","closure_rows":["pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_builder.lst:273"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
