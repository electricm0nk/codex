[{"id":"inner_sea_world_guide:monster_ability:charau_ka_thrown_weapon_mastery","label":"Thrown-Weapon Mastery","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Charau-ka are masters of thrown weapons. All charau-ka gain Throw Anything as a bonus feat. In addition, a charau-ka gains a +1 racial bonus on all thrown weapons, and their threat range for thrown weapons is doubled, as if the charau-ka possessed the Improve Critical feat for all thrown weapons. This effect doesn't stack with any other effect that expands the threat range of a weapon."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":"Attack","bonus_type":{"name":"Racial","mode":"Plain"},"print":true,"pool":"special_ability","tags":["SpecialAttack","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_world_guide","kind":"monster_ability","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_world_guide/iswg_abilities_race.lst:20"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"inner_sea_world_guide:monster_ability:charau_ka_thrown_weapon_mastery#weapon1","label":"Thrown weapons critrangedouble","value":{"Number":{"Const":1}},"applies":"Always","target":{"Other":"weapon critrangedouble"},"bonus_type":{"name":"NonStackingCrit","mode":"Plain"},"print":true,"pool":"special_ability","tags":["SpecialAttack","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_world_guide","kind":"monster_ability","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_world_guide/iswg_abilities_race.lst:20"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
