[{"id":"inner_sea_world_guide:race_trait:gillman_servitor","label":"Servitor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Gillmen serve the dark, unfathomable schemes of the reclusive aboleths, but unless the gillmen go against the orders of their aboleth masters (which are often unknown to them, masked in the form of hidden memories triggered by key events), they are free to act as they wish. In a campaign, these orders are wholly up to the GM, meaning the player of a gillman character cedes some elements of self-control when it best serves the story of the campaign."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Not":{"Holds":{"what":{"Fact":{"name":"Gillman_ReplaceServitor","value":"True"}},"count":1}}},"print":true,"pool":"special_ability","tags":["RacialTraits","Gillman Racial Trait","Gillman Racial Default","SpecialQuality","Special Quality","Gillman MA Racial Trait"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_world_guide","kind":"race_trait","closure_rows":["pathfinder/paizo/roleplaying_game/core_essentials/races/gillman/gillman_abilities_race.lst:20","pathfinder/paizo/roleplaying_game/advanced_race_guide/arg_abilities_race.lst:868","pathfinder/paizo/campaign_setting/inner_sea_races/isr_abilities_race.lst:704","pathfinder/paizo/campaign_setting/inner_sea_world_guide/iswg_abilities_race.lst:44","pathfinder/paizo/roleplaying_game/mythic_adventures/ma_feats.lst:502"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
