[{"id":"core_rulebook:feat:blind_fight","label":"Blind-Fight","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are skillled at attacking opponents that you cannot clearly perceive."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"In melee, every time you miss because of concealment (see Chapter 8), you can reroll your miss chance percentile roll one time to see if you actually hit. An invisible attacker gets no advantages related to hitting you in melee. That is, you don't lose your Dexterity bonus to Armor Class, and the attacker doesn't get the usual +2 bonus for being invisible. The invisible attacker's bonuses do still apply for ranged attacks, however. You do not need to make Acrobatics skill checks to move at full speed while blinded."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"feat","tags":["Combat","AttackOption","PsychicBloodline"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:bloodrager_bloodline_feat_blind_fight"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_blind_fight"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:core_domain_loss_subdomain"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:core_domain_night_subdomain"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:inquisitor_domain_darkness"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:inquisitor_domain_loss_subdomain"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:inquisitor_domain_night_subdomain"},"when":"Always"},{"by":{"Rule":"advanced_players_guide:class_feature:terrain_mastery_underground"},"when":"Always"},{"by":{"Rule":"adventurers_guide:ability:wayfinder_ioun_stone_resonant_power_incandescent_blue_sphere"},"when":"Always"},{"by":{"Rule":"core_rulebook:class_feature:darkness