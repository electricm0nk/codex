[{"id":"core_rulebook:feat:stunning_fist","label":"Stunning Fist","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You know just where to strike to temporarily stun a foe. "},{"Slot":{"Var":"v2fbd97d31b47a06f"}},{"Text":"/day (DC "},{"Slot":{"Var":"v53f64c775ada0733"}},{"Text":")"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"You must declare that you are using this feat before you make your attack roll (thus, a failed attack roll ruins the attempt). Stunning Fist forces a foe damaged by your unarmed attack to make a Fortitude saving throw (DC "},{"Slot":{"Var":"v53f64c775ada0733"}},{"Text":"), in addition to dealing damage normally. A defender who fails this saving throw is stunned for 1 round (until just before your next turn). A stunned character drops everything held, can't take actions, loses any Dexterity bonus to AC, and takes a -2 penalty to AC. You may attempt a stunning attack once per day for every four levels you have attained (but see Special), and no more than once per round. Constructs, oozes, plants, undead, incorporeal creatures, and creatures immune to critical hits cannot be stunned."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Wis"},{"Var":"ve59ae2a694dab2b8"}]},"op":"Gte","rhs":{"Const":13}}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":13}}}]}}]}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":8}}}]},"print":true,"pool":"feat","tags":["Combat","AttackOption","CloakedWolfBonusFeat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_stunning_fist"},"when":"Always"},{"by":{"Rule":"core_rulebook:class_feature:monk_stunning_fist"},"when":"Always"},{"by":{"Rule":"inner_sea_combat:class_feature:ranger_combat_style_feat_stunning_fist"},"when":{"Situational":{"text":"while wearing no heavy armor"}}},{"by":{"Rule":"pathfinder_unchained:class_feature:unchained_monk_stunning_fist"},"when":"Always"},{"by":{"Rule":"ultimate_magic:class_feature:discovery_stunning_fist"},"when":"Always"},{"by":{"Rule":"ultimate_psionics:monster_ability:astral_stunning_fist"},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_feats.lst:171","pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_feats.lst:129"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
