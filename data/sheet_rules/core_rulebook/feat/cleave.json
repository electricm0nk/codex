[{"id":"core_rulebook:feat:cleave","label":"Cleave","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can strike two adjacent foes with a single swing."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"As a standard action, you can make a single attack at your full base attack bonus against a foe within reach. If you hit, you deal damage normally and can make an additional attack (using your full base attack bonus) against a foe that is adjacent to the first and also within reach. You can only make one additional attack per round with this feat. When you use this feat, you take a -2 penalty to your Armor Class until your next turn."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:power_attack"},"count":1}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"vc314492280238530"},"op":"Gte","rhs":{"Const":13}}},{"Holds":{"what":{"Rule":"core_rulebook:feat:power_attack"},"count":1}},{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"vc314492280238530"},"op":"Gte","rhs":{"Const":13}}}]},"print":true,"pool":"feat","tags":["Combat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:bloodrager_bloodline_feat_cleave"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:warpriest_bonus_feat_cleave"},"when":"Always"},{"by":{"Rule":"core_rulebook:class_feature:sorcerer_bloodline_feat_cleave"},"when":"Always"},{"by":{"Rule":"ultimate_psionics:monster_ability:astral_cleave"},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_feats.lst:30"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
