[{"id":"core_rulebook:template:blinded","label":"Blinded","value":{"Number":{"Const":-2}},"prose":[{"family":"WhenActive","pieces":[{"Text":"You cannot see. You take a -2 penalty to Armor Class, loses your Dexterity bonus to AC (if any), and take a -4 penalty on most Strength- and Dexterity-based skill checks and on opposed Perception skill checks. All checks and activities that rely on vision (such as reading and Perception checks based on sight) automatically fail. All opponents are considered to have total concealment (50% miss chance) against the blinded character. Blind creatures must make a DC 10 Acrobatics skill check to move faster than half speed. Creatures that fail this check fall prone."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Situational":{"text":"when active"}},"target":"Ac","print":false,"pool":"","subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_equipment:equipment:mask_of_a_thousand_tomes"},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"template","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_templates.lst:244"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:template:blinded#bonus1","label":"Blinded (AC)","value":{"Number":{"Mul":[{"Const":-1},{"Max":[{"Const":0},{"AbilityMod":"Dex"}]}]}},"applies":{"Situational":{"text":"when active"}},"target":"Ac","print":false,"pool":"","subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"template","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_templates.lst:244"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:template:blinded#bonus2","label":"Blinded (strength skills)","value":{"Number":{"Const":-4}},"applies":{"Situational":{"text":"when active"}},"target":{"SkillGroup":"Strength"},"print":false,"pool":"","subj