[{"id":"core_rulebook:companion:crocodile_death_roll","label":"Death Roll","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When grappling a foe of its size or smaller, a crocodile can perform a death roll upon making a successful grapple check. As it clings to its foe, it tucks in its legs and rolls rapidly, twisting and wrenching its victim. The crocodile inflicts its bite damage and knocks the creature prone. If successful, the crocodile maintains its grapple."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"("},{"Slot":{"Var":"vea1a9eca9a5b5e30"}},{"Text":"d"},{"Slot":{"Var":"vf70be97e693b122f"}},{"Text":"+"},{"Slot":{"Mul":[{"Max":[{"AbilityMod":"Str"},{"Const":0}]},{"Div":[{"Const":3},{"Const":2}]}]}},{"Text":" plus trip)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialAttack","Special Attack","Special Ability","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"companion","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_companion.lst:188"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
