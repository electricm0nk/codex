[{"id":"core_rulebook:spell:vampiric_touch","label":"Vampiric Touch","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You must succeed on a melee touch attack. Your touch deals 1d6 points of damage per two caster levels [maximum 10d6]. You gain temporary hit points equal to the damage you deal. You can't gain more than the subject's current hit points + the subject's Constitution score [which is enough to kill the subject]. The temporary hit points disappear 1 hour later."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Your touch deals (min(10,floor(CASTERLEVEL/2)))d6 points of damage."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You must succeed on a melee touch attack. Your touch deals 1d6 points of damage per two caster levels [maximum 10d6]. You gain temporary hit points equal to the damage you deal. You can't gain more than the subject's current hit points + the subject's Constitution score [which is enough to kill the subject]. The temporary hit points disappear 1 hour later."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: The spell's damage increases to 1d8 points of damage per 2 caster levels (maximum 10d8). Your melee touch attack to deliver the spell threatens a critical hit on a 19 or 20. This expanded threat range doesn't stack with other effects or abilities that increase the threat range. If the damage kills the target, you gain fast healing 5 for a number of rounds equal to the Hit Dice of the target."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Vampiric Touch"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false