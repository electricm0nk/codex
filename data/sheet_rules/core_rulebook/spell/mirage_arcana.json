[{"id":"core_rulebook:spell:mirage_arcana","label":"Mirage Arcana","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This spell functions like hallucinatory terrain, except that it enables you to make any area appear to be something other than it is. The illusion includes audible, visual, tactile, and olfactory elements. Unlike hallucinatory terrain, the spell can alter the appearance of structures [or add them where none are present]. Still, it can't disguise, conceal, or add creatures [though creatures within the area might hide themselves within the illusion just as they can hide themselves within a real location]."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions like hallucinatory terrain, except that it enables you to make any area appear to be something other than it is."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions like hallucinatory terrain, except that it enables you to make any area appear to be something other than it is. The illusion includes audible, visual, tactile, and olfactory elements. Unlike hallucinatory terrain, the spell can alter the appearance of structures [or add them where none are present]. Still, it can't disguise, conceal, or add creatures [though creatures within the area might hide themselves within the illusion just as they can hide themselves within a real location]."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Concentration +(CASTERLEVEL) hours [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":400},{"Mul":[{"C