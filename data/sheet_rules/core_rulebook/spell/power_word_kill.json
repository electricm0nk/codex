[{"id":"core_rulebook:spell:power_word_kill","label":"Power Word Kill","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You utter a single word of power that instantly kills one creature of your choice, whether the creature can hear the word or not. Any creature that currently has 101 or more hit points is unaffected by power word kill."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You utter a single word of power that instantly kills one creature of your choice, whether the creature can hear the word or not."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You utter a single word of power that instantly kills one creature of your choice, whether the creature can hear the word or not. Any creature that currently has 101 or more hit points is unaffected by power word kill."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: Treat the target's current hit point total as though it were lowered by 5 times your tier. For example, a 3rd-tier archmage casting mythic power word kill would instantly kill a creature with 85 hit points or fewer. You can target a creature with more hit points than this spell could normally affect, causing it to become exhausted. Augmented (6th): If you expend four uses of mythic power, the magic of the word lingers around the target. Until the beginning of your next turn, if the target's hit point total drops to the point that this spell would have killed it upon casting, it's instantly slain."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Power Word Kill"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V"}],"pick_last":false,"suppress_when_all_zero":false},{"famil