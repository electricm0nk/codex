[{"id":"core_rulebook:spell:protection_from_energy","label":"Protection from Energy","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Protection from energy grants temporary immunity to the type of energy you specify when you cast it [acid, cold, electricity, fire, or sonic]. When the spell absorbs 12 points per caster level of energy damage [to a maximum of 120 points at 10th level], it is discharged. Protection from energy overlaps [and does not stack with] resist energy. If a character is warded by protection from energy and resist energy, the protection spell absorbs damage until its power is exhausted."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Protection from energy grants temporary immunity to the type of energy you specify when you cast it."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Protection from energy grants temporary immunity to the type of energy you specify when you cast it [acid, cold, electricity, fire, or sonic]. When the spell absorbs 12 points per caster level of energy damage [to a maximum of 120 points at 10th level], it is discharged. Protection from energy overlaps [and does not stack with] resist energy. If a character is warded by protection from energy and resist energy, the protection spell absorbs damage until its power is exhausted."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, DF"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL*10) minutes or until discharged"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving thr