[{"id":"core_rulebook:spell:overland_flight","label":"Overland Flight","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This spell functions like a fly spell, except you can fly at a speed of 40 feet (30 feet if wearing medium or heavy armor, or if carrying a medium or heavy load)."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions like a fly spell, except you can fly at a speed of 40 feet [30 feet if wearing medium or heavy armor, or if carrying a medium or heavy load] with a bonus on Fly skill checks equal to half your caster level. When using this spell for long-distance movement, you can hustle without taking nonlethal damage [a forced march still requires Constitution checks]. This means you can cover 64 miles in an 8-hour period of flight [or 48 miles at a speed of 30 feet]."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions like a fly spell, except you can fly at a speed of 40 feet [30 feet if wearing medium or heavy armor, or if carrying a medium or heavy load] with a bonus on Fly skill checks equal to half your caster level. When using this spell for long-distance movement, you can hustle without taking nonlethal damage [a forced march still requires Constitution checks]. This means you can cover 64 miles in an 8-hour period of flight [or 48 miles at a speed of 30 feet]."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) hours"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"AirSchool"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"alchemist","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":5}},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_spells.lst:419","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:681","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_spells.lst:790","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_spells.lst:961","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_spells.lst:1526","pathfinder/paizo/roleplaying_game/advanced_players_guide/apg_spells.lst:1668","pathfinder/paizo/roleplaying_game/core_rulebook/cr_spells.lst:1172","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:412","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:1857","pathfinder/paizo/roleplaying_game/ultimate_magic/um_spells.lst:430"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
