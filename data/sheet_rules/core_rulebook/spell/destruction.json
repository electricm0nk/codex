[{"id":"core_rulebook:spell:destruction","label":"Destruction","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This spell instantly delivers (caster level times 10) points of damage."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell instantly delivers 10 points of damage per caster level. If the spell slays the target, it consumes the remains utterly in holy [or unholy] fire [but not its equipment or possessions]. If the target's Fortitude saving throw succeeds, it instead takes 10d6 points of damage. The only way to restore life to a character who has failed to save against this spell [and was slain] is to use true resurrection, a carefully worded wish spell followed by resurrection, or miracle."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell instantly delivers 10 points of damage per caster level. If the spell slays the target, it consumes the remains utterly in holy [or unholy] fire [but not its equipment or possessions]. If the target's Fortitude saving throw succeeds, it instead takes 10d6 points of damage. The only way to restore life to a character who has failed to save against this spell [and was slain] is to use true resurrection, a carefully worded wish spell followed by resurrection, or miracle."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Death"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div"