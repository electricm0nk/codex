[{"id":"core_rulebook:spell:fly","label":"Fly","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The subject can fly at a speed of 60 feet (or 40 feet if it wears medium or heavy armor, or if it carries a medium or heavy load)."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The subject can fly at a speed of 60 feet [or 40 feet if it wears medium or heavy armor, or if it carries a medium or heavy load]. It can ascend at half speed and descend at double speed, and its maneuverability is good. Using a fly spell requires only as much concentration as walking, so the subject can attack or cast spells normally. The subject of a fly spell can charge but not run, and it cannot carry aloft more weight than its maximum load, plus any armor it wears. The subject gains a bonus on Fly skill checks equal to 1/2 your caster level. Should the spell duration expire while the subject is still aloft, the magic fails slowly. The subject floats downward 60 feet per round for 1d6 rounds. If it reaches the ground in that amount of time, it lands safely. If not, it falls the rest of the distance, taking 1d6 points of damage per 10 feet of fall. Since dispelling a spell effectively ends it, the subject also descends safely in this way if the fly spell is dispelled, but not if it is negated by an antimagic field."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The subject can fly at a speed of 60 feet [or 40 feet if it wears medium or heavy armor, or if it carries a medium or heavy load]. It can ascend at half speed and descend at double speed, and its maneuverability is good. Using a fly spell requires only as much concentration as walking, so the subject can attack or cast spells normally. The subject of a fly spell can charge but not run, and it cannot carry aloft more weight than its maximum load, plus any armor it wears. The subject gains a bonus on Fly skill checks equal to 1/2 your caster level. Should the spell duration expire while the subject is still aloft, the magic fails slowly. The subject floats downward 60 feet per round for 1d6 rounds. If it reaches the ground in that amount of time, it lands safely. If not, it falls the rest of the distance, taking 1d6 points of damage per 10 feet of fall. Since dispelling a spell effectively ends it, the subject also descends safely in this way if the fly spell is dispelled, but not if it is negated by an antimagic field."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Mythic: The fly speed changes to 120 feet (or 80 feet if the target is wearing medium or heavy armor, or carrying a medium or heavy load) with perfect maneuverability. When the duration expires, the target is protected by feather fall for a number of rounds equal to your caster level. Augmented (3rd): If you expend two uses of mythic power, the target adds your tier on Reflex saves and as a dodge bonus to AC. It gains these bonuses only while flying."}],"applies":{"Holds":{"what":{"MissingRule":{"pool":"mythic_spell","name":"Fly"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Creature touched"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"AirSchool"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants 60 Fly speed, or 40 if Medium Armor. Adds half Caster Level to Fly Skill."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants 60 Fly speed, or 40 if Medium Armor. Adds half Caster Level to Fly Skill."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Holds":{"what":{"Rule":"core_rulebook:feat:skill_focus"},"count":1}},"print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"bloodrager","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"shaman","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"alchemist","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"medium","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":3}},"when":"Always"}],"offers":{"id":"core_rulebook:spell:fly","count":{"Const":1},"from":{"Number":{"min":{"Const":1},"max":{"Const":20}}}},"provenance":{"book":"core_rulebook","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_spells.lst:240","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:411","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_