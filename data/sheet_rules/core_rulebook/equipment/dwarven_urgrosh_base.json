[{"id":"core_rulebook:equipment:dwarven_urgrosh_base","label":"Dwarven Urgrosh","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A dwarven urgrosh is a double weapon--an axe head and a spear point on opposite ends of a long haft. The urgrosh's axe head is a slashing weapon that deals 1d8 points of damage. Its spear head is a piercing weapon that deals 1d6 points of damage. You can use either head as the primary weapon. The other becomes the off-hand weapon. If you use an urgrosh against a charging character, the spear head is the part of the weapon that deals damage. Dwarves treat dwarven urgroshes as martial weapons."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x3"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x3"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Alternate critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":false,"pool":"","tags":["Weapon","Resizable","Melee","Exotic","OneHanded","Double","Dwarven","Slashing","Weapon Group Double"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:195"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:equipment:dwarven_urgrosh_base#alt","label":"Dwarven Urgrosh (second head)","value":"Text","applies":"Always","print":false,"pool":"","tags":["Weapon","Resizable","Melee","Exotic","OneHanded","Double","Dwarven","Slashing","Weapon Group Double"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","clo