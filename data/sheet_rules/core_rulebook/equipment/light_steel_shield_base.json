[{"id":"core_rulebook:equipment:light_steel_shield_base","label":"Light Steel Shield","value":{"Dice":{"dice":"1d3","modifier":null,"size_steps":null}},"prose":[{"family":"Desc","pieces":[{"Text":"You strap a shield to your forearm and grip it with your hand. A light shield's weight lets you carry other items in that hand, although you cannot use weapons with it.\nWooden or Steel: Wooden and steel shields offer the same basic protection, though they respond differently to some spells and effects.\nShield Bash Attacks: You can bash an opponent with a light shield. If you use your shield as a weapon, you lose its AC bonus until your next turn. An enhancement bonus on a shield does not improve the effectiveness of a shield bash made with it, but the shield can be made into a magic weapon in its own right."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Armor check penalty"},"pieces":[{"Text":"-1"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x2"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Arcane spell failure"},"pieces":[{"Text":"5"},{"Text":"%"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":false,"pool":"","tags":["Shield","Light","Weapon","Resizable","Melee","ShieldBash","Close","Weapon Group Close"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:111"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:equipment:light_steel_shield_base#bonus1","label":"Light Steel Shield (AC)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"v755dba92ad7732f0"},"op":"Eq","rhs"