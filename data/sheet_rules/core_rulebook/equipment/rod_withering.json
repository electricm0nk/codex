[{"id":"core_rulebook:equipment:rod_withering","label":"Rod","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"A rod of withering acts as a +1 light mace that deals no hit point damage. Instead, the wielder deals 1d4 points of Strength damage and 1d4 points of Constitution damage to any creature she touches with the rod (by making a melee touch attack). If she scores a critical hit, the damage from that hit is permanent ability drain. In either case, the defender negates the effect with a DC 17 Fortitude save."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Special","pieces":[{"Text":"deals 1d4 points of Strength damage and 1d4 points of Constitution damage (DC 17 Fortitude negates)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Aura: strong necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Caster Level: 13th"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Slot: none"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Cost: 12,500 gp"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Requirements: Craft Rod, Craft Magic Arms and Armor, contagion"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Other":"weapon tohit"},"print":true,"pool":"","tags":["Magic","Rod","Weapon","Resizable","Melee","Simple","Light","Finesseable","Bludgeoning","Mace","Hammer","Weapon Group Hammers","LesserMajor"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_magic_items.lst:464","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_magic_items.lst:246"],"oracle_pin":"7f8180