[{"id":"core_rulebook:equipment:gauntlet_part_of_armor_suit","label":"Gauntlet (Base)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This metal glove lets you deal lethal damage rather than nonlethal damage with unarmed strikes. A strike with a gauntlet is otherwise considered an unarmed attack. The cost and weight given are for a single gauntlet. Medium and heavy armors (except breastplate) come with gauntlets. Your opponent cannot use a disarm action to disarm you of gauntlets."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x2"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Weapon","Resizable","Melee","Simple","Light","Unarmed","Finesseable","Bludgeoning","Gauntlet","Close","Weapon Group Close","Weapon Group Natural"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:141","pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:198"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
