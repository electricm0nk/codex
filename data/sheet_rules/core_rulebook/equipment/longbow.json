[{"id":"core_rulebook:equipment:longbow","label":"Longbow (Base)","value":{"Dice":{"dice":"1d8","modifier":null,"size_steps":null}},"prose":[{"family":"Desc","pieces":[{"Text":"At almost 5 feet in height, a longbow is made up of one solid piece of carefully curved wood. You need two hands to use a bow, regardless of its size. A longbow is too unwieldy to use while you are mounted. If you have a penalty for low Strength, apply it to damage rolls when you use a longbow. If you have a Strength bonus, you can apply it to damage rolls when you use a composite longbow, but not when you use a regular longbow."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x3"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"100"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Weapon","Resizable","Ranged","Martial","Container","Projectile","Piercing","Bow","Longbow","Weapon Group Bows"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:306","pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:325","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_arms_armor.lst:599"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:equipment:longbow#bonus1","label":"Longbow (Base) (weapon)","value":{"Number":{"Min":[{"AbilityMod":"Str"},{"Const":0}]}},"applies":"Always","target":{"Other":"weapon damage"},"print":true,"pool":"","tags":["Weapon","Resizable","Ranged","Martial","Container","Projectile","Piercing","Bow","Longbow","Weapon Group Bows"],"subject":"Character","re