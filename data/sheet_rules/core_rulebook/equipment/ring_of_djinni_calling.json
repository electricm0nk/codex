[{"id":"core_rulebook:equipment:ring_of_djinni_calling","label":"Ring of Djinni Calling","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"One of the many rings of fable, this \"genie\" ring is useful indeed. It serves as a special gate by means of which a specific djinni (see the Pathfinder RPG Bestiary) can be called from the Plane of Air. When the ring is rubbed (a standard action), the call goes out, and the djinni appears on the next round. The djinni faithfully obeys and serves the wearer of the ring, but never for more than 1 hour per day. If the djinni of the ring is ever killed, the ring becomes nonmagical and worthless."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Aura: strong conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Caster Level: 17th"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Slot: ring"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Cost: 62,500 gp"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Requirements: Forge Ring, gate"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Magic","Ring","GreaterMajor"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_magic_items.lst:367","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_magic_items.lst:116"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
