[{"id":"core_rulebook:equipment:lion_s_shield","label":"Heavy Steel Shield (Base)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This +2 heavy steel shield is fashioned to appear to be a roaring lion's head. Three times per day as a free action, the lion's head can be commanded to attack (independently of the shield wearer), biting with the wielder's base attack bonus (including multiple attacks, if the wielder has them) and dealing 2d6 points of damage. This attack is in addition to any actions performed by the wielder."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Aura: moderate conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Caster Level: 10th"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Slot: shield"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Cost: 4,670 gp"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Requirements: Craft Magic Arms and Armor, summon nature's ally IV"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["LesserMedium"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:127","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_arms_armor.lst:144"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
