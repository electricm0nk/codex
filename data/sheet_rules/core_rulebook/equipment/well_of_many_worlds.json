[{"id":"core_rulebook:equipment:well_of_many_worlds","label":"Well of Many Worlds","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This strange, interdimensional device looks just like a portable hole. Anything placed within it is immediately cast to another world--a parallel world, another planet, or a different plane (chosen randomly). If the well is moved, it opens to a new plane (also randomly determined). It can be picked up, folded, or rolled, just as a portable hole can be. Objects from the world the well touches can come through the opening just as easily--it is a twoway portal."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Aura: strong conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Caster Level: 17th"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Slot: none"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Cost: 41,000 gp"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Requirements: Craft Wondrous Item, gate"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Magic","Wondrous","GreaterMajor"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_magic_items.lst:354","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_magic_items.lst:1323"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
