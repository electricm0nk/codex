[{"id":"core_rulebook:equipment:artisan_s_tools","label":"Artisan's Tools","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"These special tools include the items needed to pursue any craft. Without them, you have to use improvised tools (-2 penalty on Craft checks), if you can do the job at all.\nMasterwork artisan's tools are the perfect tools for the job, so you get a +2 circumstance bonus on Craft checks made with them."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Plural: No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Goods","Tools","Artisan"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_general.lst:203","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_general.lst:259"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
