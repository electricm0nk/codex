[{"id":"core_rulebook:equipment:alchemist_s_fire_flask","label":"Alchemist's Fire","value":{"Dice":{"dice":"1d6","modifier":null,"size_steps":null}},"prose":[{"family":"Desc","pieces":[{"Text":"You can throw a flask of alchemist's fire as a splash weapon. Treat this attack as a ranged touch attack with a range increment of 10 feet.\nA direct hit deals 1d6 points of fire damage. Every creature within 5 feet of the point where the flask hits takes 1 point of fire damage from the splash. On the round following a direct hit, the target takes an additional 1d6 points of damage. If desired, the target can use a full-round action to attempt to extinguish the flames before taking this additional damage. Extinguishing the flames requires a DC 15 Reflex save. Rolling on the ground provides the target a +2 bonus on the save. Leaping into a lake or magically extinguishing the flames automatically smothers the fire."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Special","pieces":[{"Text":"splash weapon"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Special","pieces":[{"Text":"Every creature within 5 feet of the point where the flask hits takes 1 point of fire damage from the splash. On the round following a direct hit, the target takes an additional 1d6 points of damage."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x2"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"10"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Plural: No"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x2"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"piece