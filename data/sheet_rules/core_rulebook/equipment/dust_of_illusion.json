[{"id":"core_rulebook:equipment:dust_of_illusion","label":"Dust of Illusion","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This unremarkable powder resembles chalk dust or powdered graphite. Stare at it, however, and the dust changes color and form. Put dust of illusion on a creature, and that creature is affected as if by a disguise self glamer, with the individual who sprinkles the dust envisioning the illusion desired. An unwilling target is allowed a DC 11 Reflex save to avoid the dust. The glamer lasts for 2 hours."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Aura: moderate illusion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Caster Level: 6th"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Slot: none"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Cost: 600 gp"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Requirements: Craft Wondrous Item, disguise self"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Magic","Wondrous","Consumable","LesserMinor"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_magic_items.lst:135","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_magic_items.lst:1063"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
