[{"id":"core_rulebook:equipment:crossbow_hand","label":"Hand Crossbow","value":{"Dice":{"dice":"1d4","modifier":null,"size_steps":null}},"prose":[{"family":"Desc","pieces":[{"Text":"You can draw a hand crossbow back by hand. Loading a hand crossbow is a move action that provokes attacks of opportunity. You can shoot, but not load, a hand crossbow with one hand at no penalty. You can shoot a hand crossbow with each hand, but you take a penalty on attack rolls as if attacking with two light weapons."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x2"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"2-20"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"30"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Weapon","Resizable","Ranged","Exotic","Container","Projectile","Piercing","Crossbow","Weapon Group Crossbows","InspiredOK"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:311","pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:332","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_equip.lst:20","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_arms_armor.lst:591"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
