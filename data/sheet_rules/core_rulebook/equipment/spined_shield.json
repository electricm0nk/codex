[{"id":"core_rulebook:equipment:spined_shield","label":"Heavy Steel Shield (Base)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This +1 heavy steel shield is covered in spines. It acts as a normal spiked shield. On command up to three times per day, the shield's wearer can fire one of the shield's spines. A fired spine has a +1 enhancement bonus, a range increment of 120 feet, and deals 1d10 points of damage (19-20/x2). Fired spines regenerate each day."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Aura: moderate evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Caster Level: 6th"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Slot: shield"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Cost: 2,875 gp"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Quality"},"pieces":[{"Text":"Construction Requirements: Craft Magic Arms and Armor, magic missile"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["LesserMedium"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:129","pathfinder/paizo/roleplaying_game/ultimate_equipment/ue_equip_arms_armor.lst:145"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
