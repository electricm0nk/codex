[{"id":"core_rulebook:equipment:sling_base","label":"Sling","value":{"Dice":{"dice":"1d4","modifier":null,"size_steps":null}},"prose":[{"family":"Desc","pieces":[{"Text":"A sling is little more than a leather cup attached to a pair of strings. Your Strength modifier applies to damage rolls when you use a sling, just as it does for thrown weapons. You can fire, but not load, a sling with one hand. Loading a sling is a move action that requires two hands and provokes attacks of opportunity.\nYou can hurl ordinary stones with a sling, but stones are not as dense or as round as bullets. Thus, such an attack deals damage as if the weapon were designed for a creature one size category smaller than you and you take a -1 penalty on attack rolls."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical multiplier"},"pieces":[{"Text":"x2"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Critical threat"},"pieces":[{"Text":"1-20"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"50"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":false,"pool":"","tags":["Weapon","Resizable","Ranged","Simple","Container","Projectile","Bludgeoning","Sling","Weapon Group Thrown"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"equipment","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_equip_arms_armor.lst:305"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:equipment:sling_base#bonus1","label":"Sling (weapon)","value":{"Number":{"AbilityMod":"Str"}},"applies":"Always","target":{"Other":"weapon damage"},"print":false,"pool":"","tags":["Weapon","Resizable","Ranged","Simple","Container","Projectile","Bludgeoning","Sling","Weapon Group Thrown"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind