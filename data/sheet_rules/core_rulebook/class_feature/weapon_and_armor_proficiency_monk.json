[{"id":"core_rulebook:class_feature:weapon_and_armor_proficiency_monk","label":"Weapon and Armor Proficiency","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Monks are proficient with club, crossbow (light or heavy), dagger, handaxe, javelin, kama, nunchaku, quarterstaff, sai, shuriken, siangham, and sling. Monks are not proficient with any armor or shields When wearing armor, using a shield, or carrying a medium or heavy load, a monk loses her AC bonus, as well as her fast movement and flurry of blows abilities."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":false,"pool":"special_ability","tags":["MonkClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core_rulebook:class_feature:monk"},"when":{"Compare":{"lhs":{"Var":"v9325c976723d85ed"},"op":"Eq","rhs":{"Const":0}}}},{"by":{"Rule":"core_rulebook:class_feature:monk_class"},"when":{"Compare":{"lhs":{"Var":"v9325c976723d85ed"},"op":"Eq","rhs":{"Const":0}}}}],"grants":[{"FactGrant":{"Proficiency":{"Weapon":"Club"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Light)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Crossbow (Heavy)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Dagger"}}},{"FactGrant":{"Proficiency":{"Weapon":"Handaxe"}}},{"FactGrant":{"Proficiency":{"Weapon":"Javelin"}}},{"FactGrant":{"Proficiency":{"Weapon":"Kama"}}},{"FactGrant":{"Proficiency":{"Weapon":"Nunchaku"}}},{"FactGrant":{"Proficiency":{"Weapon":"Quarterstaff"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sai"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shortspear"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sword (Short)"}}},{"FactGrant":{"Proficiency":{"Weapon":"Shuriken"}}},{"FactGrant":{"Proficiency":{"Weapon":"Siangham"}}},{"FactGrant":{"Proficiency":{"Weapon":"Sling"}}},{"FactGrant":{"Proficiency":{"Weapon":"Spear"}}},{"FactGrant":{"Proficiency":{"Weapon":"Flurry of Blows"}}},{"FactGrant":{"Proficiency":{"WeaponGroup":"Monk"}}},{"FactGrant":{"Proficie