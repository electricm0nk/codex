[{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l3_fly","label":"Fly","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The subject can fly at a speed of 60 feet [or 40 feet if it wears medium or heavy armor, or if it carries a medium or heavy load]. It can ascend at half speed and descend at double speed, and its maneuverability is good. Using a fly spell requires only as much concentration as walking, so the subject can attack or cast spells normally. The subject of a fly spell can charge but not run, and it cannot carry aloft more weight than its maximum load, plus any armor it wears. The subject gains a bonus on Fly skill checks equal to 1/2 your caster level. Should the spell duration expire while the subject is still aloft, the magic fails slowly. The subject floats downward 60 feet per round for 1d6 rounds. If it reaches the ground in that amount of time, it lands safely. If not, it falls the rest of the distance, taking 1d6 points of damage per 10 feet of fall. Since dispelling a spell effectively ends it, the subject also descends safely in this way if the fly spell is dispelled, but not if it is negated by an antimagic field."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants 60 Fly speed, or 40 if Medium Armor. Adds half Caster Level to Fly Skill."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"vceca462a08916ff8"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v7808d36d4dfbbfb7"},"op":"Gte","rhs":{"Const":7}}},{"Holds":{"what":{"Rule":"core_rulebook:feat:skill_focus"},"count":1}}]},"print":true,"pool":"internal","tags":["Sorcerer Bloodline Bonus Spell"],"subject":"Character","repeatable":false,"offers":{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l3_fly","count":{"Const":1},"from":{"Number":{"min":{"Const":1},"max":{"Const":20}}}},"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder