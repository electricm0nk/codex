[{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l6_transformation","label":"Transformation","value":{"Number":{"Const":4}},"prose":[{"family":"Desc","pieces":[{"Text":"You become a fighting machine-stronger, tougher, faster, and more skilled in combat. Your mindset changes so that you relish combat and you can't cast spells, even from magic items. You gain a +4 enhancement bonus to Strength, Dexterity, and Constitution, a +4 natural armor bonus to AC, a +5 competence bonus on Fortitude saves, and proficiency with all simple and martial weapons. Your base attack bonus equals your character level [which may give you multiple attacks]. You lose your spellcasting ability, including your ability to use spell activation or spell completion magic items, just as if the spells were no longer on your class list."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants +4 to Strength, Dexterity and Constitution, +4 natural armor, +5 to Fortitude saves, and full BAB."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"v21e467d6aadcdbc5"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v7808d36d4dfbbfb7"},"op":"Gte","rhs":{"Const":13}}},{"Situational":{"text":"when active"}}]},"target":{"Ability":"Str"},"bonus_type":{"name":"Enhancement","mode":"Plain"},"print":true,"pool":"internal","tags":["Sorcerer Bloodline Bonus Spell"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_class.lst:2280"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l6_transformation#bonus1","label":"Transformation (Dex)","value":{"Number":{"Const":4}},"applies":{"All":[{"Compare":{"lhs":{"Var":"v21e467d6aadcdbc5"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs