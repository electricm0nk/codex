[{"id":"core_rulebook:class_feature:rage","label":"Rage","value":{"Number":{"Const":1}},"also":[[{"Uses":{"period":"rounds per day"}},{"Number":{"Var":"v4abef232f76d5476"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"You can call upon inner reserves of strength and ferocity, granting you additional combat prowess. You can rage for "},{"Slot":{"Var":"v4abef232f76d5476"}},{"Text":" rounds per day. You can enter rage as a free action. The total number of rounds of rage per day is renewed after resting for 8 hours, although these hours do not need to be consecutive. While in rage, you gain a +"},{"Slot":{"Var":"v87e9c461693e9b6d"}},{"Text":" morale bonus to your Strength and a +"},{"Slot":{"Var":"ve112af64490fa73e"}},{"Text":" morale bonus to Constitution, as well as a +"},{"Slot":{"Var":"va55f19487666b126"}},{"Text":" morale bonus on Will saves. In addition, you take a -2 penalty to Armor Class. The increase to Constitution grants you "},{"Slot":{"Mul":[{"Div":[{"Var":"ve112af64490fa73e"},{"Const":2}]},"Level"]}},{"Text":" hit points, but these disappear when the rage ends and are not lost first like temporary hit points. While in rage, you cannot use any Charisma-, Dexterity-, or Intelligence-based skills (except Acrobatics, Fly, Intimidate, and Ride) or any ability that requires patience or concentration. You can end your rage as a free action and are fatigued after rage for a number of rounds equal to 2 times the number of rounds spent in the rage. You cannot enter a new rage while fatigued or exhausted but can otherwise enter rage multiple times during a single encounter or combat. If you fall unconscious, your rage immediately ends, placing you in peril of death."}],"applies":{"Holds":{"what":{"Rule":"core_rulebook:class_feature:standard_rage"},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You are using an alternative raging method."}],"applies":{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"RageSelectionAlt"}},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Each affected creature gains a +2 morale bonus to Strength and Constitution, a +1 morale bonus on Will saves, and a -2 penalty to AC. The effect is otherwise identical with a barbarian's rage except that the subjects aren't fatigued at the end of the rage."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants a +2 morale bonus to Strength and Constitution, a +1 morale bonus on Will saves, and a −2 penalty to AC"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Situational":{"text":"when active"}},"target":{"Save":"Will"},"bonus_type":{"name":"Morale","mode":"Plain"},"print":true,"pool":"special_ability","tags":["BarbarianClassFeatures","ClassFeatures","SpecialQuality","Extraordinary","Rage","AttackOption"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_race_guide:companion:companion_advancement_carnivorous_flower"},"when":{"Compare":{"lhs":"MasterLevel","op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core_rulebook:class_feature:barbarian_rage"},"when":"Always"},{"by":{"Rule":"core_rulebook:companion:companion_badger_wolverine"},"when":"Always"},{"by":{"Rule":"ultimate_combat:class_feature:wild_stalker_rage_of_the_wild"},"when":"Always"},{"by":{"Rule":"ultimate_magic:class_feature:anger_domain_divine_anger"},"when":"Always"},{"by":{"Rule":"ultimate_wilderness:class_feature:viking_berserker"},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_class.lst:412"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:class_feature:rage#bonus1","label":"Rage (AC)","value":{"Number":{"Const":-2}},"applies":{"Situational":{"text":"when active"}},"target":"Ac","print":true,"pool":"special_ability",