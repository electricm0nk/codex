[{"id":"core_rulebook:class_feature:weapon_and_armor_proficiency_bard","label":"Weapon and Armor Proficiency","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A bard is proficient with all simple weapons, plus the longsword, rapier, sap, short sword, shortbow, and whip. Bards are proficient with light armor and shields (except tower shields). A bard can cast bard spells while wearing light armor without incurring the normal arcane spell failure chance. However, like any other arcane spellcaster, a bard wearing medium or heavy armor or using a shield incurs a chance of arcane spell failure if the spell in question has a somatic component (most do). A multiclass bard still incurs the normal arcane spell failure chance for arcane spells received from other classes."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":false,"pool":"special_ability","tags":["BardClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core_rulebook:class_feature:bard"},"when":{"Compare":{"lhs":{"Var":"ve313fe21c69d0a41"},"op":"Eq","rhs":{"Const":0}}}},{"by":{"Rule":"core_rulebook:class_feature:bard_class__cbc80724848276a8"},"when":{"Compare":{"lhs":{"Var":"ve313fe21c69d0a41"},"op":"Eq","rhs":{"Const":0}}}}],"grants":[{"GatedFactGrant":{"fact":{"Proficiency":{"Weapon":"Longsword"}},"when":{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"BardWeaponProficiencies"}},"count":1}}}}},{"GatedFactGrant":{"fact":{"Proficiency":{"Weapon":"Rapier"}},"when":{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"BardWeaponProficiencies"}},"count":1}}}}},{"GatedFactGrant":{"fact":{"Proficiency":{"Weapon":"Sap"}},"when":{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"BardWeaponProficiencies"}},"count":1}}}}},{"GatedFactGrant":{"fact":{"Proficiency":{"Weapon":"Sword (Short)"}},"when":{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"BardWeaponProficiencies"}},"count":1}}}}},{