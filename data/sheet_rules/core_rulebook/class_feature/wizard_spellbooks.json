[{"id":"core_rulebook:class_feature:wizard_spellbooks","label":"Spellbooks","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A wizard must study his spellbook each day to prepare his spells. He cannot prepare any spell not recorded in his spellbook, except for read magic, which all wizards can prepare from memory.\nA wizard begins play with a spellbook containing all 0-level wizard spells (except those from his opposed schools, if any; see Arcane Schools) plus three 1st-level spells of his choice. The wizard also selects a number of additional 1st-level spells equal to his Intelligence modifier to add to the spellbook. At each new wizard level, he gains two new spells of any spell level or levels that he can cast (based on his new wizard level) for his spellbook. At any time, a wizard can also add spells found in other wizards' spellbooks to his own."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":false,"pool":"special_ability","tags":["Class Feature","Wizard Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core_rulebook:class_feature:wizard"},"when":{"All":[{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":"Level","op":"Lte","rhs":{"Const":0}}},{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}}]}},{"AtLeast":{"n":2,"of":[{"Not":{"Holds":{"what":{"ClassTag":"Base"},"count":1}}},{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}}]}},{"Compare":{"lhs":{"Var":"v4c9ec12bea914a0a"},"op":"Eq","rhs":{"Const":0}}}]}},{"Compare":{"lhs":{"Var":"v31e27e16a068fb17"},"op":"Gte","rhs":{"Const":1}}}]}},{"by":{"Rule":"core_rulebook:class_feature:wizard_class__d9affb050e701218"},"when":{"All":[{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":"Level","op":"Lte","rhs":{"Const":0}}},{"Compare":{"lhs":{"ClassLevel":"wizard"},"op":"Gte","rhs":{"Const":1}}}]}},{"AtLeast":{"n":2,"of":[{"Not":{"Holds":{"what":{"ClassTag":"Base"},"count"