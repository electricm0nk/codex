[{"id":"core_rulebook:class_feature:wizard_arcane_bond","label":"Arcane Bond","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"At 1st level, wizards form a powerful bond with an object or a creature. This bond can take one of two forms: a familiar or a bonded object. A familiar is a magical pet that enhances the wizard's skills and senses and can aid him in magic, while a bonded object is an item a wizard can use to cast additional spells or to serve as a magical item. Once a wizard makes this choice, it is permanent and cannot be changed."}],"applies":{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core_rulebook:class_feature:arcane_bond_familiar"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:class_feature:arcane_bond_bonded_object"},"count":1}}]}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"(You have selected to establish a powerful arcane bond with an object.)"}],"applies":{"Holds":{"what":{"Rule":"core_rulebook:class_feature:arcane_bond_bonded_object"},"count":1}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"(You have selected to establish a powerful arcane bond with a creature.)"}],"applies":{"Holds":{"what":{"Rule":"core_rulebook:class_feature:arcane_bond_familiar"},"count":1}},"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"arcane_bond"},"print":true,"pool":"special_ability","tags":["Class Feature","Wizard Class Feature","SpecialQuality","Supernatural or Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_combat:class_feature:rogue_talent_familiar"},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_class.lst:2569"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
