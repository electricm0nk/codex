[{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l2_barkskin","label":"Barkskin","value":{"Number":{"Min":[{"Max":[{"Sum":[{"Div":[{"Choice":"core_rulebook:class_feature:sorcerer_bonus_spell_l2_barkskin"},{"Const":3}]},{"Const":1}]},{"Const":2}]},{"Const":5}]}},"prose":[{"family":"Desc","pieces":[{"Text":"Barkskin toughens a creature's skin. The effect grants a +2 enhancement bonus to the creature's existing natural armor bonus. This enhancement bonus increases by 1 for every three caster levels above 3rd, to a maximum of +5 at 12th level. The enhancement bonus provided by barkskin stacks with the target's natural armor bonus, but not with other enhancement bonuses to natural armor. A creature without natural armor has an effective natural armor bonus of +0."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants natural armor bonus based on caster level"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"v4fec3e46f814aac8"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v7808d36d4dfbbfb7"},"op":"Gte","rhs":{"Const":5}}},{"Situational":{"text":"when active"}}]},"target":"Ac","bonus_type":{"name":"NaturalArmorEnhancement","mode":"Plain"},"print":true,"pool":"internal","tags":["Sorcerer Bloodline Bonus Spell"],"subject":"Character","repeatable":false,"offers":{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l2_barkskin","count":{"Const":1},"from":{"Number":{"min":{"Const":1},"max":{"Const":20}}}},"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_class.lst:2111"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
