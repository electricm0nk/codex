[{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l8_unholy_aura","label":"Unholy Aura","value":{"Number":{"Const":4}},"prose":[{"family":"Desc","pieces":[{"Text":"A malevolent darkness surrounds the subjects, protecting them from attacks, granting them resistance to spells cast by good creatures, and weakening good creatures when they strike the subjects. This abjuration has four effects. First, each warded creature gains a +4 deflection bonus to AC and a +4 resistance bonus on saves. Unlike the effect of protection from good, this benefit applies against all attacks, not just against attacks by good creatures. Second, a warded creature gains SR 25 against good spells and spells cast by good creatures. Third, the abjuration protects the subjects from possession and mental influence, just as protection from good does. Finally, if a good creature succeeds on a melee attack against a warded creature, the offending attacker takes 1d6 points of Strength damage [Fortitude negates]."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"WhenActive","pieces":[{"Text":"Grants a +4 deflection bonus to AC and a +4 resistance bonus on saves"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"v6eae3f86fbcbf297"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v7808d36d4dfbbfb7"},"op":"Gte","rhs":{"Const":17}}},{"Situational":{"text":"when active"}}]},"target":{"Save":"Fortitude"},"bonus_type":{"name":"Resistance","mode":"Plain"},"print":true,"pool":"internal","tags":["Sorcerer Bloodline Bonus Spell"],"subject":"Character","repeatable":false,"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_class.lst:2288"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core_rulebook:class_feature:sorcerer_bonus_spell_l8_unholy_aura#bonus1","label":"Unholy Aura (Reflex save)