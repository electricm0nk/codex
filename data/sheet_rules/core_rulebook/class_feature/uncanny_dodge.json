[{"id":"core_rulebook:class_feature:uncanny_dodge","label":"Uncanny Dodge","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can react to danger before your senses would normally allow you to do so. You cannot be caught flat-footed, nor do you lose your Dexterity bonus to AC if the attacker is invisible. You still lose your Dexterity bonus to AC if immobilized. You can still lose your Dexterity bonus to AC if an opponent successfully uses the feint action against you."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["SpecialQuality","Extraordinary","Defensive"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"bestiary:monster:angel_astral_deva"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:qlippoth_shoggti"},"when":"Always"},{"by":{"Rule":"bestiary_2:monster:quickling"},"when":"Always"},{"by":{"Rule":"core_rulebook:class_feature:uncanny_dodge_base"},"when":{"Compare":{"lhs":{"Var":"vff83338e591725cf"},"op":"Gte","rhs":{"Const":1}}}},{"by":{"Rule":"ultimate_combat:class_feature:wild_stalker_uncanny_dodge"},"when":"Always"},{"by":{"Rule":"ultimate_wilderness:companion:ambusher_cunning_ambusher"},"when":"Always"},{"by":{"Rule":"ultimate_wilderness:companion:bodyguard_uncanny_dodge"},"when":"Always"}],"provenance":{"book":"core_rulebook","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/core_rulebook/cr_abilities_class.lst:2851"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
