[{"id":"core_rulebook:class_feature:sneak_attack","label":"Sneak Attack","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"If you can catch an opponent when he is unable to defend himself effectively from your attack, you can strike a vital spot for extra damage. Your attack deals "},{"Slot":{"Var":"v5c590188ce40343d"}},{"Text":"d"},{"Slot":{"Var":"v720c825cd60af484"}},{"Text":" points of extra damage anytime your target would be denied a Dexterity bonus to AC, or when you flank your target. Should you score a critical hit with a sneak attack, this extra damage is not multiplied. Ranged attacks can count as sneak attacks only if the target is within 30 feet. With a weapon that deals nonlethal damage, you can make a sneak attack that deals nonlethal damage instead of lethal damage. You cannot use a weapon that deals lethal damage to deal nonlethal damage in a sneak attack, not even with the usual -4 penalty. You must be able to see the target well enough to pick out a vital spot and must be able to reach such a spot. You cannot sneak attack while striking a creature with concealment."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Slot":{"Var":"v5c590188ce40343d"}},{"Text":"d"},{"Slot":{"Var":"v720c825cd60af484"}}],"pick_last":true,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["RogueClassFeatures","AlchemistClassFeatures","SpecialAttack","Extraordinary","AttackOption","Unchained Rogue Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"advanced_class_guide:class_feature:cult_leader_sneak_attack"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:nature_fang_sneak_attack"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:slayer_sneak_attack"},"when":"Always"},{"by":{"Rule":"advanced_class_guide:class_feature:snakebite_striker_brawler_sneak_attack"},"when":"Always"},{"by":{"Rule":"adva