[{"id":"inner_sea_combat:feat:unfolding_wind_rush","label":"Unfolding Wind Rush","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Thrown weapons fly from your hands as if blown by a gale, and you leave behind a wake of wind as you move."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When using Perfect Style and wielding thrown weapons, you can combine a full attack action with a single move action. You must forgo the attack at your highest bonus but may take the remaining attacks as normal at any point during your movement. You can spend 1 ki point as a swift action to create a path of wind along your path of movement that functions as wind wall for 1 round; this effect does not affect your ranged attacks."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"adventurers_guide:feat:perfect_style"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:quick_draw"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_combat:feat:unfolding_wind_strike"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:mobility"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"BaseAttack","op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"v4df3d6f86dee7b25"},"op":"Gte","rhs":{"Const":13}}}]}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Max":[{"AbilityScore":"Dex"},{"Var":"vbe8e9a5a94b0ac91"}]},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"Var":"vd584bd0af3ea44f8"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":13}}},{"Situational":{"text":"Prerequisites: Dex 13, Wis 13, Mobility, Perfect Style, Quick Draw, Unfolding Wind Strike, base attack bonus + 13 or monk level 13th."}},{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Rule":"adventurers_guide:feat:perfect_style"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:quick_draw"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_comba