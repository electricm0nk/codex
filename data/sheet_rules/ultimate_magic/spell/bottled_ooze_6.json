[{"id":"ultimate_magic:spell:bottled_ooze_6","label":"Bottled Ooze","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have learned how to preserve a sample of oozes in a sealed bottle, which you can prepare for use as an extract.  When you activate the extract, you actually throw the bottle at a square within 30 feet, releasing the CR 6 ooze, which reconstitutes and attacks the closest creature.  The ooze is not under your control, but is otherwise treated as a summoned creature.  The ooze remains for "},{"Slot":{"Var":"vc87cada4f0322bf4"}},{"Text":" rounds, and decays into powder when the duration expires.  If you have the infusion discovery, another character can use the infused specimen."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"S"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"30 ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Closest Creature"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:discovery_bottled_ooze"},"count":1}},"print":true,"pool":"","subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"alchemist","spell_level":6}},"when":"Always"}],"provenance":{"book":"ultimate_magic","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_spells.lst:287"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
