[{"id":"ultimate_magic:spell:wall_of_sound","label":"Wall of Sound","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A translucent barrier of pure sound springs into existence. This wall is silent except for a faint hum, but bursts with discordant noise when touched by an object or creature. The wall deflects arrows, bolts, loose debris, and Small or smaller flying creatures like a wind wall spell, except these things rebound harmlessly rather than being directed upward. The burst of discordant noise deals 2d4 points of sonic damage to creatures within 10 feet of the triggering object or creature; touching or passing through the wall deals 2d6 points of sonic damage + 1 point of sonic damage per caster level (maximum +20). If you evoke the wall so that it appears where creatures are, each creature takes damage as if passing through the wall. A silence spell suppresses the wall within its area, but the wall reappears when the silence ends."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Sonic wall deflects and damages creatures."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Sonic"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Concentration + (CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":100},{"Mul":[{"Const":10},{"CasterLevel":"Holder"}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Wall (CASTERLEVEL*20) ft. long or ring (floor(CASTERLEVEL/2)*5) ft. radius; 20 ft. high"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bard","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"bloodrager","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"spiritualist","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":5}},"when":"Always"}],"provenance":{"book":"ultimate_magic","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_spells.lst:245","pathfinder/paizo/roleplaying_game/advanced_class_guide/acg_spells.lst:484","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:557","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:1893","pathfinder/paizo/roleplaying_game/ultimate_magic/um_spells.lst:872"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
