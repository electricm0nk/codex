[{"id":"ultimate_magic:spell:temporary_resurrection","label":"Temporary Resurrection","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Bring a creature to life for 24 hours, after which it dies again."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You restore temporary life to a body that has been dead for less than 48 hours. The spell lasts for 24 hours, after which the target dies again. The target gains 1 permanent negative level while under the effect of this spell; this negative level goes away when the target dies or is permanently raised from the dead (such as with raise dead). The target still counts as a dead corpse (but not undead) for the purpose of spells that revive dead creatures, so a cleric can cast raise dead or a similar spell on the target even while this spell is active. Once a creature has been revived with temporary resurrection, this spell cannot be used on it again until it is permanently raised from the dead."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"10 minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"24 hours"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Dead creature touched"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":7}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":7}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":7}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":7}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":6}},"when":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_feature:haunted_occultist_implement_school_necromancy"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:occultist_implement_school_necromancy"},"count":1}}]}}}],"grants":[{"FactDeclare":{"name":"CompMaterial","value":"(500 gp diamond dust)"}}],"provenance":{"book":"ultimate_magic","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_spells.lst:219","pathfinder/paizo/roleplaying_game/occult_adventures/oa_spells.lst:2010","pathfinder/paizo/roleplaying_game/occult_adventures/support/oa_spells_um.lst:131","pathfinder/paizo/roleplaying_game/ultimate_magic/um_spells.lst:846"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
