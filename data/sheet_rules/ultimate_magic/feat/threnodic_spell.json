[{"id":"ultimate_magic:feat:threnodic_spell","label":"Threnodic Spell","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can convert mind-affecting magic to necromantic power capable of controlling undead."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"This feat only works on mind-affecting spells. A threnodic spell affects undead creatures (even mindless undead) as if they weren't immune to mind-affecting effects, but has no effect on living creatures. A threnodic spell uses up a spell slot two level higher than the spell's actual level."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:spell_focus"},"count":1}},{"Compare":{"lhs":{"SkillRanks":"knowledge_religion"},"op":"Gte","rhs":{"Const":6}}}]},"print":true,"pool":"feat","tags":["Metamagic","DeathSlayerBonusFeat"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"horror_adventures:class_feature:necrologist_necropsychic_conduit"},"when":"Always"}],"grants":[{"FactDeclare":{"name":"AppliedName","value":"Threnodic"}}],"provenance":{"book":"ultimate_magic","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_feats.lst:143","pathfinder/paizo/roleplaying_game/adventurers_guide/ag_feats.lst:108"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
