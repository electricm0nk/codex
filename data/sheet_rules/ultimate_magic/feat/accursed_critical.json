[{"id":"ultimate_magic:feat:accursed_critical","label":"Accursed Critical","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your spells carry an embedded curse that manifests when they strike true."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Benefit","pieces":[{"Text":"When you confirm a critical hit with a spell or spell-like ability, you may cast bestow curse or major curse on that target as an immediate action. This works even with ranged spells. You must have bestow curse or major curse prepared or otherwise available to cast, and using this ability casts the corresponding spell."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"core_rulebook:feat:critical_focus"},"count":1}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"HighestSpellLevel":"Any"},"op":"Gte","rhs":{"Const":1}}},"Never"]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Spell":"core_rulebook:spell:bestow_curse"},"count":1}},{"Holds":{"what":{"Spell":"major_curse"},"count":1}}]}}]},"print":true,"pool":"feat","tags":["Critical"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"feat","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_feats.lst:16"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
