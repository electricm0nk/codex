[{"id":"ultimate_magic:class_feature:wood_mystery_thorn_burst","label":"Thorn Burst","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a swift action, you can cause sharp splinters of wood to explode outward from your body. These splinters deal "},{"Slot":{"Max":[{"Const":1},{"Div":[{"ClassLevel":"oracle"},{"Const":2}]}]}},{"Text":"d6 points of piercing damage to all creatures within a 10-foot burst. A Reflex save (DC "},{"Slot":{"Sum":[{"Const":10},{"Div":[{"ClassLevel":"oracle"},{"Const":2}]},{"AbilityMod":"Cha"}]}},{"Text":") halves this damage. In addition, the sharp splinters count as caltrops (see page 155 of the Core Rulebook) in the area until your next turn. You can use this ability "},{"Slot":{"Sum":[{"Const":1},{"Div":[{"ClassLevel":"oracle"},{"Const":5}]}]}},{"Text":"/day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["OracleClassFeatures","SpecialAttack","OracleRevelation","WoodRevelation","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:514"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
