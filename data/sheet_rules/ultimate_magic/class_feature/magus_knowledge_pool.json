[{"id":"ultimate_magic:class_feature:magus_knowledge_pool","label":"Knowledge Pool","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When you prepare your magus spells, you can decide to expend 1 or more points from your arcane pool, up to your Intelligence bonus. For each point you expend, you can treat any one spell from the magus spell list as if it were in your spellbook and can prepare that spell as normal that day. If you do not cast spells prepared in this way before the next time you prepares spells, you lose those spells. You can also cast spells added in this way using your spell recall ability, but only until you prepares spells again."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["MagusClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_magic:class_feature:magus"},"when":{"All":[{"AtLeast":{"n":2,"of":[{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusKnowledgePool"}},"count":1}}},{"Compare":{"lhs":{"Var":"v62ccf32782befa29"},"op":"Eq","rhs":{"Const":0}}}]}},{"Compare":{"lhs":{"Var":"v1394d5eebe50fe38"},"op":"Gte","rhs":{"Const":7}}}]}},{"by":{"Rule":"ultimate_magic:ability:magus"},"when":{"All":[{"AtLeast":{"n":2,"of":[{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusKnowledgePool"}},"count":1}}},{"Compare":{"lhs":{"Var":"v62ccf32782befa29"},"op":"Eq","rhs":{"Const":0}}}]}},{"Compare":{"lhs":{"Var":"v9cf95ab6e026a4f9"},"op":"Gte","rhs":{"Const":7}}}]}}],"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:48"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
