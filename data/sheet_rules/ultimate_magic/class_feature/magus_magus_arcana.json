[{"id":"ultimate_magic:class_feature:magus_magus_arcana","label":"Magus Arcana","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As he gains levels, a magus learns arcane secrets tailored to his specific way of blending martial puissance and magical skill. Starting at 3rd level, a magus gains one magus arcana. He gains an additional magus arcana for every three levels of magus attained after 3rd level. Unless specifically noted in a magus arcana's description, a magus cannot select a particular magus arcana more than once. Magus arcana that affect spells can only be used to modify spells from the magus spell list unless otherwise noted."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["MagusClassFeatures","Internal","ClassFeatures","Magus Arcana"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_magic:class_feature:magus"},"when":{"All":[{"AtLeast":{"n":2,"of":[{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusArcana"}},"count":1}}},{"Compare":{"lhs":{"Var":"vefc31494a8b97953"},"op":"Eq","rhs":{"Const":0}}}]}},{"Compare":{"lhs":{"Var":"v1394d5eebe50fe38"},"op":"Gte","rhs":{"Const":3}}}]}},{"by":{"Rule":"ultimate_magic:ability:magus"},"when":{"All":[{"AtLeast":{"n":2,"of":[{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"MagusArcana"}},"count":1}}},{"Compare":{"lhs":{"Var":"vefc31494a8b97953"},"op":"Eq","rhs":{"Const":0}}}]}},{"Compare":{"lhs":{"Var":"v9cf95ab6e026a4f9"},"op":"Gte","rhs":{"Const":3}}}]}}],"offers":{"id":"ultimate_magic:class_feature:magus_magus_arcana","count":{"Var":"v929dbb43c881a826"},"from":{"Rules":{"pool":"special_ability","tags":["MagusArcana"],"requires":"Always"}}},"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:45","pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:72","pathfinder