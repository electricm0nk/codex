[{"id":"ultimate_magic:class_feature:witch_hex_prehensile_hair","label":"Prehensile Hair","value":{"Number":{"Const":5}},"prose":[{"family":"Desc","pieces":[{"Text":"DC "},{"Slot":{"Var":"vd6dd30144f404718"}}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You can instantly cause your hair (or even your eyebrows) to grow up to 10 feet long or to shrink to its normal length, and can manipulate your hair as if it were a limb with a "},{"Slot":{"AbilityScore":"Int"}},{"Text":" Strength score. Your hair has reach "},{"Slot":{"Var":"va9e899ab152fe7f3"}},{"Text":" feet, and you can use it as a secondary natural attack that deals "},{"Slot":{"Const":1}},{"Text":"d"},{"Slot":{"Sum":[{"Const":3},{"Mul":[{"Min":[{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":["Size",{"Const":-3},{"Const":1}]}]}]},{"Sum":[{"Const":1},{"Mul":[{"Const":-1},{"Min":[{"Const":1},{"Max":[{"Const":0},{"Sum":["Size",{"Mul":[{"Const":-1},{"Sum":[{"Const":3},{"Const":1}]}]},{"Const":1}]}]}]}]}]}]},{"Const":-1}]}]}},{"Text":" points of damage. Your hair can manipulate objects (but not weapons) as dexterously as a human hand. The hair cannot be sundered or attacked as a separate creature. Pieces cut from your elongated hair shrink away to nothing. Using your hair does not harm your head or neck, even if you lift something heavy with it. You can manipulate your hair for "},{"Slot":{"Var":"v7de5713e90100cf5"}},{"Text":" minutes per day; these minutes do not need to be consecutive, but must be spent in 1-minute increments. A typical male witch with this hex can also manipulate his beard, moustache, or eyebrows."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":{"Var":"v62c9bc9506696185"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v7de5713e90100cf5"},"op":"Gte","rhs":{"Const":1}}}]}},"target":{"Other":"weapon reach"},"print":true,"pool":"special_ability","tags":["SpecialAttack","Supernatural","WitchHex