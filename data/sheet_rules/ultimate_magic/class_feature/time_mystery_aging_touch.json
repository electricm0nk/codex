[{"id":"ultimate_magic:class_feature:time_mystery_aging_touch","label":"Aging Touch","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your touch ages living creatures and objects. As a melee touch attack, you can deal "},{"Slot":{"Var":"vf4b69ef4cbe8b9d1"}},{"Text":" points of Strength damage to living creatures. Against objects or constructs, you can deal "},{"Slot":{"Var":"v647df4c535909bed"}},{"Text":"d6 points of damage. If used against an object in another creature's possession, treat this attack as a sunder combat maneuver. You can use this ability "},{"Slot":{"Var":"va8b7ceeba6d52d8c"}},{"Text":"/day."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["OracleClassFeatures","SpecialAttack","OracleRevelation","TimeRevelation","Supernatural","RevelationTargetOneOnly"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:498"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
