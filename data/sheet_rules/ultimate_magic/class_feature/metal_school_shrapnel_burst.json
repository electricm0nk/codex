[{"id":"ultimate_magic:class_feature:metal_school_shrapnel_burst","label":"Shrapnel Burst","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a swift action, you can cause jagged pieces of metal to explode outward from your body. These shards deal "},{"Slot":{"Var":"vd9dc2b3227478b9c"}},{"Text":"d6 points of piercing damage to all creatures within a 10-foot-radius burst. A Reflex save (DC "},{"Slot":{"Var":"vbe3fcd015b3aa2d5"}},{"Text":") halves this damage. In addition, the twisted scraps of metal make the area difficult terrain until your next turn (at which time they disappear). You can use this ability "},{"Slot":{"Var":"vc58af7eabd87ad21"}},{"Text":"/day."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The shrapnel bypasses damage reduction as if it were a magic weapon."}],"applies":{"Compare":{"lhs":{"Var":"v27dae16a4bfa90b7"},"op":"Gte","rhs":{"Const":10}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"Var":"v53d8624665563b96"},"op":"Lt","rhs":{"Const":1}}},{"Compare":{"lhs":{"Var":"v53d8624665563b96"},"op":"Lt","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["SpecialAttack","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_magic:class_feature:metal_school"},"when":{"Compare":{"lhs":{"Var":"v27dae16a4bfa90b7"},"op":"Gte","rhs":{"Const":8}}}}],"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:794","pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:813"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
