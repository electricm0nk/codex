[{"id":"ultimate_magic:class_feature:rakshasa_bloodline_silver_tongue","label":"Silver Tongue","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Var":"va01599aa3ae361d7"}}]],"prose":[{"family":"Desc","pieces":[{"Text":"You can draw upon your outsider heritage to spin amazingly convincing lies. Activating this ability is a swift action. You gain a +5 bonus on one Bluff check made to convince another of the truth of your words (similar to using glibness). If a magical effect is used against you that would detect your lies or force you to speak the truth, the user of the effect must succeed on a caster level check (DC "},{"Slot":{"Sum":[{"Const":10},{"Var":"v224510cbc83290ed"}]}},{"Text":") to succeed. Failure means the effect does not detect your lies or force you to speak only the truth. You can use this ability "},{"Slot":{"Var":"va01599aa3ae361d7"}},{"Text":" times per day."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"Ability Benefit"},"pieces":[{"Text":"(DC "},{"Slot":{"Sum":[{"Const":10},{"Var":"v224510cbc83290ed"}]}},{"Text":", "},{"Slot":{"Var":"va01599aa3ae361d7"}},{"Text":"/day)"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:sorcerer_bloodline_rakshasa"},"count":1}},{"Compare":{"lhs":{"Var":"v035aa7543bb08ab4"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Rakshasa Bloodline ~ Power LVL 01","Sorcerer Bloodline Power","SpecialQuality","Special Quality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:665"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
