[{"id":"ultimate_magic:class_feature:ranger_trap_exploding_trap","label":"Exploding Trap","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can only add this to a fire trap. The trap explodes in fire, filling all squares adjacent to the trap and dealing 1d6+"},{"Slot":{"Var":"vf21d70e3e0577d87"}},{"Text":" points of fire damage (Reflex negates). If it is an extraordinary trap, the ranger must use an explosive material such as alchemist's fire when setting the trap."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["RangerClassFeatures","SpecialAttack","RangerTrap","Extraordinary","Supernatural","SteelFalconTrap"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:1616","pathfinder/paizo/roleplaying_game/adventurers_guide/ag_abilities_class.lst:494"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
