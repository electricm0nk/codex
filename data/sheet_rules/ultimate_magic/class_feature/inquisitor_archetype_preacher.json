[{"id":"ultimate_magic:class_feature:inquisitor_archetype_preacher","label":"Preacher","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Some inquisitors wander the land to spread the true word of their faith. Often they come into conflict with those hostile to their teachings or to the preacher's need to help those who cannot help themselves. The leaders of evil or aggressive religions send these preachers into new territories to win converts and hopefully allies. Often, they start uprisings against powers hostile to their religion, or defend a group of honest believers from the depredations of the unfaithful."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"inquisitor"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:inquisitor_archetype_preacher"},"count":1}},{"Not":{"Holds":{"what":{"RuleTag":{"pool":"archetype","tag":"InquisitorSoloTactics"}},"count":1}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:inquisitor_archetype_preacher"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_feature:inquisitor_archetype_hexenhammer"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:inquisitor_archetype_royal_accuser"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_combat:class_feature:inquisitor_archetype_spellbreaker"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:inquisitor_archetype_cloaked_wolf"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:inquisitor_archetype_tactical_leader"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:inquisitor_archetype_preacher"},"count":1}}]}}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_magic:class_feature:inquisitor_archetype_preacher"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:class_