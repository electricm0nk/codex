[{"id":"ultimate_magic:class_feature:cloistered_cleric_diminished_spellcasting","label":"Diminished Spellcasting","value":{"Number":{"Const":-1}},"prose":[{"family":"Desc","pieces":[{"Text":"You choose only one domain from your deity's list of domains, and your number of non-domain spells per day for each spell level is one less than normal (for example, a 4th-level cloistered cleric has three cantrips, two 1st-level spells, one 1st-level domain spell, one 2nd-level spell, and one 2nd-level domain spell). If this reduces the number of spells per day for that level to 0, you gain only the bonus spells you would be entitled to based on your Wisdom score for that level, plus your domain spell for that level."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"SpellCell":{"class":"cleric","level":0}},"print":true,"pool":"special_ability","tags":["ClericClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:1016"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_magic:class_feature:cloistered_cleric_diminished_spellcasting#bonus1","label":"Diminished Spellcasting (level 1 spells per day)","value":{"Number":{"Const":-1}},"applies":"Always","target":{"SpellCell":{"class":"cleric","level":1}},"print":true,"pool":"special_ability","tags":["ClericClassFeatures","SpecialQuality"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:1016"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_magic:class_feature:cloistered_cleric_diminished_spellcasting#bonus2","label":"Diminished Spellcasting (level 2 spel