[{"id":"ultimate_magic:class_feature:crossblooded_crossblooded_bloodline","label":"Bloodline","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"A crossblooded bloodline combines the powers of two distinct heritages. In most cases, sorcerers with this bloodline are the offspring of two sorcerers from different ancestries, but occasionally a crossblooded sorcerer arises from the conjunction of other powers.\nA crossblooded sorcerer selects two different bloodlines. The sorcerer may gain access to the skills, feats, and some of the powers of both bloodlines she is descended from, but at the cost of reduced mental clarity and choice.\nA crossblooded sorcerer has one fewer spell known at each spell level (including cantrips) than normal and always takes a -2 penalty on Will saves."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"bloodline"},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Bloodline"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_magic:class_feature:sorcerer_archetype_crossblooded"},"when":{"Compare":{"lhs":{"ClassLevel":"sorcerer"},"op":"Gte","rhs":{"Const":1}}}}],"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_magic/um_abilities_class.lst:2042"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_magic:class_feature:crossblooded_crossblooded_bloodline#bonus1","label":"Bloodline (sorcerer bloodline feat picks)","value":{"Number":{"Var":"v4797067985005fe3"}},"applies":"Always","target":{"Pool":"sorcerer_bloodline_feat"},"bonus_type":{"name":"Base","mode":"Plain"},"print":true,"pool":"special_ability","tags":["Class Feature","Sorcerer Class Feature","Bloodline"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_magic","kind":"class_feature","closure_rows":[