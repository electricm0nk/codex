[{"id":"ultimate_intrigue:spell:hidden_presence","label":"Hidden Presence","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Prevent creatures from noticing your presence."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You prevent the targets from having conscious awareness of your presence. You make yourself completely undetectable to the subjects by erasing all awareness of your presence from their minds. The targets can't see, hear, smell, feel, or taste you, including with extraordinary or supernatural senses such as blindsense, blindsight, scent, or tremorsense. They can't pinpoint your location by any means, including detect spells. The targets remain unaware of your actions, provided you don't make any attacks or cause any obvious or directly threatening changes in the targets' environment. If you attack any of the target creatures, the effect ends. If you take an action that creates a sustained and obvious change in the target's environment-for example, attacking a creature other than a target or moving a sizeable or attended object the target can see-the target immediately receives a new saving throw."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Prevent creatures from noticing your presence."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Mind-Affecting"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) minutes [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Enchantment"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Compulsion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"Up to (CASTERLEVEL/3) creatures"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"bard","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"inquisitor","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"mesmerist","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witch","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":2}},"when":"Always"}],"provenance":{"book":"ultimate_intrigue","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_spells.lst:61","pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_spells.lst:165"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
