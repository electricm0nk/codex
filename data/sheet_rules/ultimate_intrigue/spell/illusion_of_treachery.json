[{"id":"ultimate_intrigue:spell:illusion_of_treachery","label":"Illusion of Treachery","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Make it seem like another is also responsible for your attacks."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You create an illusion that takes the same space as a foe and mimics its movements perfectly. Whenever you cast a spell or throw a weapon, the illusion ceases mimicking the target's actions just long enough to make it look like the target cast the spell or threw the weapon simultaneously with you, such that witnesses who can see both you and the target can't tell with certainty who truly cast the spell or threw the weapon. Witnesses who can see only the target see it as the only apparent source. The subject of this spell doesn't provoke attacks of opportunity from these illusory actions. Each target of the attack or spell counts as interacting with the illusion and thus receives a save to disbelieve."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Make it seem like another is also responsible for your attacks."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"S,F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds [D]"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will disbelief"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Illusion"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Subschool"},"pieces":[{"Text":"Figment"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Arcane","Divine","Psychic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"antipaladin","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"mesmerist","spell_level":3}},"when":"Always"},{"by":{"ClassSpellList":{"id":"magus","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"occultist","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"psychic","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":4}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":4}},"when":"Always"}],"provenance":{"book":"ultimate_intrigue","kind":"spell","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_spells.lst:64","pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_spells.lst:168"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
