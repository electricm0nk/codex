[{"id":"ultimate_intrigue:spell:trade_items","label":"Trade Items","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Swap a focus object with a target object."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You cause the target object and the object used as a focus for the spell to immediately swap places. The target object appears in your hand (or falls to the ground in your square if you are unable to hold it). The stronger the connection between the two objects, the more difficult the spell is to resist, as indicated below. The modifiers are cumulative. The two objects are the same type of object (such as \"keys,\" \"swords,\" \"scrolls\"), +1 DC;  The two objects are made of the same material, +1 DC; The two objects have the same weight (accurate to the nearest ounce), +1 DC; The two objects are part of the same set or made in the exact same mold, +2 DC; The target object has a higher gp value than the focus item, -2 DC; The target object is tied its holder, such as a bonded item, -2 DC."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Swap a focus object with a target object."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V,S,F"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (object)"}],"pick_last":false,"suppress_when_all_zero":false},{"fa