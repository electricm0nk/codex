[{"id":"ultimate_intrigue:class_feature:slayer_archetype_velvet_blade","label":"Velvet Blade","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Velvet blades specialize in infiltrating the upper echelons of society, mingling with nobles and courtiers, and killing them. Velvet blades are often born into the aristocracy, with an intricate understanding of the inner workings of upper-class society. Though a few velvet blades are unhinged maniacs who enjoy preying on their peers, most of these well-heeled slayers assume a professional demeanor and hire themselves out to other nobles or well-connected criminal organizations."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"slayer"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:slayer_archetype_velvet_blade"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:slayer_archetype_cutthroat"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:slayer_archetype_cutthroat"},"count":1}},{"Holds":{"what":{"Rule":"horror_adventures:class_feature:slayer_archetype_witch_killer"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:slayer_archetype_velvet_blade"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:slayer_archetype_bounty_hunter"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:slayer_archetype_bounty_hunter"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:slayer_archetype_stygian_slayer"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:slayer_archetype_stygian_slayer"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:slayer_archetype_velvet_blade"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"horror_adventures:cl