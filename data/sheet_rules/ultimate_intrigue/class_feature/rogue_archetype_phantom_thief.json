[{"id":"ultimate_intrigue:class_feature:rogue_archetype_phantom_thief","label":"Phantom Thief","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Also known as gentleman thieves or lady thieves, phantom thieves don't know the desperation of a hard life like many rogues. Instead, they come from the ranks of the elite, having grown bored with their finery, and seek thrills from acts of daring, skill, and crime. Phantom thieves don't need the money, so they often perform acts such as breaking into a secure vault for the thrill, leaving a calling card rather than robbing the place."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Not":{"Holds":{"what":{"Rule":"pathfinder_unchained:class_feature:rogue_unchained_class"},"count":1}}},{"Compare":{"lhs":{"ClassLevel":"rogue"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_phantom_thief"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_consigliere"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_phantom_thief"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_unchained_consigliere"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_unchained_phantom_thief"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:rogue_archetype_desert_raider"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:rogue_archetype_river_rat"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:rogue_archetype_sly_saboteur"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:rogue_archetype_sylvan_trickster"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_phantom_thief"},"count":1}},{"Holds":