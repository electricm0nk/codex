[{"id":"ultimate_intrigue:class_feature:swashbuckler_archetype_guiding_blade","label":"Guiding Blade","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While some swashbucklers are loners or glory hounds, always trying to take the credit for finishing off a foe with little regard for their allies, guiding blades focus their swordplay and panache on helping their allies. For a guiding blade, anything is possible when the right team comes together, and she learns how to protect and bolster her allies to ensure the team's victory. Instead of parrying attacks against her, a guiding blade redirects her enemies' ire away from her allies, interfering with enemies who attack her allies, whether that attack comes by blade or by spell."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"swashbuckler"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_guiding_blade"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:swashbuckler_archetype_flying_blade"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:swashbuckler_archetype_inspired_blade"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:swashbuckler_archetype_picaroon"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:swashbuckler_archetype_dashing_thief"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_guiding_blade"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:swashbuckler_archetype_arrow_champion"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:swashbuckler_archetype_daring_infiltrator"},"count":1}},{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:swashbuckler_archetype_mysterious_avenger"},"coun