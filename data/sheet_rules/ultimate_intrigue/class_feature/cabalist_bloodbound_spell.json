[{"id":"ultimate_intrigue:class_feature:cabalist_bloodbound_spell","label":"Bloodbound Spell","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A cabalist gets an advantage when casting spells against bleeding foes. Whenever the cabalist casts a spell against a foe that is taking bleed damage, the foe takes a -1 penalty on its saving throw against the spell (or to its AC if the spell requires an attack roll). This penalty increases to -2 if the spell is from the necromancy school."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Vigilante Class Features","CabalistClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_intrigue:class_feature:vigilante_archetype_cabalist"},"when":{"Compare":{"lhs":{"ClassLevel":"vigilante"},"op":"Gte","rhs":{"Const":5}}}}],"provenance":{"book":"ultimate_intrigue","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_abilities_class.lst:999"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
