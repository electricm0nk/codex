[{"id":"ultimate_intrigue:class_feature:rogue_archetype_sharper","label":"Sharper","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Sharpers use trickery and deception to part an owner from his valuables. Pathological risk-takers, they distinguish themselves from con artists and burglars by virtue of the simplicity and boldness of their schemes, which are usually impromptu, rather than carefully orchestrated. Many sharpers consider themselves romantic figures and foster the image of a resourceful, dashing rogue living by wits and luck while subverting authority at every turn."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"rogue"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:rogue_archetype_sharper"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_class_guide:class_feature:rogue_archetype_counterfeit_mage"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_acrobat"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_cutpurse"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_investigator"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_poisoner"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_rake"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_sniper"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_spy"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_swashbuckler"},"count":1}},{"Holds":{"what":{"Rule":"advanced_players_guide:class_feature:rogue_archetype_thug"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:rogue_arc