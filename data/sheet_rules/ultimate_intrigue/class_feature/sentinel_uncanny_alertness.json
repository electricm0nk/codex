[{"id":"ultimate_intrigue:class_feature:sentinel_uncanny_alertness","label":"Uncanny Alertness","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A sentinel is always ready to defend against incoming attacks. A sentinel is never flat-footed before acting in combat, even if she is surprised (she can still become flat-footed by any other effect or situation that would render her flat-footed)."}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"The sentinel also always acts on the surprise round. If she would have acted on the surprise round anyway, or if there is no surprise round, she gains a +"},{"Slot":{"Div":[{"Var":"veef07274d198a2be"},{"Const":2}]}},{"Text":" bonus on initiative checks."}],"applies":{"Compare":{"lhs":{"ClassLevel":"ranger"},"op":"Gte","rhs":{"Const":7}}},"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Ranger Class Features","SentinelClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_intrigue:class_feature:ranger_archetype_sentinel"},"when":{"Compare":{"lhs":{"ClassLevel":"ranger"},"op":"Gte","rhs":{"Const":4}}}}],"provenance":{"book":"ultimate_intrigue","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_abilities_class.lst:678"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
