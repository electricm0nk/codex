[{"id":"ultimate_intrigue:class_feature:feyspeaker_fey_speech","label":"Fey Speech","value":{"Number":{"Mul":[{"Const":-1},{"Div":[{"Sum":[{"Var":"v47666b8cadcbc84d"},{"Const":1}]},{"Const":4}]}]}},"prose":[{"family":"Desc","pieces":[{"Text":"A feyspeaker's words carry a tiny fragment of the otherworldly power of the fey's voices. She gains Bluff, Diplomacy, Disguise, and Sense Motive as class skills. A feyspeaker also learns Sylvan as a bonus language. In addition, the feyspeaker gains a number of skill ranks at each level equal to 6 + her Intelligence modifier, instead of 4 + her Intelligence modifier. The feyspeaker's base attack bonus from her druid levels is equal to half her druid level (much like a sorcerer's base attack bonus is calculated), rather than the usual druid base attack bonus."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":"BaseAttack","bonus_type":{"name":"Base","mode":"Replace"},"print":true,"pool":"special_ability","tags":["Druid Class Features","FeyspeakerClassFeatures","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_intrigue:class_feature:druid_archetype_feyspeaker"},"when":{"Compare":{"lhs":{"ClassLevel":"druid"},"op":"Gte","rhs":{"Const":1}}}}],"grants":[{"FactGrant":{"Language":"Sylvan"}},{"FactGrant":{"ClassSkill":"bluff"}},{"FactGrant":{"ClassSkill":"diplomacy"}},{"FactGrant":{"ClassSkill":"disguise"}},{"FactGrant":{"ClassSkill":"sense_motive"}}],"provenance":{"book":"ultimate_intrigue","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_abilities_class.lst:329"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_intrigue:class_feature:feyspeaker_fey_speech#bonus1","label":"Fey Speech (skill pool)","value":{"Number":{"Const":2}},"applies":"Always","target":{"Other":"skill pool"},"print":true,"pool":"special_ability","tags":["Dr