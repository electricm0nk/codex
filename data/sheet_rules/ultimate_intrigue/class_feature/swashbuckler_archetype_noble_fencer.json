[{"id":"ultimate_intrigue:class_feature:swashbuckler_archetype_noble_fencer","label":"Noble Fencer","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The noble fencer is an aristocrat or other upper-class socialite who trained in dueling from a young age. Noble fencers fight with their own style, with distinct differences from those of alley bravos or gladiatorial duelists. They use their quick wits and panache in both physical and social confrontations, and they rely on their training and discipline to emerge victorious, rather than merely trusting to luck."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"swashbuckler"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_noble_fencer"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_guiding_blade"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_noble_fencer"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:swashbuckler_archetype_wildstrider"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:swashbuckler_archetype_rostland_bravo"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_guiding_blade"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_noble_fencer"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:swashbuckler_archetype_arrow_champion"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:swashbuckler_archetype_noble_fencer"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_wilderness:class_feature:swashbuckler_archetype_wildstrider"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule"