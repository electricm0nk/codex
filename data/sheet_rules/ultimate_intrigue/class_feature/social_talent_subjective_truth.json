[{"id":"ultimate_intrigue:class_feature:social_talent_subjective_truth","label":"Subjective Truth","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The vigilante's disparate identities allow him to defeat magic that detects lies. As long as what he says is true from the point of view of his current identity, it detects as true to effects such as discern lies, and he can say it in effects such as zone of truth that force him to speak the truth."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:social_talent_feign_innocence"},"count":1}},{"Compare":{"lhs":{"Var":"vc98e174c19273973"},"op":"Gte","rhs":{"Const":9}}}]},"print":true,"pool":"special_ability","tags":["Social Talent","SpecialQuality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_intrigue","kind":"class_feature","closure_rows":["pathfinder/paizo/roleplaying_game/ultimate_intrigue/ui_abilities_class.lst:67"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
