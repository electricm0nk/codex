[{"id":"ultimate_intrigue:class_feature:monk_archetype_sage_counselor","label":"Sage Counselor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Sage counselors are ascetics and mystics who leave the confines of the monastery walls to advise secular people about spiritual truths and to seek knowledge of the outside world. They often find work as mentors teaching religion and martial arts, and some of them even become counselors for people in high places. Sage counselors often speak in metaphors, knowing that indirect persuasion is more effective than speaking plainly, and they use indirect tactics in combat as well."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Not":{"Holds":{"what":{"Rule":"pathfinder_unchained:class_feature:monk_unchained_class"},"count":1}}},{"Compare":{"lhs":{"ClassLevel":"monk"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:monk_archetype_sage_counselor"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"adventurers_guide:class_feature:monk_archetype_brazen_disciple"},"count":1}},{"Holds":{"what":{"Rule":"adventurers_guide:ability:unchained_monk_archetype_brazen_disciple"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:monk_archetype_perfect_scholar"},"count":1}},{"Holds":{"what":{"Rule":"inner_sea_intrigue:class_feature:unchained_monk_archetype_perfect_scholar"},"count":1}},{"Holds":{"what":{"Rule":"occult_adventures:class_feature:monk_archetype_karmic_monk"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:monk_archetype_sage_counselor"},"count":1}},{"Holds":{"what":{"Rule":"ultimate_intrigue:class_feature:unchained_monk_archetype_sage_counselor"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:monk_archetype_underfoot_adept"},"count":1}},{"Holds":{"what":{"Rule":"advanced_race_guide:class_feature:monk