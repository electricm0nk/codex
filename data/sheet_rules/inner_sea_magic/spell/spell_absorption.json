[{"id":"inner_sea_magic:spell:spell_absorption","label":"Spell Absorption","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"If you successfully counterspell a 3rd-level or lower level spell (through either dispel magic or normal means) while spell absorption is in effect, you absorb the countered spell and use it to regain spells you have already cast. If you're a Wizard, you regain the use of any single spell that you have cast since the last time you prepared spells. If you're a Sorcerer, you regain a single spell slot. The spell recovered or spell slot regained must be of an equal level or lower than the spell you counterspelled."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Abjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Components"},"pieces":[{"Text":"V, S, M"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 round"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"You"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"(CASTERLEVEL) rounds"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"sorcerer","spell_level":5}},"when":"Always"},{"by":{"ClassSpellList":{"id":"wizard","spell_level":5}},"when":"Always"}],"grants":[{"FactDeclare":{"name":"CompMaterial","value":"(a prism)"}}],"provenance":{"book":"inner_sea_magic","kind":"spell","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_magic/ism_spells.lst:38"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
