[{"id":"inner_sea_magic:class_feature:dual_cursed_curse_of_black_blood_secondary","label":"Never-Changing Curse of Black Blood","value":{"Number":{"Const":-1}},"prose":[{"family":"Desc","pieces":[{"Text":"All black-blooded oracles effectively share the same curse-the curse of black blood. The material affects these oracles physically and mentally, altering both physiology and mystic powers. The blood of a black-blooded oracle actually runs black, and wounds she suffers are infected by her own power and are difficult to heal. She is immune to the effects (both beneficial and destructive) of black blood. Positive and negative energy affect a black-blooded oracle as if she were undead-positive energy harms her, while negative energy heals her (this aspect of the curse has no effect if the oracle is undead). The curse also dulls the oracle's coordination somewhat, imparting a -4 penalty on all Dexterity-based skill checks."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"oracle_second_curse"},"print":true,"pool":"special_ability","tags":["OracleClassFeatures","SpecialQuality","Supernatural","DualBlackBloodedCurse"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_magic/ism_abilities_class.lst:301"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"inner_sea_magic:class_feature:dual_cursed_curse_of_black_blood_secondary#bonus1","label":"Never-Changing Curse of Black Blood (oracle curse picks)","value":{"Number":{"Const":1}},"applies":"Always","target":{"Pool":"oracle_curse"},"print":true,"pool":"special_ability","tags":["OracleClassFeatures","SpecialQuality","Supernatural","DualBlackBloodedCurse"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/campaign_setting/inner_