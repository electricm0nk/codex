[{"id":"inner_sea_magic:class_feature:winter_witch_cold_flesh","label":"Cold Flesh","value":"Text","also":[["CasterLevel",{"Number":{"Var":"vd07f5226a7b8e9e7"}}],["SaveDc",{"Number":{"Sum":[{"Const":11},{"AbilityMod":"Int"}]}}]],"prose":[{"family":"Special","pieces":[{"Text":"Constant"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"At 1st level, a winter witch gains endure elements as a constant spell-like ability, but only against cold temperatures. At 4th level, she gains cold resistance 5, making her comfortable in near-freezing temperatures. At 9th-level, this increases to cold resistance 10, and at 14th level, it becomes immunity to cold. This replaces the witch's 4th-level hex."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["ClassFeatures","Witch Class Feature","Winter Witch Class Feature","SpecialQuality","Special Quality","Extraordinary"],"subject":"Character","repeatable":false,"provenance":{"book":"inner_sea_magic","kind":"class_feature","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_magic/ism_abilities_class.lst:394"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
