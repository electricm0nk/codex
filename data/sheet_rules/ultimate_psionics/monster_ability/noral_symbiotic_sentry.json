[{"id":"ultimate_psionics:monster_ability:noral_symbiotic_sentry","label":"Symbiotic Sentry","value":"Text","also":[[{"Uses":{"period":"uses per day"}},{"Number":{"Const":1}}]],"prose":[{"family":"Desc","pieces":[{"Text":"When you fail a save against a mind-affecting effect, you may immediately roll a second save; if the second save is successful, you are still affected by the effect, but you are at least aware of a psychic attack and your failure to block it, even if you do not know the exact attack or its consequences.  Once per day, if the second save is successful, you may choose to use that result in place of the first roll."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"MissingRule":{"pool":"special_ability","name":"Noral ~ Symbiotic Sentry"}},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"NoralSymbioticResistance"}},"count":1}},{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"NoralSymbioticSurge"}},"count":1}}]}}}]}},"print":true,"pool":"special_ability","tags":["RacialTraits","SpecialQuality","NoralRacialTrait","NoralSymbioticResistance","NoralSymbioticSurge"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"monster_ability","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_race.lst:290"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
