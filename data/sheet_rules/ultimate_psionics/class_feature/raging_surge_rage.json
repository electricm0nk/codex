[{"id":"ultimate_psionics:class_feature:raging_surge_rage","label":"Raging Surge Bond","value":{"Number":{"Var":"va55f19487666b126"}},"prose":[{"family":"Desc","pieces":[{"Text":"You can call upon inner reserves of strength and ferocity, granting you additional combat prowess. You can rage for "},{"Slot":{"Var":"v4abef232f76d5476"}},{"Text":" rounds per day. You can enter rage as a free action. The total number of rounds of rage per day is renewed after resting for 8 hours, although these hours do not need to be consecutive. While in rage, you gain a +"},{"Slot":{"Var":"v87e9c461693e9b6d"}},{"Text":" morale bonus to your Strength and a +"},{"Slot":{"Var":"ve112af64490fa73e"}},{"Text":" morale bonus to Constitution, as well as a +"},{"Slot":{"Var":"va55f19487666b126"}},{"Text":" morale bonus on Will saves. In addition, you take a -2 penalty to Armor Class. The increase to Constitution grants you "},{"Slot":{"Mul":[{"Div":[{"Var":"ve112af64490fa73e"},{"Const":2}]},"Level"]}},{"Text":" hit points, but these disappear when the rage ends and are not lost first like temporary hit points. While in rage, you cannot use any Charisma-, Dexterity-, or Intelligence-based skills (except Acrobatics, Fly, Intimidate, and Ride) or any ability that requires patience or concentration. You can end your rage as a free action and are fatigued after rage for a number of rounds equal to 2 times the number of rounds spent in the rage. You cannot enter a new rage while fatigued or exhausted but can otherwise enter rage multiple times during a single encounter or combat. If you fall unconscious, your rage immediately ends, placing you in peril of death."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Situational":{"text":"when active"}},"target":{"Save":"Will"},"bonus_type":{"name":"Rage","mode":"Plain"},"print":true,"pool":"special_ability","tags":["WilderClassFeatures","SpecialQuality","Extraordinary","Rage","AttackOption"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"class_feature","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_class.lst:1071"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_psionics:class_feature:raging_surge_rage#bonus1","label":"Raging Surge Rage (AC)","value":{"Number":{"Var":"v35c534cc07539460"}},"applies":{"Situational":{"text":"when active"}},"target":"Ac","print":true,"pool":"special_ability","tags":["WilderClassFeatures","SpecialQuality","Extraordinary","Rage","AttackOption"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"class_feature","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_class.lst:1071"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_psionics:class_feature:raging_surge_rage#bonus2","label":"Raging Surge Rage (Str)","value":{"Number":{"Var":"v87e9c461693e9b6d"}},"applies":{"Situational":{"text":"when active"}},"target":{"Ability":"Str"},"bonus_type":{"name":"Rage","mode":"Plain"},"print":true,"pool":"special_ability","tags":["WilderClassFeatures","SpecialQuality","Extraordinary","Rage","AttackOption"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"class_feature","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_class.lst:1071"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"ultimate_psionics:class_feature:raging_surge_rage#bonus3","label":"Raging Surge Rage (Con)","value":{"Number":{"Var":"ve112af64490fa73e"}},"applies":{"Situational":{"text":"when active"}},"target":{"Ability":"Con"},"bonus_type":{"name":"Rage","mode":"Plain"},"print":true,"pool":"special_ability","tags":["WilderClassFeatures","SpecialQuality","Extraordinary","Rage","AttackOption"],"subject":"Charact