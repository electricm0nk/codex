[{"id":"ultimate_psionics:class_feature:blade_skill_evasion","label":"Evasion","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can avoid even magical and unusual attacks with great agility.  If you make a successful Reflex saving throw against an attack that normally deals half damage on a successful save, you instead take no damage.  Evasion can only be used if you are wearing light armor, medium armor, or no armor.  If you are helpless, you do not gain the benefit of evasion."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"ultimate_psionics:class_feature:cutthroat_covert_training"},"count":1}},{"Holds":{"what":{"MissingRule":{"pool":"archetype","name":"Feral Heart ~ Soulknife Archetype"}},"count":1}}]}},"print":true,"pool":"special_ability","tags":["FeralHeartBladeSkill"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"class_feature","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_class.lst:813","pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_class.lst:866"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
