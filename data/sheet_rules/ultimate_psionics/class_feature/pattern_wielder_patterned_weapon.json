[{"id":"ultimate_psionics:class_feature:pattern_wielder_patterned_weapon","label":"Patterned Weapon","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As a move action, you can transfer the tattoo of one of your powers known onto or off of one manufactured weapon you are wielding.  While on the weapon, you add +"},{"Slot":{"Var":"v0111f5c4691cd07a"}},{"Text":" to damage rolls made with that weapon.  However, you may not manifest the power represented by the tattoo."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["CrypticClassFeatures","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"class_feature","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_abilities_class.lst:1854"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
