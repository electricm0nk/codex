[{"id":"ultimate_psionics:feat:cushion_the_blow","label":"Cushion the Blow","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As long as you are maintaining psoinic focus, as an immediate action, you can minimize the damage of a single attack with a ranged, melee, or natural weapon or unarmed strike (treat all dice rolled as 1s) on any member of the collective.  This ability must be used in response to an attack on a member of the collective.  In addition, if you expend your psionic focus, you can reduce any additional damage on the attack (such as bonus damage from a high Strength or sneak attack damage) by your key ability modifier."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Collective"}},"count":1}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"Var":"v5d3312fb73f64d0e"},"op":"Gte","rhs":{"Const":6}}},{"Compare":{"lhs":{"Var":"vc0d5496af5a56d6f"},"op":"Gte","rhs":{"Const":1}}},{"Holds":{"what":{"RuleTag":{"pool":"special_ability","tag":"Collective"}},"count":1}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":15}}},{"Compare":{"lhs":{"Var":"v5d3312fb73f64d0e"},"op":"Gte","rhs":{"Const":6}}},{"Compare":{"lhs":{"Var":"vc0d5496af5a56d6f"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"feat","tags":["Psionic"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"ultimate_psionics:class_feature:battle_medic_cushion_the_blow"},"when":"Always"}],"provenance":{"book":"ultimate_psionics","kind":"feat","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_feats.lst:61"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
