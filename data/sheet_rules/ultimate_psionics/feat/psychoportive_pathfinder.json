[{"id":"ultimate_psionics:feat:psychoportive_pathfinder","label":"Psychoportive Pathfinder","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Any time you manifest psychoport, you may, as a free action, choose to leave a marker for someone else to follow. This marker has a duration of one round. If another person casts teleport or greater teleport or manifests psychoport or greater psychoport in the space you left from, they can choose as part of casting the spell or manifesting the power to appear adjacent to you in a safe, uninhabited space even if they would normally fail due to lack of familiarity or lack of range."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"nomad"},"op":"Gte","rhs":{"Const":1}}},{"Holds":{"what":{"Spell":"ultimate_intrigue:spell:trace_teleport"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Spell":"psychoport"},"count":1}},{"Holds":{"what":{"Spell":"psychoport_greater"},"count":1}}]}},{"Compare":{"lhs":{"Var":"vc0d5496af5a56d6f"},"op":"Gte","rhs":{"Const":1}}},{"Compare":{"lhs":{"ClassLevel":"nomad"},"op":"Gte","rhs":{"Const":1}}},{"Holds":{"what":{"Spell":"ultimate_intrigue:spell:trace_teleport"},"count":1}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Spell":"psychoport"},"count":1}},{"Holds":{"what":{"Spell":"psychoport_greater"},"count":1}}]}},{"Compare":{"lhs":{"Var":"vc0d5496af5a56d6f"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"feat","tags":["Psionic"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"feat","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_feats.lst:271"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
