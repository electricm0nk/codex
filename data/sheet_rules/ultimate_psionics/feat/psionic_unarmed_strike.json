[{"id":"ultimate_psionics:feat:psionic_unarmed_strike","label":"Psionic Unarmed Strike","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"To use this feat, you must expend psionic focus.  You can attempt to make a single unarmed melee attack as a standard action against a target that is sheltered behind a wall, wall of force effect, or similar barrier.  Your attack briefly skips through the Astral Plane to bypass the barrier.  This does not grant you line of sight or extra reach, requiring you to make the attack without being able to see the target or use some other method of seeing the target (such as clairaudience/clairvoyance) and be within your normal reach for your unarmed attack."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:stunning_fist"},"count":1}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"AbilityScore":"Dex"},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"Var":"vc0d5496af5a56d6f"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":2,"of":[{"Holds":{"what":{"Rule":"core_rulebook:feat:improved_unarmed_strike"},"count":1}},{"Holds":{"what":{"Rule":"core_rulebook:feat:stunning_fist"},"count":1}}]}},{"AtLeast":{"n":2,"of":[{"Compare":{"lhs":{"AbilityScore":"Dex"},"op":"Gte","rhs":{"Const":13}}},{"Compare":{"lhs":{"AbilityScore":"Wis"},"op":"Gte","rhs":{"Const":13}}}]}},{"Compare":{"lhs":{"Var":"vc0d5496af5a56d6f"},"op":"Gte","rhs":{"Const":1}}}]},"print":true,"pool":"feat","tags":["Psionic"],"subject":"Character","repeatable":false,"provenance":{"book":"ultimate_psionics","kind":"feat","closure_rows":["pathfinder/dreamscarred_press/ultimate_psionics/up_feats.lst:268"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
