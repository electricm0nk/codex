[{"id":"inner_sea_faiths:ability:exalted_boon_dahak_draconic_decoys","label":"Draconic Decoys","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"If you have performed your daily obedience, anytime you have created an image via mirror image, as a swift action you can direct one of your images to move to a flanking position against an enemy within 15 feet of you. The image allows you or an ally to flank your target for the purpose of a single attack. A redirected image dissipates when you or an ally uses the image to make a flanking attack, or otherwise remains in place for 1 round before dissipating."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"special_ability","tags":["Faith Based Boon","SpecialQuality","Supernatural"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"inner_sea_gods:ability:deific_obedience_benefits"},"when":{"AtLeast":{"n":4,"of":[{"Holds":{"what":{"Deity":{"Named":"dahak"}},"count":1}},{"AtLeast":{"n":1,"of":[{"Compare":{"lhs":"Level","op":"Gte","rhs":{"Const":16}}},{"Compare":{"lhs":{"Var":"v96aae6f20ffe46f6"},"op":"Gte","rhs":{"Const":6}}}]}},{"Not":{"Compare":{"lhs":{"ClassLevel":"evangelist"},"op":"Gte","rhs":{"Const":1}}}},{"Not":{"Compare":{"lhs":{"ClassLevel":"sentinel"},"op":"Gte","rhs":{"Const":1}}}}]}}}],"provenance":{"book":"inner_sea_faiths","kind":"ability","closure_rows":["pathfinder/paizo/campaign_setting/inner_sea_faiths/isf_abilities_faith.lst:138"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
