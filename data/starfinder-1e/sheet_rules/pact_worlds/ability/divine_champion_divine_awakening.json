[{"id":"pact_worlds:ability:divine_champion_divine_awakening","label":"Divine Awakening","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Choose a deity whose alignment is within one step of your own (see page 25 of the Starfinder Core Rulebook). If you have other abilities that require you to choose a deity (such as the priest theme), you must choose the same deity. You are divinely protected, gaining a +1 enhancement bonus to saving throws with your lowest base saving throw bonus; if two or three of your base saving throw bonuses are tied for the lowest value, choose one of those categories to gain this bonus. This functions as and doesn't stack with the bonus provided by a ring of resistance, except the effect cannot be dispelled. At 6th level and every 4 levels thereafter, the bonus increases by 1."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"pact_worlds:ability:envoy_archetype_divine_champion"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"pact_worlds:ability:mechanic_archetype_divine_champion"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"pact_worlds:ability:mystic_archetype_divine_champion"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"pact_worlds:ability:operative_archetype_divine_champion"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"pact_worlds:ability:solarian_archetype_divine_champion"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"pact_worlds:ability:soldier_archetype_divine_champion"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"pact_worlds:ability:techn