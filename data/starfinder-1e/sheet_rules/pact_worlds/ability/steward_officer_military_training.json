[{"id":"pact_worlds:ability:steward_officer_military_training","label":"Military Training","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You gain one of the following feats as a bonus feat (you must meet all the prerequisites of the chosen feat): Advanced Melee Weapon Proficiency, Improved Unarmed Strike, or Longarm Proficiency. At 6th level, if you chose Improved Unarmed Strike at 4th level, you gain Improved Combat Maneuver. Otherwise, you gain the Weapon Specialization feat as a bonus feat for the same weapon type to which the bonus feat you gained at 4th level applies. If you already have all the listed feats, you can choose a bonus combat feat instead."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"pact_worlds:ability:envoy_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"pact_worlds:ability:mechanic_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"pact_worlds:ability:mystic_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"pact_worlds:ability:operative_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"pact_worlds:ability:solarian_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"pact_worlds:ability:soldier_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"pact_worlds:ability:technomancer_archetype_steward_officer"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":4}}}}],"provenance":{"book":