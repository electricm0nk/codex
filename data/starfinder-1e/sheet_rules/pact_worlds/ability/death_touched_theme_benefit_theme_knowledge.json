[{"id":"pact_worlds:ability:death_touched_theme_benefit_theme_knowledge","label":"THEME KNOWLEDGE (Perception)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Thanks to your experiences with the undead and the growing power of the grave within your form, you have an instinctive understanding and recognition of negative energy and undead. You can use Perception, rather than Mysticism, to recall knowledge about undead and negative energy effects when you first observe them. Perception is a class skill for you, though if it is a class skill from the class you take at 1st level, you instead gain a +1 bonus to Perception checks. In addition, you gain an ability adjustment of +1 to Constitution at character creation."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"theme","tags":["Theme","Theme Benefit","Death Touched Theme Benefit","Death Touched Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"pact_worlds:ability:death_touched"},"when":"Always"}],"grants":[{"FactGrant":{"ClassSkill":"perception"}}],"provenance":{"book":"pact_worlds","kind":"ability","closure_rows":["starfinder/paizo/pact_worlds/spw_abilities.lst:156"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"pact_worlds:ability:death_touched_theme_benefit_theme_knowledge#bonus0","label":"THEME KNOWLEDGE (Perception)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"v8699219fc59f3ebb"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"perception"},"print":true,"pool":"theme","tags":["Theme","Theme Benefit","Death Touched Theme Benefit","Death Touched Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"provenance":{"book":"pact_worlds","kind":"ability","closure_rows":["starfinder/paizo/pact_worlds/spw_abilities.lst:156"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"