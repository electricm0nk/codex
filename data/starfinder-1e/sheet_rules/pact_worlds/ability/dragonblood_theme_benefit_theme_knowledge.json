[{"id":"pact_worlds:ability:dragonblood_theme_benefit_theme_knowledge","label":"THEME KNOWLEDGE (Display ~ Culture)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have a voracious appetite for lore about dragons and never forget a detail, whether it's about draconic culture, traditions, and abilities, or the personal information of the system's oldest dragons. When you attempt a Culture or Mysticism check to recall knowledge about dragons' ways, their abilities, or the names and general personal details about dragons that are adults or older, reduce the DC by 5. Culture is a class skill for you, but if it is a class skill from the class you take at 1st level, you instead gain a +1 bonus to Culture checks. In addition, you gain an ability adjustment of +1 to Charisma at character creation."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"theme","tags":["Theme","Theme Benefit","Dragonblood Theme Benefit","Dragonblood Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"pact_worlds:ability:dragonblood"},"when":"Always"}],"grants":[{"FactGrant":{"ClassSkill":"culture"}}],"provenance":{"book":"pact_worlds","kind":"ability","closure_rows":["starfinder/paizo/pact_worlds/spw_abilities.lst:162"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"pact_worlds:ability:dragonblood_theme_benefit_theme_knowledge#bonus0","label":"THEME KNOWLEDGE (Display ~ Culture)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"v31a690a55f70ca18"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"culture"},"print":true,"pool":"theme","tags":["Theme","Theme Benefit","Dragonblood Theme Benefit","Dragonblood Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"provenance":{"book":"pact_worlds","kind":"ability","closure_rows":["starfinder/paizo/pact_worlds/spw_abilities.lst:162"],"oracle_pin":"7f818006e371188e