[{"id":"character_operations_manual:ability:shirren_hive_defense","label":"Hive Defense","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Shirrens deeply value friends and constantly look out for these companions. Once per day, when an ally within 10 feet of a shirren with this trait attempts a saving throw, as a reaction, the shirren can allow that ally to roll their saving throw twice and use the higher result. This replaces communalism."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:shirren_hive_defense"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:shirren_individual_obsession"},"count":1}}]}}},"print":true,"pool":"racial_trait","tags":["Racial Trait","Shirren Racial Trait"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Shirren_Communalism","value":"true"}}],"provenance":{"book":"character_operations_manual","kind":"ability","closure_rows":["starfinder/paizo/character_operations_manual/scom_abilities_race.lst:58"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
