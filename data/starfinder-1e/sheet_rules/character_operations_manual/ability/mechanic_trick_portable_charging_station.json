[{"id":"character_operations_manual:ability:mechanic_trick_portable_charging_station","label":"Portable Charging Station","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can use your custom rig to recharge batteries. You can spend 10 minutes in contact with a battery and restore its charges to full. Once you have used your portable charging station a number of times per day equal to your Intelligence bonus (minimum 1), you can't do so again for 24 hours."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Compare":{"lhs":"Level","op":"Gte","rhs":{"Const":2}}},"print":true,"pool":"class_feature","tags":["Class Feature","Mechanic Trick","Extraordinary","Mechanic Trick LVL 2"],"subject":"Character","repeatable":false,"provenance":{"book":"character_operations_manual","kind":"ability","closure_rows":["starfinder/paizo/character_operations_manual/scom_abilities_class.lst:337"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
