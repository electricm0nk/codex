[{"id":"character_operations_manual:ability:powered_armor_jockey_perfect_fit","label":"Perfect Fit","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"While you are wearing powered armor, increase its land speed by 10 feet, up to your normal land speed, and reduce the speed adjustment from heavy armor you wear by 5 feet. In addition, reduce the armor check penalty of heavy armor or powered armor you wear by 1 (to a minimum of 0). This armor check penalty reduction stacks with reductions from other abilities, such as the armor training technique of the soldier's guard fighting style."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:technomancer_archetype_powered_armor_jockey"},"when":{"Compare":{"lhs":{"ClassLevel":"tec