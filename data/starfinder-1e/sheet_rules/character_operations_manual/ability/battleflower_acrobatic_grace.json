[{"id":"character_operations_manual:ability:battleflower_acrobatic_grace","label":"Acrobatic Grace","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can use Acrobatics checks in place of Diplomacy checks to change a creature's attitude as a sense-dependent rather than language-dependent effect. In addition, your movements can enthrall observers. As a full action, you can move up to your speed while performing an acrobatic dance. Choose one enemy within 60 feet; that foe must succeed at a Will save or be fascinated while you continue to take this full action on your turns. You can affect one extra target for every 3 class levels you have above 6th. This is a mind-affecting, sense-dependent effect."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_battleflower"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_battleflower"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_battleflower"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_battleflower"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_battleflower"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_battleflower"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:technomancer_ar