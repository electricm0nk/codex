[{"id":"character_operations_manual:ability:shirren_linguistic_acculturation","label":"Linguistic Acculturation","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"Shirrens quickly adapt to new languages they encounter, because doing so enables them to communicate their thoughts with new people and learn from them in turn. Shirrens with this trait gain a +2 bonus to Culture checks and learn two languages for each skill rank they have in the Culture skill. This replaces cultural fascination."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:shirren_cultural_assimilation"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:shirren_individual_obsession"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:shirren_linguistic_acculturation"},"count":1}}]}}},"target":{"Skill":"culture"},"bonus_type":{"name":"Racial","mode":"Plain"},"print":true,"pool":"racial_trait","tags":["Racial Trait","Shirren Racial Trait"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Shirren_CulturalFascination","value":"true"}}],"provenance":{"book":"character_operations_manual","kind":"ability","closure_rows":["starfinder/paizo/character_operations_manual/scom_abilities_race.lst:60"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
