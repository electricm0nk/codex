[{"id":"character_operations_manual:ability:vanguard_archetype_free_trader","label":"Free Trader","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A free trader is an independent contractor who buys, sells, and makes a living hauling freight. Most free traders own or work on a starship, buying surplus commodities on the cheap and traveling to distant worlds where those same commodities command good prices. Free traders sometimes band together into a small merchant company, with members acting as guards, engineers, and other specialists organized under a single manager. Everyone shares the profits. If they are lucky, one good cargo run make them rich, but for most, it's a hardknock life that means barely scraping by."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"vanguard"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_free_trader"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_android_abolitionist"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_battleflower"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_espionage_specialist"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_fixer"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_free_trader"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_instructor"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_medic"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:vanguard_archetype_powered_armor_jockey"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:abili