[{"id":"character_operations_manual:ability:instructor_efficient_mentor","label":"Efficient Mentor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"When you attempt to aid another on a skill check, you do so in half the normal time if that time is measured in units other than actions. For tasks requiring actions, one that normally takes a full action takes you only a standard action. One that normally takes a standard action takes you only a move action, and if the task usually requires only a move action, you can do it as a swift action. If you instead take the normal amount of time to aid another, the bonus you impart increases to +4 instead of the normal +2. At 18th level, you grant this +4 bonus even when you aid another quickly, and if you instead take the full time to aid another, you grant a +6 bonus instead of the normal +2."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_instructor"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_instructor"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_instructor"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_instructor"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_instructor"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_instructor"},"when":{"Compare":{