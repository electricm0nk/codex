[{"id":"character_operations_manual:ability:fixer_dark_rep","label":"Dark Rep","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Among criminals, your name is spoken in a respectful tone. Lower the DC of Bluff, Diplomacy, and Intimidate checks you attempt against criminals who know of you by 5. In addition, as a full action, you can attempt an Intimidate check to demoralize all foes within 60 feet. The DC of this check is the highest DC to demoralize any one of those foes. If you succeed, each foe is shaken for 1 round plus 1 round for every 5 by which your check result exceeds the DC."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:technomancer_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability