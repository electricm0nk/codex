[{"id":"character_operations_manual:ability:fixer_criminal_network","label":"Criminal Network","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have an array of criminal contacts, so you know who to call when you need a tip, and your contacts are usually willing to help or point you to someone who can. Reduce your DC to gather information on criminal enterprises and figures by 5. When you communicate or meet with a criminal for the first time, improve their initial attitude toward you by one step. Your reputation also helps you coerce others. When you use Intimidate to bully someone who has heard of either you or those for whom you work, the effect of a successful check lasts for 1d6 days."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_fixer"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":12}}}},{"by":{"Rule":"character_operations_manual:ability:technomancer_archetype_fixer"},"when":{"Compare":{"lhs":{"