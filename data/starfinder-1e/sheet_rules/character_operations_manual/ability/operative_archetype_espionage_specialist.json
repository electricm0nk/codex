[{"id":"character_operations_manual:ability:operative_archetype_espionage_specialist","label":"Espionage Specialist","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Espionage specialists are company spies or clandestine agents trusted by corporate management to successfully complete sensitive tasks with the utmost discretion. Espionage specialists excel at slipping into a false identity and creating forged documentation to match. Many espionage specialists prefer to avoid violence in favor of stealthy, untraceable intrusions behind enemy lines, but they are trained in combat and capable of dealing precise damage to those they catch off guard."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":{"All":[{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":1}}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_espionage_specialist"},"count":1}},{"Not":{"AtLeast":{"n":1,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core:ability:operative_archetype_phrenic_adept"},"count":1}},{"Holds":{"what":{"Rule":"core:ability:operative_archetype_starfinder_forerunner"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_android_abolitionist"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_battleflower"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_espionage_specialist"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_fixer"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_free_trader"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_instructor"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_medic"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_ma