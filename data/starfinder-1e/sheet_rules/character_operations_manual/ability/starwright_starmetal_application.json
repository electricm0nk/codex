[{"id":"character_operations_manual:ability:starwright_starmetal_application","label":"Starmetal Application","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have a starwright's kit containing tiny amounts of starmetal you can use once per day to infuse a single item. After 10 minutes of uninterrupted work, you grant the item the benefit from the chosen starmetal for 24 hours, as described below. For siccatite, choose cold (for a cold benefit) or hot (for a fire benefit)."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:technomancer_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"character_operations_manual:ability:biohacker_archetype_starwright"},"when":{"Compare":{"lhs":{"ClassLevel":"biohacke