[{"id":"character_operations_manual:ability:halfling_talespinner","label":"Talespinner","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"Halflings love adventure and travel almost as much as they enjoy spinning tales about their trials and tribulations—tales they use to entertain allies and strangers, as well as to disarm their enemies. Halflings who have this racial trait gain a +2 bonus to Bluff skill checks, and Bluff is a class skill for them. They also gain a +2 bonus to Diplomacy checks to change the attitudes of others with entertaining tales. This replaces keen senses and sure-footed."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"SkillBonus"},"pieces":[{"Text":"+2 bonus to Diplomacy checks to change the attitudes of others"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"Not":{"AtLeast":{"n":2,"of":[{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_cunning"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_needler"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_skittish"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_talespinner"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_winsome"},"count":1}}]}},{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_spacefarer"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_talespinner"},"count":1}}]}}]}}},"target":{"Skill":"bluff"},"bonus_type":{"name":"Racial","mode":"Plain"},"print":true,"pool":"racial_trait","tags":["Racial Trait","Halfling Racial Trait"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Halfling_KeenSenses","value":"true"}},{"FactDeclare":{"name":"Halfling_SureFooted","value":"true"}},{"FactGrant":{"ClassSkill":"bluff"}}],"provenance":{"book"