[{"id":"character_operations_manual:ability:halfling_winsome","label":"Winsome","value":{"Number":{"Const":2}},"prose":[{"family":"Desc","pieces":[{"Text":"Some halflings seem able to charm anyone, through a combination of endearing behavior and physical proportions that lead other species to view them as young and cute. Although such halflings might not be any kinder or friendlier, they nevertheless maximize the benefit of this mistaken impression. These halflings gain a +2 bonus to Bluff checks and to Diplomacy checks to change the attitude of indifferent creatures. This replaces sure-footed."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"Aspect":"SkillBonus"},"pieces":[{"Text":"+2 bonus to Diplomacy checks to change the attitudes of indifferent creatures"}],"pick_last":true,"suppress_when_all_zero":false}],"applies":{"Not":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_cunning"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_needler"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_skittish"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_talespinner"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:halfling_winsome"},"count":1}}]}}},"target":{"Skill":"bluff"},"bonus_type":{"name":"Racial","mode":"Plain"},"print":true,"pool":"racial_trait","tags":["Racial Trait","Halfling Racial Trait"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Halfling_SureFooted","value":"true"}}],"provenance":{"book":"character_operations_manual","kind":"ability","closure_rows":["starfinder/paizo/character_operations_manual/scom_abilities_race.lst:117"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
