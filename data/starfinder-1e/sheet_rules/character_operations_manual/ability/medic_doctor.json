[{"id":"character_operations_manual:ability:medic_doctor","label":"Doctor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You gain a number of special abilities related to the Medicine skill and healing, as noted below. \n *Whenever you use equipment or one of your abilities to restore Hit Points to a creature, any surplus healing beyond that required to restore the creature to its maximum Hit Points restores that many Stamina Points to the creature. \n *You can tend up to 20 patients with long-term care. \n *When you use the long-term stability task of Medicine, if you succeed at the Medicine check by 10 or more, the patient heals 1 HP and regains consciousness. \n *You can use Medicine to treat disease in only 1 minute instead of 10 minutes."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"character_operations_manual:ability:soldier_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"character_operations_manual:ability:technomance