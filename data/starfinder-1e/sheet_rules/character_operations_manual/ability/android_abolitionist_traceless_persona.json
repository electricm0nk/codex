[{"id":"character_operations_manual:ability:android_abolitionist_traceless_persona","label":"Traceless Persona","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Once per day, you can take 20 on an attempt to use Computers to create or detect a forgery. Anyone attempting to use Computers to track the digital signature of you or your ward must roll twice and use the lowest result when doing so. This feature provides a number of other benefits. The DC for another creature to find or follow your tracks is 20 + 1-1/2 × your ranks in Stealth or Survival (your choice). If you mask or cover allies' tracks, taking at least a full action to do so, this DC also applies to checks to find or follow those tracks. In addition, when you attempt a Disguise check to change your appearance, you can affect yourself and up to six allies. When you attempt to change your appearance and that of your allies, you can ignore DC modifiers for altering major features, being disguised as a different race of the same creature type, and being disguised as a different creature type."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_android_abolitionist"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_android_abolitionist"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_android_abolitionist"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_android_abolitionist"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"R