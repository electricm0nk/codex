[{"id":"character_operations_manual:ability:medic_medical_specialist","label":"Medical Specialist","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your medical mastery continues to improve; you gain the following abilities. \n *When you treat deadly wounds and succeed at the Medicine check by 5 or more, add your character level to the amount of Hit Points you restore. \n *When you treat a creature for disease, drugs, or poison and the patient fails a saving throw that would result in the patient moving to the next step on the condition track, you can spend 1 Resolve Point to keep the creature at its current position on the condition track. The saving throw is not considered to have been successful, but the creature does not get worse. \n *When a creature reaches a non-fatal end state for a disease, drug, or poison (such as that for leprosy), you can still treat them, and if your Medicine check is successful, the creature can still attempt a saving throw to recover."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:envoy_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:mechanic_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:mystic_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:operative_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"character_operations_manual:ability:solarian_archetype_medic"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":9}