[{"id":"character_operations_manual:spell:haunted_armor","label":"Haunted Armor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You divert a malevolent spirit from the River of Souls to haunt your opponent's armor. This spell must target a suit of light, heavy, or powered armor. The armor becomes cumbersome, reducing the wearer's speed by 10 feet and AC by 1. It also rattles, hisses, and screeches, imposing a –4 penalty on Stealth checks"}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"one worn suit of armor; see text"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"1 round/level"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"mystic","spell_level":2}},"when":"Always"}],"provenance":{"book":"character_operations_manual","kind":"spell","closure_rows":["starfinder/paizo/character_operations_manual/scom_spells.lst:20","starfinder/paizo/character_operations_manual/scom_spells.lst:87"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_conver