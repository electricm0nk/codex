[{"id":"character_operations_manual:spell:laser_net","label":"Laser Net","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"This spell creates a net of dangerous lasers between two solid points. The net can appear only if there are appropriate anchoring surfaces at both ends of the beams, such as two walls, a wall and a ceiling, or the like. Otherwise, the spell fails. Creatures that move through the laser net must succeed at a Reflex saving throw or take 1d6+1 fire damage per 5 feet of laser net they move through. Creatures that move no more than 5 feet in the laser net receive a +2 circumstance bonus to this saving throw, but creatures that move through more than 15 feet of the laser net in a single turn take a –2 penalty to the saving throw."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":100},{"Mul":[{"Const":10},{"CasterLevel":"Holder"}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"lasers in a 20-ft.-radius spread"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"1 minute/level (D)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Reflex negates, see text"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":2}},"when":"Always"}],"provenance":{"book":"character_operations_manual","kind":"spell","closure_rows":["starfinder/paizo/character_operations_manual/scom_spells.lst:30","starfinder/paizo/character_operations_manual/scom_spells.lst:97"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
