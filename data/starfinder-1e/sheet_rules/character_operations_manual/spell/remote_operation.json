[{"id":"character_operations_manual:spell:remote_operation","label":"Remote Operation","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A holographic duplicate of the target's controls appears within your reach. If the target has no controls, the spell fails. As part of concentrating on this spell, you (and only you) can use these holocontrols to operate the target as if you were able to touch its actual controls. The spell ends if the target moves out of range."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"60 ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"one operable technological device no larger than a vehicle that is not a starship"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"concentration + 1 round/level"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"yes"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":1}},"when":"Always"}],"provenance":{"book":"character_operations_manual","kind":"spell","closure_rows":["starfinder/paizo/character_operations_manual/scom_spells.lst:47","starfinder/paizo/character_operations_manual/scom_spells.lst:114"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
