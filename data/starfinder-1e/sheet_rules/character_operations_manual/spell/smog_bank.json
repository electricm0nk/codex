[{"id":"character_operations_manual:spell:smog_bank","label":"Smog Bank","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You create a noxious cloud similar to fog cloud that is harmful to living creatures. Smog bank obscures sight just as fog cloud does. Living creatures without environmental protections that are in the area when the spell is cast or who enter the area must attempt a Fortitude save or be sickened for as long as they remain in the cloud and for 1d4+1 rounds thereafter."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"creation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":100},{"Mul":[{"Const":10},{"CasterLevel":"Holder"}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"20-ft.-radius spread"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"10 minutes/level"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude negates, see text"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"No"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":3}},"when":"Always"}],"provenance":{"book":"character_operations_manual","kind":"spell","closure_rows":["starfinder/paizo/character_operations_manual/scom_spells.lst:53","starfinder/pa