[{"id":"alien_archive:ability:wrikreechee_default_snag","label":"SNAG","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Thanks to the feathery material lining its forelimbs, a wrikreechee is adept at grabbing small prey. A wrikreechee gains a +4 bonus to attack rolls when attempting to grapple a creature smaller than itself. As a full action, a wrikreechee can make two attempts to grapple a creature with a -4 penalty to the attack rolls."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"racial_trait","tags":["Racial Trait","Wrikreechee Racial Trait"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"character_operations_manual:ability:android_xenometric_race_wrikreechee"},"when":"Always"},{"by":{"Rule":"alien_archive:ability:wrikreechee"},"when":{"Not":{"Holds":{"what":{"Fact":{"name":"Wrikreechee_Snag","value":"true"}},"count":1}}}}],"grants":[{"FactDeclare":{"name":"Wrikreechee_Snag","value":"false"}}],"provenance":{"book":"alien_archive","kind":"ability","closure_rows":["starfinder/paizo/alien_archive/saa_abilities.lst:223"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
