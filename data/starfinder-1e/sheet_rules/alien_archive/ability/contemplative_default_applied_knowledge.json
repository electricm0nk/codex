[{"id":"alien_archive:ability:contemplative_default_applied_knowledge","label":"APPLIED KNOWLEDGE","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Once per day before attempting a skill check or saving throw against a creature, a contemplative can use its bonus for the skill associated with that creature's type (such as Life Science for an ooze or Mysticism for an outsider) in place of its normal bonus."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"racial_trait","tags":["Racial Trait","Contemplative Racial Trait"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Contemplative_AppliedKnowledge","value":"false"}}],"provenance":{"book":"alien_archive","kind":"ability","closure_rows":["starfinder/paizo/alien_archive/saa_abilities.lst:72"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
