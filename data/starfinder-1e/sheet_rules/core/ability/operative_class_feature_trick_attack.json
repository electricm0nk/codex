[{"id":"core:ability:operative_class_feature_trick_attack","label":"Trick Attack","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Archetype altered."}],"applies":{"AtLeast":{"n":1,"of":[{"Holds":{"what":{"Rule":"core:ability:operative_archetype_phrenic_adept"},"count":1}},{"Holds":{"what":{"Rule":"core:ability:operative_archetype_starfinder_forerunner"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_android_abolitionist"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_battleflower"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_espionage_specialist"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_fixer"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_free_trader"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_instructor"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_medic"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_powered_armor_jockey"},"count":1}},{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_archetype_starwright"},"count":1}},{"Holds":{"what":{"Rule":"pact_worlds:ability:operative_archetype_arcanamirium_sage"},"count":1}},{"Holds":{"what":{"Rule":"pact_worlds:ability:operative_archetype_divine_champion"},"count":1}},{"Holds":{"what":{"Rule":"pact_worlds:ability:operative_archetype_skyfire_centurion"},"count":1}},{"Holds":{"what":{"Rule":"pact_worlds:ability:operative_archetype_star_knight"},"count":1}},{"Holds":{"what":{"Rule":"pact_worlds:ability:operative_archetype_starfinder_data_jockey"},"count":1}},{"Holds":{"what":{"Rule":"pact_worlds:ability:operative_archetype_steward_officer"},"count":1}},{"Holds":{"what":{"Rule":"near_space:ability:operative_archetype_assassin"},"count":1}},{"Holds":{"what":{"Rule":"near_space:ability:operative_archetype_battle_leader"},"count":1}},{"Holds":{"what":{"Rule":"near_space:ability:operative_archetype_commando"},"count":1}},{"Holds":{"what":{"Rule":"near_space:ability:operative_archetype_doshko_specialist"},"count":1}},{"Holds":{"what":{"Rule":"near_space:ability:operative_archetype_mediator"},"count":1}}]}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You can trick or startle a foe and then attack when she drops her guard. As a full action, you can move up to your speed. Whether or not you moved, you can then make an attack with a melee weapon with the operative special property or with any small arm. Just before making your attack, attempt a Bluff, Intimidate, or Stealth check (or a check associated with your specialization; see page 94) with a DC equal to 20 + your target's CR. If you succeed at the check, you deal 1d4 additional damage and the target is flat-footed. This damage increases to 1d8 at 3rd level, to 3d8 at 5th level, and by an additional 1d8 every 2 levels thereafter. You can't use this ability with a weapon that has the unwieldy special property or that requires a full action to make a single attack. [Trick Attack Damage: "},{"Slot":{"Var":"v1f09ed738a47ec40"}},{"Text":"d"},{"Slot":{"Var":"va3dd559bc38adb0d"}},{"Text":"]"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Operative Class Feature","Extraordinary"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Class":{"id":"operative","at_level":1}},"when":{"All":[{"Not":{"Holds":{"what":{"Rule":"character_operations_manual:ability:operative_acf_stunt_and_strike"},"count":1}}},{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":1}}}]}}],"provenance":{"book":"core","kind":"ability","closure_rows":["starfinder/paizo/core/scr_abilities.lst:1720"],"oracle