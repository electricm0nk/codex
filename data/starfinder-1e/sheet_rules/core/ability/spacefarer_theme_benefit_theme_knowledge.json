[{"id":"core:ability:spacefarer_theme_benefit_theme_knowledge","label":"THEME KNOWLEDGE (Display ~ Physical Science)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are obsessed with distant worlds, and you always mentally catalog everything you learn about new and strange places so you can recall it when you need it most. Additionally, you use your knowledge of biology and topology to inure yourself to alien hazards. Reduce the DC of Physical Science checks to recall knowledge about strange new worlds or features of space by 5. Physical Science is a class skill for you, though if it is a class skill from the class you take at 1st level, you instead gain a +1 bonus to Physical Science checks. In addition, you gain an ability adjustment of +1 to Constitution at character creation."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"theme","tags":["Theme","Theme Benefit","SPACEFARER Theme Benefit","SPACEFARER Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core:ability:spacefarer"},"when":"Always"}],"grants":[{"FactGrant":{"ClassSkill":"physical_science"}}],"provenance":{"book":"core","kind":"ability","closure_rows":["starfinder/paizo/core/scr_abilities.lst:665"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core:ability:spacefarer_theme_benefit_theme_knowledge#bonus0","label":"THEME KNOWLEDGE (Display ~ Physical Science)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"vf5dcd4ee927746ec"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"physical_science"},"print":true,"pool":"theme","tags":["Theme","Theme Benefit","SPACEFARER Theme Benefit","SPACEFARER Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"provenance":{"book":"core","kind":"ability","closure_rows":["starfinder/paizo/core/scr_abilities.lst:665"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","conv