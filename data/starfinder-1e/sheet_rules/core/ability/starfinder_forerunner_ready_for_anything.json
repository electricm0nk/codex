[{"id":"core:ability:starfinder_forerunner_ready_for_anything","label":"Ready for Anything","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"As an advance scout and planner for larger expeditions, you have trained yourself to be ready for nearly anything. This experience and expertise at planning gives you a number of abilities. When you are able to act in the surprise round of a combat, you gain a +2 bonus to your initiative check for that combat. When you successfully identify a creature with a skill check (see page 133), you learn"}],"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"one more useful piece of information than normal."}],"applies":{"Compare":{"lhs":{"Var":"v7ed45768ceea4535"},"op":"Lt","rhs":{"Const":11}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"two more useful pieces of information than normal."}],"applies":{"Compare":{"lhs":{"Var":"v7ed45768ceea4535"},"op":"Gte","rhs":{"Const":11}}},"pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"When you attempt a Culture check to decipher writing (see page 139), there is no chance you will misconstrue the message (though you might still be unable to translate it), and you can take 20 (see page 133) on Culture checks to decipher writing even if you are not trained in Computers and don't have access to a computer or downloaded dataset."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core:ability:envoy_archetype_starfinder_forerunner"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:mechanic_archetype_starfinder_forerunner"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:mystic_archetyp