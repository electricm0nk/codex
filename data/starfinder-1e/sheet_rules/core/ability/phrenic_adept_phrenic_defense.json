[{"id":"core:ability:phrenic_adept_phrenic_defense","label":"Phrenic Defense","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Your psychic powers give you additional defenses against mental attacks. The first time you fail a saving throw against a spell or effect with the emotion, fear, mind-affecting, or pain descriptor (see page 269), you can spend 1 Resolve Point as a reaction to immediately reroll the failed saving throw. Even if the second saving throw fails, your stronger defenses might reduce the effect of the spell or ability. If the spell or ability deals damage, reduce the damage done by "},{"Slot":{"Var":"v896f2203df55d82d"}},{"Text":". If the spell or ability has a duration of 2 rounds or longer, reduce its duration by half."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core:ability:envoy_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:mechanic_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:mystic_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:operative_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:solarian_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:soldier_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"core:ability:technomancer_archetype_phrenic_adept"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":4}}}}],"prov