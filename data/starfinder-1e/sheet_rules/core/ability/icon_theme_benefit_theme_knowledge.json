[{"id":"core:ability:icon_theme_benefit_theme_knowledge","label":"THEME KNOWLEDGE (icon profession picks)","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Choose a Profession skill. You are hooked deeply into the culture of your iconic profession. When attempting a Profession or Culture check to recall knowledge about other icons of your profession or details about your profession's cultural aspects, increase the DC by 5. You gain a +1 bonus to checks with your chosen Profession skill. Culture also becomes a class skill for you, though if it is a class skill from the class you take at 1st level, you instead gain a +1 bonus to Culture checks. In addition, you gain an ability adjustment of +1 to Charisma at character creation."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"icon_profession"},"print":true,"pool":"theme","tags":["Theme","Theme Benefit","Icon Theme Benefit","Icon Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"core:ability:icon"},"when":"Always"}],"offers":{"id":"core:ability:icon_theme_benefit_theme_knowledge","count":{"Const":1},"from":{"Rules":{"pool":"class_feature","tags":["Icon Profession"],"requires":"Always"}}},"grants":[{"FactGrant":{"ClassSkill":"culture"}}],"provenance":{"book":"core","kind":"ability","closure_rows":["starfinder/paizo/core/scr_abilities.lst:635"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"core:ability:icon_theme_benefit_theme_knowledge#bonus1","label":"THEME KNOWLEDGE (Display ~ Culture)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"v31a690a55f70ca18"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"culture"},"print":true,"pool":"theme","tags":["Theme","Theme Benefit","Icon Theme Benefit","Icon Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"provenance":{"book":"core","kind":"ability","closure_rows":["star