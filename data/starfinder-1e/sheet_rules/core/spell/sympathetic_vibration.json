[{"id":"core:spell:sympathetic_vibration","label":"Sympathetic Vibration","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Deal 2d10 damage per round to freestanding structure."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"By attuning yourself to a freestanding structure or vehicle (this doesn't include starships), you can create a damaging vibration within it. Once it begins, the vibration deals 2d10 sonic damage per round to the target, bypassing hardness. You can choose at the time of casting to limit the duration of the spell; otherwise, it lasts for "},{"Slot":{"CasterLevel":"Holder"}},{"Text":" rounds. If the spell is cast upon a target that is not freestanding, the surrounding material dissipates the effect and no damage occurs. Sympathetic vibration can't affect creatures (even if they are constructs)."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Evocation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Sonic"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"10 minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One freestanding structure or vehicle"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Up to "},{"Slot":{"CasterLevel":"Holder"}},{"Text":" rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"None"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":6}},"when":"Always"}],"provenance":{"book":"core","kind":"spell","closure_rows":["starfinder/paizo/core/scr_spells.lst:228","starfinder/paizo/core/scr_spells.lst:484","starfinder/paizo/core/scr_spells.lst:791"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
