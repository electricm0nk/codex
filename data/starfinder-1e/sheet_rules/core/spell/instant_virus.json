[{"id":"core:spell:instant_virus","label":"Instant Virus","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Inflict technological construct with disease."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"You overwhelm your target's programming, installing a dangerous self-replicating programming virus. This works like a physical or mental disease (your choice), except it ignores the target's immunity to diseases. The programming virus has a frequency of 1 hour and requires two consecutive saving throws to cure. Detect affliction can reveal the existence of this virus in a construct (the virus is considered a disease for purposes of that spell). Additionally, remove affliction can remove this virus."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Necromancy"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One construct with the technological subtype"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous; see text"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude negates, see text"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":3}},"when":"Always"}],"provenance":{"book":"core","kind":"spell","closure_rows":["starfinder/pai