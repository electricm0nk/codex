[{"id":"core:spell:resistant_armor_greater","label":"Resistant Armor (Greater)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Grant DR 10/— or energy resistance 10 against three energy types."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Greater resistant armor grants the target (and its gear) protection from your choice of either kinetic damage or energy damage. If you choose kinetic damage, the target and her gear gain DR 15/— that protects against bludgeoning, piercing, and slashing damage. If you choose energy damage, pick any four of acid, cold, electricity, fire, and sonic damage. The target and her gear gain energy resistance 15 that protects against the chosen types of energy. This damage reduction or energy resistance doesn't stack with any damage reduction or energy resistance the target already has, and multiple castings of this spell don't stack."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Abjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature wearing armor"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Slot":{"Mul":[{"CasterLevel":"Holder"},{"Const":10}]}},{"Text":" minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Fortitude negates (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes (harmless)"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"mystic","spell_level":6}},"when":"Always"},{"by":{"ClassSpellList":{"id":"technomancer","spell_level":6}},"when":"Always"}],"provenance":{"book":"core","kind":"spell","closure_rows":["starfinder/paizo/core/scr_spells.lst:203","starfinder/paizo/core/scr_spells.lst:459","starfinder/paizo/core/scr_spells.lst:649","starfinder/paizo/core/scr_spells.lst:787"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
