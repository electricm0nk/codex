[{"id":"core:spell:make_whole","label":"Make Whole","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Restore 1d4 Hit Points to an object or construct."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"This spell functions as mending, except it restores 5d6 Hit Points when cast on an object or construct creature. Make whole can fix destroyed magic items, and it restores the magic properties of the item if your technomancer level is at least twice the item's level. Items with charges (such as batteries) and single-use items (such as potions and grenades) can't be repaired in this way. When you cast make whole on a construct, the spell bypasses any immunity to magic as if the spell did not allow spell resistance."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"10 minutes"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One object of up to "},{"Slot":{"CasterLevel":"Holder"}},{"Text":" bulk or one construct of any size"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (harmless, object)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes (harmless, object)"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character",