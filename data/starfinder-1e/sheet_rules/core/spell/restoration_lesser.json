[{"id":"core:spell:restoration_lesser","label":"Restoration (Lesser)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"Dispel magical ability penalty or cure 1d4 ability damage."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":"Desc","pieces":[{"Text":"Lesser restoration dispels any magical effects reducing one of the target's ability scores, or it heals 1d4 temporary ability damage to one of the target's ability scores. It also eliminates any fatigue suffered by the creature or improves an exhausted condition to fatigued, but it doesn't remove any underlying source of fatigue or exhaustion. It also doesn't heal permanent ability drain. A target that has benefited from the removal of fatigue or the reduction of exhaustion from lesser restoration can't benefit from either effect again for 24 hours."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"Conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Descriptor"},"pieces":[{"Text":"Healing"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"3 rounds"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"Touch"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"One creature"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"Instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Will negates (harmless)"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"Yes"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSp