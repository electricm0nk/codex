[{"id":"alien_archive_2:ability:vlaka_default_vlaka_senses","label":"VLAKA SENSES","value":{"Number":{"Const":1}},"prose":[{"family":"Desc","pieces":[{"Text":"Vlakas can be born with one of three possible sets of senses. During character creation, determine a vlaka's senses by choosing from those available. A vlaka born with functional sight or hearing who becomes permanently blind or deaf does not gain the abilities of a vlaka born with blindness or deafness."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","target":{"Pool":"vlaka_senses_selection"},"print":true,"pool":"racial_trait","tags":["Racial Trait","Vlaka Racial Trait"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"alien_archive_2:ability:vlaka"},"when":{"Not":{"Holds":{"what":{"Fact":{"name":"Vlaka_VlakaSenses","value":"true"}},"count":1}}}}],"offers":{"id":"alien_archive_2:ability:vlaka_default_vlaka_senses","count":{"Const":1},"from":{"Rules":{"pool":"racial_trait","tags":["Vlaka Senses Selection"],"requires":"Always"}}},"grants":[{"FactDeclare":{"name":"Vlaka_VlakaSenses","value":"false"}}],"provenance":{"book":"alien_archive_2","kind":"ability","closure_rows":["starfinder/paizo/alien_archive_2/saa2_abilities.lst:178"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
