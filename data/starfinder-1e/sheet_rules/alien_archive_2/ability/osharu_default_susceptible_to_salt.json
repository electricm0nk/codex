[{"id":"alien_archive_2:ability:osharu_default_susceptible_to_salt","label":"SUSCEPTIBLE TO SALT","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"A handful or more of salt or a splash of salt water deals 1d6 damage to an osharu, and full immersion in salt water deals 4d6 damage per round. These effects are negated by the environmental protections built into most armor."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"racial_trait","tags":["Racial Trait","Osharu Racial Trait"],"subject":"Character","repeatable":false,"grants":[{"FactDeclare":{"name":"Osharu_SusceptibleToSalt","value":"false"}}],"provenance":{"book":"alien_archive_2","kind":"ability","closure_rows":["starfinder/paizo/alien_archive_2/saa2_abilities.lst:116"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
