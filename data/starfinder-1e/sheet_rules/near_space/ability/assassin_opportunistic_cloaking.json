[{"id":"near_space:ability:assassin_opportunistic_cloaking","label":"Opportunistic Cloaking","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You know how to manipulate your environment and take advantage of gaps in others' perception to become undetectable even in plain sight. Once per day, you can attempt a Stealth check to hide as though you had succeeded at the create a diversion task of the Bluff skill against up to six creatures you're observing. This ability functions only in crowded areas or in dim light or darkness (Core Rulebook 261); the GM might determine you can use this ability in similar circumstances."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:envoy_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:mechanic_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:mystic_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:operative_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:solarian_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:soldier_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:technomancer_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":6}}}},{"by":{"Rule":"near_space:ability:biohacker_archetype_assassin"},"when":{"Compare":{"lhs":{"ClassLevel":"biohacker"},"op":