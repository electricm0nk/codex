[{"id":"near_space:ability:giantblood_theme_benefit_theme_knowledge","label":"THEME KNOWLEDGE (Culture)","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have great respect for giants and know much about their varied societies, cultural traditions, and famous figures. When you attempt a Culture or Life Science check to identify or recall knowledge about giants, their abilities, or the names of famous giants, reduce the DC by 5. Culture is a class skill for you. If it is a class skill from the class you take at 1st level, you instead gain a +1 bonus to Culture checks. In addition, you gain an ability adjustment of +1 to Constitution at character creation."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"theme","tags":["Theme","Theme Benefit","Giantblood Theme Benefit","Giantblood Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:giantblood"},"when":"Always"}],"grants":[{"FactGrant":{"ClassSkill":"culture"}}],"provenance":{"book":"near_space","kind":"ability","closure_rows":["starfinder/paizo/near_space/sns_abilities.lst:34"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"near_space:ability:giantblood_theme_benefit_theme_knowledge#bonus0","label":"THEME KNOWLEDGE (Culture)","value":{"Number":{"Const":1}},"applies":{"Compare":{"lhs":{"Var":"v31a690a55f70ca18"},"op":"Gte","rhs":{"Const":2}}},"target":{"Skill":"culture"},"print":true,"pool":"theme","tags":["Theme","Theme Benefit","Giantblood Theme Benefit","Giantblood Theme Benefit Lvl 1"],"subject":"Character","repeatable":false,"provenance":{"book":"near_space","kind":"ability","closure_rows":["starfinder/paizo/near_space/sns_abilities.lst:34"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}},{"id":"near_space:ability:giantblood_theme_benefit_theme_knowledge#bonus1","label":"THEM