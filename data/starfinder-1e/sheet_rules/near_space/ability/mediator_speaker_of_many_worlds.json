[{"id":"near_space:ability:mediator_speaker_of_many_worlds","label":"Speaker of Many Worlds","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You can draw upon all known languages to make yourself understood in almost any situation. You gain the ability to cast tongues once per day as a spell-like ability. In addition, once per day as a full action, you can touch up to two willing creatures with an Intelligence modifier of at least –3 and grant them the ability to communicate with you and each other as though under the effect of tongues. This effect lasts for 1 hour or until you end it with a swift action. This is a mind-affecting affect."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:envoy_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:mechanic_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:mystic_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:operative_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:solarian_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:soldier_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:technomancer_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":9}}}},{"by":{"Rule":"near_space:ability:biohacker_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLev