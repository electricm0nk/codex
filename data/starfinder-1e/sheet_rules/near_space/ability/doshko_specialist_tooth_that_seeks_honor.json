[{"id":"near_space:ability:doshko_specialist_tooth_that_seeks_honor","label":"Tooth That Seeks Honor","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"The second doshko tooth resists dishonor. Your training empowers you to recover from missed blows by extending your reach or changing tactics. When you miss an opponent with a melee attack with your doshko, you can grant that doshko the disarm, reach, sunder (Armory 30), or trip weapon special property until the start of your next turn. If you miss again before the start of your next turn, you can grant the doshko an additional special property from the list. You can grant a doshko only two special properties at a time with this ability."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:envoy_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:mechanic_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:mystic_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:operative_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:solarian_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:soldier_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:technomancer_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Co