[{"id":"near_space:ability:mediator_diplomatic_nuance","label":"Diplomatic Nuance","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You gain Culture and Diplomacy as class skills. For each of these skills that is already a class skill for you from a source other than this archetype, you learn to speak and read a new language. You can use your Diplomacy skill for Bluff checks to lie or pass a secret message and your Culture skill for Life Science checks to identify humanoids and monstrous humanoids. When you attempt a Diplomacy check to change a creature's attitude, the creature's attitude worsens only if you fail the check by 10 or more, rather than if you fail the check by 5 or more."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:envoy_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:mechanic_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:mystic_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:operative_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:solarian_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:soldier_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:technomancer_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":2}}}},{"by":{"Rule":"near_space:ability:biohacker_archetype