[{"id":"near_space:ability:mediator_expert_negotiator","label":"Expert Negotiator","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You are highly skilled at convincing others and reaching amicable agreements. If a creature's initial attitude toward you would be unfriendly, indifferent, or friendly, you instead treat its attitude as one category higher. When you fail a Diplomacy check to change the attitude of a hostile creature by 10 or less, you can attempt to change its attitude again. Whenever an ally uses aid another to assist you with a Diplomacy check to change a creature's attitude, if you succeed at that check, the targeted creature's attitude toward your ally also improves."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:envoy_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:mechanic_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:mystic_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:operative_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:solarian_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:soldier_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:technomancer_archetype_mediator"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":4}}}},{"by":{"Rule":"near_space:ability:biohacker_archetype_