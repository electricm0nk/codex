[{"id":"near_space:ability:doshko_specialist_tooth_that_commands_terror","label":"Tooth That Commands Terror","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You have earned the right to bear the celebrated five‑bladed doshko. Any doshko you hold manifests five blades, magically sprouting additional blades of steel or energy as needed. While you hold a doshko, you gain a +4 circumstance bonus to saves against fear effects and you gain the frightful presence universal creature rule (Alien Archive 154) with a range of 60 feet and a duration of 2d4 rounds. The DC for this effect is 10 + half your base attack bonus + your Strength modifier."}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"class_feature","tags":["Class Feature","Archetype Class Feature"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"Rule":"near_space:ability:envoy_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"envoy"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:ability:mechanic_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"mechanic"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:ability:mystic_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"mystic"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:ability:operative_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"operative"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:ability:solarian_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"solarian"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:ability:soldier_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"soldier"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:ability:technomancer_archetype_doshko_specialist"},"when":{"Compare":{"lhs":{"ClassLevel":"technomancer"},"op":"Gte","rhs":{"Const":18}}}},{"by":{"Rule":"near_space:abili