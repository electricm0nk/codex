[{"id":"near_space:spell:junk_shard","label":"Junk Shard","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You summon sharp fragments of technological junk that fly toward your target and deal 3d6 piercing and slashing damage. The spell leaves behind 1 bulk of junked electronic equipment in the target creature's space that is suitable for targeting with spells such as battle junkbot, handy junkbot, healing junkbot, junk armor, junk restraints, or junksword. The junked electronics have no resale value and cannot be repaired into any functioning item. A creature trained in Engineering or Physical Science can reveal the useless nature of the junk by directly examining it."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"conjuration"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Slot":{"Sum":[{"Const":25},{"Mul":[{"Const":5},{"Floor":{"Div":[{"CasterLevel":"Holder"},{"Const":2}]}}]}]}},{"Text":" ft."}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Target or area"},"pieces":[{"Text":"one creature or object"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"instantaneous"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Saving throw"},"pieces":[{"Text":"Reflex half"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Spell resistance"},"pieces":[{"Text":"no"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":1}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witchwarper","spell_level":1}},"when":"Always"}],"