[{"id":"near_space:spell:personal_gravity","label":"Personal Gravity","value":"Text","prose":[{"family":"Desc","pieces":[{"Text":"You alter gravity's effects on you. You treat gravity as if it were your choice of 1 step higher or lower (for example, if you were in an area of low gravity, you could choose either standard gravity or zero-g). You can suppress or resume this affect as a reaction or swift action. While under the effects of this spell, you can also reduce the distance of any forced movement that would affect you by 5 feet (minimum 0 feet), and you ignore penalties from the off-kilter condition."}],"applies":"Never","pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"School"},"pieces":[{"Text":"transmutation"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Casting time"},"pieces":[{"Text":"1 standard action"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Range"},"pieces":[{"Text":"personal"}],"pick_last":false,"suppress_when_all_zero":false},{"family":{"StatBlock":"Duration"},"pieces":[{"Text":"1 hour/level (D)"}],"pick_last":false,"suppress_when_all_zero":false}],"applies":"Always","print":true,"pool":"","tags":["Spell"],"subject":"Character","repeatable":false,"granted_by":[{"by":{"ClassSpellList":{"id":"technomancer","spell_level":2}},"when":"Always"},{"by":{"ClassSpellList":{"id":"witchwarper","spell_level":2}},"when":"Always"}],"provenance":{"book":"near_space","kind":"spell","closure_rows":["starfinder/paizo/near_space/sns_spells.lst:11","starfinder/paizo/near_space/sns_spells.lst:28"],"oracle_pin":"7f818006e371188e5717fd18d74d18a420747fc6","converter_version":"sheet_rule_convert/0.15.0"}}]
