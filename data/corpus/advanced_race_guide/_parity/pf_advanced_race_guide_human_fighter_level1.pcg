PCGVERSION:2.0

# System Information
# SD-27 Cycle E3.1 -- Advanced Race Guide parity baseline pilot case.
# Hand-authored against the real PCGen data checkout at $PCGEN_REPO_DIR
# (data/pathfinder/paizo/roleplaying_game/{core_rulebook,advanced_race_guide}/).
# "Core Rulebook" is loaded because it transitively PCC:-includes
# core_essentials/_core_essentials.pcc and the per-race
# core_essentials/races/human/_race.pcc (the actual base "Human" RACE
# definition in this checkout -- cr_races.lst itself only carries a
# "Human.MOD" modifier, not the base race). "Advanced Race Guide" supplies
# this cycle's real exercised records: the Dogslicer weapon
# (data/corpus/advanced_race_guide/equipment/arms_armor/dogslicer.json) and
# the Defiant Luck feat (data/corpus/advanced_race_guide/feat/general/defiant_luck.json).
CAMPAIGN:Core Rulebook|CAMPAIGN:Advanced Race Guide
VERSION:6.15.0
ROLLMETHOD:2|EXPRESSION:Epic Fantasy
PURCHASEPOINTS:N
GAMEMODE:Pathfinder_RPG
TABLABEL:0
AUTOSPELLS:Y
USEHIGHERKNOWN:N
USEHIGHERPREPPED:N
LOADCOMPANIONS:N
USETEMPMODS:Y
SKILLSOUTPUTORDER:0
IGNORECOST:N
ALLOWDEBT:N
AUTORESIZEGEAR:N

# Character Bio
CHARACTERNAME:pf1-arg-human-fighter-level1
TABNAME:
PLAYERNAME:
GENDER:Male
ALIGN:LN

# Character Attributes
# Mirrors SD-26's GE-06 deterministic Human Fighter level 1 pilot input
# contract (tests/fixtures/rules_core/pf1_human_fighter_level1_ge06_deterministic_input.txt)
# for the ability scores, so this book's pilot is a like-for-like baseline
# against the same CRB pilot shape.
STAT:STR|SCORE:16
STAT:DEX|SCORE:14
STAT:CON|SCORE:14
STAT:INT|SCORE:10
STAT:WIS|SCORE:12
STAT:CHA|SCORE:8
RACE:Human

# Character Class(es)
CLASS:Fighter|LEVEL:1|SKILLPOOL:0

# Character Templates

# Character Region
REGION:None

# Character Skills
SKILL:Climb|OUTPUTORDER:1|CLASSBOUGHT:[CLASS:Fighter|RANKS:1.0|COST:1|CLASSSKILL:Y]
SKILL:Intimidate|OUTPUTORDER:2|CLASSBOUGHT:[CLASS:Fighter|RANKS:1.0|COST:1|CLASSSKILL:Y]
SKILL:Swim|OUTPUTORDER:3|CLASSBOUGHT:[CLASS:Fighter|RANKS:1.0|COST:1|CLASSSKILL:Y]

# Character Languages
LANGUAGE:Common

# Character Feats
FEATPOOL:0.0

# Character Abilities
# Human's +2 ability-score bonus, applied to Strength -- same target as
# SD-26's GE-06 deterministic pilot input's `choice=choice:human_ability_bonus:ability:strength`.
# Consumes the racial "Ability Bonus" pool (CATEGORY:Special Ability,
# TYPE:AbilityBonus; cr_abilities_race.lst) the Human race's own
# "+2 to One Ability Score" trait grants automatically.
ABILITY:Ability Bonus|TYPE:NORMAL|CATEGORY:Special Ability|KEY:+2 Strength|TYPE:AbilityBonus

# Level-1 human fighter's three earned feat slots (1 base + 1 human bonus +
# 1 fighter bonus), same choices as SD-26's GE-06 deterministic pilot input:
ABILITY:FEAT|TYPE:NORMAL|CATEGORY:FEAT|KEY:Power Attack|TYPE:Combat.AttackOption|DESC:You can make exceptionally deadly melee attacks by sacrificing accuracy for power.
ABILITY:FEAT|TYPE:NORMAL|CATEGORY:FEAT|KEY:Dodge|TYPE:Combat|DESC:You are considerably harder to hit.
ABILITY:FEAT|TYPE:NORMAL|CATEGORY:FEAT|KEY:Weapon Focus|APPLIEDTO:Longsword|TYPE:Combat.WeaponFocus|DESC:You are especially good at using your chosen weapon.
# This book's own record: the Advanced Race Guide "Defiant Luck" feat
# (data/corpus/advanced_race_guide/feat/general/defiant_luck.json), gated on
# PREFACT:1,TEMPLATES,IsHuman=true in arg_feats.lst -- satisfied by this
# character's Human race/template. Grants a reroll resource
# (DefiantLuckTimes) this pilot's selected comparator dimensions do not
# measure, so it is exercised honestly (present on the character, real
# ARG-sourced feat) without needing new engine support to compute its effect.
ABILITY:FEAT|TYPE:NORMAL|CATEGORY:FEAT|KEY:Defiant Luck|TYPE:General|DESC:You can sometimes defiantly shrug off spells and attacks that would kill a lesser creature.

# Character Weapon proficiencies

# Character Equipment
# Chain Shirt + Longsword equipped/active (same GE-06 posture as SD-26's CRB
# pilot). The Dogslicer is this book's own exercised equipment record
# (data/corpus/advanced_race_guide/equipment/arms_armor/dogslicer.json,
# arg_equip_arms_armor.lst line 36): carried/equipped as a secondary weapon,
# not the primary attack weapon, since it requires its own Exotic Weapon
# Proficiency (Dogslicer) this level-1 pilot does not take -- it is included
# to exercise the real ARG record honestly, not to claim proficient combat use.
EQUIPNAME:Chain Shirt|OUTPUTORDER:1|COST:100.0|WT:25.0|QUANTITY:1.0
EQUIPNAME:Longsword|OUTPUTORDER:2|COST:15.0|WT:4.0|QUANTITY:1.0
EQUIPNAME:Dogslicer|OUTPUTORDER:3|COST:8.0|WT:1.0|QUANTITY:1.0
EQUIPSET:Default Set|ID:0.1|USETEMPMODS:Y
EQUIPSET:Armor|ID:0.1.1|VALUE:Chain Shirt|QUANTITY:1.0|USETEMPMODS:Y
EQUIPSET:Primary Hand|ID:0.1.2|VALUE:Longsword|QUANTITY:1.0|USETEMPMODS:Y
EQUIPSET:Equipped|ID:0.1.3|VALUE:Dogslicer|QUANTITY:1.0|USETEMPMODS:Y
CALCEQUIPSET:0.1

