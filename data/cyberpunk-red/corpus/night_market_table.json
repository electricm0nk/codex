    "name": "Night Market Type Table",
    "kind": "night_market_table",
    "source_page": "p339",
    "table": "type_of_goods_sold",
    "die": "1d6 twice",
    "rows": [
      {
        "roll": 1,
        "type_of_goods_sold": "Food and Drugs",
        "description": "Processed foods, fresh vegetable, live animals, and sometimes fresh street drugs."
      },
      {
        "roll": 2,
        "type_of_goods_sold": "Personal Electronics",
        "description": "Gizmos and gadgets galore. You can even find Black ICE if you hit the shadier stalls."
      },
      {
        "roll": 3,
        "type_of_goods_sold": "Weapons and Armor",
        "description": "Everything you need to cause some chaos on The Street."
      },
      {
        "roll": 4,
        "type_of_goods_sold": "Cyberware",
        "description": "The best cybertech on Street; probably not stolen or harvested. If you roll a Cyberware Option, any Foundational Cyberware (for example, a Cybereye or Neural Processor) required to install that Option is also available at the Night Market. Cyberware bought at a Night Market is not installed at the Night Market but the seller will send you to their preferred local Ripperdoc for a free installation."
      },
      {
        "roll": 5,
        "type_of_goods_sold": "Clothing and Fashionware",
        "description": "All the hottest street fashion in one place plus some chrome to accent. Fashionware can be installed at the Night Market."
      },
      {
        "roll": 6,
        "type_of_goods_sold": "Survival Gear",
        "description": "All the practical gear you need to survive the Time of the Red."
      }
    ],
    "intro_text": "Use the following tables to generate a Night Market on the spot. First, roll 1d6 twice on the table below to determine what is found at the Night Market. If you roll the same result twice, reroll until you get a different result.",
