# Rust build output
/target

# Python bytecode cache (generated by running scripts/**/tests/*.py directly)
__pycache__/
*.pyc

# graphify documentation-graph build output (regenerated by the closure
# pipeline's graphify sub-step; not a source artifact)
/graphify-out
# dated snapshot copies of the same generated tree (e.g. graphify-out.2026-07-22/)
/graphify-out.*

# Operator-supplied licensed corpus content (Paizo/PcGen EULA)
# The stubs at docs/release/SD-NN/artifacts/corpus/{apg,acg,beastiary1,…}/
# ship to origin; the operator-supplied/ subdirectory is excluded.
docs/release/SD-*/artifacts/corpus/operator-supplied/**
!docs/release/SD-*/artifacts/corpus/operator-supplied/README.md

# Wrangler CLI local cache (created by `wrangler pages deploy` etc.)
# Do not ship; the deploy state is rebuilt on each run.
.wrangler/
