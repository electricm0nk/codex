//! Controls on the catalog's own shape (generated by `artifacts/epic_4a/E4a.2_gen_catalog/gen_catalog.py`; the `REPLACED` list is
//! every compiled table, view and table-reading lookup the catalog re-implements over the package).

use std::path::{Path, PathBuf};

use crate::rules_core::rules_data_package::{TABLE_IDS, VIEWS};

fn source_files(root: &Path, skip: &dyn Fn(&Path) -> bool, out: &mut Vec<PathBuf>) {
    let Ok(entries) = std::fs::read_dir(root) else { return };
    for entry in entries.flatten() {
        let path = entry.path();
        if skip(&path) {
            continue;
        }
        if path.is_dir() {
            source_files(&path, skip, out);
        } else if path.extension().is_some_and(|ext| ext == "rs") {
            out.push(path);
        }
    }
}

fn catalog_dir() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR")).join("src/rules_core/rules_catalog")
}

/// The catalog files that are generated mirrors (not the tests that compare against the compiled
/// tables).
fn mirror_files() -> Vec<PathBuf> {
    let mut files = Vec::new();
    source_files(&catalog_dir(), &|_| false, &mut files);
    files
        .into_iter()
        .filter(|p| {
            let name = p.file_name().and_then(|n| n.to_str()).unwrap_or("");
            !matches!(name, "equivalence_tests.rs" | "override_tests.rs" | "control_tests.rs")
        })
        .collect()
}

/// Registered package tables that are also TYPES: the package carries each variant's facts
/// (`key`, `name`, `declaring_line`, `min_level`), but the enum's own methods still answer from
/// compiled `match` arms. The catalog re-exports the type; settling those methods is E4a.4's
/// ("no `.rs` left" has to place every non-table value), logged as a retro deferral.
const TYPES_WITH_COMPILED_METHODS: &[&str] =
    &["pathfinder_unchained/rogue_features/UnchainedRogueFeature", "pathfinder_unchained/summoner_features/UnchainedSummonerFeature"];

/// A catalog module re-exports a compiled item only by name (`pub use rt::<module>::<Name>;`),
/// never a table, a view or a lookup the catalog replaces, and never by glob.
#[test]
fn no_compiled_table_view_or_reader_is_re_exported_from_the_compiled_module() {
    let replaced: std::collections::BTreeSet<&str> =
        REPLACED.iter().copied().chain(TABLE_IDS.iter().copied()).chain(VIEWS.iter().map(|(id, _)| *id)).collect();
    let mut offenders = Vec::new();
    let mut re_exports = 0usize;
    for file in mirror_files() {
        let text = std::fs::read_to_string(&file).expect("read a catalog file");
        for line in text.lines() {
            let line = line.trim();
            let Some(path) = line
                .strip_prefix("pub use rt::")
                .or_else(|| line.strip_prefix("pub(crate) use rt::"))
                .and_then(|rest| rest.strip_suffix(';'))
            else {
                continue;
            };
            re_exports += 1;
            if path.contains('*') || path.contains('{') {
                offenders.push(format!("{}: glob or group re-export: {line}", file.display()));
                continue;
            }
            let id = path.replace("::", "/");
            if replaced.contains(id.as_str()) && !TYPES_WITH_COMPILED_METHODS.contains(&id.as_str()) {
                offenders.push(format!("{}: re-exports the compiled {id}", file.display()));
            }
        }
    }
    assert!(offenders.is_empty(), "the catalog hands out compiled data: {offenders:#?}");
    assert!(re_exports > 400, "scanned {re_exports} re-exports");
}

/// The other direction: every table in the package and every view of the compiled module has a
/// catalog replacement, so nothing a caller could ask the catalog for is left to the compiled copy
/// -- except the two enum types named above, whose methods stay compiled (E4a.4).
#[test]
fn every_package_table_and_view_has_a_catalog_replacement() {
    let replaced: std::collections::BTreeSet<&str> = REPLACED.iter().copied().collect();
    let missing: Vec<&str> = TABLE_IDS
        .iter()
        .copied()
        .chain(VIEWS.iter().map(|(id, _)| *id))
        .filter(|id| !replaced.contains(id) && !TYPES_WITH_COMPILED_METHODS.contains(id))
        .collect();
    assert!(missing.is_empty(), "tables or views with no catalog replacement: {missing:#?}");
}

/// The compiled module is named in the catalog only through the `rt` alias of a re-export.
#[test]
fn the_catalog_reaches_the_compiled_module_only_through_re_exports() {
    let needle = format!("{}{}", "rules_tables", "::");
    let mut offenders = Vec::new();
    for file in mirror_files() {
        let text = std::fs::read_to_string(&file).expect("read a catalog file");
        for (n, line) in text.lines().enumerate() {
            if line.contains(&needle) {
                offenders.push(format!("{}:{}: {}", file.display(), n + 1, line.trim()));
            }
        }
    }
    assert!(offenders.is_empty(), "{offenders:#?}");
}

/// The acceptance rule of E4a.2, as a test: no file outside the compiled module (and outside
/// this test) names the compiled module with a path.
#[test]
fn no_importer_names_the_compiled_tables() {
    let root = Path::new(env!("CARGO_MANIFEST_DIR"));
    let needle = format!("{}{}", "rules_tables", "::");
    let compiled = root.join("src/rules_core/rules_tables");
    let skip = |p: &Path| {
        let name = p.file_name().and_then(|n| n.to_str()).unwrap_or("");
        name == "target" || name == "node_modules" || name == ".git" || p == compiled
    };
    let mut files = Vec::new();
    for dir in ["src", "crates", "apps/desktop/src-tauri", "tests"] {
        source_files(&root.join(dir), &skip, &mut files);
    }
    let mut importers = Vec::new();
    for file in &files {
        let text = std::fs::read_to_string(file).unwrap_or_default();
        if text.contains(&needle) {
            importers.push(file.strip_prefix(root).unwrap_or(file).display().to_string());
        }
    }
    assert!(importers.is_empty(), "files still importing the compiled tables: {importers:#?}");
    assert!(files.len() > 1000, "scanned {} files", files.len());
}

