{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VarTable",
  "description": "`data/sheet_rules/_vars/<VarId>.json` -- every contribution to one variable, corpus-wide.",
  "type": "object",
  "required": [
    "contributions",
    "declared_by",
    "provenance",
    "var"
  ],
  "properties": {
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/VarContribution"
      }
    },
    "declared_by": {
      "description": "Rules whose closure declares the name; no held declarer -> the value is 0.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "label": {
      "description": "The words this variable is printed under when a sheet line has to name it.\n\n[`VarId`] is a content hash, so before this field existed the only way to name a variable was the source name, and the live side is forbidden to read one (`decisions.md §11`). The converter writes the label at ingest, spaced out of the source name mechanically and never interpreted; an empty label means the converter had no name for the id and the renderer falls back to generic words.",
      "default": "",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/definitions/VarProvenance"
    },
    "var": {
      "type": "string"
    }
  },
  "definitions": {
    "Ability": {
      "type": "string",
      "enum": [
        "Str",
        "Dex",
        "Con",
        "Int",
        "Wis",
        "Cha"
      ]
    },
    "Applies": {
      "description": "The gate. Two-valued (Include / Exclude) plus `Situational`, which includes and prints its condition on the line.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Always",
            "Never"
          ]
        },
        {
          "type": "object",
          "required": [
            "All"
          ],
          "properties": {
            "All": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Applies"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "AtLeast"
          ],
          "properties": {
            "AtLeast": {
              "type": "object",
              "required": [
                "n",
                "of"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0.0
                },
                "of": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Applies"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Not"
          ],
          "properties": {
            "Not": {
              "$ref": "#/definitions/Applies"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Compare"
          ],
          "properties": {
            "Compare": {
              "type": "object",
              "required": [
                "lhs",
                "op",
                "rhs"
              ],
              "properties": {
                "lhs": {
                  "$ref": "#/definitions/Expr"
                },
                "op": {
                  "$ref": "#/definitions/Cmp"
                },
                "rhs": {
                  "$ref": "#/definitions/Expr"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Holds"
          ],
          "properties": {
            "Holds": {
              "type": "object",
              "required": [
                "count",
                "what"
              ],
              "properties": {
                "count": {
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0.0
                },
                "what": {
                  "$ref": "#/definitions/Holdable"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Chosen"
          ],
          "properties": {
            "Chosen": {
              "type": "object",
              "required": [
                "choice"
              ],
              "properties": {
                "choice": {
                  "type": "string"
                },
                "option": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "`subject = Item`: the item carries at least `n` of the tags.",
          "type": "object",
          "required": [
            "ItemHas"
          ],
          "properties": {
            "ItemHas": {
              "type": "object",
              "required": [
                "n",
                "tags"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0.0
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Include; the condition prints on the line.",
          "type": "object",
          "required": [
            "Situational"
          ],
          "properties": {
            "Situational": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "BonusType": {
      "description": "A stacking type. `name` is a game-rule word (`\"Racial\"`, `\"Base\"`), never a token.",
      "type": "object",
      "required": [
