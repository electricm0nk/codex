aponDamage\":[],\"selectedAlternateTraitKeys\":[],\"selectedTraits\":[],\"resolvedRacialTraits\":{\"raceId\":\"core:race:human\",\"raceKey\":\"core:race:human\",\"raceName\":\"\",\"book\":\"\",\"appliedTraits\":[],\"suppressions\":[],\"firedFlags\":[],\"inertFlags\":[],\"unmatchedSelections\":[],\"blockedAlternates\":[],\"conflictingSelections\":[],\"renderedTraitDescriptions\":[],\"displayValueFeats\":[],\"errors\":[\"core:race:human: the race-trait picker reads the Pathfinder race corpus; a Starfinder race's traits are its sheet lines\"]},\"abilityScores\":{\"strength\":16,\"dexterity\":14,\"constitution\":12,\"intelligence\":11,\"wisdom\":10,\"charisma\":10},\"skillAllocations\":[{\"skillId\":\"athletics\",\"ranks\":3},{\"skillId\":\"intimidate\",\"ranks\":3},{\"skillId\":\"medicine\",\"ranks\":3},{\"skillId\":\"piloting\",\"ranks\":3},{\"skillId\":\"survival\",\"ranks\":3}],\"equipmentSelections\":[{\"itemId\":\"core:equipment:defiance_series_squad\",\"activeState\":\"EquippedActive\"},{\"itemId\":\"core:equipment:laser_rifle_azimuth\",\"activeState\":\"EquippedActive\"},{\"itemId\":\"core:equipment:baton_tactical\",\"activeState\":\"SelectedInactive\"},{\"itemId\":\"core:equipment:battery\",\"activeState\":\"SelectedInactive\"},{\"itemId\":\"core:equipment:battery\",\"activeState\":\"SelectedInactive\"},{\"itemId\":\"core:equipment:serum_of_healing_mk_1\",\"activeState\":\"SelectedInactive\"},{\"itemId\":\"core:equipment:serum_of_healing_mk_1\",\"activeState\":\"SelectedInactive\"}],\"sheetLines\":[{\"id\":\"core:ability:2_racial_stat_bonus\",\"kind\":\"ability\",\"label\":\"+2 Racial Stat Bonus\",\"form\":\"number\",\"value\":\"+2\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:armor_prof_heavy_armor\",\"kind\":\"ability\",\"label\":\"Armor Prof ~ Heavy Armor\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:armor_prof_light_armor\",\"kind\":\"ability\",\"label\":\"Armor Prof ~ Light Armor\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:human_default_bonus_feat\",\"kind\":\"ability\",\"label\":\"BONUS FEAT\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"Humans select one extra feat at 1st level.\",\"condition\":null},{\"id\":\"core:ability:soldier_class_feature_combat_feat\",\"kind\":\"ability\",\"label\":\"Combat Feat\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"At 2nd level and every 2 levels thereafter, you gain a bonus feat in addition to those gained from normal advancement. These bonus feats must be selected from those listed as combat feats. Whenever you gain a new bonus feat, you can also choose to replace one of the bonus feats you have already learned with a different bonus feat. The feat you replace can't be one that was used as a prerequisite for another feat or other ability. You can change only one feat at any given level, and you must choose whether or not to swap the feat at the time you gain the new bonus feat.\",\"condition\":null},{\"id\":\"core:ability:soldier_class_feature_gear_boost\",\"kind\":\"ability\",\"label\":\"Gear Boost\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"At 3rd level and every 4 levels thereafter, you learn a trick called a gear boost that make you better with a particular type of weapon or armor. Choose from the gear boosts listed below. Some gear boosts require you to reach a certain soldier level to select them; this level is indicated in parentheses after the boost's name.\",\"condition\":null},{\"id\":\"core:ability:human\",\"kind\":\"ability\",\"label\":\"Human\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:mercenary\",\"kind\":\"ability\",\"label\":\"Mercenary\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"Whether you take jobs that match your ethical beliefs or you fight for anyone who can afford your services, you are a hired gun. You might take pride in your past accomplishments, proudly displaying trophies of your kills, or you might be laden with guilt over being the sole survivor of a mission gone terribly wrong. You most likely work with other mercenaries and are familiar with the methodologies of military actions all across the galaxy.\\nTITLE: Mercenary\",\"condition\":null},{\"id\":\"core:ability:soldier_class_feature_primary_fighting_style\",\"kind\":\"ability\",\"label\":\"Primary Fighting Style\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"You have a preferred fighting style that represents the type of soldier you are. Each fighting style is composed of various style techniques that you learn as you gain experience. You must pick one fighting style upon taking your first soldier level, and once made, this choice cannot be changed. Descriptions of the fighting styles you can choose from appear on pages 112-115.\",\"condition\":null},{\"id\":\"core:ability:soldier_class_feature_primary_style_technique\",\"kind\":\"ability\",\"label\":\"Primary Style Technique\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"At 1st level and every 4 levels thereafter, you gain a style technique unique to your primary fighting style.\",\"condition\":null},{\"id\":\"core:ability:human_default_size_and_type\",\"kind\":\"ability\",\"label\":\"SIZE AND TYPE\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"Humans are Medium humanoids and have the human subtype.\",\"condition\":null},{\"id\":\"core:ability:human_default_skilled\",\"kind\":\"ability\",\"label\":\"SKILLED\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"Humans gain an additional skill rank at 1st level and each level thereafter.\",\"condition\":null},{\"id\":\"character_operations_manual:ability:shield_prof_shields\",\"kind\":\"ability\",\"label\":\"Shield Prof ~ Shields\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:soldier\",\"kind\":\"ability\",\"label\":\"Soldier\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:mercenary_theme_benefit_theme_knowledge\",\"kind\":\"ability\",\"label\":\"THEME KNOWLEDGE (Athletics)\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"You are knowledgeable about the military, from rival mercenary groups to standard military procedures to planetary armed forces, and you can draw upon this fount of information to aid your adventurous pursuits. Reduce the DC of Culture checks and Profession (mercenary) checks to recall knowledge about hierarchies, practices, personnel, and so on in the military by 5. Athletics is a class skill for you, though if it is a class skill from the class you take at 1st level, you instead gain a +1 bonus to Athletics checks. In addition, you gain an ability adjustment of +1 to Strength at character creation.\",\"condition\":null},{\"id\":\"core:ability:mercenary_theme_benefit_theme_knowledge#bonus0\",\"kind\":\"ability\",\"label\":\"THEME KNOWLEDGE (Athletics)\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:mercenary_theme_benefit_theme_knowledge#bonus1\",\"kind\":\"ability\",\"label\":\"THEME KNOWLEDGE (Str)\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_advanced_melee_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Advanced Melee Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_basic_melee_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Basic Melee Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_grenades\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Grenades\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_heavy_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Heavy Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_longarms\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Longarms\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_small_arms\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Small Arms\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_prof_sniper_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Prof ~ Sniper Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:soldier_class_feature_weapon_specialization\",\"kind\":\"ability\",\"label\":\"Weapon Specialization\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"You gain Weapon Specialization as a bonus feat for each weapon type this class grants you proficiency with.\",\"condition\":null},{\"id\":\"core:ability:weapon_specialization_advanced_melee_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Specialization ~ Advanced Melee Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_specialization_basic_melee_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Specialization ~ Basic Melee Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_specialization_heavy_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Specialization ~ Heavy Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_specialization_longarms\",\"kind\":\"ability\",\"label\":\"Weapon Specialization ~ Longarms\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_specialization_small_arms\",\"kind\":\"ability\",\"label\":\"Weapon Specialization ~ Small Arms\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:ability:weapon_specialization_sniper_weapons\",\"kind\":\"ability\",\"label\":\"Weapon Specialization ~ Sniper Weapons\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:class:soldier\",\"kind\":\"class\",\"label\":\"Soldier\",\"form\":\"number\",\"value\":\"+3\",\"also\":[],\"prose\":\"Skill ranks per level: 4\",\"condition\":null},{\"id\":\"core:class:soldier#bonus2\",\"kind\":\"class\",\"label\":\"Soldier (Stamina Points)\",\"form\":\"number\",\"value\":\"+21\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:class:soldier#bonus3\",\"kind\":\"class\",\"label\":\"Soldier (base Fortitude save)\",\"form\":\"number\",\"value\":\"+3\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:class:soldier#bonus4\",\"kind\":\"class\",\"label\":\"Soldier (base Reflex save)\",\"form\":\"number\",\"value\":\"+1\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:class:soldier#bonus5\",\"kind\":\"class\",\"label\":\"Soldier (base Will save)\",\"form\":\"number\",\"value\":\"+3\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:class:soldier#bonus1\",\"kind\":\"class\",\"label\":\"Soldier (hit points)\",\"form\":\"number\",\"value\":\"+18\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:equipment:defiance_series_squad\",\"kind\":\"equipment\",\"label\":\"Defiance Series, Squad\",\"form\":\"number\",\"value\":\"+5\",\"also\":[\"quantity 1\",\"upgrade slots used 0 of 1\"],\"prose\":\"EAC = 5\\nKAC = 8\\nPrice: 1220\\nArmor check penalty: -4\\nMax Dex bonus: 1\\nQuality: Level: 3\\nQuality: BULK: 3\\nUpgrade slots: 1\",\"condition\":null},{\"id\":\"core:equipment:defiance_series_squad#bonus1\",\"kind\":\"equipment\",\"label\":\"Defiance Series, Squad (KAC)\",\"form\":\"number\",\"value\":\"+8\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:equipment:defiance_series_squad#speed2\",\"kind\":\"equipment\",\"label\":\"Defiance Series, Squad (walk speed)\",\"form\":\"number\",\"value\":\"-10\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:equipment:laser_rifle_azimuth\",\"kind\":\"equipment\",\"label\":\"Laser rifle, azimuth\",\"form\":\"dice\",\"value\":\"1d8\",\"also\":[\"quantity 1\"],\"prose\":\"-\\nPrice: 425\\nRange: 120\\nQuality: Level: 1\\nQuality: Critical: Burn 1d6\\nQuality: Capacity: 20 charges\\nQuality: Usage: 1\\nQuality: Bulk: 1\\nItem level: 1\\nDamage: 1d8\",\"condition\":null},{\"id\":\"core:feat:coordinated_shot\",\"kind\":\"feat\",\"label\":\"Coordinated Shot\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"You can maneuver a foe to be in the direct line of an ally's fire.\\nWhen you are threatening a foe with a melee weapon, any ally that has line of sight to that foe without you granting that foe cover gains a +1 bonus to ranged attack rolls against that foe.\",\"condition\":null},{\"id\":\"core:feat:deadly_aim\",\"kind\":\"feat\",\"label\":\"Deadly Aim\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"Your can strike your enemies' weak points and deal more damage.\\nWhen you take the attack or full attack action with weapons (including a solarian's solar manifestation, but not spells or other special abilities of any kind), you can take a -2 penalty to your attack rolls. If you do, those attacks deal an additional 0 (minimum 1).\",\"condition\":null},{\"id\":\"core:feat:quick_draw\",\"kind\":\"feat\",\"label\":\"Quick Draw\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"You can draw weapons faster than most.\\nYou can draw a weapon as a swift action. Additionally, when making an attack using a thrown weapon as an attack or full attack action, you can draw a weapon as part of the action of making a thrown attack with it. You can draw a hidden weapon (see Sleight of Hand on page 146) as a move action.\\nNormal: You can draw a weapon as a move action, or (if your base attack bonus is +1 or higher) as part of a move action, and you can draw a hidden weapon as a standard action.\",\"condition\":null},{\"id\":\"core:feat:weapon_focus\",\"kind\":\"feat\",\"label\":\"Weapon Focus\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"You have increased training in a particular weapon type, making it easier to hit your target.\\nChoose one weapon type (small arms, longarms, heavy weapons, etc.). You gain a +1 bonus to attack rolls with that weapon type. If your base attack bonus is at least 3 lower than your character level (or your mechanic's class level, if you are a drone), you gain a +2 bonus instead.\",\"condition\":null},{\"id\":\"core:race:human\",\"kind\":\"race\",\"label\":\"Human\",\"form\":\"words\",\"value\":\"\",\"also\":[],\"prose\":\"Speed: Walk 30 ft.\",\"condition\":null},{\"id\":\"core:race:human#race_hp\",\"kind\":\"race\",\"label\":\"Human (racial Hit Points)\",\"form\":\"number\",\"value\":\"+4\",\"also\":[],\"prose\":\"\",\"condition\":null},{\"id\":\"core:equipment:baton_tactical\",\"kind\":\"equipment\",\"label\":\"Baton, tactical\",\"form\":\"dice\",\"value\":\"1d4\",\"also\":[\"quantity 1\"],\"prose\":\"Analog.operative\\nPrice: 90\\nQuality: Level: 1\\nQuality: Critical: -\\nQuality: Bulk: L\\nItem level: 1\\nDamage: 1d4\",\"condition\":null},{\"id\":\"core:equipment:battery\",\"kind\":\"equipment\",\"label\":\"Battery\",\"form\":\"words\",\"value\":\"\",\"also\":[\"quantity 2\"],\"prose\":\"-\\nPrice: 60\\nQuality: Level: 1\\nQuality: ChargesCartridges: 20\\nQuality: Bulk: -\\nItem level: 1\",\"condition\":null},{\"id\":\"core:equipment:serum_of_healing_mk_1\",\"kind\":\"equipment\",\"label\":\"Serum of Healing Mk 1\",\"form\":\"words\",\"value\":\"\",\"also\":[\"quantity 2\"],\"prose\":\"Price: 50\\nQuality: Level: 1\\nQuality: Bulk: L\",\"condition\":null}],\"sheetRulesUnavailableReason\":null,\"featSkillBonuses\":{\"