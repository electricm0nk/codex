+        mix_input.chosen.class_levels.len() >= 2,
+        "multiclass Ranger: the mix must load at least two classes: {:?}",
+        mix_input.chosen.class_levels
+    );
+    let receipt = codex::rules_core::pilot_compute::build_pilot_headless_receipt(&mix_input);
+    let diagnostics: Vec<_> =
+        receipt.computation.diagnostics.iter().filter(|d| d.claim_blocking).collect();
+    assert_eq!(
+        receipt.status,
+        codex::rules_core::pilot_compute::HeadlessReceiptStatus::Computed,
+        "{diagnostics:?}"
     );
 }
 
