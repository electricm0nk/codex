+++ b/tests/sd13_ranger_spell_save_dcs.rs
@@ -195,9 +195,22 @@ fn multiclass_ranger_does_not_gain_dc_records() {
         "multiclass Ranger must not gain any spell-save-DC record: {:?}",
         computation.explanations
     );
+    // SD-36 Epic F3d: assertion (b) changed meaning -- a Ranger+other-class mix now
+    // reaches Computed through the generic multiclass gate + fold (was: must stay
+    // claim-blocked). Vacuity guard: the mix must really load >= 2 classes.
