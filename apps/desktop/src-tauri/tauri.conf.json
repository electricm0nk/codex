{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex",
  "version": "0.16.0",
  "identifier": "io.electricm0nk.codex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex",
        "width": 1920,
        "height": 1200,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {
      "resources/authoring_workbench/guard-stance-package/": "resources/authoring_workbench/guard-stance-package/",
      "resources/corpus_fixtures/": "resources/corpus_fixtures/",
      "resources/corpus_fixtures/spell/": "resources/corpus_fixtures/spell/",
      "resources/corpus_fixtures/equipment/": "resources/corpus_fixtures/equipment/",
      "resources/corpus_fixtures/_settled/": "resources/corpus_fixtures/_settled/",
      "../../../data/corpus/": "data/corpus/",
      "../../../data/sheet_rules/": "data/sheet_rules/"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {},
      "appimage": {}
    },
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "macOS": {
      "dmg": {}
    }
  }
}
