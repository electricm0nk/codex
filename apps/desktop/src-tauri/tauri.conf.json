{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex",
  "version": "0.0.0",
  "identifier": "io.electricm0nk.codex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "resources": [
      "resources/ge08/guard-stance-package/"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {},
      "appimage": {}
    },
    "windows": {
      "msi": {},
      "nsis": {}
    },
    "macOS": {
      "app": {},
      "dmg": {}
    }
  }
}
