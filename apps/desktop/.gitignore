node_modules/
dist/
src-tauri/target/

# Generated by scripts/gen-corpus-bundle.mjs (a sanitised, residue-free
# mirror of data/corpus/ for the Tauri bundle). Not committed: it is
# regenerated by `npm run build` and by scripts/verify.sh's `corpus-bundle`
# stage, and is ~64 MB of derived JSON. The .gitkeep is tracked so the
# tauri.conf.json `resources` path always resolves on a clean checkout.
src-tauri/resources/corpus_bundle/*
!src-tauri/resources/corpus_bundle/.gitkeep
