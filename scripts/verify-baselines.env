# the run's own log (`/tmp/codex-verify-eTajSL/root-full.log`) with the awk
# form this file mandates:
#   awk '/^test result:/ { for (i=1;i<=NF;i++) if ($(i+1)=="passed;") t+=$i } \
#        END{print t+0}'  root-full.log                       -> 5907
#   awk '/^test result:/ { for (i=1;i<=NF;i++) if ($(i+1)=="failed;") t+=$i } \
#        END{print t+0}'  root-full.log                       ->    5
#   awk '/^test result: FAILED/{n++} END{print n+0}' root-full.log ->  5
#
# The +10 is accounted for BY NAME and reconciles against the root-lib delta:
#   root-lib, derived above (git diff HEAD -- src/ adds no #[test])       + 0
#   tests/sd27_pu_class_feature_descriptions_carry_the_characters_numbers.rs
#     (NEW, untracked): awk '/#\[test\]/{n++} END{print n}'    -> 10     +10
#     and the log's own line for that binary reads
#     `test result: ok. 10 passed; 0 failed`
#   git status --porcelain tests/  lists exactly this one file and no other
# 0 + 10 = 10, and 5897 + 10 = 5907 exactly.
BASELINE_ROOT_FULL_TESTS=5907

# Number of test binaries the full sweep actually RUNS (counted from cargo's
# own `Running ...` lines). This is the specific guard against the fail-fast
# trap: a run that executes a fraction of the suites and still reports a clean
# summary is caught here even if every executed suite passed.
#
# RAISED 507 -> 510 on 2026-07-31: SD-27 added three integration suites
# (`tests/sd27_size_modifiers_to_armor_class.rs`,
# `tests/sd27_pu_class_wiring_pin.rs`, `tests/sd27_book_license_record_counts.rs`).
#
# RAISED 510 -> 514 on 2026-07-31 by the SD-27 reach-verification sweep. Four
# integration suites were added by this tree's working diff, and the +4 is
# accounted for by name rather than by difference:
#   tests/sd27_alternate_racial_trait_reachability.rs
#   tests/sd27_equipment_modifier_price_matches_corpus_cost_token.rs
#   tests/sd27_pu_deferred_features_reach_the_character_sheet.rs
#   tests/sd27_size_modifiers_to_touch_cmb_cmd_and_attack.rs
#
# RAISED 514 -> 518 on 2026-07-31 by the SD-27 tranche/7-1 verification sweep.
# Four binaries were added and the +4 is accounted for by name rather than by
# difference -- three integration suites plus one new bin target:
#   tests/sd27_non_crb_spell_level_gate.rs
#   tests/sd27_aasimar_globalvar_gate_closes_the_dead_affordance.rs
#   tests/sd27_arg_and_pu_feat_effects.rs
#   src/bin/ingest_class_spell_levels_arg.rs
#
# RAISED 518 -> 521 on 2026-07-31 by the SD-27 tranche/7-1 re-verification
# sweep. Three binaries were added and the +3 is accounted for by name rather
# than by difference -- three integration suites, no new bin targets:
#   tests/sd27_feat_effects_reach_both_compute_paths.rs
#   tests/sd27_feat_prerequisite_enforcement.rs
#   tests/sd27_known_spells_must_be_on_the_class_spell_list.rs
# Cross-checked against the tree rather than against memory: `git status
# --porcelain tests/` lists exactly these three as untracked and nothing else.
#
# RAISED 521 -> 526 on 2026-07-31 by the SD-27 tranche/7-1 reach-closure
# verification sweep. Five binaries were added and the +5 is accounted for BY
# NAME rather than by difference -- five integration suites, no new bin
# targets:
#   tests/sd27_ability_automatic_granted_race_traits.rs
#   tests/sd27_apg_delta_spell_rows_resolve_against_their_base.rs
#   tests/sd27_duergar_invisibility_sla_is_upstream_blocked.rs
#   tests/sd27_flat_footed_armor_class.rs
#   tests/sd27_pu_class_features_reach_by_corpus_key.rs
# Cross-checked against the tree rather than against memory: `git status
# --porcelain tests/` lists exactly these five as untracked and nothing else,
# and `git status --porcelain src/bin/` is empty. 521 + 5 = 526, which is the
# `grep -c '^     Running '` count from the run's own log.
#
# RAISED 526 -> 528 on 2026-08-01 by the SD-27 tranche/7-1 RE-VERIFICATION
# sweep. Two binaries were added and the +2 is accounted for BY NAME rather
# than by difference -- two integration suites, no new bin targets:
#   tests/sd27_pu_prose_derived_class_features_reach_the_sheet.rs
#   tests/sd27_resolved_racial_trait_display_values.rs
# Cross-checked against the tree rather than against memory: `git status
# --porcelain tests/` lists exactly these two as untracked and nothing else,
# and `git status --porcelain src/bin/` is empty. 526 + 2 = 528, which is the
# `awk '/^[[:space:]]*Running /{n++}'` count from the run's own log -- and the
# same number a python re-parse and GNU `command grep -c` returned on it.
#
# NOT 529. That figure appears in a prior cycle report and is a miscount: it
# is the number of `^test result:` lines, which includes cargo's `Doc-tests`
# summary line. The gate counts `Running` lines (verify.sh:203), and a suite
# count that silently includes the doc-test summary would over-report the
# fail-fast guard's coverage by one -- the exact direction this floor exists
# to catch.
#
# RAISED 528 -> 529 on 2026-08-01 by the SD-27 tranche/7-1 FINAL verification
# sweep. Derived by name, not by difference -- one new integration suite, no
# new bin targets:
#   tests/sd27_pu_class_feature_descriptions_carry_the_characters_numbers.rs
# `git status --porcelain tests/` lists exactly this one file as untracked and
# nothing else, and `git status --porcelain src/bin/` is empty. 528 + 1 = 529,
# which is the `awk '/^[[:space:]]*Running /{n++}'` count from that run's own
# log (`/tmp/codex-verify-eTajSL/root-full.log`).
#
# The `^test result:` count on that same log is 530, one higher, for exactly
# the reason recorded above: it includes cargo's `Doc-tests` summary line
# (`awk '/^ *Doc-tests /{n++}'` -> 1). The gate counts `Running` lines.
BASELINE_ROOT_TEST_BINARIES=529

