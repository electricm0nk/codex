# scripts/pcgen-oracle-pin.env — the pinned PCGen oracle (public repo, never vendored).
# WHY: every corpus instrument resolves $PCGEN_CORPUS_ROOT (default $HOME/workspace/repos/pcgen/data)
# and until this file existed nothing pinned WHICH pcgen commit that was, so a cloud runner or a
# fresh box could sweep against a different oracle and report CLEAN. Bump deliberately: change the
# SHA here, re-run the full gate, and let corpus-sweep name every shipped record whose source moved.
PCGEN_ORACLE_REPO=https://github.com/PCGen/pcgen.git
PCGEN_ORACLE_SHA=7f818006e371188e5717fd18d74d18a420747fc6
PCGEN_ORACLE_SHA_DATE=2026-06-17            # informational: upstream commit date of the pin
# data/darwins_world_2/.../terrors_of_twisted_earth added for
# tests/sd17_b_races_and_abilities.rs::parser_runs_in_linear_time_on_representative_lst,
# which needs one real large-file fixture (~16 KB) to demonstrate O(n)
# parsing; a CI-fetched sparse checkout without it panicked instead of
# skipping (CI runs 35050389421, 35045137495 -- see the oracle-fetch step in
# .github/workflows/*.yml).
PCGEN_ORACLE_SPARSE_PATHS="data/pathfinder system/gameModes/Pathfinder data/darwins_world_2/rpg_objects/darwins_world_2/terrors_of_twisted_earth"
